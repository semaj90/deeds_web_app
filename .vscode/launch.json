{
"version": "0.2.0",
"configurations": [
    {
    "name": "Python: MLP Scheduler",
    "type": "debugpy",
    "request": "launch",
    "program": "${workspaceFolder}/backend/mlp_scheduler.py",
    "console": "integratedTerminal",
    "justMyCode": true,
    "env": {
        "PYTHONUNBUFFERED": "1"
    },
    "args": []
},
{
    "name": "Python: Mirror Service",
    "type": "debugpy",
    "request": "launch",
    "program": "${workspaceFolder}/backend/mirror_service.py",
    "console": "integratedTerminal",
    "justMyCode": true,
    "env": {
        "PYTHONUNBUFFERED": "1"
    },
    "args": []
},
{
    "name": "Python: DocLing Gateway",
    "type": "debugpy",
    "request": "launch",
    "module": "backend.docling_gateway.app",
    "console": "integratedTerminal",
    "justMyCode": true,
    "env": {
        "PYTHONUNBUFFERED": "1",
        "CUDA_VISIBLE_DEVICES": "0"
    },
    "args": []
},
{
    "name": "Python: Sync Worker",
    "type": "debugpy",
    "request": "launch",
    "program": "${workspaceFolder}/backend/sync_worker.py",
    "console": "integratedTerminal",
    "justMyCode": true,
    "env": {
        "PYTHONUNBUFFERED": "1"
    },
    "args": []
}
],
"compounds": [
    {
    "name": "All MLP Workers",
    "configurations": [
        "Python: MLP Scheduler",
        "Python: Mirror Service",
        "Python: DocLing Gateway",
        "Python: Sync Worker"
    ],
    "stopAll": true
}
]
}
