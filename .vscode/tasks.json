    {
      "label": "CMake: Test Addon (CUDA Check)",
      "type": "shell",
      "command": "node -e \"const b=require('./simd-bridge/cpp/build/Release/tensorrt_bridge.node'); console.log('CUDA:',b.checkCudaAvailable()===1?'GPU':'CPU'); console.log('ReLU:',Array.from(b.relu(new Float32Array([1,2,3,-1,-2,0]),6))); console.log('Dot:',Array.from(b.dotProduct(new Float32Array([1,2,3]),new Float32Array([4,5,6]),3))); console.log('Sim:',Array.from(b.graphSimilarity(new Float32Array([1,0,0,0,1,0]),2,3))); console.log('KMeans:',Array.from(b.clusterEmbeddings(new Float32Array([0,0,1,1,10,10,11,11]),4,2,2,50))); console.log('All 5 GPU tests passed');\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\libtorch-win-shared-with-deps-2.9.0+cu130\\libtorch\\lib;${env:PATH}",
          "CUDA_VISIBLE_DEVICES": "0"
        }
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
