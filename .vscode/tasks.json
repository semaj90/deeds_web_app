      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Docker Services Up",
      "type": "shell",
      "command": "$ErrorActionPreference = 'Stop'; if (-not (Get-Command docker -ErrorAction SilentlyContinue)) { Write-Error 'Docker CLI is not installed or not on PATH.'; exit 1 }; try { docker version | Out-Null } catch { Write-Error 'Docker Desktop Linux engine is unavailable. Start Docker Desktop or switch to the Linux containers backend, then retry.'; exit 1 }; $serviceAliases = @(@('deeds-postgres-prod','postgres-pgvector','phase66-postgres'), @('deeds-redis-prod','phase66-redis','legal-ai-redis'), @('deeds-qdrant-prod','phase66-qdrant','legal-ai-qdrant'), @('phase66-minio','legal-ai-minio'), @('phase66-rabbitmq','legal-ai-rabbitmq'), @('phase66-couchdb','legal-ai-couchdb')); $toStart = @(); foreach ($aliases in $serviceAliases) { $matches = @(); foreach ($name in $aliases) { $status = docker inspect --format '{{.State.Status}}' $name 2>$null; if ($LASTEXITCODE -eq 0) { $matches += @{ Name = $name; Status = $status.Trim() } } } if ($matches.Count -eq 0) { Write-Host ('Skipping missing service aliases: ' + ($aliases -join ', ')) -ForegroundColor Yellow; continue } $running = $matches | Where-Object { $_.Status -eq 'running' } | Select-Object -First 1; if ($running) { Write-Host ('Already running: ' + $running.Name) -ForegroundColor DarkGray; continue } $toStart += ($matches | Select-Object -First 1).Name }; if ($toStart.Count -eq 0) { Write-Host 'All requested services are already running.' -ForegroundColor Green; exit 0 }; docker start @toStart",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Docker Services Status",
      "type": "shell",
      "command": "docker ps --format \"table {{.Names}}\\t{{.Status}}\\t{{.Ports}}\"",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "DB Migrate",
      "type": "shell",
      "command": "npx drizzle-kit migrate",
