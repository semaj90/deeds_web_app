      "type": "shell",
      "command": "if (Test-Path build) { Remove-Item -Recurse -Force build }; if (Test-Path build-debug) { Remove-Item -Recurse -Force build-debug }; if (Test-Path build-cpu) { Remove-Item -Recurse -Force build-cpu }; Write-Host 'All build dirs cleaned'",
