{
	servers {
		protocols h1 h2 h3
	}
}

https://localhost:8443 {
	tls internal

	encode zstd gzip

	# SvelteKit OpenAI-compatible facade
	handle /api/* {
		reverse_proxy host.docker.internal:5173 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# TRACE MCP
	handle /mcp* {
		reverse_proxy host.docker.internal:8788 {
			flush_interval -1
			header_up Host {host}
		}
	}

	# Optional direct llama-server lane, exposed under /llama/
	handle_path /llama/* {
		reverse_proxy host.docker.internal:8090 {
			flush_interval -1
			header_up Host {host}
		}
	}

	# SvelteKit app shell / fallback
	handle {
		reverse_proxy host.docker.internal:5173 {
			flush_interval -1
			header_up Host {host}
		}
	}
}
