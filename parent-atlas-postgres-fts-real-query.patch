+
+function boundLimit(limit: number): number {
+  if (!Number.isFinite(limit)) return 20;
+  return Math.max(1, Math.min(Math.trunc(limit), 200));
+}
+
+function globToSqlLikePattern(pattern: string): string {
+  return pattern
+    .replace(/([\\%_])/g, '\\$1')
+    .replace(/\*/g, '%')
+    .replace(/\?/g, '_');
+}
