# Prevent copying entire 3–10 GB repo into Docker
*/

# Include only what's needed for builds
!sveltekit-frontend/**
!python-services/**
!tensor_services/**
!engine-builder/**
!training/**
!clickhouse-mirror.py
!Dockerfile.clickhouse-mirror

# Exclude large/unnecessary directories
.cache/
node_modules/
logs/
temp*/
tmp*/
*.log
*.tmp
__pycache__/
.pytest_cache/
.coverage
dist/
build/
.vscode/
.git/
*.md
docs/
scripts/
tests/
*.txt
*.json
!package.json
!tsconfig.json
!pyproject.toml
!requirements*.txt
!Dockerfile*
!docker-compose*.yml