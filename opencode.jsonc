{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "provider": {
    "bifrost-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bifrost Gemma4 Local",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local"
      },
      "models": {
        "gemma4-legal-iq4xs-direct.gguf": {
          "name": "Gemma4 Legal",
          "tools": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "bifrost-local/gemma4-legal-iq4xs-direct.gguf",
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "trace_*": "allow",
    "turbovec_*": "allow",
    "engram_*": "allow",
    "langextract_*": "allow"
  },
  "mcp": {
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 60000,
      "headers": {
        "Accept": "application/json, text/event-stream"
      }
    },
    "turbovec": {
      "type": "remote",
      "url": "http://127.0.0.1:8791/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "engram-embed": {
      "type": "local",
      "command": [
        "node",
        "./sveltekit-frontend/scripts/mcp/engram-embed-mcp.mjs",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 60000,
      "env": {
        "ENGRAM_ONLY": "true",
        "REDIS_ENABLED": "false"
      }
    },
    "gemma4-offload": {
      "type": "local",
      "command": [
        "node",
        "./sveltekit-frontend/scripts/mcp/gemma4-offload-mcp.mjs"
      ],
      "enabled": true,
      "timeout": 30000,
      "env": {
        "ENGRAM_ONLY": "true"
      }
    }
  },
  "instructions": [
    ".opencode/system.md",
    "AGENTS.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".svelte-kit/**",
      "memory/**",
      "tmp/**",
      ".opencode/cards/**",
      ".opencode/cache/**",
      ".opencode/ndjson/**",
      ".opencode/embeddings/**",
      ".opencode/ace-packet.json",
      ".opencode/ace-packet-*.json",
      ".opencode/ace-packets/**",
      ".opencode/ace-packets_stale/**",
      ".opencode/ace-context.json",
      ".opencode/feature-files.json",
      ".opencode/startup-context.json",
      ".opencode/ace-seed-*.json",
      ".opencode/patchcard-*.json",
      ".opencode/ingest/**",
      ".opencode/summaries/**",
      ".opencode/jobs/**",
      ".opencode/tasks/**",
      ".opencode/commits/**",
      ".opencode/fixes/**",
      ".opencode/quarantine/**",
      ".opencode/recommendations/**",
      ".opencode/context/**",
      ".opencode/agents/**",
      ".opencode/kanban/**",
      ".opencode/feature-map/**",
      ".opencode/memory/**",
      ".opencode/tools/**",
      ".opencode/node_modules/**",
      "sveltekit-frontend/node_modules/**",
      "sveltekit-frontend/.svelte-kit/**",
      "sveltekit-frontend/static/ort/**",
      "sveltekit-frontend/static/gemma3_270m_onnx/**",
      "sveltekit-frontend/static/embeddinggemma_300m_onnx/**",
      "simd-bridge/cpp/build/**",
      "granite-docling-258M/**",
      "turbovec/**",
      "models/**"
    ]
  }
}