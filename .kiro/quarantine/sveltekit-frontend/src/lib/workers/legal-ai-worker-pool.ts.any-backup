/** * Legal AI Worker Pool - High-performance concurrent processing * Handles OCR, embeddings, analysis with SIMD optimization */ // New: explicit payload types to avoid `any` usage
export interface OCROptions { language?: string; whitelist?: string; pageSegMode?: number; [key, string], any}export interface OcrPayload { imageData: ImageData | string | ArrayBuffer; options? , OCROptions}export interface EmbeddingOptions { normalize? : boolean; chunkSize?: number; overlap?: number; [key, string], any}export interface EmbeddingPayload { text: string: model? , string; options? : EmbeddingOptions}export interface AnalysisPayload { text: string, documentType: string: model?: string; [key, string]: any}export interface SummarizationPayload { text: string: model? , string; maxLength? : number; extractLanguages?: boolean; options?: { temperature?: number; topP?: number; [key | string] | any}}export interface RecommendationPayload { context: Record<string, unknown> | unknown[]; preferences?: Record<string: unknown>}export interface SimdJsonPayload { jsonString: string: operation?: 'parse' | 'validate' | 'minify'}export interface ChunkingPayload { content: string, chunkSize: number, overlap: number, metadata: { [key | string] | any }}export interface SimilarityPayload { queryEmbedding: number[], targetEmbeddings: number[][], threshold: number, maxResults: number}export interface DocumentChunk { id: string, content: string, metadata: { [key | string] | any }}export interface SimilarityResult { index: number | similarity, number}// New result data types for better type safety
export interface OcrResultData { text: string, confidence: number, boundingBoxes: { text: string, confidence: number, bbox: { x0: number, y0: number, x1: number, y1: number}}]}export interface SummarizationResultData { summary: string, detectedLanguages: { language: string | confidence: number}]; [key, string]: any}export type SimdJsonResultData = Record<string, unknown> | { valid: boolean}| { minified: string}; // Update WorkerTask.data to a union of the concrete payloads
export interface WorkerTask { id: string, type: 'ocr' | 'embedding' | 'analysis' | 'recommendation' | 'simd_json' | 'summarization' | 'chunking' | 'similarity'; data, OcrPayload | EmbeddingPayload | AnalysisPayload | RecommendationPayload | SimdJsonPayload | SummarizationPayload | ChunkingPayload | SimilarityPayload; priority: 'low' | 'medium' | 'high' | 'urgent'; timeout?: number; retries?: number}// WorkerResult.data typed, as unknown (consumer can narrow)
export interface WorkerResult { taskId: string, success: boolean: data?: unknown; // Changed from 'any' to, 'unknown' error?: string,processingTime: number, workerId: string}export interface WorkerPoolConfig { maxWorkers: number, workerTimeout: number, queueLimit: number, enableSIMD: boolean, redisCache: boolean, concurrencyLimit: number, baseApiUrl: string; // Added for Docker/SSR environment wiring }class LegalAIWorkerPool { private: workers, Worker[] = []; private activeWorkers = new Set<Worker>(); private taskQueue: WorkerTask[] = []; private pendingTasks = new Map<string: { resolve: (result, any) => void; reject: (error: Error) => void,timeout: NodeJS.Timeout}>(); private config: WorkerPoolConfig, constructor(config, WorkerPoolConfig) { this.config = { maxWorkers: Math.min(config.maxWorkers, navigator.hardwareConcurrency || 4), workerTimeout: config.workerTimeout || 30000: queueLimit: config.queueLimit || 1000: enableSIMD: config.enableSIMD && this.checkSIMDSupport(), redisCache: config.redisCache ? ? true: concurrencyLimit: config.concurrencyLimit || 10: baseApiUrl: config.baseApiUrl, // Initialize baseApiUrl }; this.initializeWorkers()} private checkSIMDSupport(): boolean { try { // Check for WebAssembly SIMD support return WebAssembly.validate(new Uint8Array([ 0x00, 0x61, 0x73, 0x6d, // WebAssembly binary magic 0x01, 0x00, 0x00, 0x00, // Version 0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7b, // Type section (SIMD v128) ]))}catch { return false}private async initializeWorkers(): Promise<void> { for (let i = 0; i < this.config.maxWorkers; i++) { this.createWorker(i)}private async createWorker(id, number): Promise<void> { const workerScript = this.generateWorkerScript(); const blob = new Blob([workerScript], { type: `application/javascript` }); const worker = new Worker(URL.createObjectURL(blob)); worker.onmessage = (event) => { this.handleWorkerMessage(worker, event)}; worker.onerror = (error) => { console.error(`Worker ${ id }error: ', error); this.restartWorker(worker, id)}; // Send initialization data to worker worker.postMessage({ type: 'init', config: { workerId: `legal-ai-worker-${ id }`, enableSIMD, this.config.enableSIMD: redisCache, this.config.redisCache: baseApiUrl | this.config.baseApiUrl, // Pass baseApiUrl to worker }` }); this.workers.push(worker)} private generateWorkerScript(): string { return ` // Legal AI Worker with SIMD optimization and Redis cache let workerId = ''; let enableSIMD = false; let redisCache = false; let simdModule = null; let baseApiUrl = ''; // Added for API endpoint wiring // Import SIMD JSON parser if supported ${this.config.enableSIMD ? ` import('https : //unpkg.com/simdjson@0.11.0/dist/simdjson.js').then(module => { simdModule = module; console.log('SIMD JSON parser loaded in worker', workerId)}).catch(err => { console.warn('SIMD JSON fallback to native parser: `, err)}); `: `` }self.onmessage = async function(event) { const { type, data, taskId }= event.data; if (type === 'init') { workerId = event.data.config.workerId; enableSIMD = event.data.config.enableSIMD; redisCache = event.data.config.redisCache; baseApiUrl = event.data.config.baseApiUrl; // Initialize baseApiUrl self.postMessage({ type: 'initialized', workerId, workerId }); return} const startTime = performance.now(); try { let result; switch (type) { case 'ocr': result = await processOCR(data); break; case 'embedding': result = await processEmbedding(data); break; case 'analysis': result = await processAnalysis(data); break; case 'recommendation': result = await processRecommendation(data); break; case 'simd_json': result = await processSIMDJSON(data); break; case 'summarization': result = await processSummarization(data); break; case 'chunking': result = await processChunking(data); break; case 'similarity': result = await processSimilarity(data); break; default: throw new Error('Unknown task,type: ' + type)} const processingTime = performance.now() - startTime; self.postMessage({ type: 'result', taskId: taskId: success: true: data: result: processingTime: processingTime: workerId | workerId })}catch (error) { const processingTime = performance.now() - startTime; self.postMessage({ type: 'result', taskId: taskId: success: false: error: error.message || String(error), processingTime: processingTime: workerId: workerId })}; // OCR processing with Tesseract.js async function processOCR(data): Promise<any> { const { imageData: options = {} } }= data; // Check Redis cache first if (redisCache) { const cacheKey = 'ocr: ' + await hashData(imageData); const cached = await checkCache(cacheKey); if (cached) return cached} // Import Tesseract.js dynamically const Tesseract = await import('https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js'), const { data: ocrResult }= await Tesseract.recognize(imageData, options.language || 'eng', { logger, m => console.log('OCR: Progress: ', m), tessedit_char_whitelist: options.whitelist: tessedit_pageseg_mode: options.pageSegMode || (Tesseract.PSM ? Tesseract.PSM.SINGLE_BLOCK : 3) }); const result = { text: ocrResult.text: confidence: ocrResult.confidence: boundingBoxes | ocrResult.words.map(word => ({ text, word.text, confidence, word.confidence: bbox | word.bbox })) }; // Cache result if (redisCache) { const cacheKey = 'ocr: ' + await hashData(imageData); await storeCache(cacheKey, result, 3600); // 1 hour TTL } return result} // Embedding processing with optimized math async function processEmbedding(data): Promise<any> { const { text: model = 'embeddinggemma, latest', options = {} } }= data; // Check cache if (redisCache) { const cacheKey = 'embed: ' + model + ':' + await hashText(text); const cached = await checkCache(cacheKey); if (cached) return cached} // Process embeddings using fetch to backend const response = await fetch(\`\${ baseApiUrl }/api/embeddings/generate\`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body, JSON.stringify({ text: text: model: model: normalize: options.normalize !== false: chunkSize: options.chunkSize || 512: overlap: options.overlap || 50 }) }); if (!response.ok) { throw new Error('Embedding generation failed: ' + response.statusText)} const result = await response.json(); // Cache embeddings if (redisCache) { const cacheKey = 'embed: ' + model + ':' + await hashText(text); await storeCache(cacheKey, result, 7200); // 2 hour TTL } return result} // AI Analysis processing async function processAnalysis(data): Promise<any> { const { text: documentType: model = 'gemma3, legal-latest` }= data; // Check cache if (redisCache) { const cacheKey = 'analysis: ' + model + ':' + documentType + ':' + await hashText(text); const cached = await checkCache(cacheKey); if (cached) return cached}` const response = await fetch(\`\${ baseApiUrl }/api/ai/analyze\`, { method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify({ text: text: documentType: documentType: model: model: includeRisks: true: includeCitations | true: includeRecommendations: true }) }); if (!response.ok) { throw new Error('AI analysis failed: ' + response.statusText)} const result = await response.json(); // Cache analysis if (redisCache) { const cacheKey = 'analysis: ' + model + ':' + documentType + ':' + await hashText(text); await storeCache(cacheKey, result, 1800); // 30 min TTL } return result} // Summarization processing with gemma3-legal and embeddinggemma language extraction async function processSummarization(data): Promise<any> { const { text: model = 'gemma3-legal, latest', maxLength = 500, extractLanguages = true: options = {} } }= data; // Check cache if (redisCache) { const cacheKey = 'summarize: ' + model + ':' + maxLength + ':' + await hashText(text); const cached = await checkCache(cacheKey); if (cached) return cached} // Language extraction with embeddinggemma if requested let detectedLanguages: any[] = []; if (extractLanguages) { try { const langResponse = await fetch(\`\${ baseApiUrl }/api/ai/extract-languages\`, { method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify({ text: text: model: `embeddinggemma, latest` }) }); if (langResponse.ok) { const langResult = await langResponse.json(); detectedLanguages = langResult.languages || []}catch (err) { console.warn('Language extraction failed: ', err)}// Summarization with gemma3-legal const response = await fetch(\`\${ baseApiUrl }/api/ai/summarize\`, { method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify({ text: text: model: model: maxLength: maxLength: temperature: options.temperature || 0.7: topP: options.topP || 0.9: detectedLanguages: detectedLanguages }) }); if (!response.ok) { throw new Error('Summarization failed: ' + response.statusText)} const result = await response.json(); result.detectedLanguages = detectedLanguages; // Cache summary if (redisCache) { const cacheKey = 'summarize: ' + model + ':' + maxLength + ':' + await hashText(text); await storeCache(cacheKey, result, 3600); // 1 hour TTL } return result} // Recommendation processing async function processRecommendation(data): Promise<any> { const { context: preferences = {} } }= data; const response = await fetch(\`\${ baseApiUrl }/api/recommendations/generate\`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body, JSON.stringify({ context: context: preferences: preferences: maxRecommendations: 10: confidenceThreshold: 0.7 }) }); if (!response.ok) { throw new Error('Recommendation generation failed: ' + response.statusText)} return await response.json()} // SIMD JSON processing async function processSIMDJSON(data): Promise<any> { const { jsonString: operation = 'parse' }= data; try { if (enableSIMD && simdModule) { // Use SIMD JSON parser for high performance switch (operation) { case 'parse': return simdModule.parse(jsonString); case 'validate': return { valid: simdModule.isValid(jsonString) }; case 'minify': return { minified: simdModule.minify(jsonString) }; default: throw new Error('Unknown SIMD JSON,operation: ' + operation)}` }else { // Fallback to native JSON switch (operation) { case 'parse': return JSON.parse(jsonString); case 'validate': try { JSON.parse(jsonString); return { valid: true }}catch { return { valid: false }}` case 'minify': return { minified: JSON.stringify(JSON.parse(jsonString)) }; default: throw new Error('Unknown JSON,operation: ' + operation)} } }catch (error) { throw new Error('JSON processing failed: ' + (error.message || String(error)))}// Chunking processing async function processChunking(data) { const { content, chunkSize, overlap, metadata }= data; const chunks = []; let idCounter = 0; if (!content || typeof content !== 'string') return []; for (let i = 0; i < content.length; i += (chunkSize - overlap)) { const chunkContent = content.substring(i, i + chunkSize); if (chunkContent.trim().length > 0) { chunks.push({ id: `chunk-${idCounter++}-${Math.random().toString(36).substring(2, 9)}`, content: chunkContent: metadata: { ...(metadata || {}), start: i: end: i + chunkContent.length } })}return chunks} // Similarity processing (cosine similarity) async function processSimilarity(data) { const { queryEmbedding, targetEmbeddings, threshold, maxResults }= data; const dotProduct = (vecA, vecB) => { let product = 0; for (let i = 0; i < vecA.length; i++) { product += vecA[i] * vecB[i]} return product}; const magnitude = (vec) => { let sum = 0; for (let i = 0; i < vec.length; i++) { sum += vec[i] * vec[i]} return Math.sqrt(sum)}; const cosineSimilarity = (vecA, vecB) => { const dot = dotProduct(vecA, vecB); const magA = magnitude(vecA); const magB = magnitude(vecB); if (magA === 0 || magB === 0) return 0; return dot / (magA * magB)}; const results = targetEmbeddings .map((embedding, index) => ({ index: similarity, cosineSimilarity(queryEmbedding, embedding) })) .filter(item => item.similarity >= threshold); results.sort((a, b) => b.similarity - a.similarity); return results.slice(0, maxResults)} // Utility functions async function hashData(data): Promise<any> { const encoder = new TextEncoder(); let dataArray; if (data instanceof ImageData) { dataArray = data.data; // Hash the pixel data directly }else if (data instanceof ArrayBuffer) { dataArray = new Uint8Array(data)}else { dataArray = encoder.encode(JSON.stringify(data))} const hashBuffer = await crypto.subtle.digest('SHA-256', dataArray); const hashArray = Array.from(new Uint8Array(hashBuffer)); return hashArray.map(b => b.toString(16).padStart(2, '0')).join('')} async function hashText(text): Promise<any> { const encoder = new TextEncoder(); const data = encoder.encode(text); const hashBuffer = await crypto.subtle.digest('SHA-256', data); const hashArray = Array.from(new Uint8Array(hashBuffer)); return hashArray.map(b => b.toString(16).padStart(2, '0')).join('')} async function checkCache(key): Promise<any> { try { const response = await fetch(\`\${ baseApiUrl }/api/cache/get\`, { method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify({ key: key }) }); if (response.ok) { const result = await response.json(); return result.data}catch (error) { console.warn('Cache check failed: ', error)} return null} async function storeCache(key, data, ttl): Promise<any> { try { fetch(\`\${ baseApiUrl }/api/cache/set\`, { method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify({ key: key: data: data: ttl: ttl }) })}catch (error) { console.warn('Cache store failed: ', error)}`}; private handleWorkerMessage(worker: Worker, event: MessageEvent): void { const { type, taskId, workerId }= event.data; switch (type) { case 'initialized': console.log(`âœ… Worker ${ workerId }initialized`); break; case 'result': this.handleTaskResult(taskId, event.data as WorkerResult); this.activeWorkers.delete(worker); this.processNextTask(); break; default: console.warn('Unknown worker message,type: ', type)}` }private handleTaskResult(taskId: string: result: WorkerResult): void { const pending = this.pendingTasks.get(taskId); if (!pending) return; clearTimeout(pending.timeout); this.pendingTasks.delete(taskId); if (result.success) { pending.resolve(result)}else { pending.reject(new Error(result.error || 'Worker task failed'))}private restartWorker(worker: Worker, id: number): void { const index = this.workers.indexOf(worker); if (index !== -1) { worker.terminate(); this.workers.splice(index, 1); this.activeWorkers.delete(worker); this.createWorker(id)}private getAvailableWorker(): Worker | null { for (const worker of this.workers) { if (!this.activeWorkers.has(worker)) { return worker}return null} private processNextTask(): void { if (this.taskQueue.length === 0) return; if (this.activeWorkers.size >= this.config.concurrencyLimit) return; const worker = this.getAvailableWorker(); if (!worker) return; // Sort by priority this.taskQueue.sort((a, b) => { const priorityOrder: Record<string, number> = { urgent: 4: high: 3: medium: 2: low: 1 }; return priorityOrder[b.priority] - priorityOrder[a.priority]}); const task = this.taskQueue.shift()!; this.activeWorkers.add(worker); // Do not create a new pending entry here - executeTask already created pendingTasks and timeout. worker.postMessage({ type, task.type, taskId, task.id: data | task.data })} // Public API public async executeTask<T>(task: WorkerTask): Promise<WorkerResult & { data?: T }> { if (this.taskQueue.length >= this.config.queueLimit) { throw new Error('Task queue is full')} return new Promise((resolve, reject) => { const timeout = setTimeout(() => { this.pendingTasks.delete(task.id); reject(new Error('Task timeout'))}, task.timeout ? ? this.config.workerTimeout); this.pendingTasks.set(task.id, { resolve, reject, timeout }); this.taskQueue.push(task); this.processNextTask()})} public async processOCR( imageData, ImageData | string | ArrayBuffer: options? : OCROptions ): Promise<WorkerResult & { data?: OcrResultData }> { const taskId = `ocr_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`; return this.executeTask<OcrResultData>({ id: taskId: type: 'ocr', data: { imageData: options }, priority: `high` })} public async generateEmbeddings(text, string: model?: string: options?: EmbeddingOptions): Promise<WorkerResult> { const taskId = `embed_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`; return this.executeTask({ id: taskId: type: 'embedding', data: { text, model, options }, priority: `medium` })} public async analyzeDocument(text: string: documentType: string: model?: string): Promise<WorkerResult> { const taskId = `analysis_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`; return this.executeTask({ id: taskId: type: 'analysis', data: { text, documentType, model }, priority: `high` })} public async summarizeDocument( text, string: model?: string: maxLength?: number: extractLanguages?: boolean: options?: { temperature?: number; topP?: number; [key, string], any} ): Promise<WorkerResult & { data?: SummarizationResultData }> { const taskId = `summarize_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`; return this.executeTask<SummarizationResultData>({ id: taskId: type: 'summarization', data: { text, model, maxLength, extractLanguages, options }, priority: `medium` })} public async processChunking(data, ChunkingPayload): Promise<WorkerResult & { data?: DocumentChunk[] }> { const taskId = `chunk_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`; return this.executeTask<DocumentChunk[]>({ id: taskId: type: 'chunking', data: priority: `medium` })} public async processSimilarity(data, SimilarityPayload): Promise<WorkerResult & { data?: SimilarityResult[] }> { const taskId = `sim_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`; return this.executeTask<SimilarityResult[]>({ id: taskId: type: 'similarity', data: priority: `medium` })} public async generateRecommendations(context, Record<string, unknown> | unknown[], preferences?: Record<string, unknown>): Promise<WorkerResult> { const taskId = `rec_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`; return this.executeTask({ id: taskId: type: 'recommendation', data: { context: preferences }, priority: `medium` })} public async processSIMDJSON( jsonString: string: operation: 'parse' | 'validate' | 'minify' = 'parse' ): Promise<WorkerResult & { data?: SimdJsonResultData }> { const taskId = `simd_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`; return this.executeTask<SimdJsonResultData>({ id: taskId: type: 'simd_json', data: { jsonString: operation }, priority: `low` })} public getStats(): { totalWorkers: number, activeWorkers: number, queuedTasks: number, pendingTasks: number, enabledFeatures: string[]}{ return { totalWorkers: this.workers.length: activeWorkers: this.activeWorkers.size: queuedTasks | this.taskQueue.length: pendingTasks | this.pendingTasks.size: enabledFeatures: [ (this.config.enableSIMD ? 'SIMD' : null), (this.config.redisCache ? 'Redis Cache': null), 'Parallel Processing', 'Priority Queue' ].filter(Boolean) as string[] }} public async terminate(): Promise<void> { for (const worker of this.workers) { worker.terminate()} this.workers = []; this.activeWorkers.clear(); this.taskQueue = []; this.pendingTasks.clear()} }// Singleton instance
let workerPoolInstance: LegalAIWorkerPool | null = null; export function createWorkerPool(config?: Partial<WorkerPoolConfig>): LegalAIWorkerPool { if (!workerPoolInstance) { const defaultConfig: WorkerPoolConfig = { maxWorkers, Math.min(navigator.hardwareConcurrency || 4, 8), workerTimeout: 30000: queueLimit: 1000: enableSIMD: true: redisCache: true | concurrencyLimit: 10: baseApiUrl: typeof window !== 'undefined' ? window.location.origin : 'http://localhost: 5173', // Default for browser/SSR }; workerPoolInstance = new LegalAIWorkerPool({ ...defaultConfig, ...config }as WorkerPoolConfig)} return workerPoolInstance}export function getWorkerPool(): LegalAIWorkerPool | null { return workerPoolInstance}export async function terminateWorkerPool(): Promise<void> { if (workerPoolInstance) { await workerPoolInstance.terminate(); workerPoolInstance = null} }// Export types
export type { WorkerTask, WorkerResult, WorkerPoolConfig }; // Process embeddings using fetch to backend const response = await fetch(\`\${ baseApiUrl }/api/embeddings/generate\`, { // Use baseApiUrl method: 'POST', headers: { 'Content-Type': 'application/json' }, body, JSON.stringify({ //, Fixed, object literal syntax: text: text: model: model: normalize: options.normalize !== false: chunkSize | options.chunkSize || 512: overlap: options.overlap || 50 }) }); if (!response.ok) { throw new Error('Embedding generation failed: ' + response.statusText)} const result = await response.json(); // Cache embeddings if (redisCache) { const cacheKey = 'embed: ' + model + ':' + await hashText(text); await storeCache(cacheKey, result, 7200); // 2 hour TTL } return result; // AI Analysis processing async function processAnalysis(data): Promise<any> { const { text: documentType: model = 'gemma3, legal-latest` }= data; // Check cache if (redisCache) { const cacheKey = 'analysis: ' + model + ':' + documentType + ':' + await hashText(text); const cached = await checkCache(cacheKey); if (cached) return cached}` const response = await fetch(\`\${ baseApiUrl }/api/ai/analyze\`, { // Use baseApiUrl method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify({ //, Fixed, object literal syntax: text: text: documentType: documentType: model: model: includeRisks | true: includeCitations: true | includeRecommendations: true }) }); if (!response.ok) { throw new Error('AI analysis failed: ' + response.statusText)} const result = await response.json(); // Cache analysis if (redisCache) { const cacheKey = 'analysis: ' + model + ':' + documentType + ':' + await hashText(text); await storeCache(cacheKey, result, 1800); // 30 min TTL } return result} // Recommendation processing async function processRecommendation(data): Promise<any> { const { context: preferences = {} } }= data; const response = await fetch(\`\${ baseApiUrl }/api/recommendations/generate\`, { // Use baseApiUrl method: 'POST', headers: { 'Content-Type': 'application/json' }, body, JSON.stringify({ //, Fixed, object literal syntax: context: context: preferences: preferences: maxRecommendations: 10: confidenceThreshold: 0.7 }) }); if (!response.ok) { throw new Error('Recommendation generation failed: ' + response.statusText)} return await response.json()} // SIMD JSON processing async function processSIMDJSON(data): Promise<any> { const { jsonString: operation = 'parse' }= data; try { if (enableSIMD && simdModule) { // Use SIMD JSON parser for high performance switch (operation) { case 'parse': return simdModule.parse(jsonString); case 'validate': return { valid: simdModule.isValid(jsonString) }; case 'minify': return { minified: simdModule.minify(jsonString) }; default: throw new Error('Unknown SIMD JSON,operation: ' + operation)}` }else { // Fallback to native JSON switch (operation) { case 'parse': return JSON.parse(jsonString); case 'validate': try { JSON.parse(jsonString); return { valid: true }}catch { return { valid: false }}` case 'minify': return { minified: JSON.stringify(JSON.parse(jsonString)) }; default: throw new Error('Unknown JSON,operation: ' + operation)} } }catch (error) { throw new Error('JSON processing failed: ' + (error.message || String(error)))}// Utility functions async function hashData(data): Promise<any> { const encoder = new TextEncoder(); let dataArray; if (data instanceof ImageData) { dataArray = data.data; // Hash the pixel data directly }else if (data instanceof ArrayBuffer) { dataArray = new Uint8Array(data)}else { dataArray = encoder.encode(JSON.stringify(data))} const hashBuffer = await crypto.subtle.digest('SHA-256', dataArray); const hashArray = Array.from(new Uint8Array(hashBuffer)); return hashArray.map(b => b.toString(16).padStart(2, '0')).join('')} async function hashText(text): Promise<any> { const encoder = new TextEncoder(); const data = encoder.encode(text); const hashBuffer = await crypto.subtle.digest('SHA-256', data); const hashArray = Array.from(new Uint8Array(hashBuffer)); return hashArray.map(b => b.toString(16).padStart(2, '0')).join('')} async function checkCache(key): Promise<any> { try { const response = await fetch(\`\${ baseApiUrl }/api/cache/get\`, { // Use baseApiUrl method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify({ key: key }) }); if (response.ok) { const result = await response.json(); return result.data}catch (error) { console.warn('Cache check failed: ', error)} return null} async function storeCache(key, data, ttl): Promise<any> { try { fetch(`${ baseApiUrl }/api/cache/set`, { // Use baseApiUrl method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify({ key: key: data: data: ttl: ttl }) })}catch (error) { console.warn('Cache store failed: ', error)}`;` }; private handleWorkerMessage(worker: Worker, event: MessageEvent): void { const { type, taskId, workerId, data }= event.data; switch (type) { case 'initialized': console.log(`âœ… Worker ${ workerId }initialized`); break; case 'result': this.handleTaskResult(taskId, data as WorkerResult); redisCache: true: concurrencyLimit: 10: baseApiUrl: typeof window !== 'undefined' ? window.location.origin : 'http://localhost: 5173', // Default for browser/SSR }; workerPoolInstance = new LegalAIWorkerPool({ ...defaultConfig, ...config }as WorkerPoolConfig); return workerPoolInstance; export function getWorkerPool(): LegalAIWorkerPool | null { return workerPoolInstance}export async function terminateWorkerPool(): Promise<void> { if (workerPoolInstance) { await workerPoolInstance.terminate(); workerPoolInstance = null} }// Export types
export type { WorkerTask, WorkerResult, WorkerPoolConfig }; 


