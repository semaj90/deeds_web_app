{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "@playwright/mcp@0.0.78", "--browser", "chromium"],
      "env": {
        "PLAYWRIGHT_BASE_URL": "http://localhost:5173"
      }
    },
    "trace": {
      "type": "http",
      "url": "http://127.0.0.1:8788/mcp"
    },
    "atlas-task-kernel": {
      "command": "node",
      "args": ["./sveltekit-frontend/scripts/mcp/atlas-task-kernel-mcp.mjs"]
    },
    "atlas-tools": {
      "command": "node",
      "args": ["./sveltekit-frontend/scripts/mcp/atlas-tools-mcp.mjs"],
      "env": {
        "ATLAS_TOOLS_MOCK": "0"
      }
    },
    "socraticode": {
      "command": "node",
      "args": ["C:/Users/james/AppData/Local/npm-cache/_npx/39052607b6e520af/node_modules/socraticode/dist/index.js", "mcp"],
      "env": {
        "QDRANT_MODE": "external",
        "QDRANT_URL": "http://localhost:6333",
        "OLLAMA_MODE": "external",
        "OLLAMA_HOST": "http://localhost:11434",
        "EMBEDDING_MODEL": "embeddinggemma:latest",
        "EMBEDDING_DIMENSIONS": "768",
        "QDRANT_COLLECTION_PREFIX": "sc_deeds",
        "SOCRATICODE_PROJECT_ID": "deeds-web-app"
      }
    }
  }
}
