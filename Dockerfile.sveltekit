# Multi-stage build for SvelteKit 2 with native C++/Rust NAPI bindings
FROM node:22-slim AS base

# Install dependencies for building native C++/Rust modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    gcc \
    libc6-dev \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Copy package configuration
COPY sveltekit-frontend/package*.json ./sveltekit-frontend/
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Install pnpm
RUN npm install -g pnpm

# Copy native bridge source code first (needed to compile the addon)
COPY simd-bridge ./simd-bridge

# Build the Rust native addon from source inside the container
RUN cd simd-bridge/rust-simdjson && \
    cargo build --release && \
    cp target/release/libsimd_bridge_rs.so target/release/simd_bridge_rs.node || \
    cp target/release/simd_bridge_rs.dll target/release/simd_bridge_rs.node || \
    cp target/release/libsimd_bridge_rs.dylib target/release/simd_bridge_rs.node || true

# Install dependencies for SvelteKit
WORKDIR /app/sveltekit-frontend
RUN pnpm install --frozen-lockfile

# Copy SvelteKit frontend source
COPY sveltekit-frontend/ .

# Build for development
FROM base AS development
WORKDIR /app/sveltekit-frontend
RUN pnpm install --dev
EXPOSE 5173 5174
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]

# Build SvelteKit for production
FROM base AS build
WORKDIR /app/sveltekit-frontend
RUN pnpm run build

# Production runner image (glibc-based node:22-slim)
FROM node:22-slim AS production

WORKDIR /app

# Install runtime dependencies if any (production only)
COPY sveltekit-frontend/package*.json ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile --prod

# Copy built frontend assets
COPY --from=build /app/sveltekit-frontend/build ./build
COPY --from=build /app/sveltekit-frontend/static ./static
COPY --from=build /app/sveltekit-frontend/package.json ./package.json

# Copy compiled native binaries
COPY --from=build /app/simd-bridge /app/simd-bridge

# Create non-root user for security
RUN groupadd -r sveltekit && useradd -r -g sveltekit -u 1001 sveltekit
RUN chown -R sveltekit:sveltekit /app
USER sveltekit

EXPOSE 3000

ENV NODE_ENV=production

# Start SvelteKit production server
CMD ["node", "build"]