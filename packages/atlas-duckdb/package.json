{
  "name": "@atlas/duckdb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DuckDB multicore analytical sidecar for atlas ML pipelines",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots.d.ts",
      "default": "./dist/snapshots.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./exports": {
      "types": "./dist/exports.d.ts",
      "default": "./dist/exports.js"
    },
    "./vector-snapshots": {
      "types": "./dist/vector-snapshots.d.ts",
      "default": "./dist/vector-snapshots.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "duckdb": "^1.4.4"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
