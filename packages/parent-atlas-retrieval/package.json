{
  "name": "@deeds/parent-atlas-retrieval",
  "version": "0.1.0",
  "description": "Parent Atlas standalone retrieval support: Bifrost contracts, CrossEncoder refinement, GPU/SIMD bridges",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bifrost": {
      "types": "./dist/bifrost/index.d.ts",
      "default": "./dist/bifrost/index.js"
    },
    "./crossencoder": {
      "types": "./dist/crossencoder/index.d.ts",
      "default": "./dist/crossencoder/index.js"
    },
    "./gpu": {
      "types": "./dist/gpu/index.d.ts",
      "default": "./dist/gpu/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:boundary": "node ../../scripts/atlas/audit-parent-atlas-retrieval-package-boundary-v1.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.47",
    "@deeds/parent-atlas-core": "file:../parent-atlas-core",
    "ioredis": "^5.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
  }
}
