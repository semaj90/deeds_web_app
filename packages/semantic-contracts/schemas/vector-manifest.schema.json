{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.deeds.legal/schemas/vector-manifest/1.0.0",
  "title": "Vector Manifest v1.0.0",
  "description": "Declares a vector's identity: name, dimensions, model, normalization, hashing. Every vector must declare its manifest.",
  "type": "object",
  "required": [
    "vectorName",
    "model",
    "dimensions",
    "representation",
    "distance",
    "normalized"
  ],
  "properties": {
    "vectorName": {
      "type": "string",
      "enum": [
        "semantic_768",
        "semantic_mrl_512",
        "semantic_mrl_256",
        "semantic_mrl_128",
        "dense_384",
        "dense_768_legacy",
        "title_384",
        "summary_384",
        "symbol_384",
        "ontology_384",
        "latent_256",
        "latent_128",
        "latent_64",
        "topology_ae64_v1",
        "late_interaction",
        "bm42_sparse"
      ],
      "description": "Canonical vector identity across all stores"
    },
    "model": {
      "type": "string",
      "description": "Model used to produce this vector (e.g., 'embeddinggemma:latest')"
    },
    "upstreamModelId": {
      "type": "string",
      "description": "Upstream model identity corresponding to the runtime tag"
    },
    "maxInputTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "Maximum admitted input tokens for the model contract"
    },
    "slidingWindow": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "Model attention sliding-window setting; not the maximum input length"
    },
    "modelRevision": {
      "type": "string",
      "description": "Model version/revision for reproducibility"
    },
    "checkpointRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Immutable learned-model checkpoint identity shared by derived outputs"
    },
    "dimensions": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "Vector dimensionality (semantic_768 canonical; native MRL 512/256/128 reference lanes; 384 legacy)"
    },
    "representation": {
      "type": "string",
      "enum": ["dense", "sparse", "multivector"],
      "description": "Storage representation type"
    },
    "distance": {
      "type": "string",
      "enum": ["Cosine", "Dot", "Euclid", "Manhattan"],
      "description": "Distance metric for similarity search"
    },
    "normalized": {
      "type": "boolean",
      "description": "Whether vector is L2-normalized (required for Cosine distance)"
    },
    "qdrantCollection": {
      "type": "string",
      "description": "Separate Qdrant collection when the representation is not a named slot in the primary collection"
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "PHYSICAL" },
            "postgresColumn": { "type": "string" },
            "qdrantCollection": { "type": "string" },
            "qdrantVectorSlot": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "derivedFrom", "derivation"],
          "properties": {
            "kind": { "const": "DERIVED" },
            "derivedFrom": { "type": "string" },
            "derivation": { "enum": ["MRL_PREFIX_L2_RENORMALIZE", "NESTED_PREFIX_L2_RENORMALIZE"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 of source content at embedding time"
    },
    "workspaceRevision": {
      "type": "string",
      "description": "Workspace/corpus revision at embedding time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when vector was created"
    }
  },
  "additionalProperties": false
}
