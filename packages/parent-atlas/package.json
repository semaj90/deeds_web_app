{
  "name": "@deeds/parent-atlas",
  "version": "0.1.0",
  "description": "Atlas audit gates, adapters, and pipeline CLI for the deeds-web-app monorepo",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./core/contextual-tree-snapshot": "./dist/core/contextual-tree-snapshot.js",
    "./core/graph-snapshot-v2": "./dist/core/graph-snapshot-v2.js",
    "./core/structural-symbol": "./dist/core/structural-symbol.js",
    "./core/structural-extraction-fabric": "./dist/core/structural-extraction-fabric.js",
    "./core/treesitter-chunker-evidence-adapter": "./dist/core/treesitter-chunker-evidence-adapter.js",
    "./core/ast-grep-observation-adapter": "./dist/core/ast-grep-observation-adapter.js",
    "./core/langextract-grounding-adapter": "./dist/core/langextract-grounding-adapter.js",
    "./core/langextract-sidecar-metadata-adapter": "./dist/core/langextract-sidecar-metadata-adapter.js",
    "./core/symbol-registry-repository": "./dist/core/symbol-registry-repository.js",
    "./core/structural-reference-resolver": "./dist/core/structural-reference-resolver.js",
    "./core/evidence-entity-repository": "./dist/core/evidence-entity-repository.js",
    "./core/gis-canonicalization": "./dist/core/gis-canonicalization.js",
    "./core/structural-production-receipt": "./dist/core/structural-production-receipt.js",
    "./core/hypergraph-retrieval": "./dist/core/hypergraph-retrieval.js",
    "./core/hypergraph-query-policy": "./dist/core/hypergraph-query-policy.js",
    "./core/hypergraph-ppr": "./dist/core/hypergraph-ppr.js",
    "./core/adaptive-hypergraph-chain": "./dist/core/adaptive-hypergraph-chain.js",
    "./core/dynamic-hyperedge-sql": "./dist/core/dynamic-hyperedge-sql.js",
    "./core/relationship-query-repository": "./dist/core/relationship-query-repository.js",
    "./core/relationship-vector-projection": "./dist/core/relationship-vector-projection.js",
    "./core/graph-projection-parity": "./dist/core/graph-projection-parity.js",
    "./core/semantic-executor-manifest": "./dist/core/semantic-executor-manifest.js",
    "./core/executor-plans": "./dist/core/executor-plans.js",
    "./core/retrieval-action-receipt": "./dist/core/retrieval-action-receipt.js",
    "./core/evidence-entity-backfill": "./dist/core/evidence-entity-backfill.js",
    "./core/feature-intelligence-repository": "./dist/core/feature-intelligence-repository.js",
    "./core/feature-matrix": "./dist/core/feature-matrix.js",
    "./core/feature-matrix-materializer": "./dist/core/feature-matrix-materializer.js",
    "./core/model-signal-receipt": "./dist/core/model-signal-receipt.js",
    "./core/multiview-rerank": "./dist/core/multiview-rerank.js",
    "./core/qlora-dataset-export": "./dist/core/qlora-dataset-export.js",
    "./core/ace-hypergraph-payload": "./dist/core/ace-hypergraph-payload.js",
    "./core/ace-packet-v2": "./dist/core/ace-packet-v2.js",
    "./core/ace-runtime-adapter": "./dist/core/ace-runtime-adapter.js",
    "./core/hyperrag-live-integration": "./dist/core/hyperrag-live-integration.js",
    "./core/proof-gates": "./dist/core/proof-gates.js",
    "./core/hypergraph-fusion-facade": "./dist/core/hypergraph-fusion-facade.js"
  },
  "bin": {
    "atlas": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test:canonical-surface": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/canonical-surface.test.mjs",
    "test:feature-intelligence": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/feature-intelligence.test.mjs",
    "test:hypergraph-retrieval": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/hypergraph-retrieval.test.mjs",
    "test:feature-matrix": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/feature-matrix.test.mjs",
    "test:ace-hypergraph-packet": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/ace-hypergraph-packet.test.mjs",
    "test:hypergraph-ppr": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/hypergraph-ppr.test.mjs",
    "test:scaffold-contracts": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/scaffold-contracts.test.mjs",
    "test:structural-extraction": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/structural-extraction.test.mjs",
    "test:structural-vertical": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/structural-vertical.integration.test.mjs",
    "test:sidecar-provenance-compat": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/sidecar-provenance-compat.test.mjs",
    "test:python-structural-provenance": "python ../../python/test_atlas_structural_provenance.py",
    "audit:structural-provenance": "node ../../scripts/atlas/audit-structural-provenance-wiring.mjs",
    "prove:ast-sidecar": "node ../../scripts/atlas/prove-ast-sidecar.mjs",
    "test:feature-intelligence:all": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --test ./test/feature-intelligence.test.mjs ./test/hypergraph-retrieval.test.mjs ./test/feature-matrix.test.mjs ./test/ace-hypergraph-packet.test.mjs ./test/hypergraph-ppr.test.mjs ./test/scaffold-contracts.test.mjs ./test/structural-extraction.test.mjs ./test/structural-vertical.integration.test.mjs ./test/sidecar-provenance-compat.test.mjs",
    "gate:identity": "node --experimental-vm-modules dist/cli.js gate identity",
    "gate:replay": "node --experimental-vm-modules dist/cli.js gate replay --all",
    "gate:lineage": "node --experimental-vm-modules dist/cli.js gate lineage",
    "gate:final": "node --experimental-vm-modules dist/cli.js gate final",
    "ingest": "node --experimental-vm-modules dist/cli.js ingest",
    "enrich:karpathy": "node --experimental-vm-modules dist/cli.js enrich karpathy",
    "cache:hydrate": "node --experimental-vm-modules dist/cli.js cache hydrate",
    "mapreduce": "node --experimental-vm-modules dist/cli.js mapreduce",
    "library:registry-scan": "node --experimental-vm-modules dist/cli.js library registry-scan",
    "verify:boundaries": "node ../../scripts/atlas/verify-atlas-package-boundaries.mjs"
  },
  "dependencies": {
    "@deeds/atlas-core": "file:../atlas-core",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
