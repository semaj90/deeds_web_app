########################################
# Source code EXCEPTIONS
# Later rules override earlier ones in .gitignore.
# These ensure source code is never hidden by broad binary/build patterns.
########################################

# GPU TypeScript source files (override gpu-* Go binary pattern)
!sveltekit-frontend/src/**/gpu-*

# GPU demo and route pages (override gpu-* pattern for directories)
!sveltekit-frontend/src/routes/**/gpu-*/

# ONNX Runtime WASM loaders (small .mjs files, not .wasm binaries)
!sveltekit-frontend/static/ort/*.mjs

