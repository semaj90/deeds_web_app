{
  "repoName": "deeds-web-app",
  "repoRoot": ".",
  "outputs": {
    "graphDir": "docs/graph",
    "rootAtlasJson": "docs/graph/repo-root-atlas.json",
    "rootAtlasMd": "docs/graph/repo-root-atlas.md",
    "workspaceMapJson": "docs/graph/repo-workspace-map.json",
    "workspaceMapMd": "docs/graph/repo-workspace-map.md",
    "languageMapJson": "docs/graph/repo-language-map.json",
    "languageMapMd": "docs/graph/repo-language-map.md",
    "importMapJson": "docs/graph/repo-import-map.json",
    "importMapMd": "docs/graph/repo-import-map.md",
    "envMapJson": "docs/graph/repo-env-map.json",
    "envMapMd": "docs/graph/repo-env-map.md",
    "routeAtlasJson": "docs/graph/repo-sveltekit-route-atlas.json",
    "routeAtlasMd": "docs/graph/repo-sveltekit-route-atlas.md",
    "qdrantReportJson": "docs/graph/repo-qdrant-payload-atlas.json",
    "qdrantReportMd": "docs/graph/repo-qdrant-payload-atlas.md",
    "neo4jReportJson": "docs/graph/repo-neo4j-graphrag-report.json",
    "neo4jReportMd": "docs/graph/repo-neo4j-graphrag-report.md",
    "couchdbReportJson": "docs/graph/repo-couchdb-mapreduce-report.json",
    "couchdbReportMd": "docs/graph/repo-couchdb-mapreduce-report.md",
    "redisReportJson": "docs/graph/repo-redis-ace-cards.json",
    "redisReportMd": "docs/graph/repo-redis-ace-cards.md",
    "batchReportJson": "docs/graph/batch-gpu-analysis-report.json",
    "batchReportMd": "docs/graph/batch-gpu-analysis-report.md",
    "writeManifest": "docs/graph/atlas-write-manifest.json"
  },
  "sources": {
    "codebaseGraph": "sveltekit-frontend/docs/graph/codebase-graph.json",
    "routeMap": "sveltekit-frontend/docs/graph/sveltekit-route-map.json",
    "routeGapAtlas": "sveltekit-frontend/docs/graph/sveltekit-route-gap-atlas.json",
    "clusterAliases": "sveltekit-frontend/docs/graph/cluster-aliases.json",
    "hypergraphClusters": "sveltekit-frontend/docs/graph/hypergraph-clusters.json",
    "llms": "sveltekit-frontend/docs/graph/LLMS.md"
  },
  "workspaces": ["sveltekit-frontend", "simd-bridge", "vscode-extension"],
  "ignoreDirs": ["node_modules", ".git", ".svelte-kit", "dist", "build", "coverage", ".cache", "tmp", "target"],
  "scanRoots": ["scripts", "sveltekit-frontend/src", "sveltekit-frontend/scripts", "sveltekit-frontend/tests", "simd-bridge", "vscode-extension"],
  "qdrantCollections": ["codebase_chunks_768", "codebase_chunks_64d", "glyph_atlas", "task_distillates", "docs_chunks", "error_notes"],
  "redisKeys": ["wiki:note:dir:*", "couchdb:pagerank_scores", "agents:dir:*", "code:llm_output:path:*", "summary:cluster:*"] ,
  "featureFamilies": ["ace.context", "hyperrag.routing", "retrieval_graph", "db.schema", "gpu_topology"]
}
