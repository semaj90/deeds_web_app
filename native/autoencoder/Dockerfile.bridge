FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir torch==2.2.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html \
    && pip install --no-cache-dir fastapi uvicorn numpy

COPY scripts/ scripts/

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8098/health')" || exit 1

EXPOSE 8098

CMD ["uvicorn", "scripts.server:app", "--host", "0.0.0.0", "--port", "8098"]
