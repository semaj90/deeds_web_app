    "atlas:freeze:5k:dry": "npx tsx scripts/atlas/freeze-vector-snapshot-5k.mts --verbose --dry-run",
    "atlas:embedding:validate": "npx tsx scripts/atlas/test-embedding-validation.mts --verbose",
    "atlas:embedding:norms": "npx tsx scripts/atlas/audit-embedding-dimensions.mjs --verbose",
