    "atlas:duckdb:snapshot:full:verify": "npx tsx scripts/atlas/duckdb/build-full-snapshot.mts --verify",
    "atlas:duckdb:validate": "npx tsx scripts/atlas/duckdb/validate-domain-snapshot.mts",
    "atlas:duckdb:validate:full": "npx tsx scripts/atlas/duckdb/validate-domain-snapshot.mts --full",
