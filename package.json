    "atlas:pagerank:promote:verbose": "npx tsx scripts/atlas/promote-neo4j-pagerank-to-postgres.mts --apply --verbose",
    "atlas:phase0:smoke": "npm run atlas:vector-lanes:smoke && npm run atlas:redis:smoke && npm run atlas:embedding:smoke",
    "atlas:smoke:all": "npm run atlas:phase0:smoke && npm run atlas:phase3:smoke && npm run atlas:phase4:smoke",
    "atlas:phase4:ace": "npm run atlas:ace:assemble && npm run atlas:ace:gemma4 && npm run atlas:ace:leases",
    "atlas:ace:assemble": "npx tsx scripts/atlas/smoke-phase4-ace.mts",
    "atlas:ace:gemma4": "npx tsx scripts/atlas/smoke-phase4-ace.mts",
    "atlas:ace:leases": "npx tsx scripts/atlas/smoke-phase4-ace.mts",
    "atlas:phase3:smoke": "npx tsx scripts/atlas/smoke-phase3-routing.mts",
    "atlas:phase4:smoke": "npx tsx scripts/atlas/smoke-phase4-ace.mts",
    "atlas:gate1:pagerank-split": "npx tsx scripts/atlas/gate-1-pagerank-split.mts --apply",
    "atlas:gate1:pagerank-split:dry": "npx tsx scripts/atlas/gate-1-pagerank-split.mts --dry-run",
    "atlas:gate2:tag-768": "npx tsx scripts/atlas/gate-2-tag-768dim-usage.mts",
    "atlas:gate12:dry": "npx tsx scripts/atlas/gate-12-feature-extraction.mts --dry-run",
    "atlas:gate12:dry:limit": "npx tsx scripts/atlas/gate-12-feature-extraction.mts --dry-run --limit=100 --verbose",
    "atlas:gate12:apply": "npx tsx scripts/atlas/gate-12-feature-extraction.mts --apply",
    "atlas:gate12:apply:verbose": "npx tsx scripts/atlas/gate-12-feature-extraction.mts --apply --verbose",
    "atlas:gate12:smoke": "npx tsx scripts/atlas/gate-12-feature-extraction.mts --dry-run --limit=1000 --verbose",
    "atlas:gate12:verify": "npx tsx scripts/atlas/gate-12-verify.mts",
    "atlas:gates:parallel:dry": "npx tsx scripts/atlas/parallel-gates-orchestrator.mts --dry-run",
    "atlas:gates:parallel:apply": "npx tsx scripts/atlas/parallel-gates-orchestrator.mts --apply",
    "atlas:gates:parallel:monitor": "npx tsx scripts/atlas/parallel-gates-orchestrator.mts --monitor",
    "atlas:pipeline:full": "npm run atlas:gate12:apply && npm run atlas:gates:parallel:apply && npm run atlas:gate12:verify",
    "atlas:pipeline:20step": "npm run atlas:phase0:foundation && npm run atlas:phase1:indexing && npm run atlas:phase2:clustering && npm run atlas:phase3:routing && npm run atlas:phase4:ace"
  },
