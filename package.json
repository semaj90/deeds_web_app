    "atlas:duckdb:vector-snapshot:5k": "npx tsx scripts/atlas/duckdb/freeze-vector-snapshot.mts --apply",
    "atlas:duckdb:vector-snapshot:5k:verify": "npx tsx scripts/atlas/duckdb/freeze-vector-snapshot.mts --verify",
    "atlas:duckdb:index-lanes:5k": "npx tsx scripts/atlas/duckdb/build-vector-index-lanes.mts --apply --compare",
    "atlas:duckdb:index-lanes:5k:dry": "npx tsx scripts/atlas/duckdb/build-vector-index-lanes.mts --compare",
