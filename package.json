    "atlas:index:turbovec:build:dry": "npx tsx scripts/atlas/test-embedding-qdrant-turbovec.mjs",
    "atlas:index:validate": "npx tsx scripts/atlas/validate-index-quality.mts --verbose",
    "atlas:phase2:clustering": "npm run atlas:cluster:kmeans:train && npm run atlas:cluster:som:train && npm run atlas:cluster:persist && npm run atlas:cache:aggressive:prewarm",
    "atlas:cluster:kmeans:train": "npx tsx scripts/atlas/validate-som-20x20-topology.mjs --verbose",
    "atlas:cluster:som:train": "npx tsx scripts/atlas/validate-som-20x20-topology.mjs --verbose",
    "atlas:cluster:persist": "npx tsx scripts/atlas/smoke-completeness-validation.mjs --verbose",
    "atlas:cluster:persist:dry": "npx tsx scripts/atlas/validate-cluster-cards.mjs --verbose",
    "atlas:cache:aggressive:prewarm": "npx tsx scripts/atlas/daily-startup-validation.mjs --verbose",
