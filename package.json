    "atlas:retrieval:kag-expand": "npx tsx scripts/atlas/smoke-phase3-routing.mts",
    "atlas:retrieval:rerank": "npx tsx scripts/atlas/smoke-phase3-routing.mts",
    "atlas:retrieval:validate": "npx tsx scripts/atlas/validate-retrieval-gates.mts --verbose",
    "atlas:vector-lanes:smoke": "npx tsx scripts/atlas/smoke-vector-lane-registry.mts",
    "atlas:redis:smoke": "npx tsx scripts/atlas/smoke-redis-cache.mts",
    "atlas:embedding:smoke": "npx tsx scripts/atlas/smoke-embedding-contract.mts",
    "atlas:pagerank:promote:dry": "npx tsx scripts/atlas/promote-neo4j-pagerank-to-postgres.mts",
