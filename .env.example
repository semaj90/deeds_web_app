# -----------------------------------------------------------------------
# ROTORQUANT / TURBOQUANT SAFE PATH B
# -----------------------------------------------------------------------
ROTORQUANT_MODEL_PATH=C:\Users\james\Videos\deeds-web-app\vendor\models\gemma4-legal.gguf
TURBO_MODEL_PATH=C:\Users\james\Videos\deeds-web-app\vendor\models\gemma4-legal.gguf
TURBO_MMPROJ_PATH=C:\Users\james\Videos\deeds-web-app\vendor\models\mmproj-gemma4.gguf
# LEGAL_LORA_PATH must point to a GGUF LoRA adapter for llama-server --lora.
# Current vendor adapters are .safetensors and are incompatible with this runtime.
# LEGAL_LORA_PATH=C:\Users\james\Videos\deeds-web-app\vendor\models\lora\gemma4-legal-grpo\adapter_model.safetensors
LLAMA_SERVER_PATH=C:\Users\james\Desktop\llama-server-cuda\llama-server.exe
# TURBO_PROFILE options: stock (default), turboquant (V=turbo3), turboquant-safe, atomicbot, turbo3 (V=turbo3), turbo4 (V=turbo4)
# Note: turbo3/turbo4 require a patched llama-server.exe with PolarQuant/TurboQuant KV cache support.
TURBO_PROFILE=turboquant-safe
TURBO_KV_K=q8_0
TURBO_KV_V=q8_0
TURBO_CTX=65536
TURBO_PARALLEL=1
LLM_CONTEXT_SIZE=65536
OPENAI_MAX_OUTPUT_TOKENS=CHANGE_ME
OPENAI_HARD_INPUT_CAP=60000
TURBO_NGL=99
TURBOQUANT_ENABLED=true
ROTORQUANT_KV_ENABLED=false
MTP_ENABLED=false
TENSORRT_LLM_ENABLED=false
TURBOQUANT_BASE_URL=http://127.0.0.1:8090
TURBOQUANT_URL=http://127.0.0.1:8090
# DRAFT_MODEL_PATH is deprecated and ignored by scripts/launch-turboquant.ps1.
# Use ENABLE_MTP_DRAFTER=true and MTP_DRAFT_MODEL=<path> with a compatible small Gemma/Gemma4 GGUF.
# DRAFT_MODEL_PATH=C:\Users\james\.ollama\models\blobs\sha256-735af2139dc652bf01112746474883d79a52fa1c19038265d363e3d42556f7a2
DRAFT_N=5

