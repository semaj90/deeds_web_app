# Legal AI QUIC Server Dockerfile
# High-performance UDP/QUIC server with TLS for legal document processing
# Supports Go 1.25+ with GOTOOLCHAIN for version management

FROM golang:1.25-alpine AS builder

# Install build dependencies and set up Go toolchain
RUN apk add --no-cache git ca-certificates curl

# Set GOTOOLCHAIN to auto-download newer Go versions
ENV GOTOOLCHAIN=auto
ENV GOPROXY=https://proxy.golang.org,direct

# Set working directory
WORKDIR /app

# Copy Go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY quic-server.go ./

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o legal-ai-quic-server quic-server.go

# Production stage
FROM alpine:latest

# Install CA certificates for TLS
RUN apk --no-cache add ca-certificates

# Create app directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/legal-ai-quic-server /app/legal-ai-quic-server

# Expose QUIC ports (UDP) + HTTP health
EXPOSE 4433/udp 4434/udp 8095

# Environment variables
ENV QUIC_PORT=4433
ENV HTTP_PORT=8095
ENV REDIS_URL=""
ENV DATABASE_URL=""

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8095/health || exit 1

# Start the QUIC server
CMD ["/app/legal-ai-quic-server"]
