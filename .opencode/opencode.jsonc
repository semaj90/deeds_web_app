{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "model": "llama-server/ornith-1.5-9b",
  "small_model": "llama-server/ornith-1.5-9b",
  "default_agent": "ornith-atlas-kernel",
  "provider": {
    "llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (:8090)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local",
      },
      "models": {
        // Tool formatting is server-owned. Ornith 1.5's embedded tokenizer
        // template is Qwen-compatible; launch-turboquant.ps1 enables --jinja.
        "ornith-1.5-9b": {
          "name": "Ornith 1.5 9B",
          "tools": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 4096,
          },
          "options": {
            "temperature": 0.6,
            "topP": 0.95,
            "topK": 20,
            "stream": true,
            "maxTokens": 4096,
          },
        },
        "gemma4-legal-iq4xs-direct.gguf": {
          "name": "Gemma4 Legal Direct 65K",
          "tools": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096,
          },
        },
      },
    },
  },
  "mcp": {
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 60000,
    },
    "atlas-task-kernel": {
      "type": "local",
      "command": ["node", "./sveltekit-frontend/scripts/mcp/atlas-task-kernel-mcp.mjs"],
      "enabled": true,
      "timeout": 30000,
    },
    "ldr-research": {
      "type": "local",
      "command": ["node", "./sveltekit-frontend/scripts/mcp/ldr-mcp.mjs"],
      "enabled": true,
      "timeout": 120000,
    },
  },
  "agent": {
    "ornith-atlas-kernel": {
      "mode": "primary",
      "description": "Curated Parent Atlas task agent on Ornith 1.5 9B; backend stores and BitFrost remain behind Atlas capabilities",
      "model": "llama-server/ornith-1.5-9b",
      "temperature": 0.8,
      "steps": 10,
      "prompt": "Use only the curated Atlas task capabilities. Never call storage, graph, cache, or raw backend tools directly. Do not narrate or imitate tool calls. Wait for actual tool results before making claims. Never edit files or execute mutations. Always use the canonicalized Atlas context rather than raw retrieval output.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "bash": "ask",
        "Get-Location": "allow",
        "git status": "allow",
        "git diff": "allow",
        "rg": "allow",
        "atlas-task-kernel*": "allow",
        "ldr-research*": "allow",
        "LLMS.md.*": "allow",
        "evidence.*": "allow",
        "image.*": "allow",
        "edit": "deny",
      },
    },
    "ornith-function-caller": {
      "mode": "subagent",
      "description": "Ornith 1.5 function-calling auditor on llama-server :8090",
      "model": "llama-server/ornith-1.5-9b",
      "temperature": 0.8,
      "steps": 10,
      "prompt": "When a tool is needed, use the provider's native structured tool-calling mechanism. Do not narrate, imitate, or manually print tool invocations in ordinary response content. Never expose raw tool-call syntax to the user. Wait for actual tool results before making claims based on them. Prefer TRACE MCP retrieval tools. Do not edit files.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "bash": "ask",
        "atlas-task-kernel*": "allow",
        "ldr-research*": "allow",
        "edit": "deny",
      },
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "reserved": 3072,
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 18000,
  },
  "share": "disabled",
}
