{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "model": "llama-server/ornith-1.5-9b",
  "small_model": "llama-server/ornith-1.5-9b",
  "default_agent": "ornith-trace-audit",
  "provider": {
    "llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (:8090)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local",
      },
      "models": {
        // Tool formatting is server-owned. Ornith 1.5's embedded tokenizer
        // template is Qwen-compatible; launch-turboquant.ps1 enables --jinja.
        "ornith-1.5-9b": {
          "name": "Ornith 1.5 9B",
          "tools": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 4096,
          },
          "options": {
            "temperature": 0.6,
            "topP": 0.95,
            "topK": 20,
            "stream": true,
            "maxTokens": 4096,
          },
        },
        "gemma4-legal-iq4xs-direct.gguf": {
          "name": "Gemma4 Legal Direct 65K",
          "tools": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096,
          },
        },
      },
    },
  },
  "mcp": {
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 60000,
    },
    "atlas-tools": {
      "type": "local",
      "command": ["node", "./sveltekit-frontend/scripts/mcp/atlas-tools-mcp.mjs"],
      "enabled": true,
      "timeout": 30000,
    },
  },
  "agent": {
    "ornith-trace-audit": {
      "mode": "primary",
      "description": "Read-only repository auditor using native TRACE retrieval tools on Ornith 1.5 9B",
      "model": "llama-server/ornith-1.5-9b",
      "temperature": 0.8,
      "steps": 10,
      "prompt": "When a tool is needed, use the provider's native structured tool-calling mechanism. Do not narrate, imitate, or manually print tool invocations in ordinary response content. Never expose raw tool-call syntax to the user. Wait for actual tool results before making claims based on them. Emit at most one tool call per assistant turn. Never batch or parallelize tool calls. Use exact TRACE tool names exposed by the connected MCP server. Prefer compact, ranked evidence. Verify source paths before reporting them. Do not edit files.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "bash": "ask",
        "Get-Location": "allow",
        "git status": "allow",
        "git diff": "allow",
        "rg": "allow",
        "atlas.*": "allow",
        "ace.*": "allow",
        "trace.*": "allow",
        "kag.*": "allow",
        "taxonomy.*": "allow",
        "clusters.*": "allow",
        "hypergraph.*": "allow",
        "knowledge.*": "allow",
        "codebase.*": "allow",
        "ops.*": "allow",
        "runtime.*": "allow",
        "LLMS.md.*": "allow",
        "evidence.*": "allow",
        "image.*": "allow",
        "shell.*": "allow",
        "edit": "deny",
      },
    },
    "ornith-function-caller": {
      "mode": "subagent",
      "description": "Ornith 1.5 function-calling auditor on llama-server :8090",
      "model": "llama-server/ornith-1.5-9b",
      "temperature": 0.8,
      "steps": 10,
      "prompt": "When a tool is needed, use the provider's native structured tool-calling mechanism. Do not narrate, imitate, or manually print tool invocations in ordinary response content. Never expose raw tool-call syntax to the user. Wait for actual tool results before making claims based on them. Prefer TRACE MCP retrieval tools. Do not edit files.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "bash": "ask",
        "atlas.*": "allow",
        "ace.*": "allow",
        "trace.*": "allow",
        "kag.*": "allow",
        "codebase.*": "allow",
        "ops.*": "allow",
        "edit": "deny",
      },
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "reserved": 3072,
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 18000,
  },
  "share": "disabled",
}
