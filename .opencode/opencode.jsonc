{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "model": "llama-server/ornith-1.5-9b",
  "small_model": "llama-server/ornith-1.5-9b",
  "default_agent": "ornith-atlas-kernel",
  "provider": {
    "llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (:8090)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local",
      },
      "models": {
        // Tool formatting is server-owned. Ornith 1.5's embedded tokenizer
        // template is Qwen-compatible; launch-turboquant.ps1 enables --jinja.
        "ornith-1.5-9b": {
          "name": "Ornith 1.5 9B",
          "tools": true,
          "reasoning": false,
          "limit": {
          "context": 65536,
          "output": 4096,
          },
          "options": {
            "temperature": 0.4,
            "topP": 0.95,
            "topK": 20,
            "stream": true,
            "maxTokens": 4096,
          },
        },
        // The historical gemma4-legal-iq4xs-direct.gguf entry was removed 2026-10-04: it is not served on :8090 and a
        // single-model llama-server would answer it with Ornith under a Gemma label. Recoverable from git history.
      },
    },
  },
  // Token/context alignment (measured 2026-10-05): MCP tool schemas ride on EVERY request. TRACE alone is 188 tools
  // (~33k tokens of the 65,536 window) and claude-mem adds 22 (8 of them write data or launch LLM sessions). Both are
  // off by default so plan/build keep their context; agents that need TRACE re-enable it per agent below.
  // Server prefix naming (`<server>_<tool>`) is OpenCode's convention; verify with `npm run opencode:align:check`.
  "tools": {
    "trace*": false,
    "claude-mem*": false,
  },
  // Backstop for every agent incl. built-in plan/build (which default to "* allow"). atlas-tools has 9 read tools and one
  // writer (record_outcome: NDJSON ledger + Neo4j edges); outcomes must go through the governed LearningOutcomeV1 path.
  "permission": {
    "atlas-tools_record_outcome": "deny",
    "claude-mem*": "deny",
  },
  "mcp": {
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 60000,
    },
    "atlas-task-kernel": {
      "type": "local",
      "command": ["node", "./sveltekit-frontend/scripts/mcp/atlas-task-kernel-mcp.mjs"],
      "enabled": true,
      "timeout": 60000,
    },
    "ldr-research": {
      "type": "local",
      "command": ["node", "./sveltekit-frontend/scripts/mcp/ldr-mcp.mjs"],
      "enabled": false,
      "timeout": 120000,
    },
  },
  "agent": {
    // Defined in repo-root opencode.json and merged by name: re-enable TRACE (globally off above) for agents that use it.
    "ornith-trace-audit": { "tools": { "trace*": true } },
    "trace-mcp-tooling": { "tools": { "trace*": true } },
    "mcp-toolchain": { "tools": { "trace*": true } },
    "ornith-atlas-kernel": {
      "mode": "primary",
      "description": "Curated Parent Atlas task agent on Ornith 1.5 9B; backend stores and BitFrost remain behind Atlas capabilities",
      "model": "llama-server/ornith-1.5-9b",
      "temperature": 0.4,
      "steps": 20,
      "prompt": "Use only the curated Atlas task capabilities. Never call storage, graph, cache, or raw backend tools directly. Do not narrate or imitate tool calls. Wait for actual tool results before making claims. Never edit files or execute mutations. Always use the canonicalized Atlas context rather than raw retrieval output.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "bash": "ask",
        "Get-Location": "allow",
        "git status": "allow",
        "git diff": "allow",
        "rg": "allow",
        "atlas-task-kernel*": "allow",
        "ldr-research*": "allow",
        "LLMS.md.*": "allow",
        "evidence.*": "allow",
        "image.*": "allow",
        "todowrite": "allow",
        "atlas-tools*": "allow",
        "atlas-tools_record_outcome": "deny",
        "edit": "deny",
      },
    },
    "ornith-function-caller": {
      "mode": "subagent",
      "description": "Ornith 1.5 function-calling auditor on llama-server :8090",
      "model": "llama-server/ornith-1.5-9b",
      "temperature": 0.4,
      "steps": 10,
      "prompt": "When a tool is needed, use the provider's native structured tool-calling mechanism. Do not narrate, imitate, or manually print tool invocations in ordinary response content. Never expose raw tool-call syntax to the user. Wait for actual tool results before making claims based on them. Prefer TRACE MCP retrieval tools. Do not edit files.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "bash": "ask",
        "atlas-task-kernel*": "allow",
        "ldr-research*": "allow",
        "atlas-tools*": "allow",
        "atlas-tools_record_outcome": "deny",
        "edit": "deny",
      },
    },
    "atlas-rlm-repair": {
      "mode": "primary",
      "description": "Revision-aware Parent Atlas RLM and agentic repair auditor",
      "model": "llama-server/ornith-1.5-9b",
      "temperature": 0,
      "steps": 8,
      "tools": { "trace*": true },
      "prompt": "Use only revision-qualified Atlas/TRACE evidence. Classify verified errors, build bounded evidence packets, and return repair candidates plus validation plans. Never edit files, apply repairs, persist hidden reasoning, or treat transport logs, Qdrant IDs, cache keys, tensors, KV state, or GPU pointers as identity. A recommendation is not authorization. Always include writesPerformed=false and structured evidence references.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "bash": "ask",
        "atlas-task-kernel*": "allow",
        "trace.*": "allow",
        "trace_*": "allow",
        "atlas.*": "allow",
        "atlas-tools*": "allow",
        "atlas-tools_record_outcome": "deny",
        "edit": "deny",
      },
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "reserved": 3072,
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 18000,
  },
  "share": "disabled",
}
