{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "enabled_providers": ["llama-server"],
  "provider": {
    "llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemma4 Direct GGUF",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "gemma4-legal-iq4xs-direct.gguf": {
          "name": "Gemma4 Legal IQ4_XS Direct GGUF",
          "tools": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "options": {
            "temperature": 0,
            "stream": true,
            "maxTokens": 8192,
            "stop": [
              "Thinking:",
              "Self-Correction",
              "_gemma3",
              "gemma3.5-27"
            ]
          }
        },
        "hforf.gguf": {
          "name": "HForF Qwen (Reasoning Model)",
          "tools": true,
          "reasoning": true,
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "options": {
            "temperature": 0.7,
            "stream": true,
            "maxTokens": 4096,
            "stop": [
              "Human:",
              "Assistant:",
              "<|im_end|>"
            ]
          }
        }
      }
    }
  },
  "model": "llama-server/gemma4-legal-iq4xs-direct.gguf",
  "small_model": "llama-server/gemma4-legal-iq4xs-direct.gguf",
  "permission": {
    "bash": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "edit": "ask",
    "write": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "trace_*": "allow",
    "turbovec_*": "allow",
    "engram_*": "allow",
    "langextract_*": "allow"
  },
  "mcp": {
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 120000,
      "headers": {
        "Accept": "application/json, text/event-stream"
      }
    },
    "atlas-tools": {
      "type": "local",
      "command": ["npx", "tsx", "./sveltekit-frontend/scripts/mcp/atlas-tools-mcp.mjs"],
      "enabled": true,
      "timeout": 120000,
      "env": {
        "NODE_ENV": "production",
        "MCP_STDIO": "true"
      }
    },
    "turbovec": {
      "type": "remote",
      "url": "http://127.0.0.1:8791/mcp",
      "enabled": false,
      "timeout": 30000
    },
    "engram-embed": {
      "type": "local",
      "command": ["node", "./sveltekit-frontend/scripts/mcp/engram-embed-mcp.mjs", "--stdio"],
      "enabled": true,
      "timeout": 60000,
      "env": {
        "ENGRAM_ONLY": "true",
        "REDIS_ENABLED": "false"
      }
    },
    "gemma4-offload": {
      "type": "local",
      "command": ["node", "./sveltekit-frontend/scripts/mcp/gemma4-offload-mcp.mjs"],
      "enabled": true,
      "timeout": 30000,
      "env": {
        "ENGRAM_ONLY": "true"
      }
    }
  },
  "instructions": [
    ".opencode/system.md",
    "sveltekit-frontend/.opencode/skills/no-placeholder-policy.md",
    "AGENTS.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/",
      "dist/",
      ".git/",
      ".svelte-kit/",
      "memory/",
      "tmp/",
      ".opencode/cards/**",
      ".opencode/cache/**",
      ".opencode/ndjson/**",
      ".opencode/embeddings/**",
      ".opencode/ace-packet.json",
      ".opencode/ace-packet-*.json",
      ".opencode/ace-packets/**",
      ".opencode/ace-packets_stale/**",
      ".opencode/ace-context.json",
      ".opencode/feature-files.json",
      ".opencode/startup-context.json",
      ".opencode/ace-seed-*.json",
      ".opencode/patchcard-*.json",
      ".opencode/ingest/**",
      ".opencode/summaries/**",
      ".opencode/jobs/**",
      ".opencode/tasks/**",
      ".opencode/commits/**",
      ".opencode/fixes/**",
      ".opencode/quarantine/**",
      ".opencode/recommendations/**",
      ".opencode/context/**",
      ".opencode/agents/**",
      ".opencode/kanban/**",
      ".opencode/feature-map/**",
      ".opencode/memory/**",
      ".opencode/tools/**",
      ".opencode/node_modules/**",
      "neschrom97/**",
      "sveltekit-frontend/node_modules/**",
      "sveltekit-frontend/.svelte-kit/**",
      "sveltekit-frontend/static/ort/**",
      "sveltekit-frontend/static/gemma3_270m_onnx/**",
      "sveltekit-frontend/static/embeddinggemma_300m_onnx/**",
      "simd-bridge/cpp/build/**",
      "granite-docling-258M/**",
      "turbovec/**",
      "models/**"
    ]
  }
}
