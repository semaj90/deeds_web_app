{
  "$schema": "https://opencode.ai/config.json",
  "model": "gemma4-iq4xs-direct.gguf",
  "shell": "pwsh",
  "permission": {
    "bash": {
      "*": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "glob": "allow"
  },
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server :8090",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local"
      },
      "models": {
        "gemma4-iq4xs-direct.gguf": {
          "name": "Gemma4 Legal IQ4_XS (65K context)",
          "tools": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 4096
          },
          "system": "You are a helpful assistant with access to bash, read, grep, and other tools. When you need to run a tool, think about it first, then execute it."
        }
      }
    }
  },
  "mcp": {
    "atlas-tools": {
      "type": "local",
      "command": ["node", "sveltekit-frontend/scripts/mcp/atlas-tools-mcp.mjs"],
      "enabled": true,
      "timeout": 30000
    },
    "engram-embed": {
      "type": "local",
      "command": ["node", "sveltekit-frontend/scripts/mcp/engram-embed-mcp.mjs"],
      "enabled": true,
      "timeout": 30000
    },
    "gemma4-offload": {
      "type": "local",
      "command": ["node", "sveltekit-frontend/scripts/mcp/gemma4-offload-mcp.mjs"],
      "enabled": true,
      "timeout": 30000
    },
    "ldr-research": {
      "type": "local",
      "command": ["node", "sveltekit-frontend/scripts/mcp/ldr-mcp.mjs"],
      "enabled": true,
      "timeout": 120000
    },
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 60000
    }
  },
  "lsp": {
    "typescript": {
      "command": ["node", "C:/Users/james/Videos/deeds-web-app/sveltekit-frontend/node_modules/typescript-language-server/lib/cli.mjs", "--stdio"],
      "extensions": ["ts", "tsx", "js", "jsx"]
    },
    "svelte": {
      "command": ["node", "C:/Users/james/Videos/deeds-web-app/sveltekit-frontend/node_modules/svelte-language-server/bin/server.js", "--stdio"],
      "extensions": ["svelte"]
    },
    "json": {
      "command": ["node", "C:/Users/james/Videos/deeds-web-app/sveltekit-frontend/node_modules/vscode-langservers-extracted/bin/vscode-json-language-server", "--stdio"],
      "extensions": ["json", "jsonc"]
    }
  }
}
