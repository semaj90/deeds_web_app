{
  "$schema": "https://opencode.ai/config.json",
  "model": "turboquant/gemma4-legal.gguf",
  "small_model": "turboquant/gemma4-legal.gguf",
  "default_agent": "atlas-context",
  "shell": "pwsh",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "read": "ask",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "trace_*": "allow",
    "turbovec_*": "allow",
    "engram_*": "allow",
    "langextract_*": "allow",
    "bash": {
      "npm run tools:check:structural": "allow",
      "npm run index:*": "allow",
      "npm run graphify:dependency:audit": "allow",
      "npm --prefix * run index:*": "allow",
      "npm --prefix * run graphify:dependency:audit": "allow",
      "node scripts/index/*": "allow",
      "rg *": "allow",
      "ast-grep *": "allow",
      "sg *": "allow",
      "jq *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "rm *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "docker exec *": "allow",
      "docker ps *": "allow",
      "npm run ace:packet -- *": "allow",
      "npm run ace:ask -- *": "allow",
      "npm run ace:stream -- *": "allow",
      "npm run index:clusters:query -- *": "allow",
      "node scripts/ace/*.mjs *": "allow",
      "Get-Content * | Select-Object -Skip * -First *": "allow",
      "cat *.md": "deny",
      "cat *.txt": "deny",
      "cat *.json": "deny",
      "Get-Content docs/llms/generated/*": "deny",
      "Get-Content *.json": "deny",
      "*": "ask"
    }
  },
  "provider": {
    "turboquant": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama-server :8091 (sanitizer → :8090, tool-calling clean)",
      "options": {
        "baseURL": "http://127.0.0.1:8091/v1",
        "apiKey": "local"
      },
      "models": {
        "gemma4-legal.gguf": {
          "name": "Gemma4 Legal GGUF (merged rotorquant)",
          "tools": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "gemma4-iq4xs": {
          "name": "Gemma4 Legal 64K",
          "tools": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "gemma4-iq4xs-direct.gguf": {
          "name": "Gemma4 Legal IQ4_XS (direct)",
          "tools": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    },
    "yorha": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "YorHA OpenAI facade :5173 (ACE/KAG pipeline)",
      "options": {
        "baseURL": "http://127.0.0.1:5173/api/v1",
        "apiKey": "local"
      },
      "models": {
        "yorha-hermes": {
          "name": "YorHA ACE Hermes 64K",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "yorha-legal": {
          "name": "YorHA ACE Legal 64K",
          "limit": {
            "context": 65536,
            "output": 4097
          }
        }
      }
    }
  },
  "command": {
    "atlas-context": {
      "description": "Use Atlas-first retrieval without reading full files",
      "agent": "atlas-context",
      "subtask": true,
      "template": "Use ace-stream first, then ace-packet if needed, then npm run index:clusters:query, then atlas.search, then rg exact section, then read only a 40-80 line window. Return sourceRefs, chunkIds, commands, clusterPath, cache keys, and a short answer. Do not read full .md, .txt, .json files."
    },
    "ace-packet": {
      "description": "Build compact ACE packet for the current query",
      "agent": "atlas-context",
      "subtask": false,
      "template": "Build an ACE packet for the user's query. Prefer cached summaries, sourceRefs, chunkIds, searchGroups, and commands. Do not read full files."
    },
    "ace-stream": {
      "description": "Stream a compact ACE packet and validate Redis cache packet injection",
      "agent": "atlas-context",
      "subtask": false,
      "template": "Build a compact ACE packet for the user's query, stream through the cache lane, verify Redis hot-path packet injection, and report packet hash, cache keys, and any cache miss. Do not read full files."
    },
    "atlas-cluster": {
      "description": "Query the Atlas manifold cluster map before reading files",
      "agent": "atlas-context",
      "subtask": true,
      "template": "Run npm run index:clusters:query for the user's query, identify the top cluster path, then use rg inside only that cluster. Return clusterId, clusterPath, sourceRefs, chunkIds, and commands."
    },
    "workspace-ready": {
      "description": "Validate workspace, sidecars, semantic indexing, and feature readiness",
      "agent": "atlas-context",
      "subtask": true,
      "template": "Validate config, discover scripts, check sidecars, run codebase indexing, and verify ACE context. Use ACE hits and recommendations first; do not jump to model-only answers."
    },
    "workspace-bootstrap": {
      "description": "Refresh ACE context, local health, and report artifacts",
      "agent": "atlas-context",
      "subtask": false,
      "template": "Refresh ACE context, TODO summary, MCP health, semantic index, recommendations, startup briefing. Do not modify files. Prefer ACE hits before model-only response."
    }
  },
  "mcp": {
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 60000,
      "headers": {
        "Accept": "application/json, text/event-stream"
      }
    },
    "turbovec": {
      "type": "remote",
      "url": "http://127.0.0.1:8791/mcp",
      "enabled": false,
      "timeout": 30000,
      "note": "TurboVec HTTP service has no MCP endpoint. Called directly from code via turbovec-prefilter.ts. Enable if MCP wrapper created."
    },
    "gemma4-offload": {
      "type": "local",
      "description": "Repo-audit-only MCP for evidence-grounded summaries and classifications",
      "command": ["node", "sveltekit-frontend/scripts/mcp/gemma4-offload-mcp.mjs"],
      "enabled": true,
      "timeout": 30000
    },
    "engram-embed": {
      "type": "local",
      "description": "stdio-only embeddings MCP; no chat or generic generation",
      "command": ["node", "sveltekit-frontend/scripts/mcp/engram-embed-mcp.mjs", "--stdio"],
      "enabled": true,
      "timeout": 60000
    },
    "ldr-research": {
      "type": "local",
      "command": "node",
      "args": ["sveltekit-frontend/scripts/mcp/ldr-mcp.mjs"],
      "enabled": true,
      "timeout": 120000,
      "description": "Local Deep Research: async multi-engine research via Gemma4 + SearXNG + Wikipedia"
    },
    "atlas-tools": {
      "type": "local",
      "command": ["node", "sveltekit-frontend/scripts/mcp/atlas-tools-mcp.mjs"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "agent": {
    "atlas-context": {
      "description": "Atlas-first retrieval agent using ACE packets and strict context-budget rules",
      "model": "turboquant/gemma4-legal.gguf",
      "temperature": 0.2,
      "steps": 8,
      "prompt": "Repo evidence first. Check .opencode/recommendations, .opencode/tasks, docs/graph/recommendations.md, and relevant Parent Atlas reports before answering. Use report or command output only. Findings are historical, recommendations are append-only, tasks are persistent. If evidence is missing, say what report is needed. Use Gemma4 only after evidence is gathered, and only for repo-audit summaries. Never use it for generic chat or tutorials.",
      "permission": {
        "*": "deny",
        "read": "ask",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "ace_*": "allow",
        "ace.*": "allow",
        "turbovec_*": "allow",
        "turbovec.*": "allow",
        "engram_*": "allow",
        "engram.*": "allow",
        "langextract_*": "allow",
        "langextract.*": "allow",
        "graph_*": "allow",
        "graph.*": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": {
          "docker exec *": "allow",
          "docker ps *": "allow",
          "npm run ace:packet -- *": "allow",
          "npm run ace:ask -- *": "allow",
          "npm run ace:stream -- *": "allow",
          "npm run index:clusters:query -- *": "allow",
          "npm run index:*": "allow",
          "node scripts/ace/*.mjs *": "allow",
          "rg *": "allow",
          "Get-Content * | Select-Object -Skip * -First *": "allow",
          "git status": "allow",
          "git diff *": "allow",
          "*": "ask"
        }
      }
    },
    "antigravity": {
      "description": "General-purpose agent: bash, MCP tools, read, grep. Use for tool-calling tests and operational tasks.",
      "model": "turboquant/gemma4-legal.gguf",
      "temperature": 0,
      "steps": 10,
      "prompt": "You have access to bash, read, grep, and MCP tools. RULE: When the user asks you to run a command, you MUST call the bash tool. Do NOT write text explanations. Do NOT describe what you will do. Call the tool immediately with the exact command. First action = tool call, not text.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "ace_*": "allow",
        "ace.*": "allow",
        "graph.*": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": {
          "docker exec *": "allow",
          "docker ps *": "allow",
          "rg *": "allow",
          "git status": "allow",
          "git diff *": "allow",
          "*": "allow"
        }
      }
    },
    "trace-audit": {
      "description": "Read-only TRACE audit agent with compact context tools",
      "model": "turboquant/gemma4-legal.gguf",
      "temperature": 0,
      "steps": 8,
      "prompt": "Before reading .md, .json, .sql files: call atlas.compact_context, context.build_kv_packet, ace.compact_search. Do not read whole Markdown files. Use TRACE MCP prompt-cache: call context.build_kv_packet before retrieval. Prefer cached cards over raw files. If no TRACE tool visible, stop with TRACE_MCP_NOT_AVAILABLE. Do not edit or mutate anything.",
      "permission": {
        "*": "deny",
        "read": "ask",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "edit": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "hermes-ace": {
      "description": "Hermes-ACE agent using ACE context, MCP tools, and repo-audit Gemma4",
      "model": "turboquant/gemma4-legal.gguf",
      "temperature": 0,
      "steps": 12,
      "prompt": "Repo evidence first. Check .opencode/recommendations, .opencode/tasks, docs/graph/recommendations.md, docs/reports before answering. Use MCP tools: trace.kag_search, trace.atlas_query, turbovec, engram-embed, langextract. Use Gemma4 only after evidence is gathered, for repo-audit summaries only. Never for generic chat or tutorials.",
      "permission": {
        "*": "deny",
        "read": "ask",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "audit": {
      "description": "Read-only SvelteKit 2 / Svelte 5 / Drizzle / Zod auditor (no MCP)",
      "model": "turboquant/gemma4-legal.gguf",
      "temperature": 0,
      "steps": 8,
      "prompt": "You are a read-only codebase auditor. Focus on SvelteKit 2, Svelte 5 runes, Bits UI, Drizzle ORM, PostgreSQL schemas, Zod validations, SSR boundaries, API routes, and deep audit safety. Do not edit files.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "edit": "deny"
      }
    }
  },
  "instructions": [
    ".opencode/system.md",
    "AGENTS.md",
    ".claude/skills/trace-mcp-tooling/SKILL.md",
    "sveltekit-frontend/docs/architecture/gemma4-to-claude-code-handoff.md"
  ],
  "share": "disabled"
}
