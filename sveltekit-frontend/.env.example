# ═══════════════════════════════════════════════════════════════════════
# Deeds Legal AI Platform — Environment Configuration Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ===== Database (local proxy to healthy PostgreSQL on 5434) =====
DATABASE_URL=postgresql://legal_admin:CHANGE_ME@localhost:5434/legal_ai_db
# Docker: DATABASE_URL=postgresql://legal_admin:CHANGE_ME@postgres:5432/legal_ai_db

# ===== Redis Cache =====
REDIS_URL=redis://localhost:6379
# Docker: REDIS_URL=redis://redis:6379

# ===== Qdrant Vector Database =====
QDRANT_URL=http://localhost:6333
# Or parts: QDRANT_HOST=localhost  QDRANT_PORT=6333
# Docker: QDRANT_URL=http://qdrant:6333

# ===== RabbitMQ Message Queue =====
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Docker: RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ===== Ollama AI Service =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_KEEP_ALIVE=2m
OLLAMA_EMBED_KEEP_ALIVE=24h
# Primary LLM for legal analysis (used by ollama-client.ts + phase109/tag-chunks)
OLLAMA_CHAT_MODEL=gemma4-legal:latest
# Primary embedding model (768-dim, used by ollama-client.ts)
OLLAMA_EMBED_MODEL=embeddinggemma:latest
# Gemma 4 E4B Q4_K_M — VLM + tool calling + complex reasoning (fallback: gemma3-legal)
GEMMA4_MODEL=gemma4:e4b-it-q4_K_M
# Docker: OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===== MinIO Object Storage =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_EVIDENCE_BUCKET=legal-evidence

# ===== Auth Secrets (REQUIRED — MUST change for production) =====
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING
SERVICE_AUTH_TOKEN=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING

# ===== SvelteKit Configuration =====
PORT=5173
HOST=127.0.0.1
ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173

# ===== Neo4j Graph Database (optional) =====
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=CHANGE_ME

# ===== CouchDB Document Store (optional — ACE context engine) =====
# COUCHDB_URL=http://admin:CHANGE_ME@localhost:5984

# ===== gRPC Services (optional) =====
# EMBEDDING_GRPC_URL=127.0.0.1:50051
# EMBEDDING_GRPC_ENABLED=false
# RETRIEVAL_GRPC_URL=127.0.0.1:50053
# RETRIEVAL_GRPC_ENABLED=false

# ===== QUIC/NATS Transport (optional) =====
# EMBEDDING_QUIC_ENABLED=false
# NATS_URL=nats://127.0.0.1:4222

# ===== TensorRT-LLM Inference (optional — port 8099) =====
# TENSORRT_URL=http://localhost:8099

# ===== Triton Inference Server (optional — port 8000) =====
# TRITON_URL=http://localhost:8000
# TRITON_VLM_MODEL=gemma_vlm_ensemble
# TRITON_VISION_MODEL=siglip_vision
# TRITON_LLM_MODEL=legal-llm

# ===== Web Push VAPID Keys (generate: npx web-push generate-vapid-keys --json) =====
# PUBLIC_VAPID_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:admin@example.com

# ===== ntfy.sh Push Notifications (optional) =====
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=deeds-legal-alerts

# ===== Email SMTP (optional) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Deeds Legal AI <noreply@example.com>

# ===== Web Search APIs (optional) =====
# SEARXNG_URL=http://localhost:8888
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# ===== Firecrawl (optional — YouTube transcript fallback) =====
# FIRECRAWL_API_KEY=

# ===== Go Search Service (optional) =====
# GO_SEARCH_URL=
# GO_SEARCH_GRPC_URL=127.0.0.1:50055

# ===== LiteLLM Proxy (optional — semantic caching) =====
# LITELLM_URL=http://localhost:4000
# LITELLM_API_KEY=sk-your-key
# LITELLM_ENABLED=false

# ===== Langfuse Observability (optional) =====
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3030
# LANGFUSE_ENABLED=false

# ===== LLM Provider Keys (optional — for multi-provider routing) =====
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
# OPENAI_API_KEY=

# ===== Whisper Speech-to-Text (optional — nodejs-whisper CUDA) =====
# WHISPER_MODEL=base
# WHISPER_CUDA=true
# WHISPER_PATH=whisper
# WHISPER_DEVICE=cpu
# WHISPER_USE_SERVER=false
# WHISPER_SERVER_URL=http://127.0.0.1:8178

# ===== Docling VLM Service (optional — document extraction + YOLO + Whisper) =====
# DOCLING_SERVICE_URL=http://localhost:8085

# ===== LangExtract Service (optional — Python FastAPI + spaCy + NER) =====
# LANGEXTRACT_ENABLED=false
# LANGEXTRACT_URL=http://127.0.0.1:8095

# ===== Development Settings (do NOT set in production) =====
# DEV_BYPASS_AUTH=true
# NODE_ENV=development

# ===== Interactive Chat Controls =====
ACE_CHAT_SELF_EVAL_ENABLED=false

# ══════════════════════════════════════════════════════════════
# Playwright Test Environment
# ══════════════════════════════════════════════════════════════
# Configure service ports for E2E tests
# Tests use process.env > .env.local > .env > hardcoded defaults

PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
TURBO_QUANT_URL=http://localhost:8090
OLLAMA_BASE_URL=http://localhost:11434
LITERT_URL=http://localhost:8070
QDRANT_URL=http://localhost:6333
REDIS_HOST=localhost
REDIS_PORT=6379
DATABASE_PORT=5434
MINIO_ENDPOINT=http://localhost:9000
RABBITMQ_URL=amqp://localhost:5672
LANGEXTRACT_URL=http://localhost:8095
GRPC_EMBED_URL=localhost:50051
