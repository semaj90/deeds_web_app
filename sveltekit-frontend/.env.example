# ═══════════════════════════════════════════════════════════════════════
# Deeds Legal AI Platform — Environment Configuration Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ===== Database (PostgreSQL 16 + pgvector) =====
DATABASE_URL=postgresql://legal_admin:CHANGE_ME@localhost:5434/legal_ai_db
# Docker: DATABASE_URL=postgresql://legal_admin:CHANGE_ME@postgres:5432/legal_ai_db

# ===== Redis Cache =====
REDIS_URL=redis://localhost:6379
# Explicit host/port (for ioredis config):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# Docker: REDIS_URL=redis://redis:6379

# ===== Qdrant Vector Database =====
QDRANT_URL=http://localhost:6333
# Or parts: QDRANT_HOST=localhost  QDRANT_PORT=6333
# Docker: QDRANT_URL=http://qdrant:6333

# ===== RabbitMQ Message Queue =====
RABBITMQ_URL=amqp://legal_admin:secret123@localhost:5672
# Management API:
# RABBITMQ_MGMT_URL=http://localhost:15672
# Docker: RABBITMQ_URL=amqp://legal_admin:secret123@rabbitmq:5672

# ===== Ollama AI Service =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_KEEP_ALIVE=2m
OLLAMA_EMBED_KEEP_ALIVE=24h
# Primary LLM — unified text+vision, GRPO legal LoRA merged (5.3GB)
OLLAMA_CHAT_MODEL=gemma4-legal-vlm:latest
# Vision-language model (same unified model by default)
# OLLAMA_VLM_MODEL=gemma4-legal-vlm:latest
# Primary embedding model (768-dim)
OLLAMA_EMBED_MODEL=embeddinggemma:latest
# Gemma 4 E4B — tool calling + thinking + vision
GEMMA4_MODEL=gemma4-legal-vlm:latest
# Docker: OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===== Bifrost AI Gateway (L2 semantic cache — replaces LiteLLM) =====
# BIFROST_URL=http://localhost:3040
# BIFROST_ENABLED=false
# OpenAI-compat base URL (via Bifrost → Ollama) for pgai, LangChain, external tools:
# OPENAI_BASE_URL=http://localhost:3040/v1
# OPENAI_API_KEY=dummy

# ===== MinIO Object Storage =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_EVIDENCE_BUCKET=legal-evidence
# MINIO_LIBRARY_BUCKET=legal-library

# ===== Auth Secrets (REQUIRED — MUST change for production) =====
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING
SERVICE_AUTH_TOKEN=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING

# ===== SvelteKit Configuration =====
PORT=5173
HOST=127.0.0.1
ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173

# ===== Neo4j Graph Database (optional) =====
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=CHANGE_ME

# ===== CouchDB Document Store (optional — ACE context engine) =====
# COUCHDB_URL=http://admin:CHANGE_ME@localhost:5984

# ===== gRPC Services (optional — all default disabled) =====
# EMBEDDING_GRPC_URL=127.0.0.1:50051
# EMBEDDING_GRPC_ENABLED=false
# RETRIEVAL_GRPC_URL=127.0.0.1:50053
# RETRIEVAL_GRPC_ENABLED=false
# RETRIEVAL_HTTP_URL=http://localhost:8100
# RETRIEVAL_HTTP_ENABLED=false
# CHR97_GRPC_URL=127.0.0.1:50055
# CHR97_GRPC_ENABLED=false
# TOOL_GRPC_URL=127.0.0.1:50057
# TOOL_GRPC_ENABLED=false

# ===== QUIC/NATS Transport (optional) =====
# EMBEDDING_QUIC_ENABLED=false
# NATS_URL=nats://127.0.0.1:4222

# ===== TensorRT-LLM Inference (optional — port 8099) =====
# TENSORRT_URL=http://localhost:8099

# ===== Triton Inference Server (optional — port 8000) =====
# TRITON_URL=http://localhost:8000
# TRITON_VLM_MODEL=gemma_vlm_ensemble
# TRITON_VISION_MODEL=siglip_vision
# TRITON_LLM_MODEL=legal-llm

# ===== Granite-Docling Document Intelligence (optional) =====
# Ollama multimodal model for layout-aware PDF/image extraction
# GRANITE_DOCLING_MODEL=ibm/granite-docling:258m
# GRANITE_DOCLING_ENABLED=true

# ===== Docling Service (optional — Python FastAPI) =====
# DOCLING_SERVICE_URL=http://localhost:8085

# ===== Whisper Speech-to-Text (optional — audio evidence transcription) =====
# WHISPER_MODEL=base
# WHISPER_CUDA=true
# WHISPER_PATH=whisper
# WHISPER_DEVICE=cpu
# Persistent server mode (eliminates cold start):
# WHISPER_USE_SERVER=false
# WHISPER_SERVER_URL=http://127.0.0.1:8178

# ===== LangExtract Service (optional — Python FastAPI + spaCy + NER) =====
# LANGEXTRACT_ENABLED=false
# LANGEXTRACT_URL=http://127.0.0.1:8095

# ===== LangGraph Synthesis Service (Docker GPU profile) =====
# Start: docker compose --profile gpu up -d langgraph-synthesis
# HMM Baum-Welch adaptation, GRPO reward, full LangGraph DAG pipeline
LANGGRAPH_URL=http://localhost:8091
LANGGRAPH_ENABLED=true

# ===== Microservice URLs (optional — all have inline fallbacks) =====
# CODEBASE_INDEX_URL=http://localhost:8090
# ORCHESTRATOR_URL=http://localhost:8102
# RAG_SERVICE_URL=http://localhost:8103
# CUDA_SERVICE_URL=http://localhost:8765
# FASTAPI_URL=http://localhost:8001

# ===== Langfuse Observability (recommended — traces LLM calls) =====
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3030
# LANGFUSE_ENABLED=false

# ===== Web Search APIs (optional) =====
# SEARXNG_URL=http://localhost:8888
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# ===== Firecrawl (optional — YouTube transcript fallback) =====
# FIRECRAWL_API_KEY=

# ===== Go Search Service (optional) =====
# GO_SEARCH_URL=http://localhost:8096
# GO_SEARCH_GRPC_URL=127.0.0.1:50055

# ===== Obsidian Vault Sync (optional — obsidian-local-rest-api plugin) =====
# OBSIDIAN_URL=https://127.0.0.1:27124
# OBSIDIAN_API_KEY=

# ===== Web Push VAPID Keys (generate: npx web-push generate-vapid-keys --json) =====
# PUBLIC_VAPID_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:admin@example.com

# ===== ntfy.sh Push Notifications (optional) =====
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=deeds-legal-alerts

# ===== Email SMTP (optional) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Deeds Legal AI <noreply@example.com>

# ===== Google Gemini (optional — cloud fallback for Ollama) =====
# GEMINI_API_KEY=

# ===== Python / CUDA Compute Tools =====
# Path to Python with PyTorch+CUDA — needed for phase89-cuda-clustering.py and GPU scripts.
# Point to project .venv python (torch 2.7.0+cu128 already installed there).
# Windows: PYTHON_PATH=C:\Users\james\Videos\deeds-web-app\.venv\Scripts\python.exe
# Linux:   PYTHON_PATH=/path/to/project/.venv/bin/python
# Default 'python' works if PyTorch is in your system Python.
# PYTHON_PATH=python

# Path to ffmpeg binary (optional — audio transcription pipeline via Whisper)
# FFMPEG_PATH=

# ===== GraphML gRPC (optional — GPU graph analytics, port 50056) =====
# GRAPH_ML_GRPC_URL=127.0.0.1:50056
# GRAPH_ML_GRPC_ENABLED=false

# ===== ACE Performance Tuning =====
# ACE_EMBED_BATCH_TIMEOUT_MS=20000

# ===== LLM Provider Keys (optional — for multi-provider routing) =====
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
# OPENAI_API_KEY=

# ===== Python Executable (for CUDA clustering scripts) =====
# PYTHON_PATH=python
# Windows dev: PYTHON_PATH=C:\Users\james\Videos\deeds-web-app\.venv\Scripts\python.exe

# ===== Interactive Chat Controls =====
ACE_CHAT_SELF_EVAL_ENABLED=false
# ACE_EMBED_BATCH_TIMEOUT_MS=20000

# ===== Development Settings (do NOT set in production) =====
# DEV_BYPASS_AUTH=true
# NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
