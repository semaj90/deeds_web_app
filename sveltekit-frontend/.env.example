# LOADED BY: SvelteKit/Vite process started from sveltekit-frontend/
# SCOPE: Frontend app runtime overrides and local dev service wiring
# PRECEDENCE: CLI inline env (for example npm run dev:gpu) overrides this file
# NOTE: Root .env is consumed by Docker/services/scripts and may intentionally differ
DATABASE_URL="REPLACE_ME"

# INTENTIONAL FRONTEND OVERRIDES (do not auto-sync from root .env):
# - GEMMA4_MODEL=gemma4-legal:latest (frontend legal text lane)
# - HERMES_API_URL=http://127.0.0.1:8090 (TurboQuant lane endpoint)
# - TURBO_PROFILE=turboquant and TURBO_KV_V=turbo3 (validated fast lane)
# - TURBO_MODEL_PATH / ROTORQUANT_MODEL_PATH point to local direct IQ4_XS artifact
# - SEAWEED_* credentials/ports are frontend runtime defaults; root .env may differ for service stacks

# gRPC / QUIC transport (4-tier embedding fallback chain)
EMBEDDING_GRPC_ENABLED=true
EMBEDDING_GRPC_URL="REPLACE_ME"
EMBEDDING_QUIC_ENABLED=true
NATS_URL="REPLACE_ME"
QUIC_HEALTH_URL="REPLACE_ME"
GO_SEARCH_URL="REPLACE_ME"
GO_SEARCH_GRPC_URL="REPLACE_ME"
RETRIEVAL_GRPC_URL="REPLACE_ME"
RETRIEVAL_GRPC_ENABLED=true
RETRIEVAL_HTTP_URL="REPLACE_ME"
RETRIEVAL_HTTP_ENABLED=false

# LangExtract — spaCy NER + structure-aware document extraction (21 files wired)
LANGEXTRACT_ENABLED=true
LANGEXTRACT_URL="REPLACE_ME"

# LiteLLM — DISABLED (supply chain attack March 2026, replaced by Bifrost + pgai)
# See deeds_labs/infra/litellm-archive/bifrostvslitellm_lab.md
LITELLM_ENABLED=false

# Bifrost — Go AI gateway (50x faster, 280x smaller, built-in semantic cache)
BIFROST_ENABLED=true
BIFROST_URL="REPLACE_ME"

# Ollama is embeddings-only in this workspace.
# Generation/chat is served by llama-server via TURBO_* + LLAMA_SERVER_PATH below.
OLLAMA_URL="REPLACE_ME"
EMBEDDING_MODEL="REPLACE_ME"

# OpenAI-compatible base URL (via Bifrost gateway → Ollama)
# Use this for pgai, LangChain, Python scripts, or any OpenAI SDK client
OPENAI_BASE_URL="REPLACE_ME"
OPENAI_API_KEY="REPLACE_ME"

# CouchDB — document store for graph recommendations and pagerank
COUCHDB_URL="REPLACE_ME"

# Neo4j — graph database (matches docker-compose NEO4J_AUTH)
NEO4J_URI="REPLACE_ME"
NEO4J_USER="REPLACE_ME"
NEO4J_PASSWORD="REPLACE_ME"

# Langfuse v3 — LLM observability (docker/langfuse.yml — port 3030)
# Pre-seeded keys from LANGFUSE_INIT_PROJECT_* in docker/langfuse.yml
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY="REPLACE_ME"
LANGFUSE_SECRET_KEY="REPLACE_ME"
LANGFUSE_HOST="http://localhost:3030"

# Whisper persistent server (GPU VRAM resident, no cold start)
# Start: scripts/whisper-server-start.cmd
WHISPER_USE_SERVER=false
WHISPER_SERVER_URL="REPLACE_ME"
# Path to whisper CLI binary (venv install)
WHISPER_PATH="REPLACE_ME"
WHISPER_MODEL="REPLACE_ME"
WHISPER_DEVICE="REPLACE_ME"
# ffmpeg path for Whisper audio decoding (portable binary, no admin required)
FFMPEG_PATH="REPLACE_ME"

# SearXNG metasearch engine (agent web search)
SEARXNG_URL="REPLACE_ME"
SEARXNG_PORT=8889

# Qdrant — vector search
QDRANT_URL="REPLACE_ME"
QDRANT_HOST="127.0.0.1"
QDRANT_PORT=6333

# RabbitMQ — message broker (matches docker-compose.yml default_user)
RABBITMQ_URL="REPLACE_ME"
RABBITMQ_USER="REPLACE_ME"
RABBITMQ_PASSWORD="REPLACE_ME"

DEV_BYPASS_AUTH="REPLACE_ME"

# MinIO Storage (S3-compatible) — active by default
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="REPLACE_ME"
MINIO_SECRET_KEY="REPLACE_ME"
MINIO_USE_SSL=false
MINIO_EVIDENCE_BUCKET="REPLACE_ME"

# SeaweedFS S3-compatible gateway (canonical object store — MinIO deprecated May 2026)
# Start with: docker compose --profile seaweedfs up -d
SEAWEED_ENDPOINT="localhost"
SEAWEED_S3_PORT=8333
SEAWEED_ACCESS_KEY="REPLACE_ME"
SEAWEED_SECRET_KEY="REPLACE_ME"
SEAWEED_MASTER_PORT=9333
SEAWEED_FILER_PORT=8382

# Speculative decoding — use ENABLE_MTP_DRAFTER + MTP_DRAFT_MODEL (launcher checks these)
# DRAFT_MODEL_PATH is DEPRECATED and ignored by launch-turboquant.ps1 — do not use.
# To enable: set ENABLE_MTP_DRAFTER=true and MTP_DRAFT_MODEL=<path-to-draft-gguf>
# Set ENABLE_MTP_DRAFTER=true to activate draft-model speculative decoding
# Draft: gemma3:270m Ollama GGUF blob — shares Gemma tokenizer (256K vocab) with Gemma4
ENABLE_MTP_DRAFTER=false
MTP_DRAFT_MODEL="REPLACE_ME"
DRAFT_N=5

# Hermes prose server — routed through Ollama (gemma4-hermes-64k:latest, 64K ctx, legal+vision)
# Same blob as gemma4-legal-vlm:latest (d9c7875f) but num_ctx=65536.
# Code in openai-facade.ts maps yorha-hermes → gemma4-hermes-64k:latest and POSTs here.
# Fallback: bifrostChat gemma4-legal if this endpoint is unreachable.
HERMES_API_URL="REPLACE_ME"

# RotorQuant GGUF — weight-quantised Gemma4, works on stock llama-server.exe
# Download: majentik/gemma-4-E4B-RotorQuant-GGUF-IQ4_XS from HuggingFace
# When set, launch-turboquant.ps1 uses this instead of TURBO_MODEL_PATH

# Legal LoRA adapter — Path A: inject at runtime over a base-model GGUF
# Only needed when ROTORQUANT_MODEL_PATH points at a base (non-legal) GGUF.
# The default Ollama blob (sha256-a79de882) already has the LoRA merged — skip this.
# LEGAL_LORA_PATH=...
# LEGAL_LORA_SCALE=0.8


# llama-server context window (stock CUDA build, q8_0/q8_0 KV fits 16K on 8GB GPU)
# Use the working stock binary (Build 8757) that supports Gemma 4

# Use 'stock' profile — speculative decoding disabled (MTP_ENABLED=false, ENABLE_MTP_DRAFTER=false)
# --- Restored stable Path B runtime: stock llama.cpp CUDA + IQ4_XS model ---
# Do not enable AtomicBot, MTP, TurboQuant KV, or TensorRT-LLM until those files are real and health-checked.
MCP_LEGACY_ALIASES=true
ACE_ENCODED_PREFILTER_ENABLED=true
ACE_ENCODED_PREFILTER_MODE="REPLACE_ME"
ACE_ENCODED_RERANK_ENABLED=true
ACE_ENCODED_RERANK_WEIGHT="REPLACE_ME"
ROTORQUANT_MODEL_PATH="REPLACE_ME"
TURBO_MODEL_PATH="REPLACE_ME"
# gemma4-legal-iq4xs.gguf (round-trip): 21.6 tok/s, 1762ms TTFT
# gemma4-legal-iq4xs-direct.gguf (direct): 59.8 tok/s, 220ms TTFT — use this
LLAMA_SERVER_PATH="REPLACE_ME"
# mmproj sidecar for VLM mode (disables speculative decoding, enables vision)
MMPROJ_PATH="REPLACE_ME"
TURBO_PROFILE="REPLACE_ME"
TURBO_KV_K="REPLACE_ME"
TURBO_KV_V="REPLACE_ME"
TURBO_CTX=65536
TURBO_PARALLEL=1
LLM_CONTEXT_SIZE=65536
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_HARD_INPUT_CAP=60000
TURBO_NGL=99
TURBOQUANT_ENABLED=true
ROTORQUANT_KV_ENABLED=false
MTP_ENABLED=false
TENSORRT_LLM_ENABLED=false

# Primary chat model: newest legal fine-tune (7 days ago, bb431bb6f7c9)
GEMMA4_MODEL="REPLACE_ME"
# Keep this as fallback only; primary chat/generation lane is llama-server.
OLLAMA_VLM_MODEL="REPLACE_ME"
# Embeddings
OLLAMA_EMBED_MODEL="REPLACE_ME"
# Document extraction (granite-docling pipeline)
GRANITE_DOCLING_MODEL="REPLACE_ME"
GRANITE_DOCLING_ENABLED=true
