# Production Dockerfile with Node.js Pointer Compression (50% Memory Reduction)
# Build: docker build -f Dockerfile.production -t deeds-web-app:latest .
# Run: docker run -p 3000:3000 -e NODE_ENV=production deeds-web-app:latest

# ============================================
# Stage 1: Build (Standard Node.js)
# ============================================
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies first (better layer caching)
COPY package*.json ./
RUN npm ci --only=production --ignore-scripts

# Copy source code
COPY . .

# Build SvelteKit app
RUN npm run build

# Prune dev dependencies
RUN npm prune --production

# ============================================
# Stage 2: Production Runtime (Pointer Compression)
# ============================================
FROM ghcr.io/platformatic/node-caged:22 AS runtime

# Install dumb-init (proper PID 1 process)
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S sveltekit -u 1001

WORKDIR /app

# Copy built artifacts from builder
COPY --from=builder --chown=sveltekit:nodejs /app/build ./build
COPY --from=builder --chown=sveltekit:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=sveltekit:nodejs /app/package.json ./

# Switch to non-root user
USER sveltekit

# Environment variables
ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    # Memory optimization flags
    NODE_OPTIONS="--max-old-space-size=2048 --optimize-for-size --gc-interval=100" \
    # Pointer compression enabled by node-caged base image
    # Security headers
    ORIGIN=http://localhost:3000

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the SvelteKit server
CMD ["node", "build/index.js"]
