{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "svelte",
      "node",
      "@webgpu/types"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.ts",
    "svelte.config.js",
    "vite.config.js"
  ],
  "exclude": [
    // ── Build artifacts ──
    "node_modules",
    "**/node_modules/**",
    "build",
    ".svelte-kit",
    ".svelte-check-tmp/**",
    "../.rag-metrics/**",

    // ── Archives and backups ──
    "archives/**",
    "src/lib/_archive/**",
    "src/archived/**",
    "**/_archive/**",
    "src_fixed/**",
    ".phase72-backups/**",
    ".codemod-backups/**",
    ".svelte5-fix-backups/**",
    "backups/**",
    "agentic-error-resolution/fixed/**",
    "scripts/phase104-backups/**",
    "scripts/backup-consolidation/**",
    "reports/backups-*/**",
    "**/*.*backup*",
    "**/*.*bak*",
    "**/*.corruption-backup",
    "**/*.replaced",
    "src/**/*.bak.*",
    "src/**/_disabled/**",
    "src/**/_yorha_legacy/**",
    "**/*.any-backup",

    // ── Tests and stories ──
    "src/tests/**",
    "src/stories/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.stories.ts",

    // ── Generated / binary code ──
    "src/proto/**",
    "src/**/*.js",
    "src/grpc/**",
    "src/flatbuf/**",
    "src/wasm/**",
    "**/*.worker.ts",
