# Docker Environment Configuration
DOCKER_ENV=true
DOCKER_CONTAINER=true

# Service URLs (Docker Desktop)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CHAT_KEEP_ALIVE=2m
OLLAMA_EMBED_KEEP_ALIVE=24h
TRITON_URL=http://host.docker.internal:8001
REDIS_URL=redis://host.docker.internal:6379
REDIS_PASSWORD=redis
QDRANT_URL=http://host.docker.internal:6333
NEO4J_URL=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
POSTGRES_URL=postgres://postgres:postgres@host.docker.internal:5432/deeds
MINIO_URL=http://host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Feature Flags
OCR_MODE=hybrid
WORKER_PERSIST_DB=true
NEO4J_CREATE_SIMILARITY_LINKS=true
NEO4J_INIT_ON_START=true
ENABLE_WEBGPU=true
ENABLE_CUDA=true
ENABLE_SIMD_JSON=true

# QUIC Runtime
QUIC_ENABLED=true
DEV_QUIC_PORT=5173

# Development
DEV_BYPASS_AUTH=true
NODE_ENV=development
ACE_CHAT_SELF_EVAL_ENABLED=false

# Performance
ENABLE_GPU=true
RTX_3060_OPTIMIZATION=true
CONTEXT7_MULTICORE=true
OLLAMA_GPU_LAYERS=30

# Memory & Cache
MEMORY_CACHE_TTL=3600
VECTOR_CACHE_SIZE=10000

# Security
JWT_SECRET=your-secret-key
API_KEY=your-api-key

# Logging
LOG_LEVEL=info
ENABLE_STRUCTURED_LOGGING=true
