# Development Caddy Configuration
# These wildcard :port listeners are cleartext HTTP; they do not provide HTTP/3/QUIC.

# Development SvelteKit server with relaxed QUIC settings
:5178 {
    # Development CORS headers (permissive for local dev)
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
    header Access-Control-Allow-Credentials "true"

    # Handle preflight requests
    @options {
        method OPTIONS
    }
    handle @options {
        respond 200
    }

    # QUIC Bridge proxy (WebTransport support)
    handle /quic/* {
        reverse_proxy https://localhost:8100 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    # QUIC health check (HTTP fallback)
    handle /quic-health {
        rewrite * /health
        reverse_proxy http://localhost:8101
    }

    # TRACE MCP over Streamable HTTP / JSON-RPC
    handle /mcp* {
        reverse_proxy http://localhost:8788 {
            flush_interval -1
        }
    }

    # Optional direct llama-server lane
    handle_path /llama/* {
        reverse_proxy http://localhost:8090 {
            flush_interval -1
        }
    }

    # SSE / streaming API routes (disable buffering)
    handle /api/cases/*/evidence/jobs/*/events {
        reverse_proxy localhost:5173 {
        }
    }

    handle /api/sse/* {
        reverse_proxy localhost:5173 {
            flush_interval -1
        }
    }

    handle /api/ai/* {
        reverse_proxy localhost:5173 {
            flush_interval -1
        }
    }

    handle /api/*/stream* {
        reverse_proxy localhost:5173 {
            flush_interval -1
        }
    }

    handle /api/synthesis/* {
        reverse_proxy localhost:5173 {
            flush_interval -1
        }
    }

    handle /api/detective/* {
        reverse_proxy localhost:5173 {
            flush_interval -1
        }
    }

    # Auto-generated WebSocket routes from ws-orchestrator are optional.
    # Keep this disabled unless the generated Caddyfile.ws exists.
    # import Caddyfile.ws

    # Reverse proxy to Vite dev server
    reverse_proxy localhost:5173 {
        # Development connection settings (more permissive)
        transport http {
            keepalive 10s
            keepalive_idle_conns 2
        }

        # Pass through dev headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Handle dev server restarts gracefully
        fail_duration 1s
        max_fails 3
    }

    # Basic compression for dev (lighter than production)
    encode gzip

    # Development logging (more verbose)
    log {
        output stdout
        format console
        level DEBUG
    }

}

# Alternative dev server on different port for testing
:5179 {
    header Access-Control-Allow-Origin "*"

    reverse_proxy localhost:5176 {
        fail_duration 1s
    }

    encode gzip
}

