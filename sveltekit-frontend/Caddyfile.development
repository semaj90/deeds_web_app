# Development Redis Insight (no auth for local dev)
:8001 {
    reverse_proxy localhost:8001
}

# Development health check with detailed info
:8082 {
    handle /health {
        respond 200 {
            body `{
                "status": "healthy",
                "environment": "development",
                "service": "legal-ai-platform-dev",
                "protocol": "HTTP (non-TLS)",
                "vite_server": "localhost:5173",
                "caddy_proxy": "localhost:5178",
                "minio": "localhost:9000",
                "timestamp": "{time.now}",
                "version": "dev"
            }`
            close
        }
    }

    handle /dev-info {
        respond 200 {
            body `{
                "development_urls": {
                    "frontend": "http://localhost:5178",
                    "frontend_direct": "http://localhost:5173",
                    "minio_console": "http://localhost:9001",
                    "minio_api": "http://localhost:9000",
                    "redis_insight": "http://localhost:8001",
                    "health": "http://localhost:8082/health"
                },
                "quic_enabled": false,
                "cors_enabled": true,
                "logging": "verbose"
            }`
            close
        }
    }

    # Default health response for dev
    respond "HTTP Development Server Ready" 200
}

# WebSocket proxy for HMR (Hot Module Replacement)
:24678 {
    reverse_proxy localhost:24678 {
        # WebSocket-specific settings
        header_up Upgrade {>Upgrade}
        header_up Connection {>Connection}
    }
}
