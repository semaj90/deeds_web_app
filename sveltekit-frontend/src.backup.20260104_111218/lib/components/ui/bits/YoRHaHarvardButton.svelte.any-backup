  .loading-spinner { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 16px; height: 16px;border: 2px solid transparent; border-top: 2px solid var(--enhanced-accent); border-radius: 50%; animation: spin 1s linear infinite}
  .pixelated { image-rendering: -moz-crisp-edges; image-rendering: -webkit-crisp-edges; image-rendering: pixelated; image-rendering: crisp-edges}
