  @keyframes spin { 0% { transform: translate(-50%, -50%) rotate(0deg)}
    100% { transform: translate(-50%, -50%) rotate(360deg)}
  } @keyframes badge-shine { 0% { left: -100%}
    100% { left: 100%}
  }
