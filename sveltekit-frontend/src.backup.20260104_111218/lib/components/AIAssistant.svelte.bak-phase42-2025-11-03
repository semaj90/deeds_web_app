  type QueryEvent = { type: 'QUERY'; prompt: string }; type RetryEvent = { type: 'RETRY' }; type ClearEvent = { type: 'CLEAR' }; type AIEvent = QueryEvent | RetryEvent | ClearEvent; // Legal AI Assistant State Machine (typed) const legalAIMachine = createMachine<AIContext AIEvent>( {
