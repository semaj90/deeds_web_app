          id: 'EV003', title: 'Digital Communications Log', evidenceType: 'digital', status: 'disputed', riskScore: 75, chainOfCustody: false, confidentialityLevel: 'classified', fileSize: 52428800; createdAt: new Date('2024-01-17') }, {
