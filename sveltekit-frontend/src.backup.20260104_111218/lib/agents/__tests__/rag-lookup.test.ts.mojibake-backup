/**
 * Phase 13: Property-Based Tests for RAG Lookup Tool
 * Feature: phase-13-agentic-tool-calling, Property 6: RAG Search Results
 * Validates: Requirements 6.2, 6.3
 */

import { describe, it, expect, beforeEach, vi } from 'vitest';
import { toolRegistry } from '../tools';
import type { RagLookupResult } from '../types';

describe('RAG Lookup Tool - Property 6: RAG Search Results', () => {
  beforeEach(() => {
    // Mock environment variables
    process.env.QDRANT_URL = 'http://localhost:6333';
    process.env.QDRANT_COLLECTION = 'test_collection';
    process.env.REDIS_ENDPOINT = 'http://localhost:6379';
  });

  /**
   * Property 6: RAG Search Results
   * For any query, the RAG lookup SHALL return results ranked by similarity score in descending order.
   * Validates: Requirements 6.2, 6.3
   */
  describe('Property 6: Results ranked by similarity score', () => {
    it('should return results sorted by similarity score in descending order', async () => {
      // Mock Ollama embedding generation
      global.fetch = vi.fn((url: string, options?: any) => {
        if (url.includes('/api/embed')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                embedding: Array(384).fill(0.5),
              }),
          } as Response);
        }

        // Mock Qdrant search response with multiple results
        if (url.includes('/points/search')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                result: [
                  { score: 0.95, payload: { id: 1, content: 'High relevance' } },
                  { score: 0.87, payload: { id: 2, content: 'Medium relevance' } },
                  { score: 0.72, payload: { id: 3, content: 'Low relevance' } },
                ],
              }),
          } as Response);
        }

        return Promise.reject(new Error('Unexpected fetch'));
      });

      const result = (await toolRegistry.rag_lookup({
        query: 'test query',
        topK: 3,
      })) as RagLookupResult;

      // Verify results are sorted by score descending
      expect(result.matches).toHaveLength(3);
      expect(result.matches[0].score).toBe(0.95);
      expect(result.matches[1].score).toBe(0.87);
      expect(result.matches[2].score).toBe(0.72);

      // Verify descending order property
      for (let i = 0; i < result.matches.length - 1; i++) {
        expect(result.matches[i].score).toBeGreaterThanOrEqual(result.matches[i + 1].score);
      }
    });

    it('should handle empty results gracefully', async () => {
      global.fetch = vi.fn((url: string) => {
        if (url.includes('/api/embed')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                embedding: Array(384).fill(0.5),
              }),
          } as Response);
        }

        if (url.includes('/points/search')) {
          return Promise.resolve({
            ok: true,
            json: () => Promise.resolve({ result: [] }),
          } as Response);
        }

        return Promise.reject(new Error('Unexpected fetch'));
      });

      const result = (await toolRegistry.rag_lookup({
        query: 'no results query',
        topK: 5,
      })) as RagLookupResult;

      expect(result.matches).toHaveLength(0);
      expect(result.summary).toContain('Retrieved 0');
    });

    it('should respect topK parameter for result limiting', async () => {
      global.fetch = vi.fn((url: string, options?: any) => {
        if (url.includes('/api/embed')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                embedding: Array(384).fill(0.5),
              }),
          } as Response);
        }

        if (url.includes('/points/search')) {
          const body = JSON.parse(options?.body || '{}');
          const limit = body.limit || 5;

          // Return exactly limit results
          const results = Array.from({ length: limit }, (_, i) => ({
            score: 1.0 - i * 0.1,
            payload: { id: i, content: `Result ${i}` },
          }));

          return Promise.resolve({
            ok: true,
            json: () => Promise.resolve({ result: results }),
          } as Response);
        }

        return Promise.reject(new Error('Unexpected fetch'));
      });

      // Test with topK = 3
      const result3 = (await toolRegistry.rag_lookup({
        query: 'test',
        topK: 3,
      })) as RagLookupResult;

      expect(result3.matches).toHaveLength(3);

      // Test with topK = 10
      const result10 = (await toolRegistry.rag_lookup({
        query: 'test',
        topK: 10,
      })) as RagLookupResult;

      expect(result10.matches).toHaveLength(10);
    });

    it('should maintain score ordering across multiple queries', async () => {
      const queries = ['query1', 'query2', 'query3'];

      global.fetch = vi.fn((url: string, options?: any) => {
        if (url.includes('/api/embed')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                embedding: Array(384).fill(0.5),
              }),
          } as Response);
        }

        if (url.includes('/points/search')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                result: [
                  { score: 0.9, payload: { id: 1 } },
                  { score: 0.8, payload: { id: 2 } },
                  { score: 0.7, payload: { id: 3 } },
                ],
              }),
          } as Response);
        }

        return Promise.reject(new Error('Unexpected fetch'));
      });

      for (const query of queries) {
        const result = (await toolRegistry.rag_lookup({
          query,
          topK: 3,
        })) as RagLookupResult;

        // Verify ordering for each query
        for (let i = 0; i < result.matches.length - 1; i++) {
          expect(result.matches[i].score).toBeGreaterThanOrEqual(result.matches[i + 1].score);
        }
      }
    });

    it('should handle Qdrant errors gracefully', async () => {
      global.fetch = vi.fn((url: string) => {
        if (url.includes('/api/embed')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                embedding: Array(384).fill(0.5),
              }),
          } as Response);
        }

        if (url.includes('/points/search')) {
          return Promise.resolve({
            ok: false,
            status: 500,
            statusText: 'Internal Server Error',
          } as Response);
        }

        return Promise.reject(new Error('Unexpected fetch'));
      });

      const result = (await toolRegistry.rag_lookup({
        query: 'test',
        topK: 5,
      })) as RagLookupResult;

      // Should return graceful error response
      expect(result.matches).toHaveLength(0);
      expect(result.summary).toContain('Error');
    });

    it('should validate query is non-empty', async () => {
      const result = (await toolRegistry.rag_lookup({
        query: '',
        topK: 5,
      })) as RagLookupResult;

      expect(result.matches).toHaveLength(0);
      expect(result.summary).toContain('Error');
    });

    it('should use default topK of 5 when not specified', async () => {
      let capturedLimit = 0;

      global.fetch = vi.fn((url: string, options?: any) => {
        if (url.includes('/api/embed')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                embedding: Array(384).fill(0.5),
              }),
          } as Response);
        }

        if (url.includes('/points/search')) {
          const body = JSON.parse(options?.body || '{}');
          capturedLimit = body.limit;

          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                result: Array.from({ length: capturedLimit }, (_, i) => ({
                  score: 1.0 - i * 0.1,
                  payload: { id: i },
                })),
              }),
          } as Response);
        }

        return Promise.reject(new Error('Unexpected fetch'));
      });

      await toolRegistry.rag_lookup({ query: 'test' });

      expect(capturedLimit).toBe(5);
    });

    it('should include payload data in results', async () => {
      global.fetch = vi.fn((url: string) => {
        if (url.includes('/api/embed')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                embedding: Array(384).fill(0.5),
              }),
          } as Response);
        }

        if (url.includes('/points/search')) {
          return Promise.resolve({
            ok: true,
            json: () =>
              Promise.resolve({
                result: [
                  {
                    score: 0.95,
                    payload: {
                      id: 1,
                      content: 'Test content',
                      tags: ['tag1', 'tag2'],
                      timestamp: 1234567890,
                    },
                  },
                ],
              }),
          } as Response);
        }

        return Promise.reject(new Error('Unexpected fetch'));
      });

      const result = (await toolRegistry.rag_lookup({
        query: 'test',
        topK: 1,
      })) as RagLookupResult;

      expect(result.matches[0]).toHaveProperty('score', 0.95);
      expect(result.matches[0]).toHaveProperty('id', 1);
      expect(result.matches[0]).toHaveProperty('content', 'Test content');
      expect(result.matches[0]).toHaveProperty('tags');
      expect(result.matches[0]).toHaveProperty('timestamp');
    });
  });
});
