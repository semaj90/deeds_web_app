/**
 * Hybrid Theme: Enhanced-Bits + UnoCSS + NES.css + N64 Gaming
 * 90% regular DOM, 10% canvas for glyph-heavy processes
 */

/* Base Enhanced-Bits + NES.css theme */
@import 'nes.css/css/nes.min.css';

/* Enhanced-Bits N64 color palette */
:root {
  /* N64 inspired colors */
  --n64-blue: #0066cc;
  --n64-red: #cc0000;
  --n64-green: #00cc66;
  --n64-yellow: #cccc00;

  /* YoRHa inspired */
  --yorha-white: #d4c5b0;
  --yorha-black: #454138;
  --yorha-gold: #cd9a5b;

  /* NES.css overrides for legal AI */
  --nes-primary: var(--n64-blue);
  --nes-success: var(--n64-green);
  --nes-warning: var(--n64-yellow);
  --nes-error: var(--n64-red);

  --yorha-accent: #00ff41;
  --yorha-muted: #9ca3af;
  --yorha-success: #16a34a;
  --yorha-warning: #f59e0b;
  --yorha-error: #ef4444;
  --yorha-bg-elevated: rgba(255, 255, 255, 0.03);
}

/* Minimal global reset and utilities used by pages */
html,
body {
  height: 100%;
  margin: 0;
  padding: 0;
  background: var(--yorha-black);
  color: var(--yorha-white);
  font-family:
    Inter,
    system-ui,
    -apple-system,
    'Segoe UI',
    Roboto,
    'Helvetica Neue',
    Arial;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Lightweight container used by existing components */
.nes-container {
  background: var(--yorha-bg-elevated);
  border-radius: 6px;
  padding: 12px;
  box-sizing: border-box;
}

/* Small helpers */
.text-muted {
  color: var(--yorha-muted);
}
.text-accent {
  color: var(--yorha-accent);
}
.bg-accent {
  background-color: var(--yorha-accent);
  color: #000;
}

/* Enhanced-Bits Legal UI Components */
.enhanced-bits-card {
  /* Replaced `@apply nes-container is-dark;` with explicit rules
     to avoid unknown @apply at-rule and keep the nes-container look. */
  background: linear-gradient(135deg, var(--yorha-black), #2a2a2a);
  border-radius: 6px;
  padding: 12px;
  box-sizing: border-box;
  border: 2px solid var(--yorha-gold);
  /* is-dark feel */
  color: var(--yorha-white);
  /* subtle inner shadow like a dark container */
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
}

/* Minimal nes-btn approximation for enhanced buttons */
.enhanced-bits-button {
  /* Replaced `@apply nes-btn;` with compact styles */
  display: inline-block;
  padding: 0.5rem 0.75rem;
  border-radius: 4px;
  border: 2px solid var(--nes-primary, var(--n64-blue));
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(0, 0, 0, 0.08));
  color: var(--yorha-white);
  font-family: 'Courier New', monospace;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
  text-decoration: none;
  line-height: 1;
}

/* Minimal nes-input approximation for enhanced inputs */
.enhanced-bits-input {
  /* Replaced `@apply nes-input;` with compact rules */
  display: inline-block;
  padding: 0.5rem 0.6rem;
  border-radius: 4px;
  border: 2px solid var(--yorha-gold);
  background: var(--yorha-black);
  color: var(--yorha-white);
  box-sizing: border-box;
  outline: none;
}

/* Gaming Canvas Integration */
.glyph-engine-container {
  position: relative;
  background: var(--yorha-black);
  border: 2px solid var(--n64-blue);
  border-radius: 0; /* NES.css style */
}

.glyph-engine-canvas {
  image-rendering: pixelated; /* N64 style */
  image-rendering: -moz-crisp-edges;
  image-rendering: crisp-edges;
  background: transparent;
}

/* Accessibility for canvas elements */
.glyph-engine-container[role='application']:focus-visible {
  outline: 2px solid var(--yorha-gold);
}

/* Legal document specific styling */
.legal-evidence-card {
  /* mirror enhanced-bits-card rules (kept concise) */
  background: linear-gradient(135deg, var(--yorha-black), #2a2a2a);
  border-radius: 6px;
  padding: 12px;
  box-sizing: border-box;
  border: 2px solid var(--yorha-gold);
  color: var(--yorha-white);
  border-left: 4px solid var(--n64-green);
}

.legal-case-priority-critical {
  border-color: var(--n64-red) !important;
  box-shadow: 0 0 10px rgba(204, 0, 0, 0.3);
}

.legal-case-priority-high {
  border-color: var(--n64-yellow) !important;
}

.legal-case-priority-medium {
  border-color: var(--n64-blue) !important;
}

.legal-case-priority-low {
  border-color: var(--n64-green) !important;
}

/* N64 texture-style backgrounds for special areas */
.texture-background {
  background-image: repeating-linear-gradient(
    45deg,
    var(--yorha-black),
    var(--yorha-black) 2px,
    transparent 2px,
    transparent 4px
  );
}

/* Responsive design for both regular and canvas components */
@media (max-width: 768px) {
  .glyph-engine-canvas.enhanced-bits-card {
    margin: 0.5rem;
    padding: 1rem;
  }
}

/* Animation utilities for gaming feel */
.gaming-transition {
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.gaming-hover:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}
