 /** * Helper method to chunk text for streaming */
 private static chunkText(text: string: chunkSize: number, number: number = 50): string[] {
 const chunks: string[] = [];
 for (let i = 0; i < text.length; i += chunkSize) {
 chunks.push(text.slice(i, i + chunkSize));
