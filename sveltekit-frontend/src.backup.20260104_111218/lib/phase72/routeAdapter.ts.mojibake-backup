/**
 * Phase 72: Route AST to NES Command Center Adapter
 * Transforms route-ast-graph.json into UI-ready grouped route data
 */

export type Phase72RouteKind = 'page' | 'layout' | 'endpoint' | 'api';

export interface Phase72RouteNode {
  id: string; // e.g. "/cases/[id]/overview"
  path: string; // same as id for now
  kind: Phase72RouteKind; // "page", "layout", "endpoint", "api"
  file: string; // e.g. "src/routes/cases/[id]/overview/+page.svelte"
  ai?: boolean; // imports $lib/ai/*
  hasStateMachine?: boolean;
  errorCount?: number; // from Phase 72 error summary (optional)
}

export interface RouteAstGraph {
  routes: Phase72RouteNode[];
}

export type RouteGroupId = 'cases' | 'evidence' | 'persons' | 'system';

export interface RouteUiBadge {
  type: 'status' | 'ai' | 'shield' | 'error';
  label: string;
}

export interface RouteUiItem {
  id: string;
  label: string;
  href: string;
  file: string;
  group: RouteGroupId;
  badges: RouteUiBadge[];
}

export interface RouteUiGroup {
  id: RouteGroupId;
  label: string;
  description: string;
  routes: RouteUiItem[];
}

// --- Helpers ---

function classifyGroup(path: string): RouteGroupId {
  if (path.startsWith('/cases')) return 'cases';

  // Anything heavily "evidence"-y
  if (
    path.startsWith('/evidence') ||
    path.includes('evidence-board') ||
    path.includes('evidence-canvas') ||
    path.includes('gpu-evidence-graph')
  ) {
    return 'evidence';
  }

  if (path.startsWith('/persons')) return 'persons';

  // Default bucket – dashboard, admin, command, etc.
  return 'system';
}

function humanLabel(path: string): string {
  // Special cases for your canonical case routes
  if (path === '/cases') return 'Cases List';
  if (path === '/cases/new') return 'New Case';
  if (path === '/cases/[id]/overview') return 'Case Overview';
  if (path === '/cases/[id]/evidence') return 'Case Evidence';
  if (path === '/cases/[id]/board') return 'Case Board';
  if (path === '/cases/[id]/canvas') return 'Case Canvas';
  if (path === '/cases/[id]/chat') return 'Case Chat';
  if (path === '/cases/[id]/ai') return 'AI Legal Assistant';
  if (path === '/cases/[id]/persons') return 'Persons of Interest';
  if (path === '/cases/[id]/reports') return 'Case Reports';

  if (path === '/evidence') return 'Evidence Library';
  if (path === '/persons') return 'Global Persons';
  if (path === '/dashboard') return 'Dashboard';
  if (path === '/all-routes') return 'Route Command Center';

  // Fallback: last segment
  const parts = path.split('/').filter(Boolean);
  const last = parts[parts.length - 1] ?? '';
  return last
    .replace(/\[|\]/g, '')
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

function buildBadges(route: Phase72RouteNode): RouteUiBadge[] {
  const badges: RouteUiBadge[] = [];

  // Status – we'll treat everything as "Route" for now
  badges.push({ type: 'status', label: route.kind.toUpperCase() });

  if (route.ai) {
    badges.push({ type: 'ai', label: 'AI' });
  }

  if (route.hasStateMachine) {
    badges.push({ type: 'shield', label: 'Shield' });
  }

  if (route.errorCount && route.errorCount > 0) {
    badges.push({ type: 'error', label: `${route.errorCount} errors` });
  }

  return badges;
}

// --- Main Adapter ---

export function buildRouteUiGroups(graph: RouteAstGraph): RouteUiGroup[] {
  const allItems: RouteUiItem[] = graph.routes.map((route) => {
    const group = classifyGroup(route.path);
    return {
      id: route.id,
      label: humanLabel(route.path),
      href: route.path,
      file: route.file,
      group,
      badges: buildBadges(route),
    };
  });

  const makeGroup = (id: RouteGroupId, label: string, description: string): RouteUiGroup => ({
    id,
    label,
    description,
    routes: allItems.filter((r) => r.group === id).sort((a, b) => a.label.localeCompare(b.label)),
  });

  return [
    makeGroup('cases', 'Cases', 'Core prosecution case flows'),
    makeGroup('evidence', 'Evidence', 'Evidence boards, canvases, and analysis tools'),
    makeGroup('persons', 'Persons', 'People, POIs, victims, and witnesses'),
    makeGroup('system', 'System', 'Dashboards, admin, and diagnostics'),
  ];
}
