// Minimal in-memory Redis to satisfy this endpoint during dev/testing
class InMemoryRedis implements RedisClientLike {
    private kv = new Map<string, string>();
    private hashes = new Map<string, Record<string, string>>();
    public status = 'ready';

    async get(key: string): Promise<string | null> {
        return this.kv.get(key) ?? null;
    }
    async setex(key: string, _seconds: number, value: string): Promise<void> {
        this.kv.set(key, value);
    }
    async hset(key: string, obj: Record<string, unknown>): Promise<void> {
        const asRecord: Record<string, string> = {};
        Object.keys(obj).forEach(k => { asRecord[k] = String(obj[k]); });
        this.hashes.set(key, asRecord);
    }
    async hgetall(key: string): Promise<Record<string, string>> {
        return this.hashes.get(key) ?? {};
    }
}

function createRedisInstance(): RedisClientLike {
    return new InMemoryRedis();
}

