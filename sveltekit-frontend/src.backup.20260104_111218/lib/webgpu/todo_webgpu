// Optional amqp for message queue integration (keeps previous logic but typed)
async function getRabbitChannel(): Promise<AmqpChannel | null> {
    if (!rabbitChannel) {
        try {
            // dynamic import; if amqplib isn't installed this will simply not enable RabbitMQ
            // keep the try/catch so runtime is resilient
            // eslint-disable-next-line @typescript-eslint/no-var-requires
            const amqp = await import('amqplib').catch(() => null);
            if (amqp) {
                const connection = await amqp.connect(process.env.RABBITMQ_URL || 'amqp://localhost');
                const ch = await connection.createChannel();
                await ch.assertExchange('ai_jobs', 'topic', { durable: true });
                await ch.assertQueue('intelligent_todo_queue', { durable: true });
                await ch.bindQueue('intelligent_todo_queue', 'ai_jobs', 'todo.generate.npm');
                rabbitChannel = { publish: (exchange: string, routingKey: string, content: Buffer, options?: any) => ch.publish(exchange, routingKey, content, options) };
                console.log('[RabbitMQ] Connection and channel established for Intelligent Todo jobs.');
            }
        } catch (err) {
            console.warn('RabbitMQ not available, job processing will be simulated in-process:', err);
        }
    }
    return rabbitChannel;
}

