// --- Caching and Compression Utilities ---

function generateCacheKey(errorText: string): string {
    const hash = createHash('sha256');
    hash.update(errorText); // Key is based purely on the error content
    return `npm-todo:${hash.digest('hex').substring(0, 16)}`;
}

function compressData(data: unknown): string {
    const jsonString = JSON.stringify(data);
    const compressed = pako.gzip(jsonString) as Uint8Array;
    return Buffer.from(compressed).toString('base64');
}

function decompressData(base64String: string): unknown {
    const buffer = Buffer.from(base64String, 'base64');
    const decompressed = pako.ungzip(buffer, { to: 'string' }) as string;
    return JSON.parse(decompressed);
}

// --- Core RAG Pipeline (to be executed by a worker) ---

async function runRAGPipelineForError(error: NPMError): Promise<Omit<IntelligentTodo, 'processingTime'>> {
    // 2. EMBED (Triton Server)
    const errorEmbedding = await tritonClient.getEmbedding(error.errorText);

    // 3. RETRIEVE (Qdrant Vector DB)
    const similarErrorVectors = await qdrantClient.search('npm_errors', {
        vector: errorEmbedding,
        limit: 3,
    });
    const similarErrorIds = similarErrorVectors.map((v: { id: number }) => v.id);

    // 4. AUGMENT (PostgreSQL via Drizzle)
    let contextText = 'No similar errors found in the database.';
    if (similarErrorIds.length > 0) {
        const similarSolutions = await db.select()
            .from(solvedErrors)
            .where(inArray(solvedErrors.id, similarErrorIds));

        const typedSolutions = (similarSolutions as Array<{ rawErrorText?: string; solutionText?: string }>) ?? [];

        contextText = typedSolutions
            .map((s) => `SIMILAR ERROR:\n${s.rawErrorText}\nSOLUTION:\n${s.solutionText}`)
            .join('\n\n---\n\n');
    }

    // 5. GENERATE (Triton Server with Fine-Tuned Gemma)
    const finalPrompt = `You are an expert software engineer. A user has an NPM error. Based on the error and context from similar past solutions, generate a step-by-step todo list to resolve it.\n\n---ERROR---\n${error.errorText}\n\n---CONTEXT---\n${contextText}\n\n---SOLUTION STEPS---`;
    const generatedSolution = await tritonClient.generateText(finalPrompt);

    return {
        errorId: error.id,
        originalError: error.errorText,
        suggestedSteps: generatedSolution.split('\n').filter((step: string) => step.trim().length > 0 && !step.startsWith('---')),
        contextUsed: similarErrorIds.length,
    };
}

// --- Main POST Handler (Job Creation) ---

const originalPOSTHandler: RequestHandler = async ({ request }) => {
    try {
        const body: IntelligentTodoRequest = await request.json();
        const { errors, useCache = true } = body;

        if (!errors || !Array.isArray(errors) || errors.length === 0) {
            return json({ error: 'Request body must be a non-empty array of NPMError objects.' }, { status: 400 });
        }

        const jobs = await Promise.all(errors.map(async (error) => {
            const jobId = generateCacheKey(error.errorText);
            const startTime = Date.now();

            if (useCache) {
                const cachedResult = await redis.get(`job:result:${jobId}`);
                if (cachedResult) {
                    console.log(`[Intelligent Todo] Cache HIT for job: ${jobId}. Returning job ID.`);
                    return { errorId: error.id, jobId, status: 'completed' };
                }
            }

            const jobPayload = { error, jobId, startTime };
            const channel = await getRabbitChannel();

            if (channel && channel.publish) {
                // Production: Enqueue the job in RabbitMQ for a separate worker to process.
                channel.publish('ai_jobs', 'todo.generate.npm', Buffer.from(JSON.stringify(jobPayload)));
            } else {
                // Development/Fallback: Process the job immediately (asynchronously) without a queue.
                console.warn(`Processing job ${jobId} in-process due to missing RabbitMQ connection.`);
                runRAGPipelineForError(error).then((result) => {
                    const processingTime = Date.now() - startTime;
                    const finalResult: IntelligentTodo = { ...result, processingTime };
                    redis.setex(`job:result:${jobId}`, 3600, compressData(finalResult)); // Cache for 1 hour
                }).catch((err: Error) => {
                    console.error(`In-process job ${jobId} failed:`, err);
                    redis.setex(`job:error:${jobId}`, 3600, JSON.stringify({ message: err.message }));
                });
            }

            await redis.hset(`job:status:${jobId}`, { status: 'queued', queuedAt: Date.now() });

            return { errorId: error.id, jobId, status: 'queued' };
        }));

        return json({ jobs });

    } catch (error: unknown) {
        const e = error as Error;
        console.error('[Intelligent Todo API] Error creating jobs:', e);
        return json({ error: 'Failed to create intelligent todo generation jobs', details: e.message }, { status: 500 });
    }
};

// --- Health Check & Job Status GET Handler ---

const originalGETHandler: RequestHandler = async ({ url }) => {
    const jobIdsParam = url.searchParams.get('jobIds');

    if (jobIdsParam) {
        // --- Job Status Polling Logic ---
        const jobIds = jobIdsParam.split(',');
        const results = await Promise.all(jobIds.map(async (jobId: string) => {
            const resultData = await redis.get(`job:result:${jobId}`);
            if (resultData) {
                return { jobId, status: 'completed', data: decompressData(resultData) };
            }
            const errorData = await redis.get(`job:error:${jobId}`);
            if (errorData) {
                return { jobId, status: 'failed', error: JSON.parse(errorData) };
            }
            const statusData = await redis.hgetall(`job:status:${jobId}`);
            if (statusData && (statusData as Record<string, string>).status) {
                return { jobId, status: (statusData as Record<string, string>).status };
            }
            return { jobId, status: 'not_found' };
        }));
        return json({ results });
    } else {
        // --- System Health Check Logic ---
        const healthStatus = {
            status: 'healthy',
            timestamp: new Date().toISOString(),
            components: {
                tritonServer: 'ok', // Placeholder
                qdrantDatabase: 'ok', // Placeholder
                postgresDatabase: 'ok', // Placeholder
                // use typed access instead of (redis as any)
                redisCache: redis.status === 'ready' ? 'ok' : 'degraded',
                rabbitMQ: rabbitChannel ? 'ok' : 'unavailable',
            },
        };
        return json(healthStatus);
    }
};

