import type { QuantizedEmbedding } from '$lib/shared/embedding-types';

export interface SimilarityResult {
  index: number;
  score: number;
}

export interface WebGPUSimilarityConfig {
  workgroupSize: number;
  maxBatchSize: number;
  enableProfiling: boolean;
}

/**
 * WebGPU Similarity Engine for fast cosine similarity computation
 * Uses quantized embeddings (Uint8Array) for efficient GPU processing
 */
export class WebGPUSimilarityEngine {
  private device: GPUDevice | null = null;
  private pipeline: GPUComputePipeline | null = null;
  private bindGroupLayout: GPUBindGroupLayout | null = null;
  private config: WebGPUSimilarityConfig;

  constructor(config: Partial<WebGPUSimilarityConfig> = {}) {
    this.config = {
      workgroupSize: 256,
      maxBatchSize: 1024,
      enableProfiling: false,
      ...config,
    };
  }

  /**
   * Initialize WebGPU device and pipeline
   */
  async initialize(): Promise<void> {
    if (!navigator.gpu) {
      throw new Error('WebGPU not supported');
    }

    const adapter = await navigator.gpu.requestAdapter();
    if (!adapter) {
      throw new Error('No WebGPU adapter found');
    }

    this.device = await adapter.requestDevice();

    // Create bind group layout
    this.bindGroupLayout = this.device.createBindGroupLayout({
      entries: [
        // Query embedding buffer
        {
          binding: 0,
          visibility: GPUShaderStage.COMPUTE,
          buffer: { type: 'read-only-storage' },
        },
        // Document embeddings buffer
        {
          binding: 1,
          visibility: GPUShaderStage.COMPUTE,
          buffer: { type: 'read-only-storage' },
        },
        // Scale/offset buffer for dequantization
        {
          binding: 2,
          visibility: GPUShaderStage.COMPUTE,
          buffer: { type: 'read-only-storage' },
        },
        // Output similarity scores buffer
        {
          binding: 3,
          visibility: GPUShaderStage.COMPUTE,
          buffer: { type: 'storage' },
        },
      ],
    });

    // Create pipeline
    const shaderModule = this.device.createShaderModule({
      code: this.getSimilarityShader(),
    });

    this.pipeline = this.device.createComputePipeline({
      layout: this.device.createPipelineLayout({
        bindGroupLayouts: [this.bindGroupLayout],
      }),
      compute: {
        module: shaderModule,
        entryPoint: 'computeSimilarity',
      },
    });
  }

  /**
   * Compute cosine similarity between query and multiple documents using WebGPU
   */
  async computeSimilarityBatch(
    queryEmbedding: QuantizedEmbedding,
    documentEmbeddings: QuantizedEmbedding[],
    topK: number = 10
  ): Promise<SimilarityResult[]> {
    if (!this.device || !this.pipeline || !this.bindGroupLayout) {
      throw new Error('WebGPU not initialized');
    }

    const startTime = performance.now();

    const numDocs = documentEmbeddings.length;
    const embeddingSize = queryEmbedding.data.length;

    // Validate all embeddings have same size
    for (const doc of documentEmbeddings) {
      if (doc.data.length !== embeddingSize) {
        throw new Error('All embeddings must have the same dimensions');
      }
    }

    // Create GPU buffers
    const queryBuffer = this.device.createBuffer({
      size: queryEmbedding.data.byteLength,
      usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST,
      mappedAtCreation: true,
    });
    new Uint8Array(queryBuffer.getMappedRange()).set(queryEmbedding.data);
    queryBuffer.unmap();

    // Pack all document embeddings into a single buffer
    const docsBufferSize = numDocs * embeddingSize;
    const docsBuffer = this.device.createBuffer({
      size: docsBufferSize,
      usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST,
      mappedAtCreation: true,
    });
    const docsView = new Uint8Array(docsBuffer.getMappedRange());
    for (let i = 0; i < numDocs; i++) {
      docsView.set(documentEmbeddings[i].data, i * embeddingSize);
    }
    docsBuffer.unmap();

    // Create scale/offset buffer (query_scale, query_offset, doc_scales..., doc_offsets...)
    const scaleOffsetBuffer = this.device.createBuffer({
      size: (2 + numDocs * 2) * 4, // 4 bytes per float32
      usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST,
      mappedAtCreation: true,
    });
    const scaleOffsetView = new Float32Array(scaleOffsetBuffer.getMappedRange());
    scaleOffsetView[0] = queryEmbedding.scale;
    scaleOffsetView[1] = queryEmbedding.offset;
    for (let i = 0; i < numDocs; i++) {
      scaleOffsetView[2 + i * 2] = documentEmbeddings[i].scale;
      scaleOffsetView[2 + i * 2 + 1] = documentEmbeddings[i].offset;
    }
    scaleOffsetBuffer.unmap();

    // Output buffer for similarity scores
    const outputBuffer = this.device.createBuffer({
      size: numDocs * 4, // float32 per document
      usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_SRC,
    });

    // Create bind group
    const bindGroup = this.device.createBindGroup({
      layout: this.bindGroupLayout,
      entries: [
        { binding: 0, resource: { buffer: queryBuffer } },
        { binding: 1, resource: { buffer: docsBuffer } },
        { binding: 2, resource: { buffer: scaleOffsetBuffer } },
        { binding: 3, resource: { buffer: outputBuffer } },
      ],
    });

    // Execute compute shader
    const commandEncoder = this.device.createCommandEncoder();
    const passEncoder = commandEncoder.beginComputePass();

    passEncoder.setPipeline(this.pipeline);
    passEncoder.setBindGroup(0, bindGroup);

    // Dispatch workgroups (one per document)
    const workgroupsX = Math.ceil(numDocs / this.config.workgroupSize);
    passEncoder.dispatchWorkgroups(workgroupsX, 1, 1);

    passEncoder.end();

    // Copy results back to CPU
    const stagingBuffer = this.device.createBuffer({
      size: numDocs * 4,
      usage: GPUBufferUsage.COPY_DST | GPUBufferUsage.MAP_READ,
    });

    commandEncoder.copyBufferToBuffer(outputBuffer, 0, stagingBuffer, 0, numDocs * 4);

    this.device.queue.submit([commandEncoder.finish()]);

    // Read results
    await stagingBuffer.mapAsync(GPUMapMode.READ);
    const results = new Float32Array(stagingBuffer.getMappedRange());

    // Clean up
    queryBuffer.destroy();
    docsBuffer.destroy();
    scaleOffsetBuffer.destroy();
    outputBuffer.destroy();
    stagingBuffer.destroy();

    // Convert to SimilarityResult array and sort by score
    const similarityResults: SimilarityResult[] = [];
    for (let i = 0; i < numDocs; i++) {
      similarityResults.push({
        index: i,
        score: results[i],
      });
    }

    similarityResults.sort((a, b) => b.score - a.score);

    if (this.config.enableProfiling) {
      console.log(
        `[WebGPU] Similarity computation: ${performance.now() - startTime}ms for ${numDocs} documents`
      );
    }

    return similarityResults.slice(0, topK);
  }

  /**
   * WebGPU compute shader for cosine similarity
   */
  private getSimilarityShader(): string {
    return `
 struct Params {
 queryScale: f32,
 queryOffset: f32,
 docScales: array<f32>,
 docOffsets: array<f32>,
 };

 @group(0) @binding(0) var<storage, read> queryEmbedding: array<u32>; // Uint8 as u32
 @group(0) @binding(1) var<storage, read> docEmbeddings: array<u32>; // Packed document embeddings
 @group(0) @binding(2) var<storage, read> params: Params;
 @group(0) @binding(3) var<storage, read_write> output: array<f32>;

 @compute @workgroup_size(256)
 fn computeSimilarity(@builtin(global_invocation_id) globalId: vec3<u32>) {
 let docIndex = globalId.x;
 let embeddingSize = arrayLength(&queryEmbedding);

 if (docIndex >= arrayLength(&output)) {
 return;
 }

 // Dequantize query embedding
 var queryVec: array<f32, 384>; // Assume 384 dimensions
 var queryNorm: f32 = 0.0;

 for (var i: u32 = 0; i < embeddingSize; i++) {
 let quantized = f32(queryEmbedding[i]);
 let dequantized = (quantized / 255.0) * params.queryScale + params.queryOffset;
 queryVec[i] = dequantized;
 queryNorm += dequantized * dequantized;
 }
 queryNorm = sqrt(queryNorm);

 // Dequantize document embedding
 var docVec: array<f32, 384>;
 var docNorm: f32 = 0.0;
 let docScale = params.docScales[docIndex];
 let docOffset = params.docOffsets[docIndex];

 for (var i: u32 = 0; i < embeddingSize; i++) {
 let quantized = f32(docEmbeddings[docIndex * embeddingSize + i]);
 let dequantized = (quantized / 255.0) * docScale + docOffset;
 docVec[i] = dequantized;
 docNorm += dequantized * dequantized;
 }
 docNorm = sqrt(docNorm);

 // Compute cosine similarity
 var dotProduct: f32 = 0.0;
 for (var i: u32 = 0; i < embeddingSize; i++) {
 dotProduct += queryVec[i] * docVec[i];
 }

 let similarity = dotProduct / (queryNorm * docNorm);
 output[docIndex] = similarity;
 }
 `;
  }

  /**
   * Check if WebGPU is supported
   */
  static async isSupported(): Promise<boolean> {
    try {
      if (!navigator.gpu) return false;
      const adapter = await navigator.gpu.requestAdapter();
      return adapter !== null;
    } catch {
      return false;
    }
  }

  /**
   * Get GPU adapter info
   */
  static async getAdapterInfo(): Promise<GPUAdapterInfo | null> {
    try {
      const adapter = await navigator.gpu.requestAdapter();
      return adapter?.info || null;
    } catch {
      return null;
    }
  }

  /**
   * Cleanup resources
   */
  destroy(): void {
    this.device?.destroy();
    this.device = null;
    this.pipeline = null;
    this.bindGroupLayout = null;
  }
}
