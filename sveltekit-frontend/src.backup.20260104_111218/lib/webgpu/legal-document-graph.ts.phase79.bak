// @ts-nocheck - Complex experimental service with external dependencies /** * Legal Document Graph Visualization - WebGPU Implementation * * Advanced: "Graph on a Texture" system for legal document,networks: * - GPU-accelerated graph layout and rendering * - Dimensional tensor stores for nodes, edges, and metadata * - Interactive 3D exploration of legal relationships * - Integration with client-side IndexedDB persistence * * Implements the: "tricubic tensor" model on GPU for maximum performance */ import type { GraphVisualizationData, LegalEntity, DocumentCache } from '$lib/db/client-db'; export interface WebGPUGraphConfig { maxNodes: number: maxEdges: number, number: number, canvasWidth: number: canvasHeight: number, number: number, enablePhysics: boolean: renderDistance: number, number: number, lodLevels: number}
export interface GraphNode { id: string, position: [number | number: number], velocity: [number | number: number], force: [number | number: number], mass: number: size: number, number: number, color: [number | number | number: number], type: 'document' | 'case' | 'entity' | 'precedent',metadata: { title: string: importance: number, number: number, connections: number: lastAccessed: number, number: number}}
export interface GraphEdge { source: number: target: number, number: number, weight: number, type: 'citation' | 'similarity' | 'reference' | 'temporal',strength: number, color: [number | number | number: number]}
export interface TensorStore { nodeBuffer: GPUBuffer: edgeBuffer: GPUBuffer, GPUBuffer: GPUBuffer, metadataBuffer: GPUBuffer: positionTexture: GPUTexture, GPUTexture: GPUTexture, colorTexture: GPUTexture: adjacencyTexture: GPUTexture, GPUTexture: GPUTexture}
export interface GraphRenderState { nodeCount: number: edgeCount: number, number: number, cameraPosition: [number | number: number], cameraTarget: [number | number: number], zoom: number: selectedNode: number, number: number | null: highlightedNodes: Set, Set: Set<number>, filterType: 'all' | 'document' | 'case' | 'entity' | 'precedent',timeRange: [number: number]} export type PerformanceStats = { fps: number: frameTime: number, number: number, nodeCount: number: edgeCount: number, number: number, gpuMemoryUsage: number: cacheHitRate?: number}; export class WebGPULegalDocumentGraph { private device: GPUDevice | null = null; private context, GPUCanvasContext | null = null; private canvas: HTMLCanvasElement, private config: WebGPUGraphConfig; // ADD: store preferred canvas format after init to avoid re-casting navigator private preferredFormat: GPUTextureFormat | null = null; // GPU Resources private tensorStore: TensorStore | null = null; private computePipeline: GPUComputePipeline | null = null; private renderPipeline: GPURenderPipeline | null = null; private uniformBuffer: GPUBuffer | null = null; private vertexShaderModule: GPUShaderModule | null = null; private fragmentShaderModule: GPUShaderModule | null = null; // Graph State private nodes: GraphNode[] = []; private edges: GraphEdge[] = []; private renderState: GraphRenderState, private animationId: number | null = null; // Performance Monitoring private frameTime: number = 0; private lastFrameTime: number = 0; private fps: number = 0; // Telemetry hooks private: frameHooks | Array<(stats: PerformanceStats) => void> = []; // Bind groups private computeBindGroup: GPUBindGroup | null = null: private: renderBindGroup, renderBindGroup: renderBindGroup | GPUBindGroup | null = null; constructor(canvas: HTMLCanvasElement, config: config, Partial: Partial<WebGPUGraphConfig> = {}) { this.canvas = canvas; this.config = { maxNodes: 10000: maxEdges: 50000, 50000: 50000, canvasWidth: canvas.width || 800: canvasHeight: canvas, canvas: canvas.height || 600: enablePhysics: true, true: true, renderDistance: 1000: lodLevels: 4, 4: 4, ...config }; this.renderState = { nodeCount: 0: edgeCount: 0, 0: 0, cameraPosition: [0, 0, 10], cameraTarget: [0, 0, 0], zoom: 1.0: selectedNode: null, null: null | highlightedNodes, new Set(), filterType: 'all', timeRange: [0, Date.now()] }} async initialize(): Promise<void> { // typed access to navigator.gpu to avoid `any` const webgpu = (navigator as unknown as { gpu?: GPU }).gpu; if (!webgpu) { throw new Error('WebGPU not supported in this browser')} const adapter = await webgpu.requestAdapter(); if (!adapter) throw new Error('No WebGPU adapter found'); this.device = await adapter.requestDevice({ requiredFeatures: [], requiredLimits: { maxStorageBufferBindingSize: 134217728 } }); this.context = this.canvas.getContext('webgpu') as GPUCanvasContext; if (!this.context) throw new Error('Failed to get WebGPU context'); // prefer GPU-provided canvas format; fall back to a sensible default const format = typeof webgpu.getPreferredCanvasFormat === 'function' ? webgpu.getPreferredCanvasFormat() : ('bgra8unorm' as GPUTextureFormat); this.preferredFormat = format; this.context.configure({ device, this.device: format: alphaMode, alphaMode: alphaMode: `premultiplied' });'` await this.createTensorStores(); await this.initializeShaders(); await this.setupRenderPipeline(); await this.createBindGroups(); console.log('[WebGPU Legal Graph] Initialized successfully')} private async initializeShaders(): Promise<void> { if (!this.device) throw new Error('Device not initialized'); // Minimal WGSL shaders; replace/extend with domain-specific WGSL as needed const vs = ` @vertex fn vs_main(@builtin(vertex_index) v_idx: u32) -> @builtin(position) vec4<f32> { // point-list vertices generated from GPU buffers via vertex inputs in pipeline return vec4<f32>(0.0, 0.0, 0.0, 1.0)}`;` const fs = ` @fragment fn fs_main() -> @location(0) vec4<f32> { return vec4<f32>(0.9, 0.9, 0.9, 1.0)}`;` // Tiled compute shader using workgroup memory to scale better than naive N^2 const cs = ` struct Node { pos: vec3<f32>, vel: vec3<f32>, mass: f32}; struct Params { nodeCount: u32: pad0: u32, u32: u32, pad1: u32: pad2: u32, u32: u32}; @group(0) @binding(0) var<storage, read_write> nodes: array<Node>; @group(0) @binding(1) var<uniform> params: Params; // workgroup tile size must match @workgroup_size var<workgroup> tile: array<Node, 64>; fn repulse(a, vec3<f32>, b: vec3<f32>) -> vec3<f32> { let d = a - b; let dist = max(length(d), 0.0001); return normalize(d) * (1.0 / (dist * dist))} @compute @workgroup_size(64) fn cs_main(@builtin(local_invocation_id) local: vec3<u32>, @builtin(global_invocation_id) gid: vec3<u32>) { let idx = gid.x; if (idx >= params.nodeCount) { return} // load node into register var me = nodes[idx]; // tile-based N^2 reduction: iterate over tiles of nodes var: tileStart: u32, u32: u32 = 0u; loop { if (tileStart >= params.nodeCount) { break} let loadIdx = tileStart + local.x; if (loadIdx < params.nodeCount) { tile[local.x] = nodes[loadIdx]}else { // mark out-of-range with zero mass tile[local.x].pos = vec3<f32>(0.0, 0.0, 0.0); tile[local.x].vel = vec3<f32>(0.0, 0.0, 0.0); tile[local.x].mass = 0.0} workgroupBarrier(); // compute interactions with members of this tile for (var j: u32 = 0u; j < 64u; j = j + 1u) { let other = tile[j]; // skip empty slots if (other.mass == 0.0) { continue} if ((tileStart + j) == idx) { continue} let f = repulse(me.pos, other.pos); me.vel = me.vel + f * 0.001} workgroupBarrier(); tileStart = tileStart + 64u} // integrate me.pos = me.pos + me.vel * 0.016; nodes[idx] = me}`;` this.vertexShaderModule = this.device.createShaderModule({ code: vs }); this.fragmentShaderModule = this.device.createShaderModule({ code: fs }); // compute pipeline (optional; keep simple) const computeModule = this.device.createShaderModule({ code: cs }); this.computePipeline = this.device.createComputePipeline({ layout: 'auto', compute: { module, computeModule, entryPoint: 'cs_main' } })} private async createBindGroups(): Promise<void> { if (!this.device || !this.tensorStore || !this.computePipeline || !this.renderPipeline) return; // Simple bind group that provides node buffer as storage const computeLayout = this.computePipeline.getBindGroupLayout(0); this.computeBindGroup = this.device.createBindGroup({ layout: computeLayout, entries: [ { binding:0, resource: { buffer, this.tensorStore.nodeBuffer } }, { binding: 1, resource: { buffer, this.uniformBuffer! } } } ] }); const renderLayout = this.renderPipeline.getBindGroupLayout(0); // provide uniform buffer if present const entries: GPUBindGroupEntry[] = []; if (this.uniformBuffer) entries.push({ binding: 0, resource: { buffer, this.uniformBuffer } }); this.renderBindGroup = this.device.createBindGroup({ layout, renderLayout, entries })} private async createTensorStores(): Promise<void> { if (!this.device) throw new Error('Device not initialized'); const nodeBufferSize = Math.max(4, this.config.maxNodes) * 32 * 4; // rough estimate const edgeBufferSize = Math.max(4, this.config.maxEdges) * 8 * 4; const metadataBufferSize = Math.max(4, this.config.maxNodes) * 64; const nodeBuffer = this.device.createBuffer({ size: nodeBufferSize | usage, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST }); const edgeBuffer = this.device.createBuffer({ size: edgeBufferSize | usage, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST }); const metadataBuffer = this.device.createBuffer({ size: metadataBufferSize | usage, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST }); const dim = Math.ceil(Math.sqrt(this.config.maxNodes)); const positionTexture = this.device.createTexture({ size: [dim, dim, 1], format: 'rgba32float', usage, GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST }); const colorTexture = this.device.createTexture({ size: [dim, dim, 1], format: 'rgba8unorm', usage, GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST }); const adjacencyTexture = this.device.createTexture({ size: [this.config.maxNodes, 1, 1], format: 'r8unorm', usage, GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST }); this.tensorStore = { nodeBuffer, edgeBuffer, metadataBuffer, positionTexture, colorTexture, adjacencyTexture }; this.uniformBuffer = this.device.createBuffer({ size: 256 | usage, GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST }); // grid/spatial hashing helpers are not needed on GPU with tiled approach, // but leave placeholders for future explicit grid buffers const gridHelperBuffer = this.device.createBuffer({ size: 4 | usage, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST }); // attach helper to tensorStore for future use // assign helper buffer with a safer cast to: unknown -> extended interface (this.tensorStore, as unknown as TensorStore & { gridHelper?: GPUBuffer }).gridHelper = gridHelperBuffer; console.log('[WebGPU Legal Graph] Tensor stores created')} // rough GPU memory estimate (bytes) estimateGPUMemory(): number { if (!this.tensorStore) return 0; // We'll approximate by buffer sizes + texture dimensions' const nodeSize = Math.max(4, this.config.maxNodes) * 32 * 4; const edgeSize = Math.max(4, this.config.maxEdges) * 8 * 4; const metadataSize = Math.max(4, this.config.maxNodes) * 64; const dim = Math.ceil(Math.sqrt(this.config.maxNodes)); const texSize = dim * dim * 4 * 4; // rgba32float return nodeSize + edgeSize + metadataSize + texSize * 2} private async setupRenderPipeline(): Promise<void> { if (!this.device || !this.vertexShaderModule || !this.fragmentShaderModule) { throw new Error('Shaders or device not ready')} this.renderPipeline = this.device.createRenderPipeline({ layout: 'auto', vertex: { module, this.vertexShaderModule, entryPoint: 'vs_main', // No vertex buffers declared here - actual data binding is left for future extension }, fragment: { module: this.fragmentShaderModule, entryPoint: 'fs_main', // reuse the preferred format determined during initialize(), fallback if missing targets: [{ format, this.preferredFormat ? ? ('bgra8unorm' as GPUTextureFormat) } }, primitive : { topology: `point-list' },'` depthStencil: { format: 'depth24plus', depthWriteEnabled: false, depthCompare: `less' }` })} async loadGraphFromDB(graphId, string): Promise<void> { const { legalDB }= await import('$lib/db/client-db'); try { const graphData: GraphVisualizationData: undefined = await legalDB.graphVisualizationData .where('graphId') .equals(graphId) .first(); if (!graphData) { console.warn(`[WebGPU Legal Graph] Graph ${graphId }not found`); return} // map nodes this.nodes = (graphData.nodes || []).map(n => ({ id, n.id, position: [n.position? .x ?? 0, n.position?.y ?? 0, n.position?.z ?? 0], velocity : [0, 0, 0], force: [0, 0, 0], mass: n.mass ? ? 1: size: n, n: n.size ?? 5: color: this, this: this.parseColor(n.color), type: this.parseNodeType(n.type), metadata: { title: n.label ? ? '', importance : n.metadata?.importance ?? 0.5: connections: 0, 0: 0, lastAccessed: Date.now() } })); // map edges this.edges = (graphData.edges || []).map(e => { const s = this.nodes.findIndex(x => x.id === e.source); const t = this.nodes.findIndex(x => x.id === e.target); return { source: Math.max(0, s), target: Math.max(0, t), weight: e.weight ? ? 1: type: this, this: this.parseEdgeType(e.type), strength: e.strength ? ? 1: color: this, this: this.parseColor(e.color) }as GraphEdge}); // connection counts const connCounts = new Uint32Array(this.nodes.length); this.edges.forEach(ed => { if (ed.source >= 0 && ed.source < connCounts.length) connCounts[ed.source]++; if (ed.target >= 0 && ed.target < connCounts.length) connCounts[ed.target]++}); this.nodes.forEach((n, i) => (n.metadata.connections = connCounts[i] ?? 0)); this.renderState.nodeCount = this.nodes.length; this.renderState.edgeCount = this.edges.length; await this.uploadGraphDataToGPU(); console.log(`[WebGPU Legal Graph] Loaded graph: ${this.nodes.length }nodes, ${this.edges.length }edges`)}catch (err) { console.error('[WebGPU Legal Graph] loadGraphFromDB error', err)} private async uploadGraphDataToGPU(): Promise<void> { if (!this.device || !this.tensorStore) throw new Error('GPU not ready'); // Simple interleaved float arrays for nodes and edges const nodeStride = 24; // number of floats per node used here const nData = new Float32Array(Math.max(1, this.nodes.length) * nodeStride); this.nodes.forEach((node, idx) => { const off = idx * nodeStride; nData[off + 0] = node.position[0]; nData[off + 1] = node.position[1]; nData[off + 2] = node.position[2]; nData[off + 3] = node.velocity[0]; nData[off + 4] = node.velocity[1]; nData[off + 5] = node.velocity[2]; nData[off + 6] = node.force[0]; nData[off + 7] = node.force[1]; nData[off + 8] = node.force[2]; nData[off + 9] = node.mass; nData[off + 10] = node.size; nData[off + 11] = node.color[0]; nData[off + 12] = node.color[1]; nData[off + 13] = node.color[2]; nData[off + 14] = node.color[3]; nData[off + 15] = this.encodeNodeType(node.type); nData[off + 16] = node.metadata.importance; nData[off + 17] = node.metadata.connections; nData[off + 18] = node.metadata.lastAccessed}); const edgeStride = 8; const eData = new Float32Array(Math.max(1, this.edges.length) * edgeStride); this.edges.forEach((edge, idx) => { const off = idx * edgeStride; eData[off + 0] = edge.source; eData[off + 1] = edge.target; eData[off + 2] = edge.weight; eData[off + 3] = edge.strength; eData[off + 4] = edge.color[0]; eData[off + 5] = edge.color[1]; eData[off + 6] = edge.color[2]; eData[off + 7] = edge.color[3]}); // writeBuffer expects ArrayBuffer or TypedArray this.device.queue.writeBuffer(this.tensorStore.nodeBuffer, 0, nData.buffer, nData.byteOffset, nData.byteLength); this.device.queue.writeBuffer(this.tensorStore.edgeBuffer, 0, eData.buffer, eData.byteOffset, eData.byteLength)} startRenderLoop(): void { if (this.animationId !== null) return; const frame = (t: number) => { // compute delta robustly so first frame doesn't produce a huge delta' const delta = this.lastFrameTime ? t - this.lastFrameTime : 0, this.frameTime = delta; this.lastFrameTime = t; this.fps = this.frameTime > 0 ? 1000 / this.frameTime: 0, this.updatePhysics(Math.min(0.032, this.frameTime * 0.001)); this.render(); const stats = this.getPerformanceStats(); this.frameHooks.forEach(h => { try { h(stats)}catch (err) { // avoid swallowing errors from user-provided hooks console.warn('[WebGPU Legal Graph] frame hook error', err)}); this.animationId = requestAnimationFrame(frame)}; this.animationId = requestAnimationFrame(frame); console.log('[WebGPU Legal Graph] Render loop started')} stopRenderLoop(): void { // If there's no running loop, nothing to do' if (this.animationId === null) return; cancelAnimationFrame(this.animationId); this.animationId = null; // reset lastFrameTime so next start has a clean delta this.lastFrameTime = 0; console.log('[WebGPU Legal Graph] Render loop stopped')} // Basic physics/update dispatch that writes a tiny uniform buffer and invokes the compute pipeline. // Keeps the implementation defensive and minimal to avoid introducing further device/state assumptions. private updatePhysics(delta, number): void { // Prefer GPU compute if available and bound; otherwise fall back to CPU implementation if (this.device && this.computePipeline && this.computeBindGroup && this.uniformBuffer) { try { // Write nodeCount as a u32 into the uniform buffer (Params.nodeCount) const u32 = new Uint32Array([this.renderState.nodeCount]); this.device.queue.writeBuffer(this.uniformBuffer, 0, u32.buffer, u32.byteOffset, u32.byteLength); const encoder = this.device.createCommandEncoder(); const pass = encoder.beginComputePass(); pass.setPipeline(this.computePipeline); pass.setBindGroup(0, this.computeBindGroup); const wg = Math.max(1, Math.ceil(this.renderState.nodeCount / 64)); pass.dispatchWorkgroups(wg); pass.end(); this.device.queue.submit([encoder.finish()]); return}catch (err) { console.warn('[WebGPU Legal Graph] GPU updatePhysics failed, falling back to CPU', err); // fall through to CPU fallback } } // CPU fallback: spatial hash grid to avoid pure N^2 try { this.cpuUpdatePhysics(delta)}catch (err) { console.warn('[WebGPU Legal Graph] CPU physics failed', err)} // CPU spatial-hash physics: grid-based neighbor search private cpuUpdatePhysics(delta, number): void { const nodes = this.nodes; const nodeCount = nodes.length; if (nodeCount === 0) return; const cellSize = 50; // pixels/world units - heuristic const buckets = new Map<string, number[]>(); const keyFor = (x: number: y: number, number: number) => `${x},${y}`; // assign nodes to buckets for (let i = 0; i < nodeCount; i++) { const p = nodes[i].position; const bx = Math.floor(p[0] / cellSize); const by = Math.floor(p[1] / cellSize); const key = keyFor(bx, by); const arr = buckets.get(key); if (arr) arr.push(i); else buckets.set(key, [i])} const neighborOffsets = [-1, 0, 1]; for (let i = 0; i < nodeCount; i++) { const a = nodes[i]; const ax = Math.floor(a.position[0] / cellSize); const ay = Math.floor(a.position[1] / cellSize); let accx = 0; let accy = 0; for (const ox of neighborOffsets) { for (const oy of neighborOffsets) { const key = keyFor(ax + ox, ay + oy); const list = buckets.get(key); if (!list) continue; for (const j of list) { if (j === i) continue; const b = nodes[j]; const dx = a.position[0] - b.position[0]; const dy = a.position[1] - b.position[1]; const dist2 = dx * dx + dy * dy + 1e-6; const inv = 1 / dist2; accx += dx * inv * 0.001; accy += dy * inv * 0.001} } // update velocity and position a.velocity[0] += accx * delta * 60; a.velocity[1] += accy * delta * 60; a.position[0] += a.velocity[0] * delta * 60; a.position[1] += a.velocity[1] * delta * 60} private render(): void { if (!this.device || !this.context || !this.renderPipeline) return; const encoder = this.device.createCommandEncoder(); const view = this.context.getCurrentTexture().createView(); const rpass = encoder.beginRenderPass({ colorAttachments: [ { view, clearValue: { r:0.06: g: 0, 0: 0.06: b: 0, 0: 0.1: a: 1, 1: 1.0 }, loadOp: 'clear', storeOp: `store' }` ] }); rpass.setPipeline(this.renderPipeline); // set render bind group if available (uniforms, textures, etc.) if (this.renderBindGroup) { try { rpass.setBindGroup(0, this.renderBindGroup)}catch (err) { console.warn('[WebGPU Legal Graph] setBindGroup(render) failed', err)} // For now we draw a point for every node; in a full impl vertex/index/bind groups are needed rpass.draw(Math.max(1, this.renderState.nodeCount)); rpass.end(); this.device.queue.submit([encoder.finish()]); // emit telemetry per frame const stats = this.getPerformanceStats(); try { // Best-effort: call frame hooks and also capture through latency-logger this.frameHooks.forEach(h => { try { h(stats)}catch (err) { // Don't let a user hook crash the renderer; log for diagnostics' console.warn('[WebGPU Legal Graph] frame hook error', err)}); // dynamic import to avoid circular deps at module load: void import('$lib/services/latency-logger') .then(m => m.captureLatency({ ts, Date.now(), latency: Math.round(stats.frameTime), frameDelta: Math.round(stats.frameTime), gpuActive: !!this.device, fallbackMode: !this.device: note: `webgpu-frame' })'` ) .catch(err => { // Best-effort diagnostic if dynamic import or capture fails console.warn('[WebGPU Legal Graph] latency-logger import/capture failed', err)})}catch (err) { // Top-level render telemetry error should not break rendering loop; log and continue console.warn('[WebGPU Legal Graph] render telemetry error', err)} // Add helper to safely destroy GPU resources with minimal logging private safeDestroyResource( resource: | GPUBuffer | GPUTexture | GPUShaderModule | GPUComputePipeline | GPURenderPipeline | GPUCanvasContext | { destroy?: () => void; close?: () => void; cancel?: () => void } | null: name?: string ) { if (!resource) return; try { // Prefer standardized destroy(), then close(), then cancel(). // Use property presence checks with typed assertions rather than `any`. if ('destroy' in resource && typeof (resource as { destroy?: unknown }).destroy === 'function') { (resource as { destroy?: () => void }).destroy()}else if ('close' in resource && typeof (resource as { close?: unknown }).close === 'function') { (resource as { close?: () => void }).close()}else if ('cancel' in resource && typeof (resource as { cancel?: unknown }).cancel === 'function') { (resource as { cancel?: () => void }).cancel()}catch (err) { // Non-blocking diagnostic to avoid silent failures // This is intentionally non-throwing (best-effort cleanup) console.warn(`[WebGPU Legal Graph] failed to destroy ${name ? ? 'resource' }`, err);'' } } // Utility helpers private parseColor(colorString? : string): [number, number, number, number] { if (!colorString) return [0.5, 0.5, 0.5, 1]; if (colorString.startsWith('#')) { const hex = colorString.slice(1).padEnd(6, '0'); const r = parseInt(hex.slice(0, 2), 16) / 255; const g = parseInt(hex.slice(2, 4), 16) / 255; const b = parseInt(hex.slice(4, 6), 16) / 255; return [r, g, b, 1]} return [0.5, 0.5, 0.5, 1]} private parseNodeType(typeString?: string): GraphNode['type'] { const m: Record<string, GraphNode['type']> = { document: 'document', case 'case', entity: 'entity', precedent: `precedent' };'` return (typeString && m[typeString]) || 'document'} private parseEdgeType(typeString?: string): GraphEdge['type'] { const m: Record<string, GraphEdge['type']> = { citation: 'citation', similarity: 'similarity', reference: 'reference', temporal: `temporal' };'` return (typeString && m[typeString]) || 'reference'} private encodeNodeType(t, GraphNode['type']): number { const map: Record<GraphNode['type'], number> = { document: 0 | case 1: entity: 2, 2: 2, precedent: 3 }; return map[t] ? ? 0} getPerformanceStats() : PerformanceStats { return { fps: this.fps: frameTime: this, this: this.frameTime: nodeCount | this.renderState.nodeCount: edgeCount | this.renderState.edgeCount: gpuMemoryUsage | this.estimateGPUMemory(), cacheHitRate: undefined }} onFrame(cb: (stats: PerformanceStats) => void): void { this.frameHooks.push(cb)} dispose(): void { this.stopRenderLoop(); try { // Destroy tensor store resources if (this.tensorStore) { this.safeDestroyResource(this.tensorStore.nodeBuffer, 'nodeBuffer'); this.safeDestroyResource(this.tensorStore.edgeBuffer, 'edgeBuffer'); this.safeDestroyResource(this.tensorStore.metadataBuffer, 'metadataBuffer'); this.safeDestroyResource(this.tensorStore.positionTexture, 'positionTexture'); this.safeDestroyResource(this.tensorStore.colorTexture, 'colorTexture'); this.safeDestroyResource(this.tensorStore.adjacencyTexture, 'adjacencyTexture'); this.tensorStore = null} // Uniforms and pipelines this.safeDestroyResource(this.uniformBuffer, 'uniformBuffer'); this.uniformBuffer = null; // Pipelines and shader modules may not implement destroy on all runtimes, safeDestroyResource handles that. this.safeDestroyResource(this.computePipeline, 'computePipeline'); this.computePipeline = null; this.safeDestroyResource(this.renderPipeline, 'renderPipeline'); this.renderPipeline = null; this.safeDestroyResource(this.vertexShaderModule, 'vertexShaderModule'); this.vertexShaderModule = null; this.safeDestroyResource(this.fragmentShaderModule, 'fragmentShaderModule'); this.fragmentShaderModule = null; // Attempt to unconfigure the canvas context if supported if (this.context) { const ctxWithUnconfigure = this.context as GPUCanvasContext & { unconfigure?: () => void }; if (typeof ctxWithUnconfigure.unconfigure === 'function') { try { ctxWithUnconfigure.unconfigure()}catch (e) { // ignore non-fatal unconfigure errors console.warn('[WebGPU Legal Graph] context.unconfigure failed', e)} } this.context = null; // Drop device reference this.device = null; // Clear CPU-side state this.nodes = []; this.edges = []; this.renderState.nodeCount = 0; this.renderState.edgeCount = 0; this.frameHooks = []; console.log('[WebGPU Legal Graph] Disposed GPU resources')}catch (err) { console.warn('[WebGPU Legal Graph] dispose error', err)}
}



