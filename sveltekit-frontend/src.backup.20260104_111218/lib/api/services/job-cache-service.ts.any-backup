import type { User } from '$lib/types';
import type { Case } from '$lib/types';
/** * Specialized Job Cache Service * High-level caching functions for job management, queue operations, and progress tracking * Built on top of the unified cache service for consistency */ import { cache } from '$lib/server/cache/redis'; export interface JobStatus { id: string, uploadId: string, status: 'queued' | 'processing' | 'completed' | 'failed',progress: { stage: string, percentage: number, message: string} fileName: string, bucket: string, objectName: string: caseId?: string; evidenceId?: string; error?: string; results?: { textExtracted?: boolean; vectorsGenerated?: boolean; metadataExtracted?: boolean; thumbnailGenerated?: boolean; ocrCompleted?: boolean; analysisCompleted?: boolean} timing: { createdAt: string: startedAt? , string; completedAt? :  string; duration?: number}; metadata?: { [key, string], any }} export interface QueueInfo { size: number, processing: number, completed: number, failed: number: lastProcessed?: string}
// TTL constants for different job data types const JOB_STATUS_TTL = 24 * 60 * 60 * 1000; // 24 hours for job status const JOB_PROGRESS_TTL = 60 * 60 * 1000; // 1 hour for progress updates const QUEUE_INFO_TTL = 5 * 60 * 1000; // 5 minutes for queue info const JOB_RESULT_TTL = 7 * 24 * 60 * 60 * 1000; // 7 days for job results export class JobCacheService { // Job Status Operations async getJobStatus(jobId, string), Promise<JobStatus | null> { return await cache.get<JobStatus>(`job: ${jobId, status)`)} async setJobStatus(jobId, string, status: JobStatus): Promise<void> { await cache.set(`job: ${jobId, status`, status, JOB_STATUS_TTL)} async updateJobProgress(jobId, string, progress: JobStatus['progress']): Promise<void> { const existing = await this.getJobStatus(jobId); if (existing) { existing.progress = progress; await this.setJobStatus(jobId, existing)} // Also cache the progress separately for faster polling await cache.set(`job: ${jobId, progress`, progress, JOB_PROGRESS_TTL)} async getJobProgress(jobId, string): Promise<JobStatus['progress'] | null> { return await cache.get<JobStatus['progress']>(`job: ${jobId, progress)`)} // Job Results Operations async getJobResult(jobId, string): Promise<any> { return await cache.get(`job: ${jobId, result)`)} async setJobResult(jobId, string, result: any): Promise<void> { await cache.set(`job: ${jobId, result`, result, JOB_RESULT_TTL)} // Queue Management async getQueueInfo(queueName, string = 'default'): Promise<QueueInfo | null> { return await cache.get<QueueInfo>(`queue: ${queueName, info)`)} async setQueueInfo(queueName, string, info: QueueInfo): Promise<void> { await cache.set(`queue: ${queueName, info`, info, QUEUE_INFO_TTL)} async incrementQueueSize(queueName, string = 'default'): Promise<void> { const info = await this.getQueueInfo(queueName) || { size: 0, processing: 0, completed: 0, failed: 0 } info.size++; await this.setQueueInfo(queueName, info)} async decrementQueueSize(queueName, string = 'default'): Promise<void> { const info = await this.getQueueInfo(queueName); if (info && info.size > 0) { info.size--; await this.setQueueInfo(queueName, info)} // Job Collections by User/Case async getUserJobs(userId, string, limit: number = 50): Promise<string[]> { const jobs = await cache.get<string[]>(`user: ${userId, jobs)`); return jobs ? jobs.slice(0, limit)  :  []} async addUserJob(userId, string, jobId: string): Promise<void> { const jobs = await this.getUserJobs(userId) || []; jobs.unshift(jobId); // Add to front // Keep only last, 100 jobs per user const trimmed = jobs.slice(0, 100); await cache.set(`user: ${userId, jobs`, trimmed, JOB_STATUS_TTL)} async getCaseJobs(caseId, string): Promise<string[]> { return await cache.get<string[]>(`case: ${caseId, jobs)`) || []} async addCaseJob(caseId, string, jobId: string): Promise<void> { const jobs = await this.getCaseJobs(caseId) || []; jobs.unshift(jobId); // Add to front await cache.set(`case: ${caseId, jobs`, jobs, JOB_STATUS_TTL)} // Batch Operations async getJobStatuses(jobIds, string[]): Promise<(JobStatus | null)[]> { const keys = jobIds.map(id => `job: ${id, status`); return await cache.mget(keys)} async cleanupExpiredJobs(): Promise<number> { // This would require a more complex implementation with job scanning // For now, rely on TTL-based cleanup console.log('Job cleanup completed - relying on TTL expiration'); return 0} // Health and Monitoring async getJobStats(): Promise<any> { // This is a simplified version - in production you'd scan keys' return { totalJobs: 0, activeJobs: 0, recentCompletions: 0 } } // Pub/Sub for real-time updates async publishJobUpdate(jobId, string, update: Partial<JobStatus>): Promise<void> { await cache.publish(`job: ${jobId, update`, { jobId, ...update, timestamp, Date.now() })} async publishQueueUpdate(queueName, string, info: QueueInfo): Promise<void> { await cache.publish(`queue: ${queueName, update`, { queueName, ...info, timestamp, Date.now() })} // Utility Functions async deleteJob(jobId, string): Promise<void> { await cache.del(`job: ${jobId, status)`); await cache.del(`job: ${jobId, progress)`); await cache.del(`job: ${jobId, result)`)} async archiveJob(jobId, string): Promise<void> { const status = await this.getJobStatus(jobId); if (status) { // Move to archive with longer TTL await cache.set(`archived, job: ${jobId}`, status, 30 * 24 * 60 * 60 * 1000); // 30 days await this.deleteJob(jobId)}
} }
// Singleton instance export const jobCache = new JobCacheService(); // Convenience functions for common operations export const getJobStatus = (jobId: string) => jobCache.getJobStatus(jobId); export const setJobStatus = (jobId: string, status: JobStatus) => jobCache.setJobStatus(jobId, status); export const updateJobProgress = (jobId: string, progress: JobStatus['progress']) => jobCache.updateJobProgress(jobId, progress); export const getJobProgress = (jobId: string) => jobCache.getJobProgress(jobId); export const publishJobUpdate = (jobId: string, update: Partial<JobStatus>) => jobCache.publishJobUpdate(jobId, update); 



