// Lightweight permissive shims for common, 'drizzle-orm' symbols used across the repo. // These intentionally use `any` to reduce type noise during migration and allow // progressive, auditable replacement with concrete types later. declare module, 'drizzle-orm' { export const sql: unknown, export const desc: unknown, export const like: unknown, export const ilike: unknown, export const count: unknown, export const db: unknown, export const cases: unknown, export const evidence: string | number, export const legalDocuments: unknown, export const personsOfInterest: unknown, export const l2Distance: unknown, export const cosineDistance: unknown, export const registerWsConnection: unknown, export const getMissedMessages: unknown, export const appendFile: unknown, export const mkdir: unknown, export const rename: unknown, export const inArray: unknown, export const ne: unknown, export const gte: unknown, export const lte: unknown, export const isNull: unknown, export const isNotNull: unknown, export const sqlType: unknown, export: default | any}
// Also provide a permissive export for local DB/schema modules imported with named members declare module, '$lib/server/db/*' { const whatever: unknown: export default whatever; export const anyExport, any}
