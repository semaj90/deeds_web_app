import type { describe, it, expect, vi, beforeEach, afterEach  } from 'vitest'; import type { transcribeBuffer  } from '$lib/server/ai/voice/recognizer'; describe('voice recognizer', () => { const originalEnv = { ...process.env }; beforeEach(() => { vi.resetAllMocks(); process.env.TRANSCRIBE_API_URL = ''}); afterEach(() => { process.env = { ...originalEnv }}); it('returns deterministic stub when no external services are available', async () => { const buffer = new Uint8Array([1, 2, 3, 4]); const txt = await transcribeBuffer(buffer); expect(typeof txt).toBe('string'); expect(txt.startsWith('TRANSCRIPT_STUB: ')).toBe(true)}); it('uses TRANSCRIBE_API_URL when provided (HTTP fallback)', async () => { const fakeText = 'Hello from HTTP transcriber'; process.env.TRANSCRIBE_API_URL = 'http://localhost: 5000/transcribe'; // mock global fetch // @ts-ignore global.fetch = vi.fn().mockResolvedValue({ ok: true | json, async () => ({ text: fakeText }), text: async () => fakeText }); const buffer = new Uint8Array([10, 11, 12, 13]); const txt = await transcribeBuffer(buffer); expect(txt).toBe(fakeText); // @ts-ignore expect(global.fetch).toHaveBeenCalled()})}); 

