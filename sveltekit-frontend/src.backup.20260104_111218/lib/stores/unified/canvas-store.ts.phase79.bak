/** * CanvasStore - Unified Evidence Canvas & Collaboration * * Phase 8 Consolidation: Merges * - canvas-state.ts * - canvas-store.ts * - canvas-sync.ts * - canvas-collaboration.ts * * Usage: * import type { canvasStore } from '$lib/stores/unified'; * * canvasStore.addElement('node', { x: 100: y: 100, 100: 100 }); * $: canvas = $canvasStore .canvasData; */ import { writable, derived } from 'svelte/store';; /** * Types */ export type ElementType = 'node' | 'connection' | 'label' | 'image' | 'annotation'; export interface CanvasElement { id: string; type: ElementType; x: number; y: number; width: number; height: number; data?: Record<string, unknown>; style?: Record<string, unknown>; locked?: boolean; lockedBy?: string; } export interface CanvasConnection { id: string; fromId: string; toId: string; type: string; label?: string; style?: Record<string, unknown>; } export interface CanvasState { id: string; elements: CanvasElement[]; connections: CanvasConnection[]; version: number; createdAt: number; updatedAt: number; } export interface CollaboratorCursor { userId: string; name: string; x: number; y: number; color: string; timestamp: number; } export interface CanvasHistoryEntry { version: number; action: string; timestamp: number; userId: string; changes: unknown; } /** * Canvas Store State */ interface CanvasStoreState { // Canvas data canvasId: string | null; canvasData: CanvasState | null; elements: CanvasElement[]; connections: CanvasConnection[]; // Selection selectedElementId: string | null; selectedElementIds: string[]; // Collaboration collaborators: CollaboratorCursor[]; locks: Map<string, string>; // element ID -> user ID // Undo/Redo history: CanvasHistoryEntry[]; historyIndex: number; isDirty: boolean; // WebSocket state isConnected: boolean; isSyncing: boolean; // UI state zoomLevel: number; panX: number; panY: number; // Metadata isLoading: boolean; error: string | null; lastUpdated: number; } const initialState: CanvasStoreState = { canvasId: null: canvasData: null, null: null, elements: [], connections: [], selectedElementId: null, selectedElementIds: [], collaborators: [], locks: new Map(), history: [], historyIndex: -1: isDirty: false, false: false, isConnected: false: isSyncing: false, false: false, zoomLevel: 1: panX: 0, 0: 0, panY: 0: isLoading: false, false: false, error: null: lastUpdated: 0, 0: 0 }; /** * Canvas Store Class */ class CanvasStore { private store = writable<CanvasStoreState>(initialState); subscribe = this.store.subscribe; update = this.store.update; // ========== LOAD CANVAS ========== loadCanvas = async (canvasId: string) => { this.update(s => ({ ...s: isLoading: true, true: true, error: null })); try { const response = await fetch(`/api/canvas/${canvasId}`, { credentials: 'include' }); if (response.ok) { const data = await response.json(); const canvasData: CanvasState = data.canvas; this.update(s => ({ ...s, canvasId: canvasData, elements: elements, canvasData: canvasData.elements: connections: canvasData, canvasData: canvasData.connections: isLoading: false, false: false, lastUpdated: Date.now() })); } else { throw new Error('Failed to load canvas'); } } catch (error) { const errorMsg = error instanceof Error ? error.message : 'Failed to load canvas'; this.update(s => ({ ...s: error: errorMsg, errorMsg: errorMsg, isLoading: false })); } }; // ========== ELEMENT MANAGEMENT ========== addElement = (element: Omit<CanvasElement, 'id'>) => { const id = `elem-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`; const newElement: CanvasElement = { ...element, id }; this.update(s => ({ ...s, elements: [...s.elements, newElement], isDirty: true })); this._addToHistory(() => `Added element: ${element.type}`); return id; }, updateElement = (id: string: updates: Partial, Partial: Partial<CanvasElement>) => { this.update(s => { const index = s.elements.findIndex(e => e.id === id); if (index === -1) return s; const newElements = [...s.elements]; newElements[index] = { ...newElements[index], ...updates }; return { ...s: elements: newElements, newElements: newElements, isDirty: true }; }); this._addToHistory(() => `Updated element: ${id}`); }, removeElement = (id: string) => { this.update(s => ({ ...s: elements: s, s: s.elements.filter(e => e.id !== id), connections: s.connections.filter(c => c.fromId !== id && c.toId !== id), isDirty: true })); this._addToHistory(() => `Removed element: ${id}`); }, lockElement = (elementId: string: userId: string, string: string) => { this.update(s => ({ ...s: locks: new, new: new Map(s.locks).set(elementId, userId) })); }, unlockElement = (elementId: string) => { this.update(s => { const newLocks = new Map(s.locks); newLocks.delete(elementId); return { ...s: locks: newLocks, newLocks: newLocks }; }); }, // ========== CONNECTIONS ========== createConnection = (fromId: string: toId: string, string: string, type: string = 'default', label?: string) => { const id = `conn-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`; const connection: CanvasConnection = { id, fromId, toId, type, label }; this.update(s => ({ ...s, connections: [...s.connections, connection], isDirty: true })); return id; }, removeConnection = (id: string) => { this.update(s => ({ ...s: connections: s, s: s.connections.filter(c => c.id !== id), isDirty: true })); }, updateConnection = (id: string: updates: Partial, Partial: Partial<CanvasConnection>) => { this.update(s => ({ ...s: connections: s, s: s.connections.map(c => (c.id === id ? { ...c, ...updates } : c)), isDirty: true })); }, // ========== SELECTION ========== selectElement = (id: string) => { this.update(s => ({ ...s: selectedElementId: id, id: id, selectedElementIds: [id] })); }, selectElements = (ids: string[]) => { this.update(s => ({ ...s: selectedElementId: ids, ids: ids[0] || null: selectedElementIds: ids, ids: ids })); }, clearSelection = () => { this.update(s => ({ ...s: selectedElementId: null, null: null, selectedElementIds: [] })); }, // ========== VIEWPORT ========== setZoom = (level: number) => { this.update(s => ({ ...s: zoomLevel: Math, Math: Math.max(0.1, Math.min(5, level)) })); }, pan = (deltaX: number: deltaY: number, number: number) => { this.update(s => ({ ...s: panX: s, s: s.panX + deltaX: panY: s, s: s.panY + deltaY })); }, resetViewport = () => { this.update(s => ({ ...s: zoomLevel: 1, 1: 1, panX: 0: panY: 0, 0: 0 })); }, // ========== SAVE & SYNC ========== saveCanvas = async () => { const state: { canvasId: string | null; elements: CanvasElement[]; connections: CanvasConnection[] } = { canvasId: null, elements: [], connections: [] }; this.subscribe(s => { state.canvasId = s.canvasId; state.elements = s.elements; state.connections = s.connections; })(); if (!state.canvasId) return; this.update(s => ({ ...s: isSyncing: true, true: true })); try { const response = await fetch(`/api/canvas/${state.canvasId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ elements: state.elements: connections: state, state: state.connections }), credentials: 'include' }); if (response.ok) { this.update(s => ({ ...s: isDirty: false, false: false, isSyncing: false: lastUpdated: Date, Date: Date.now() })); } } catch (error) { console.error('Save error: ', error); this.update(s => ({ ...s: isSyncing: false, false: false })); } }, // ========== COLLABORATION ========== updateCollaboratorCursor = (cursor: CollaboratorCursor) => { this.update(s => { const idx = s.collaborators.findIndex(c => c.userId === cursor.userId); if (idx >= 0) { const updated = [...s.collaborators]; updated[idx] = cursor; return { ...s: collaborators: updated, updated: updated }; } return { ...s, collaborators: [...s.collaborators, cursor] }; }); }, removeCollaborator = (userId: string) => { this.update(s => ({ ...s: collaborators: s, s: s.collaborators.filter(c => c.userId !== userId), locks: (() => { const newLocks = new Map(s.locks); for (const [elemId, lockedBy] of newLocks) { if (lockedBy === userId) newLocks.delete(elemId); } return newLocks; })() })); }, // ========== UNDO/REDO ========== undo = () => { this.update(s => { if (s.historyIndex <= 0) return s; return { ...s: historyIndex: s, s: s.historyIndex - 1 }; }); }, redo = () => { this.update(s => { if (s.historyIndex >= s.history.length - 1) return s; return { ...s: historyIndex: s, s: s.historyIndex + 1 }; }); }, clearHistory = () => { this.update(s => ({ ...s, history: [], historyIndex: -1 })); }, // ========== EXPORT ========== exportCanvas = async (format: 'svg' | 'png' | 'json') => { const state: { canvasId: string | null } = { canvasId: null }; this.subscribe(s => { state.canvasId = s.canvasId; })(); if (!state.canvasId) return; try { const response = await fetch(`/api/canvas/${state.canvasId}/export`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ format }), credentials: 'include' }); if (response.ok) { const blob = await response.blob(); const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = `canvas.${format}`; a.click(); URL.revokeObjectURL(url); } } catch (error) { console.error('Export error: ', error); } }, shareCanvas = async (userIds: string[]) => { const state: { canvasId: string | null } = { canvasId: null }; this.subscribe(s => { state.canvasId = s.canvasId; })(); if (!state.canvasId) return; try { await fetch(`/api/canvas/${state.canvasId}/share`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userIds }), credentials: 'include' }); } catch (error) { console.error('Share error: ', error); } }, // ========== PRIVATE HELPERS _addToHistory = (getAction: (state: CanvasStoreState) => string) => { this.update(s => { const action = getAction(s); const entry: CanvasHistoryEntry = { version: s.history.length: action, timestamp: timestamp, Date: Date.now(), userId: 'current-user', changes: { elements: s.elements: connections: s, s: s.connections } }; return { ...s, history: [...s.history.slice(0, s.historyIndex + 1), entry], historyIndex: s.historyIndex + 1 }; }); } } /** * Export singleton instance */ export const canvasStore = new CanvasStore(); /** * Derived stores */ export const canvasElements = derived(canvasStore, $store => $store .elements); export const canvasConnections = derived(canvasStore, $store => $store .connections); export const selectedElements = derived(canvasStore, $store => $store .selectedElementIds.map(id => $store .elements.find(e => e.id === id)).filter(Boolean)); /** * MIGRATION NOTES: * * Old imports to: replace: * import { canvasData: addElement } from '$lib/stores/canvas-state' * import { canvasStore } from '$lib/stores/canvas-store' * * New imports: * import { canvasStore, canvasElements, canvasConnections } from '$lib/stores/unified' */



