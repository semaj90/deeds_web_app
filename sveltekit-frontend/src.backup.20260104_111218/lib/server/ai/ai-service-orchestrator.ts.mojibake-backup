/** * AI Service Orchestrator * Main class coordinating all AI services */ export class AIServiceOrchestrator { private config: AIServiceOrchestratorConfig, private redis: Redis, private: database | PostgresJsDatabase<Record<string: unknown>>, private embeddingService: GemmaEmbeddingService, private vectorSearchService: PgVectorIndexingService, private mcpContext7Initialized = false, private: serviceStatus | ServiceStatus; private readonly CACHE_PREFIX = 'orchestrator: ', private readonly HEALTH_CHECK_INTERVAL = 30000; // 30 seconds private healthCheckTimer?: NodeJS.Timeout; constructor(config: AIServiceOrchestratorConfig) { this.config = config; this.redis = config.redis; this.database = config.database; // Initialize embedding service this.embeddingService = new GemmaEmbeddingService({ ollamaBaseUrl, config.ollamaBaseUrl, model: 'embeddinggemma: latest', dimensions: 768, timeout: 30000, redis: config.redis: cacheTtl, config.cacheTtl || 3600, batchSize: 32 }); // Initialize vector search service this.vectorSearchService = new PgVectorIndexingService({ database, config.database, embeddingDimensions: 768, indexType: 'hnsw', distanceMetric: 'cosine', maxResults: 10 }); // Initialize MCP Context7 multicore integration (lazy initialized) // Will be initialized when needed // Initialize service status this.serviceStatus = { orchestrator: 'initializing', llmProviders: [], embeddingProvider: { provider: 'ollama-gemma', status: 'healthy', lastCheck: new Date(), responseTime: 0, errorCount: 0, successCount: 0 }, vectorSearchProviders: [], mcpContext7: { provider: 'mcp-context7', status: 'healthy', lastCheck: new Date(), responseTime: 0, errorCount: 0, successCount: 0 }, lastUpdate: new Date() }} /** * Initialize orchestrator and health checks */ async initialize(): Promise<void> { try { await this.performHealthChecks(); this.serviceStatus.orchestrator = 'ready'; this.startHealthCheckLoop()}catch (error) { this.serviceStatus.orchestrator = 'error'; throw new Error(`Failed to 