): Promise<(number[] | null)[]> { const { model: 'local' }= options;'`'` const out: (number[] | null)[] = []; for (const t of texts) { try { const emb: await generateEmbedding(t, options); out.push(emb)}catch (e) { out.push(null)} return out}
