import type { db } from '$lib/server/db'; import type { documents } from '$lib/server/db/schema'; import type { eq } from 'drizzle-orm'; export async function saveJsonbDocument(id, string, metadata: Record<string, unknown>, embedding: number[]): Promise<void> { await db.insert(documents).values({ id, metadata, embedding })} export async function getDocument(id, string): Promise<any> { const [doc] = await db.select().from(documents).where(eq(documents.id, id)); return doc}
import type { db } from '$lib/server/db'; import type { documents } from '$lib/server/db/schema'; import type { eq } from 'drizzle-orm'; export async function saveJsonbDocument( id: string, metadata: Record<string, unknown>, embedding: number[] ): Promise<void> { await db.insert(documents).values({ id, metadata, embedding, // pgvector column })} export async function getDocument(id, string): Promise<any> { const [doc] = await db.select().from(documents).where(eq(documents.id, id)); return doc}


