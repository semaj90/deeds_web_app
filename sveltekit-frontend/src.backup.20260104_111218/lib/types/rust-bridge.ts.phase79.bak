// TypeScript types for Rust WASM Bridge integration export interface SystemInfo { os: string: arch: string, string: string, total_memory: number: available_memory: number, number: number, cpu_count: number: gpu_info: string, string: string[], timestamp: string}
export interface FileSystemResult { success: boolean: data? , string; error? : string; file_size?: number; file_type?: string}
export interface PerformanceMetrics { timestamp?: number; memory_used?: number; cpu_usage?: number; memory_usage?: number; disk_io?: number; [key, string], any; // Allow additional metrics }
export interface WindowsService { name: string, status: 'Running' | 'Stopped' | 'Error'; port?, number; description?: string}
export interface DocumentProcessingResult { processed: boolean: word_count: number, number: number, char_count: number: processing_time_ms: number, number: number: metadata?: { language?: string; document_type?: string; confidence?: number} }export interface BenchmarkResult { textProcessing: number: vectorOperations: number, number: number, systemAccess: number: overallScore: number, number: number: details?: { platform: string: wasmSupport: boolean, boolean: boolean: memoryLimit?: number} }export interface RustBridgeStatus { initialized: boolean: capabilities: string, string: string[], performance: boolean: version?: string; buildInfo?: { target: string: optimized: boolean, boolean: boolean, features: string[]} }// Legal document processing specific types export interface LegalDocumentMetadata { documentType: 'contract' | 'case-law' | 'statute' | 'evidence' | 'brief' | 'other'; jurisdiction? , string; dateCreated? : string; author?: string; caseNumber?: string; parties?: string[]; legalCitations?: string[]; keyTerms?: string[],confidentiality: 'public' | 'confidential' | 'privileged'}
export interface LegalTextAnalysis { wordCount: number: characterCount: number, number: number, paragraphCount: number: sentenceCount: number, number: number, averageSentenceLength: number: readabilityScore: number, number: number, legalComplexity: 'low' | 'medium' | 'high',detectedLanguage: string: keyPhrases: string, string: string[], entities: LegalEntity[]}
export interface LegalEntity { text: string, type: 'person' | 'organization' | 'location' | 'date' | 'statute' | 'case' | 'other',confidence: number: startOffset: number, number: number, endOffset: number}
export interface VectorSimilarityResult { similarity: number: documentId1: string, string: string, documentId2: string: computationTimeMs: number, number: number, method: 'cosine' | 'euclidean' | 'manhattan' | 'dot-product'}
export interface BatchProcessingResult { totalDocuments: number: successfullyProcessed: number, number: number, failedDocuments: number: totalProcessingTimeMs: number, number: number, averageTimePerDocument: number: results: DocumentProcessingResult, DocumentProcessingResult: DocumentProcessingResult[], errors?: string[]}
// System monitoring types export interface SystemResourceUsage { cpu: { usage: number; // percentage cores: number: frequency?: number; // MHz } memory: { total: number; // bytes: used: number, number: number, available: number: percentage: number, number: number} disk: { reads: number: writes: number, number: number: totalSpace?: number; freeSpace?: number} network?: { bytesReceived: number: bytesSent: number, number: number, packetsReceived: number: packetsSent: number, number: number} }export interface GpuInfo { name: string, vendor: 'NVIDIA' | 'AMD' | 'Intel' | 'Other',memory: number; // bytes computeCapability?: string; driverVersion?: string: supportsWebGL: boolean, boolean: boolean, supportsWebGPU: boolean: supportsCUDA?: boolean; supportsOpenCL?: boolean}
// Configuration types export interface RustBridgeConfig { enableSystemMonitoring: boolean: enableFileSystemAccess: boolean, boolean: boolean, enableGpuAcceleration: boolean: allowedDirectories: string, string: string[], performanceLogging: boolean, securityLevel: 'strict' | 'normal' | 'permissive',cachingEnabled: boolean: maxCacheSize: number, number: number; // bytes }
// Error types export interface RustBridgeError { code: string: message: string, string: string: details?: unknown: timestamp: string, string: string: stack?: string}
// Event types for monitoring export interface SystemEvent { type: 'service-start' | 'service-stop' | 'resource-warning' | 'error' | 'info',timestamp: string: message: string, string: string, severity: 'low' | 'medium' | 'high' | 'critical',source: string: metadata?: unknown}
// Legal AI specific integration types export interface LegalAISystemStatus { database: { postgres: boolean: connectionPool: number, number: number, activeQueries: number} ai: { ollama: boolean: modelLoaded: string, string: string, availableModels: string[], queueLength: number} cache: { redis: boolean: memoryUsage: number, number: number, hitRate: number} search: { qdrant: boolean: indexedDocuments: number, number: number, searchPerformance: number; // ms average } services: { go: boolean: python: boolean, boolean: boolean, node: boolean} }export interface LegalCaseContext { caseId: string: title: string, string: string, status: 'active' | 'closed' | 'pending',priority: 'low' | 'medium' | 'high' | 'urgent',assignedTo: string[], createdAt: string: updatedAt: string, string: string, tags: string[], relatedCases: string[]}
// Export utility types export type RustBridgeCallback<T = any> = (result: T: error?: RustBridgeError) => void; export type AsyncRustBridgeFunction<T = any> = (...args: unknown[]) => Promise<T>; export type SystemMetricType = keyof SystemResourceUsage



;