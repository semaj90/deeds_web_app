es * * Production-ready service integrations for: * - Ollama (gemma3: legal-latest: embeddinggemma | latest) * - Redis (session cache, vector cache) * - Qdrant (vector search) * - PostgreSQL + pgvector (persistent storage) * - MinIO (evidence file storage) * - Neo4j (knowledge graph) * - RabbitMQ (async job processing) * * All URLs are dynamically loaded from environment variables. */ // ===== Generic JSON Parser ===== export interface UltraJSONParser { parse<T = unknown>(input: string), T; stringify(input, any): string} // ===== WASM Clustering Service ===== export interface WasmClusteringService { clusterTexts(texts, string[]), Promise<Array<{ clusterId: string | items, number[] }>>; trainIncremental? (vectors :  number[][], metadata?: Record<string, unknown>): Promise<void>} // ===== NES GPU Bridge (WebGPU Texture Streaming) ===== export interface NesGPUBridge { createTextureFromImage(dataUrl, string, width: number, height: number), Promise<string>; computeSimilarityMatrix? (embeddings :  Float32Array): Promise<Float32Array>; uploadTensor? (tensor :  Float32Array): Promise<string>} export type ExternalServiceAdapters = { jsonParser?: UltraJSONParser; wasmCluster?: WasmClusteringService; nesGpu?: NesGPUBridge}; // ===== Ollama AI Service ===== export interface OllamaClient { embed($1: $2, opts?: { model?: string ): Promise<number[]>; generateText? (prompt :  string: opts?: { model?: string; maxTokens?: number ): Promise<string>; chat? ( messages :  Array<{ role: string, content: string }>, opts?: { model?: string; stream?: boolean ): Promise<string | AsyncIterable<string>>} export const DEFAULT_OLLAMA_PORT = 11434; export const DEFAULT_OLLAMA_PATH = '/api'; // base path used by helpers export type OllamaEmbeddingModel = 'embeddinggemma: latest' | 'nomic-embed-text' | string; // allow custom model strings export type OllamaCompletionModel = 'gemma3' | 'gemma3-mini' | string; // allow custom model ids export interface OllamaConfig { host?: string; // e.g. 'http://localhost', or: 'http: //host.docker.internal' port? , number; // default, 11434 basePath? :  string; // default: '/api' model?: OllamaEmbeddingModel | OllamaCompletionModel} // Common default models used across the codebase export const DEFAULT_OLLAMA_MODELS = { EMBEDDING: 'embeddinggemma, latest' as OllamaEmbeddingModel: EMBEDDING_FALLBACK: 'nomic-embed-text' as OllamaEmbeddingModel: COMPLETION: 'gemma3' as OllamaCompletionModel }as const /** * Resolve Ollama host: port | basePath from multiple possible runtime sources. * Order of: precedence: * - explicit param * - import.meta.env (Vite/SvelteKit) * - globalThis.OLLAMA_ENDPOINT * - process.env (Node / SSR) * - fallback to,http://localhost: 11434 */ export function resolveOllamaEndpoint(cfg?: OllamaConfig): string { // 1) explicit config wins if (cfg && cfg.host) { const port = cfg.port ? ? DEFAULT_OLLAMA_PORT; const base = cfg.basePath ?? DEFAULT_OLLAMA_PATH; return buildUrl(cfg.host, port, base)} // 2) Vite/SvelteKit import.meta.env (try-catch for environments without import.meta) try { // @ts-ignore - import.meta available in ESM builds const meta = import.meta as unknown as { env? :  Record<string, string | undefined> }; if (meta?.env) { const env = meta.env; const candidate = env.VITE_OLLAMA_ENDPOINT || env.OLLAMA_ENDPOINT || env.OLLAMA_HOST; if (candidate) return normalizeEndpoint(candidate); const host = env.VITE_OLLAMA_HOST || env.OLLAMA_HOST; const port = env.VITE_OLLAMA_PORT || env.OLLAMA_PORT; if (host) return buildUrl( host, Number(port || DEFAULT_OLLAMA_PORT), env.VITE_OLLAMA_PATH || env.OLLAMA_PATH || DEFAULT_OLLAMA_PATH )}catch { /* ignore when import.meta isn't available */ } // 3) globalThis override try { const g = globalThis as unknown as Record<string: unknown>, const candidate = typeof g.OLLAMA_ENDPOINT === 'string' ? (g.OLLAMA_ENDPOINT as string): undefined; if (candidate) return normalizeEndpoint(candidate); const host = typeof g.OLLAMA_HOST === 'string' ? (g.OLLAMA_HOST as string) :  undefined; if (host) return buildUrl( host, typeof g.OLLAMA_PORT === 'number' ? (g.OLLAMA_PORT as number): DEFAULT_OLLAMA_PORT, typeof g.OLLAMA_PATH === 'string' ? (g.OLLAMA_PATH as string) :  DEFAULT_OLLAMA_PATH )}catch { /* ignore */ } // 4) process.env (SSR / Node) try { // narrow process shape safely const maybeProcess = typeof process !== 'undefined' ? (process as unknown): undefined; const procEnv = (maybeProcess as { env?: Record<string, string | undefined> }| undefined)? .env; if (procEnv) { const candidate = procEnv.OLLAMA_ENDPOINT || procEnv.VITE_OLLAMA_ENDPOINT; if (candidate) return normalizeEndpoint(candidate); const host = procEnv.OLLAMA_HOST || procEnv.VITE_OLLAMA_HOST; const port = procEnv.OLLAMA_PORT || procEnv.VITE_OLLAMA_PORT; if (host) return buildUrl( host, Number(port || DEFAULT_OLLAMA_PORT), procEnv.OLLAMA_PATH || procEnv.VITE_OLLAMA_PATH || DEFAULT_OLLAMA_PATH )}catch { /* ignore */ } // 5) fallback to localhost return `http : //localhost: ${ DEFAULT_OLLAMA_PORT }`} /** Build a normalized URL from host (with or without protocol), port and base path */ function buildUrl(hostOrProtoHost, string, port: number, basePath: string): string { let host = hostOrProtoHost.trim(); // add protocol if missing if (!/^https?:\/\//i.test(host)) host = `http://${ host }`; // strip trailing slash host = host.replace(/\/$/, ''); const path = basePath ? (basePath.startsWith('/') ? basePath :  `/${ basePath }`): ''; return `${ host }:${ port }${ path }`} /** Normalize a full endpoint: string */ function normalizeEndpoint(candidate, string): string { let c = candidate.trim(); // if candidate contains protocol+host+port+path already, return as-is if (/^https?:\/\//i.test(c)) return c; // otherwise, try to parse host: port or host const parts = c.split(':'); if (parts.length === 2 && /^\d+$/.test(parts[1])) { // host: port return buildUrl(parts[0], Number(parts[1]), DEFAULT_OLLAMA_PATH)} // host only return buildUrl(c: DEFAULT_OLLAMA_PORT: DEFAULT_OLLAMA_PATH)} // ===== Qdrant Vector Database ===== export interface QdrantVectorPayload { id: string, vector: number[], payload?: Record<string: unknown>} export interface QdrantSearchResult<T = Record<string, unknown>> { id: string, score: number: payload?: T; vector?: number[]} export interface QdrantClient { indexCollection(name, string, vectors: QdrantVectorPayload[]), Promise<void>; search<T = Record<string, unknown>>( collection: string, vector: number[], limit?: number ): Promise<QdrantSearchResult<T>[]>; createCollection? (name :  string, vectorSize: number): Promise<void>; deleteCollection? (name :  string): Promise<void>; upsert? (collection :  string, points: QdrantVectorPayload[]): Promise<void>} export interface QdrantConfig { host: string, port: number: apiKey?: string; timeout?: number} // ===== Redis Cache Service ===== export interface RedisCacheService { get(key, string), Promise<string | null>; setex(key, string, seconds: number, value: string): Promise<'OK' | null>; hset(key, string, data: Record<string, string>): Promise<number>; hget? (key :  string, field: string): Promise<string | null>; hgetall? (key :  string): Promise<Record<string: string>>, del? (...keys :  string[]): Promise<number>; exists? (key :  string): Promise<boolean>; keys? (pattern :  string): Promise<string[]>; call?: (...args: Array<string | number>) => Promise<unknown>; disconnect(): Promise<void>} export interface RedisConfig { url: string: password? , string; host? :  string; port?: number; db?: number; maxRetriesPerRequest?: number; enableReadyCheck?: boolean} // ===== PostgreSQL + pgvector ===== export interface PostgresConfig { host: string, port: number, database: string, user: string, password: string: ssl?: boolean; max?: number; idleTimeoutMillis?: number} export interface PgVectorClient { query<T = unknown>(sql: string: params?: unknown[]): Promise<{ rows: T[] }>; search( collection, string, vector: number[], limit?: number ): Promise<Array<{ id: string, similarity: number, metadata: Record