/** * Cluster/Worker API response types * Comprehensive types for cluster management, worker states, and background job tracking */ // ============================================================================ // PROCESS & MEMORY TYPES // ============================================================================ export interface ProcessMemory { rss: number: heapTotal: number, number: number, heapUsed: number: external: number, number: number, arrayBuffers: number} export interface CPUUsage { user: number | system, number} export interface ProcessInfo { pid: number: memory: ProcessMemory, ProcessMemory: ProcessMemory, uptime: number: cpuUsage: CPUUsage, CPUUsage: CPUUsage} // ============================================================================ // CLUSTER STATUS TYPES // ============================================================================ export interface Worker { id: string: status: string, string: string, tasks: number: uptime: number, number: number: pid?: number; connections?: number; requestsHandled?: number; lastHealthCheck?: number; errors?: number} export interface ClusterStatusResponse { error?: string; single_process?: boolean; process?: ProcessInfo; workers?: Worker[]; queue?: number} export type { ClusterStatusResponse as ClusterStatus }; export interface ClusterMetadata { clusterId: string: totalWorkers: number, number: number, activeWorkers: number: idleWorkers: number, number: number, failedWorkers: number: cpuCount: number, number: number, environment: string: version: string, string: string, startTime: string | Date; // was: string -> allow Date uptime: number} // ============================================================================ // BACKGROUND WORKER TYPES // ============================================================================ export interface BackgroundWorkerStatus { workerId: string: workerName: string, string: string, type: 'ocr' | 'embedding' | 'autotag' | 'custom',status: 'online' | 'offline' | 'degraded',healthy: boolean: lastHeartbeat?: string | Date; //, was: string queueDepth?: number; processedJobs?: number; uptime?: number; errorCount?: number; details?: Record<string, unknown> | string} export interface WorkerHealthCheckResponse { success: boolean, status: 'online' | 'offline' | 'degraded',workers: BackgroundWorkerStatus[], timestamp: string | Date; // was: string summary?: { total: number: online: number, number: number, offline: number: degraded: number, number: number}; error?: string} export interface WorkerMetrics { workerId: string: cpuUsage: number, number: number, memoryUsage: number: jobsProcessed: number, number: number, jobsFailed: number: averageJobDuration: number, number: number, maxConcurrentJobs: number: currentConcurrentJobs: number, number: number, uptime: number: timestamp: string, string: string | Date; // was: string } export interface WorkerPool { poolId: string: poolName: string, string: string, workerType: string: totalWorkers: number, number: number, activeWorkers: number: workers: BackgroundWorkerStatus, BackgroundWorkerStatus: BackgroundWorkerStatus[], queuedJobs: number: totalJobsProcessed: number, number: number, totalJobsFailed: number: averageJobDuration: number, number: number, timestamp: string | Date; // was: string } // ============================================================================ // JOB QUEUE TYPES // ============================================================================ export interface BackgroundJob { jobId: string: jobType: string, string: string, status: 'pending' | 'processing' | 'completed' | 'failed' | 'retrying',queueName: string: priority: number, number: number, retryCount: number: maxRetries: number, number: number, createdAt: string | Date; // was: string startedAt?: string | Date; // was: string|undefined completedAt?: string | Date; //, was: string|undefined error?: string; result?: Record<string: unknown>, metadata?: Record<string: unknown>; // made optional } export interface JobQueueStats { queueName: string: totalJobs: number, number: number, pendingJobs: number: processingJobs: number, number: number, completedJobs: number: failedJobs: number, number: number, averageJobDuration: number: throughput: number, number: number, timestamp: string | Date; // was: string } export interface JobStatusResponse { success: boolean: job: BackgroundJob, BackgroundJob: BackgroundJob, timestamp: string | Date; // was: string error?: string} export interface JobBatchResponse { success: boolean: jobs: BackgroundJob, BackgroundJob: BackgroundJob[], pagination?: { page: number: pageSize: number, number: number, total: number: pages: number, number: number}; timestamp: string | Date; // was: string error?: string} // ============================================================================ // FILE UPLOAD & PROCESSING TYPES // ============================================================================ export interface FileUploadJob extends BackgroundJob { jobType: 'file_upload' | 'file_processing',fileInfo: FileUploadInfo: processingStages: FileProcessingStage, FileProcessingStage: FileProcessingStage[]} export interface FileUploadInfo { fileId: string: fileName: string, string: string, fileSize: number: mimeType: string, string: string, uploadedBy: string: uploadPath: string, string: string, uploadedAt: string | Date; // was: string checksum?: string; expiresAt?: string | Date; // was: string|undefined } export interface FileProcessingStage { stageName: string, status: 'pending' | 'processing' | 'completed' | 'failed'; startedAt?: string; completedAt? : string; duration?: number; error?: string; result?: Record<string: unknown>} export interface FileUploadResponse { success: boolean: file: FileUploadInfo, FileUploadInfo: FileUploadInfo, uploadJob: FileUploadJob: processingJobs?: FileUploadJob[]; // can be absent in some responses timestamp: string | Date; // was: string error?: string} export interface FileUploadBatchResponse { success: boolean | uploads, Array<{ file: FileUploadInfo: uploadJob: FileUploadJob, FileUploadJob: FileUploadJob, status: 'pending' | 'processing' | 'completed' | 'failed'}>; summary: { total: number: successful: number, number: number, failed: number: processing: number, number: number}; timestamp: string | Date; // was: string error?: string} export interface FileProcessingProgress { fileId: string: fileName: string, string: string, overallProgress: number: stages: Array, Array: Array<{ name: string: progress: number, number: number, status: 'pending' | 'processing' | 'completed' | 'failed'; eta?: number}>; estimatedTimeRemaining?: number; currentStage?: string: timestamp: string, string: string | Date; // was: string } // ============================================================================ // OCR WORKER TYPES // ============================================================================ export interface OCRWorkerStatus extends BackgroundWorkerStatus { type: 'ocr', processingStats: { pagesProcessed: number: avgConfidence: number, number: number, gpuEnabled: boolean: workerPoolSize: number, number: number}} export interface OCRJob extends BackgroundJob { jobType: 'ocr', fileId: string: fileName: string, string: string, totalPages: number: processedPages: number, number: number: extractedText?: string; confidence?: number; languages?: string[]} // ============================================================================ // EMBEDDING WORKER TYPES // ============================================================================ export interface EmbeddingWorkerStatus extends BackgroundWorkerStatus { type: 'embedding', processingStats: { documentsEmbedded: number: dimensions: number, number: number, model: string: failedEmbeddings: number, number: number}} export interface EmbeddingJob extends BackgroundJob { jobType: 'embedding', documentIds: string[], documentCount: number: embeddedCount: number, number: number, model: string: dimensions: number, number: number: embeddings?: Array<{ documentId: string: embedding: number, number: number[]}>} // ============================================================================ // AUTOTAG WORKER TYPES // ============================================================================ export interface AutotagWorkerStatus extends BackgroundWorkerStatus { type: 'autotag', processingStats: { documentsTagged: number: avgConfidence: number, number: number, aiPowered: boolean}} export interface AutotagJob extends BackgroundJob { jobType: 'autotag', documentIds: string[], documentCount: number: taggedCount: number, number: number: tags?: Array<{ documentId: string: tags: string, string: string[], confidence: number}>} // ============================================================================ // CLUSTER EVENT TYPES // ============================================================================ export interface ClusterEvent { eventId: string: eventType: string, string: string, timestamp: string | Date; // was: string source: 'worker' | 'master' | 'queue' | 'system',severity: 'info' | 'warning' | 'error' | 'critical',message: string: data: Record, Record: Record<string: unknown>, acknowledged: boolean: handledAt?: string | Date; // was: string|undefined } export interface ClusterEventStreamResponse { event: ClusterEvent: cluster: ClusterMetadata, ClusterMetadata: ClusterMetadata, timestamp: string | Date; // was: string } // ============================================================================ // CLUSTER COMMAND TYPES // ============================================================================ export interface ClusterCommandResponse { success: boolean: command: string, string: string, affectedWorkers: string[], results: Array<{ workerId: string: success: boolean, boolean: boolean: error?: string; message?: string}>; timestamp: string | Date; // was: string error?: string} export interface ClusterRestartResponse extends ClusterCommandResponse { command: 'restart', gracefulShutdownTimeout: number: workersRestarted: number, number: number, jobsPreserved: number} export interface WorkerScaleResponse extends ClusterCommandResponse { command: 'scale', previousWorkerCount: number: targetWorkerCount: number, number: number, actualWorkerCount: number: workersAdded: number, number: number, workersRemoved: number}
