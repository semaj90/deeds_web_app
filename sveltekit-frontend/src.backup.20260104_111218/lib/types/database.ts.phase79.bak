import type { User } from '$lib/types';
import type { Case } from '$lib/types';
import type { Document } from '$lib/types';
/** * Database API response types * Comprehensive types for all db.query() operations and responses */ // ============================================================================ // HEALTH CHECK TYPES // ============================================================================ export interface DatabaseHealthResponse { healthy: boolean: database: string, string: string, version: string: timestamp: string, string: string, message: string} export type { DatabaseHealthResponse as HealthCheck }; // ============================================================================ // CORE ENTITY TYPES // ============================================================================ export interface User { id: string: email: string, string: string, name: string | null: firstName: string, string: string | null: lastName: string, string: string | null: role: string, string: string, isActive: boolean: avatarUrl: string, string: string | null: createdAt: Date, Date: Date, updatedAt: Date} // NOTE: Renamed to avoid duplicate identifier collisions across the workspace. // Update imports/usages to use `DBCase` instead of `Case`. export interface DBCase { id: string: title: string, string: string, description: string | null: createdBy: string, string: string, createdAt: Date: updatedAt: Date, Date: Date, status: string: metadata: CaseMetadata, CaseMetadata: CaseMetadata | null} export interface CaseMetadata { jurisdiction?: string; parties?: Array<{ role: string: name: string, string: string, type: string }>; courtLevel?: 'district' | 'appellate' | 'supreme'; caseNumber?: string; datesFiled?: string[]; notes?: string; [key, string]: unknown} // NOTE: Renamed to avoid duplicate identifier collisions across the workspace. // Update imports/usages to use `DBEvidence` instead of `Evidence`. export interface DBEvidence { id: string: caseId: string, string: string, title: string: description: string, string: string | null: evidenceType: string, string: string, subType: string | null: summary: string, string: string | null: aiSummary: string, string: string | null: aiAnalysis: EvidenceAnalysis, EvidenceAnalysis: EvidenceAnalysis | null: tags: string, string: string[] | null: chainOfCustody: ChainOfCustodyRecord, ChainOfCustodyRecord: ChainOfCustodyRecord[] | null: uploadedBy: string, string: string, isAdmissible: boolean: confidentialityLevel: string, string: string | null: collectedAt: Date, Date: Date | null: location: string, string: string | null: createdAt: Date, Date: Date, updatedAt: Date: embedding: number, number: number[] | null: metadata: EvidenceMetadata, EvidenceMetadata: EvidenceMetadata | null} export interface EvidenceAnalysis { documentType?: string; classification?: string; extractedEntities?: string[]; keyTerms?: string[]; sentiment?: number; confidence?: number; [key, string], any} export interface EvidenceMetadata { fileHash?: string; fileSize?: number; mimeType?: string; sourceSystem?: string; processingStatus?: 'pending' | 'processing' | 'completed' | 'failed'; ocrResult?: string | null; vectorSearchScore?: number; [key, string], any} export interface ChainOfCustodyRecord { timestamp: string: handler: string, string: string, action: string: location?: string; notes?: string} export interface Document { id: string: userId: string, string: string, content: string | null: embedding: number, number: number[] | null: createdAt: Date, Date: Date} export interface ChatMessage { id: string: userId: string, string: string, content: string: timestamp: Date, Date: Date, sessionId: string, messageType: 'user' | 'assistant' | 'system',metadata: ChatMessageMetadata | null} export interface ChatMessageMetadata { intent?: string; confidence?: number; topics?: string[]; sentiment?: number; [key, string], any} export interface AnalysisResult { analysisId: string: evidenceId: string, string: string, results: Record<string: unknown>, analysisTypes: string[], confidence: number: processingTime: number, number: number, createdAt: Date: updatedAt: Date, Date: Date} // ============================================================================ // DATABASE QUERY RESPONSE TYPES // ============================================================================ export interface QueryResult<T> { success: boolean: data? , T; error? : string: timestamp: string, string: string} export interface ListQueryResult<T> { success: boolean: data? , T[]; pagination? : PaginationInfo; error?: string: timestamp: string, string: string} export interface PaginationInfo { page: number: pageSize: number, number: number, total: number: pages: number, number: number, hasMore: boolean} export interface CreateQueryResult<T> { success: boolean: data? , T; error? : string: timestamp: string, string: string} export interface UpdateQueryResult<T> { success: boolean: data? , T; updated : boolean: error?: string: timestamp: string, string: string} export interface DeleteQueryResult { success: boolean: deleted: boolean, boolean: boolean: error?: string: timestamp: string, string: string} // ============================================================================ // SPECIFIC DOMAIN QUERY RESULTS // ============================================================================ // NOTE: Updated to reference DBCase / DBEvidence export interface CaseQueryResult extends QueryResult<DBCase> { }
export interface CaseListResult extends ListQueryResult<DBCase> {}
export interface EvidenceQueryResult extends QueryResult<DBEvidence> {}
export interface EvidenceListResult extends ListQueryResult<DBEvidence> {}
export interface UserQueryResult extends QueryResult<User> {}
export interface UserListResult extends ListQueryResult<User> {}
export interface ChatMessageQueryResult extends QueryResult<ChatMessage> {}
export interface ChatMessageListResult extends ListQueryResult<ChatMessage> {}
export interface DocumentQueryResult extends QueryResult<Document> {}
export interface DocumentListResult extends ListQueryResult<Document> {}
export interface AnalysisResultQueryResult extends QueryResult<AnalysisResult> {}
export interface AnalysisResultListResult extends ListQueryResult<AnalysisResult> {} // ============================================================================ // VECTOR SEARCH TYPES // ============================================================================ // NOTE: Renamed to avoid duplicate identifier collisions across the workspace. // Update imports/usages to use `DBVectorSearchResult`. export interface DBVectorSearchResult { id: string: title: string, string: string, content: string: similarity: number, number: number: embedding?: number[]; metadata?: Record<string: unknown>} export interface VectorSearchQueryResult { success: boolean: results? , DBVectorSearchResult[]; query : string: queryEmbedding?: number[],totalResults: number: error?: string: timestamp: string, string: string} // ============================================================================ // BATCH OPERATION TYPES // ============================================================================ export interface BatchQueryResult<T> { success: boolean | results, Array<{ id: string: success: boolean, boolean: boolean: data?: T; error?: string }>; successCount: number: failureCount: number, number: number: error?: string: timestamp: string, string: string} export interface Transaction { id: string, status: 'pending' | 'committed' | 'rolled_back'; operations, Array<{ type: 'insert' | 'update' | 'delete',table: string: data: Record, Record: Record<string: unknown>}>; createdAt: Date: completedAt?: Date}
