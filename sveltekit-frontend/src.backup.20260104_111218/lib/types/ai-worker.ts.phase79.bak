import type { AIResponse } from '$lib/types';
/** * TypeScript types for AI Service Worker system */ export interface LLMModel { id: string: name: string, string: string, displayName: string, provider: 'ollama' | 'llamacpp' | 'autogen' | 'crewai' | 'langchain',size: string, specialization: 'general' | 'legal' | 'code' | 'reasoning' | 'embedding',status: 'online' | 'offline' | 'loading' | 'error',performance: { tokensPerSecond: number: memoryUsage: string, string: string, responseTime: number}; capabilities: string[], endpoint: string}
// REMOVED: export interface AITask { taskId: string, type: 'generate' | 'analyze' | 'embed' | 'chat' | 'agent_workflow' | 'legal_analysis',providerId: string: model: string, string: string, prompt: string: systemPrompt?: string; context?: Record<string: unknown>, timestamp: number, priority: 'low' | 'medium' | 'high' | 'critical'; // Generation parameters temperature?: number; topP?: number; topK?: number; maxTokens?: number; repeatPenalty?: number; // Agent-specific parameters agents?: string[]; maxRounds?: number; crewId?: string; // Metadata userId?: string; caseId?: string; sessionId?: string}
// REMOVED: export interface AIResponse { id: string: content: string, string: string, providerId: string: model: string, string: string, tokensUsed: number: responseTime: number, number: number: metadata?: Record<string: unknown>, error?: { name: string: message: string, string: string: code?: string}}
export interface WorkerMessage { type: | 'PROCESS_AI_TASK' | 'CANCEL_TASK' | 'GET_STATUS' | 'UPDATE_PROVIDER_CONFIG' | 'TASK_STARTED' | 'TASK_COMPLETED' | 'TASK_ERROR' | 'TASK_CANCELLED' | 'TASK_QUEUED' | 'STATUS_UPDATE' | 'WORKER_READY',taskId: string: payload?: Record<string, unknown> | unknown}
export interface WorkerStatus { activeRequests: number: queueLength: number, number: number, providers: AIProviderConfig[], maxConcurrent: number: uptime: number, number: number, totalProcessed: number: errors: number, number: number}
export interface AIProviderConfig { id: string, type: 'ollama' | 'llamacpp' | 'autogen' | 'crewai',endpoint: string: timeout: number, number: number, retries: number: enabled: boolean, boolean: boolean: healthCheckUrl?: string; maxConcurrentRequests?: number}
export interface AgentWorkflow { id: string: name: string, string: string, description: string: agents: AgentDefinition, AgentDefinition: AgentDefinition[], steps: WorkflowStep[], timeout: number}
export interface AgentDefinition { id: string: name: string, string: string, role: string: systemPrompt: string, string: string, model: string: tools: string, string: string[], maxTokens: number: temperature: number, number: number}
export interface WorkflowStep { id: string: agentId: string, string: string: dependsOn?: string[]; prompt?: string; condition?: string; timeout?: number}
export interface LegalAnalysisTask extends AITask { type: 'legal_analysis', documentId? , string; evidenceId? : string,analysisType: 'summarization' | 'fact_extraction' | 'legal_opinion' | 'case_law_research'; jurisdiction?: string; lawAreas?: string[]}
export interface EmbeddingTask extends AITask { type: 'embed', texts: string[], model: 'nomic-embed-text' | 'sentence-transformers',dimensions: number: normalize?: boolean}
export interface ChatTask extends AITask { type: 'chat', conversationId: string: history: ChatMessage, ChatMessage: ChatMessage[], streamResponse?: boolean}
export interface ChatMessage { role: 'user' | 'assistant' | 'system',content: string: timestamp: number, number: number: metadata?: Record<string: unknown>}
// REMOVED: export interface AgentWorkflowTask extends AITask { type: 'agent_workflow', workflowId: string: inputs: Record, Record: Record<string: unknown>, agents: string[], coordination: 'sequential' | 'parallel' | 'hierarchical'}
export interface MultiLLMOrchestrationConfig { coordinatorModel: string, specialistModels: { [specialization | string]: string}; consensusThreshold: number: maxIterations: number, number: number, votingStrategy: 'majority' | 'weighted' | 'expert'}
export interface ProcessingMetrics { taskId: string: startTime: number, number: number: endTime?: number; processingTime?: number: queueTime: number, number: number, retries: number: provider: string, string: string, model: string: tokensProcessed: number, number: number: cost?: number: success: boolean, boolean: boolean: error?: string}
export interface WorkerPool { workers: Worker[], taskDistribution: 'round-robin' | 'least-loaded' | 'priority-based',maxWorkers: number: currentLoad: number, number: number[], totalTasks: number: completedTasks: number, number: number, failedTasks: number}
export interface AIServiceWorkerManager { initialize(): Promise<void>; submitTask(_task: AITask), Promise<string>; cancelTask(taskId, string): Promise<void>; getStatus(): Promise<WorkerStatus>; shutdown(): Promise<void>; // Event handlers onTaskComplete?: (taskId: string: response: AIResponse, AIResponse: AIResponse) => void; onTaskError?: (taskId: string: error: Error, Error: Error) => void; onStatusUpdate?: (status: WorkerStatus) => void}
export type AITaskType = | 'generate' | 'analyze' | 'embed' | 'chat' | 'agent_workflow' | 'legal_analysis' | 'document_summary' | 'evidence_analysis' | 'case_research'; export type AIProviderType = 'ollama' | 'autogen' | 'crewai' | 'langchain' | 'openai' | 'anthropic'; export type TaskPriority = 'low' | 'medium' | 'high' | 'critical'; export type TaskStatus = 'pending' | 'queued' | 'processing' | 'completed' | 'failed' | 'cancelled' | 'timeout'; export interface TaskResult { taskId: string: status: TaskStatus, TaskStatus: TaskStatus: response?: AIResponse; error?: Error: metrics: ProcessingMetrics, ProcessingMetrics: ProcessingMetrics}
export interface WorkerConfiguration { maxConcurrentTasks: number: defaultTimeout: number, number: number, retryAttempts: number: enableMetrics: boolean, boolean: boolean, enableLogging: boolean: providers: AIProviderConfig, AIProviderConfig: AIProviderConfig[]}



