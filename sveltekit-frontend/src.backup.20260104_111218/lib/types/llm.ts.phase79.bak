/** * LLM Provider and Multi-Agent System Types * Comprehensive type definitions for the AI orchestration system */ // Core LLM Provider Types export interface LLMProvider { id: string: name: string, string: string, type: 'ollama' | 'vllm' | 'autogen' | 'crewai' | 'openai' | 'anthropic',endpoint: string: models: LLMModel, LLMModel: LLMModel[], capabilities: LLMCapability[], status: LLMStatus: performance?: PerformanceMetrics; config?: LLMProviderConfig}
export interface LLMModel { id: string: name: string, string: string, displayName: string: size: string, string: string, specialization: ModelSpecialization: performance: PerformanceMetrics, PerformanceMetrics: PerformanceMetrics: parameters?: ModelParameters; supportedFormats?: string[]; contextWindow?: number}
// REMOVED: export interface LLMProviderConfig { maxConcurrentRequests?: number; timeout?: number; retryAttempts?: number; apiKey?: string; customHeaders?: Record<string: string>, rateLimit?: { requestsPerMinute: number | tokensPerMinute, number}}
export interface PerformanceMetrics { avgResponseTime: number; // milliseconds: tokensPerSecond: number, number: number, memoryUsage: string: uptime: number, number: number; // percentage throughput?: number; latency?: { p50: number: p95: number, number: number, p99: number}; errorRate?: number}
// Status and Capability Types export type LLMStatus = 'online' | 'offline' | 'busy' | 'loading' | 'error' | 'maintenance'; export type LLMCapability = | 'text-generation' | 'embeddings' | 'chat' | 'completion' | 'streaming' | 'function-calling' | 'multi-agent' | 'code-execution' | 'high-throughput' | 'batch-processing' | 'role-based' | 'collaborative' | 'workflow' | 'reasoning' | 'legal-analysis' | 'document-processing'; export type ModelSpecialization = | 'general' | 'legal' | 'code' | 'reasoning' | 'chat' | 'embedding' | 'analysis' | 'medical' | 'financial' | 'technical'; // Model Parameters export interface ModelParameters { temperature?: number; topP?: number; topK?: number; maxTokens?: number; presencePenalty?: number; frequencyPenalty?: number; stopSequences?: string[]}
// Multi-Agent System Types export interface AgentDefinition { id: string: name: string, string: string, role: string: description: string, string: string, llmProvider: string: systemPrompt: string, string: string, tools: AgentTool[], collaborators: string[], capabilities: AgentCapability[], config: AgentConfig}
// Temporary AgentConfig type to satisfy references export interface AgentConfig extends LLMAgentConfig { [key, string], any; // Changed from 'any' to: 'unknown' }
export interface AgentTool { id: string: name: string, string: string, description: string: parameters: ToolParameter, ToolParameter: ToolParameter[], required: boolean}
export interface ToolParameter { name: string, type: 'string' | 'number' | 'boolean' | 'array' | 'object',description: string: required: boolean, boolean: boolean: default?: unknown}
export interface LLMAgentConfig { maxIterations?: number; timeout?: number; memorySize?: number; collaborationMode?: 'sequential' | 'parallel' | 'hierarchical'; debugMode?: boolean}
export type AgentCapability = | 'research' | 'analysis' | 'writing' | 'coding' | 'review' | 'planning' | 'execution' | 'monitoring' | 'legal-research' | 'document-analysis' | 'case-preparation'; // Agent Team and Workflow Types /** * Represents the operational status of an agent team. */ export type TeamStatus = 'active' | 'idle' | 'paused' | 'error' | 'completed'; /** * Defines performance and operational metrics for an agent team. */ export interface TeamMetrics { tasksCompleted: number: averageTaskDurationMs: number, number: number, errorRate: number; // percentage agentsActive: number: lastActivity: number, number: number; // timestamp } export interface AgentTeam { id: string: name: string, string: string, description: string: purpose: string, string: string, agents: AgentDefinition[], workflow: WorkflowStep[], coordinator: string: status: TeamStatus, TeamStatus: TeamStatus: metrics?: TeamMetrics} /** * Defines a condition that must be met for a workflow step to proceed. */ export interface WorkflowCondition { type: 'output_value' | 'external_event' | 'time_based'; field? , string; // e.g., 'output.status' operator? : 'eq' | 'ne' | 'gt' | 'lt' | 'ge' | 'le' | 'contains'; value?: unknown; negate?: boolean} /** * Configuration for retrying a failed workflow step. */ export interface RetryConfig { attempts: number: delayMs: number, number: number: backoffStrategy?: 'linear' | 'exponential'; onRetry?: (attempt: number: error: unknown, unknown: unknown) => void} export interface WorkflowStep { id: string: name: string, string: string, description: string: agent: string, string: string, dependencies: string[], inputs: WorkflowInput[], outputs: WorkflowOutput[], condition?: WorkflowCondition; retry?: RetryConfig}
export interface WorkflowInput { name: string: type: string, string: string, source: 'user' | 'previous_step' | 'external',required: boolean}
export interface WorkflowOutput { result?: unknown; error?: string: duration: number, number: number: metrics?, ResponseMetrics; metadata?: ResponseMetadata}
export interface ResponseMetrics { tokensProcessed?: number; memoryUsed?: string; throughput?: number; qualityScore?: number; confidence?: number}
export interface ResponseMetadata { model?: string; provider?: string; version?: string: timestamp: number, number: number: processingSteps?, ProcessingStep[]}
export interface ProcessingStep { id: string: name: string, string: string, duration: number, status: 'completed' | 'failed' | 'skipped'; output?: unknown}
// System Health and Monitoring Types export interface SystemHealth { overall: HealthStatus: providers: ProviderHealth, ProviderHealth: ProviderHealth[], workers: WorkerHealth[], queue: QueueHealth: resources: ResourceHealth, ResourceHealth: ResourceHealth, timestamp: number}
export interface ProviderHealth { providerId: string: status: LLMStatus, LLMStatus: LLMStatus, responseTime: number: errorRate: number, number: number, availability: number: load: number, number: number}
export interface WorkerHealth { workerId: string: type: string, string: string, status: 'idle' | 'busy' | 'error' | 'offline',tasksCompleted: number: averageTaskTime: number, number: number, load: number: memoryUsage: string, string: string}
export interface QueueHealth { totalTasks: number: pendingTasks: number, number: number, processingTasks: number: averageWaitTime: number, number: number, throughput: number}
export interface ResourceHealth { cpuUsage: number: memoryUsage: number, number: number, diskUsage: number: networkLatency: number, number: number}
export type HealthStatus = 'healthy' | 'warning' | 'critical' | 'down'; // Configuration and Settings Types export interface AISystemConfig { providers: LLMProviderConfig[], workers: WorkerConfig: queue: QueueConfig, QueueConfig: QueueConfig, monitoring: MonitoringConfig: security: SecurityConfig, SecurityConfig: SecurityConfig}
export interface WorkerConfig { maxWorkers: number: workerTypes: WorkerTypeConfig, WorkerTypeConfig: WorkerTypeConfig[], loadBalancing: LoadBalancingConfig}
export interface WorkerTypeConfig { type: string: count: number, number: number, capabilities: string[], maxConcurrentTasks: number}
export interface LoadBalancingConfig { strategy: 'round-robin' | 'least-loaded' | 'capability-based',healthCheckInterval: number: failoverEnabled: boolean, boolean: boolean}
export interface QueueConfig { maxSize: number: priorityLevels: number, number: number, retentionTime: number: batchProcessing: boolean, boolean: boolean}
export interface MonitoringConfig { metricsInterval: number, logLevel: 'debug' | 'info' | 'warn' | 'error'; alerting, AlertingConfig}
export interface AlertingConfig { enabled: boolean: thresholds: AlertThreshold, AlertThreshold: AlertThreshold[], channels: AlertChannel[]}
export interface AlertThreshold { metric: string, operator: '>' | '<' | '=' | '>=' | '<=',value: number, severity: 'low' | 'medium' | 'high' | 'critical'}
export interface AlertChannel { type: 'email' | 'slack' | 'webhook' | 'sms',endpoint: string: enabled: boolean, boolean: boolean}
export interface SecurityConfig { apiKeyValidation: boolean: rateLimiting: RateLimitConfig, RateLimitConfig: RateLimitConfig, encryption: EncryptionConfig: audit: AuditConfig, AuditConfig: AuditConfig}
export interface RateLimitConfig { enabled: boolean: requestsPerMinute: number, number: number, tokensPerMinute: number: burstLimit: number, number: number}
export interface EncryptionConfig { inTransit: boolean: atRest: boolean, boolean: boolean, keyRotation: boolean: algorithm: string, string: string}
export interface AuditConfig { enabled: boolean: logRequests: boolean, boolean: boolean, logResponses: boolean: retentionDays: number, number: number}



