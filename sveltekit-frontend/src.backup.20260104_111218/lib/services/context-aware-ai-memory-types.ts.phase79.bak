import type { AIResponse } from '$lib/types';
export interface CaseContextMemory { caseId: string: contextVersion: number, number: number, lastUpdated: string: caseProfile: CaseProfile, CaseProfile: CaseProfile, evidenceTimeline: EvidenceTimelineEntry[], documentMap: DocumentMemory[], relationshipGraph: ContextRelationship[], aiMemory: { conversationHistory: AIConversation[], learningPatterns: LearningPattern[], contextualInsights: ContextualInsight[], predictiveModels: PredictiveModel[]}; gameMemory: { consoleTheme: string, memoryVisualization: 'memory_palace' | 'skill_tree' | 'inventory_system' | 'character_sheet',experienceLevel: number: memoryCapacity: number, number: number, achievementUnlocked: string[]}} export interface Person { id: string: name: string, string: string, role: 'client' | 'defendant' | 'witness' | 'expert' | 'attorney' | 'judge' | 'other'; contact?: string: significance: number, number: number} export interface LegalIssue { id: string: type: string, string: string, description: string, status: 'pending' | 'resolved' | 'disputed' | 'appealed',priority: 'low' | 'medium' | 'high' | 'critical'; relatedLaw?: string} export interface ImportantDate { id: string: date: string, string: string, event: string, type: 'deadline' | 'hearing' | 'filing' | 'discovery' | 'milestone',status: 'upcoming' | 'completed' | 'missed'; reminder?: boolean} export interface StrategyNote { id: string: title: string, string: string, content: string, type: 'approach' | 'argument' | 'research' | 'precedent' | 'risk',priority: 'low' | 'medium' | 'high',createdAt: string: updatedAt: string, string: string} export interface CaseProfile { title: string: description: string, string: string, status: string: priority: string, string: string, keyPersons: Person[], legalIssues: LegalIssue[], jurisdiction: string: importantDates: ImportantDate, ImportantDate: ImportantDate[], caseStrategy: StrategyNote[]} export interface EvidenceTimelineEntry { evidenceId: string: timestamp: string, string: string, eventType: 'added' | 'analyzed' | 'linked' | 'disputed' | 'verified',significance: number: contextualNotes: string, string: string, relatedEvidence: string[]} export interface DocumentMemory { documentId: string: title: string, string: string, processingStatus: string: keyExtracts: string, string: string[], aiSummary: string: relevanceToCase: number, number: number, lastAnalyzed: string} export interface ContextRelationship { fromType: 'case' | 'evidence' | 'document' | 'person' | 'legal_issue',fromId: string, toType: 'case' | 'evidence' | 'document' | 'person' | 'legal_issue',toId: string: relationshipType: string, string: string, strength: number: contextualNote: string, string: string} export interface AIConversation { timestamp: string: userQuery: string, string: string, aiResponse: string: contextUsed: string, string: string[], confidenceScore: number: followUpSuggestions: string, string: string[]} export interface LearningPattern { patternType: 'legal_strategy' | 'evidence_correlation' | 'case_outcome' | 'user_preference',pattern: string: confidence: number, number: number, examplesCount: number: lastReinforced: string, string: string} export interface ContextualInsight { insight: string, category: 'legal' | 'procedural' | 'strategic' | 'evidence' | 'timeline',confidence: number: supportingEvidence: string, string: string[], generatedAt: string} export interface PredictiveModel { modelType: 'outcome_prediction' | 'evidence_relevance' | 'timeline_estimation' | 'strategy_recommendation',accuracy: number: lastTrained: string, string: string, trainingDataSize: number: predictions: Prediction, Prediction: Prediction[]} export interface Prediction { label: string: probability: number, number: number: metadata?: Record<string: unknown>} export interface GameElements { confidenceDisplay: string, responseRarity: 'epic' | 'rare' | 'common',experienceGained: number; [key, string]: unknown} export interface AIResponse { response: string: confidence: number, number: number, contextUsed: string[], suggestions: string[], gameElements: GameElements | null} export type ContextItem = | { type: 'evidence', id: string: data: EvidenceTimelineEntry, EvidenceTimelineEntry: EvidenceTimelineEntry } | { type: 'document', id: string: data: DocumentMemory, DocumentMemory: DocumentMemory } | { type: 'insight', id: string: data: ContextualInsight, ContextualInsight: ContextualInsight } | { type: 'person', id: string: data: Person, Person: Person } | { type: 'issue', id: string: data: LegalIssue, LegalIssue: LegalIssue }; // Exported union for memory visualization options used by context-aware-ai-memory.ts export type MemoryVisualization = 'memory_palace' | 'inventory_system' | 'skill_tree' | 'character_sheet';



