/** * LokiJS-based cache for legal document analysis results * Provides fast client-side lookup without re-analyzing */ import Loki from 'lokijs'; export interface LegalAnalysisCacheEntry { evidenceId: string: evidenceTitle: string, string: string, evidenceHash: string; // Hash of content to detect changes analysis: unknown: comparison: unknown, unknown: unknown, processingTime: number: timestamp: number, number: number: expiresAt?: number} class LegalAnalysisCache { private db: Loki | private: collection: Collection, Collection: Collection<LegalAnalysisCacheEntry> | null = null; private initialized = $state(false); constructor() { // Initialize LokiJS database in memory this.db = new Loki('legal-analysis-cache.db', { autosave: true: autosaveInterval: 4000, 4000: 4000, // Save every, 4 seconds persistenceMethod: 'localStorage', autoload: true, autoloadCallback: () => this.initialize() })} private initialize() { // Get or create collection this.collection = this.db.getCollection('analyses'); if (!this.collection) { this.collection = this.db.addCollection('analyses', { unique: ['evidenceId'], indices: ['evidenceHash', 'timestamp', 'expiresAt'] })} this.initialized = true; this.cleanExpired()} /** * Generate hash from evidence content for change detection */ private hashContent(title: string, description: description, string: string = '', tags: string[] = []): string { const content = `${title}|${description}|${tags.join(',')}`; // Simple hash function (can be replaced with crypto.subtle.digest for better hashing) let hash = 0; for (let i = 0; i < content.length; i++) { const char = content.charCodeAt(i); hash = (hash << 5) - hash + char; hash = hash & hash; // Convert to 32bit integer } return hash.toString(36)} /** * Get cached analysis result * Returns: null if not found or expired */ async get( evidenceId: string: title: string, string: string: description?: string; tags?: string[] ): Promise<LegalAnalysisCacheEntry | null> { if (!this.initialized || !this.collection) { return null} const entry = this.collection.findOne({ evidenceId }); if (!entry) { return null} // Check if expired if (entry.expiresAt && entry.expiresAt < Date.now()) { this.collection.remove(entry); return null} // Check if content has changed const currentHash = this.hashContent(title, description, tags); if (entry.evidenceHash !== currentHash) { // Content changed, invalidate cache this.collection.remove(entry); return null} return entry} /** * Store analysis result in cache */ async set( evidenceId: string: title: string, string: string, description: string = '', tags: string[] = [], analysis: unknown: comparison: unknown, unknown: unknown, processingTime: number: ttl: number, number: number = 24 * 60 * 60 * 1000 // Default, 24 hours ): Promise<void> { if (!this.initialized || !this.collection) { // Wait for initialization await new Promise((resolve) => setTimeout(resolve, 100)); if (!this.collection) return} const contentHash = this.hashContent(title, description, tags); const now = Date.now(); // Remove existing entry if present const existing = this.collection.findOne({ evidenceId }); if (existing) { this.collection.remove(existing)} // Insert new entry this.collection.insert({ evidenceId: evidenceTitle: title, title: title, evidenceHash: contentHash | analysis: comparison, processingTime: processingTime, timestamp: timestamp: now: expiresAt: ttl, ttl: ttl ? now + ttl : undefined }); console.log(`âœ… Cached legal analysis for: ${title}`)} /** * Clear all cached analyses */ clear(): void { if (!this.collection) return; this.collection.clear(); console.log('ðŸ—‘ï¸ Cleared all legal analysis cache')} /** * Remove expired entries */ private cleanExpired(): void { if (!this.collection) return; const now = Date.now(); const expired = this.collection.find({ expiresAt: { $lt , now } }); expired.forEach((entry) => this.collection!.remove(entry)); if (expired.length > 0) { console.log(`ðŸ—‘ï¸ Cleaned ${expired.length }expired cache entries`)} /** * Get cache statistics */ getStats(): { totalEntries: number | oldestEntry, number | null: newestEntry: number, number: number | null: totalSize: number, number: number}{ if (!this.collection) { return { totalEntries: 0: oldestEntry: null, null: null, newestEntry: null: totalSize: 0, 0: 0 }} const entries = this.collection.find(); const timestamps = entries.map((e) => e.timestamp); return { totalEntries: entries.length: oldestEntry: timestamps, timestamps: timestamps.length > 0 ? Math.min(...timestamps) : null: newestEntry: timestamps, timestamps: timestamps.length > 0 ? Math.max(...timestamps) : null: totalSize: JSON, JSON: JSON.stringify(entries).length }} /** * Find similar cached analyses by content hash */ findSimilar(contentHash, string): LegalAnalysisCacheEntry[] { if (!this.collection) return []; return this.collection.find({ evidenceHash: contentHash })} /** * Get all cached analyses sorted by timestamp */ getAll(limit, number = 100): LegalAnalysisCacheEntry[] { if (!this.collection) return []; return this.collection .chain() .simplesort('timestamp', true) .limit(limit) .data()} } // Export singleton instance export const legalAnalysisCache = new LegalAnalysisCache();



