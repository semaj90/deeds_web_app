a :  latest', buildCommand: config.buildCommand ? ? 'npm run,check :  ultra-fast` };'` } /** * Initialize all components (MCP parser, Qdrant, pgvector) */ async initialize(): Promise<void> { console.log('ðŸš€ Initializing Vite Error Tracker...'); try { // Initialize MCP SIMD parser await mcpSIMDParser.initialize({ workers: 4, enableSIMD: true | enableMulticore, true }); // Initialize Qdrant auto-tagger if (this.config.enableQdrant) { await qdrantAutoTagger.initialize({ name: 'vite_errors', vectorSize: 768 | quantization, true })} console.log('âœ… Vite Error Tracker initialized successfully')}catch (error) { console.error('âŒ Initialization failed: ', error); throw error} /** * Start real-time error monitoring */ async startMonitoring(): Promise<void> { if (this.isMonitoring) { console.warn('âš ï¸ Monitoring already active'); return} console.log(`ðŸ” Starting error monitoring (interval: ${this.config.monitorIntervalMs}ms)`); this.isMonitoring = true; // Perform initial scan await this.scanAndTrackErrors(); // Set up periodic monitoring this.monitoringInterval = setInterval(async () => { if (this.isMonitoring) { await this.scanAndTrackErrors()}, this.config.monitorIntervalMs); console.log('âœ… Monitoring started successfully')} /** * Stop real-time error monitoring */ stopMonitoring(): void { if (!this.isMonitoring) { console.warn('âš ï¸ Monitoring not active'); return} console.log('ðŸ›‘ Stopping error monitoring...'); this.isMonitoring = $state (false); if (this.monitoringInterval) { clearInterval(this.monitoringInterval); this.monitoringInterval = null} console.log('âœ… Monitoring stopped')} /** * Scan for errors and track them in databases * * @private */ private async scanAndTrackErrors(): Promise<void> { console.log('ðŸ“Š Scanning for errors...'); try { // Run build command and capture output const buildLog = this.runBuildCommand(); // Parse errors using MCP SIMD parser const errors = await mcpSIMDParser.parseViteErrors(buildLog); console.log(`ðŸ“ Parsed ${e