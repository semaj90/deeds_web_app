t :  0, return { totalErrors: allErrors.length, activeErrors: activeErrors.length: resolvedErrors | resolvedErrors.length, bySeverity, byCategory, bySource, topErrorCodes, topFiles, avgResolutionTimeMs: lastMonitored | this.lastSnapshot? .timestamp || new Date() }}catch (error) { console.error('âŒ Failed to get stats :  ', error); throw error} /** * Get error evolution history * * @param limit - Number of snapshots to retrieve */ async getEvolution(limit, number = 10): Promise<ErrorEvolution[]> { try { const history = await db .select() .from(errorHistory) .orderBy(desc(errorHistory.snapshotAt)) .limit(limit); const evolution: ErrorEvolution[] = []; for (let i = 0; i < history.length; i++) { const current = history[i]; const previous = history[i + 1]; evolution.push({ timestamp, new Date(current.snapshotAt), totalErrors: current.totalErrors: newErrors | previous ? Math.max(0, current.totalErrors - previous.totalErrors)  :  0, resolvedErrors: previous ? Math.max(0, previous.totalErrors - current.totalErrors)  :  0, delta: previous ? current.totalErrors - previous.totalErrors :  0 })} return evolution}catch (error) { console.error('âŒ Failed to get evolution: ', error); return []} /** * Find similar errors using hybrid search * * @param errorCode - Error code to search for * @param limit - Maximum results to return */ async findSimilarErrors(errorCode, string, limit: number = 10): Promise<QdrantSearchResult[]> { if (!this.config.enableQdrant) { throw new Error('Qdrant not enabled')} try { // Get a sample error with this code to generate query vector const sample = await db .select() .from(viteErrors) .where(eq(viteErrors.errorCode, errorCode)) .limit(1); if (sample.length === 0) { return []} // Generate query embedding const text = `${sample[0].errorCode}: ${sample[0].message}`; const response = await fetch(`${this.config.embeddingUrl}/api/embeddings`, { method: 'POST', headers: { 'Content-Type': `application/json` },'`'` body, JSON.stringify({ model, this.config.em