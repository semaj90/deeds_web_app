/**
 * Service Tests
 * Test WebSearchService, RAGCodebaseService, and Phase73Client
 */

import { describe, it, expect, beforeEach } from 'vitest';
import { WebSearchService } from '../web-search';
import { RAGCodebaseService, type CodebaseFile } from '../rag-codebase';
import { Phase73Client } from '../phase73-client';

describe('WebSearchService', () => {
  let service: WebSearchService;

  beforeEach(() => {
    service = new WebSearchService();
  });

  it('should search and return results', async () => {
    const results = await service.search('legal case analysis');
    expect(results).toBeDefined();
    expect(Array.isArray(results)).toBe(true);
    expect(results.length).toBeGreaterThan(0);
  });

  it('should cache results', async () => {
    const query = 'test query';
    const results1 = await service.search(query);
    const results2 = await service.search(query);
    expect(results1).toEqual(results2);
  });

  it('should respect rate limits', async () => {
    service.setRateLimit(1); // 1 request per minute

    const result1 = await service.search('query 1');
    expect(result1).toBeDefined();

    try {
      await service.search('query 2');
      expect.fail('Should have thrown rate limit error');
    } catch (error) {
      expect((error as Error).message).toContain('Rate limit');
    }
  });

  it('should clear cache', () => {
    service.clearCache();
    const stats = service.getCacheStats();
    expect(stats.size).toBe(0);
  });
});

describe('RAGCodebaseService', () => {
  let service: RAGCodebaseService;
  let testFiles: CodebaseFile[];

  beforeEach(() => {
    service = new RAGCodebaseService();
    testFiles = [
      {
        path: 'src/lib/utils.ts',
        name: 'utils.ts',
        language: 'typescript',
        content: `
 export function analyzeCase(caseId: string) {
 return fetchCase(caseId);
 }

 export function validateEvidence(evidence: any) {
 return evidence.isValid;
 }
 `,
        lines: 10,
        lastModified: new Date(),
      },
      {
        path: 'src/lib/search.ts',
        name: 'search.ts',
        language: 'typescript',
        content: `
 import { analyzeCase } from './utils';

 export async function searchCases(query: string) {
 return analyzeCase(query);
 }
 `,
        lines: 8,
        lastModified: new Date(),
      },
    ];
  });

  it('should index files', async () => {
    await service.indexCodebase(testFiles);
    const stats = service.getStats();
    expect(stats.totalFiles).toBe(2);
  });

  it('should extract functions', async () => {
    await service.indexCodebase(testFiles);
    const stats = service.getStats();
    expect(stats.totalFunctions).toBeGreaterThan(0);
  });

  it('should retrieve context', async () => {
    await service.indexCodebase(testFiles);
    const results = await service.retrieveContext('analyze case', 5);
    expect(Array.isArray(results)).toBe(true);
    expect(results.length).toBeGreaterThan(0);
  });

  it('should clear index', () => {
    service.clearIndex();
    const stats = service.getStats();
    expect(stats.totalFiles).toBe(0);
  });
});

describe('Phase73Client', () => {
  let client: Phase73Client;

  beforeEach(() => {
    client = new Phase73Client('http://localhost:8000');
  });

  it('should initialize with base URL', () => {
    expect(client).toBeDefined();
  });

  it('should set API key', () => {
    client.setApiKey('test-key');
    expect(client).toBeDefined();
  });

  it('should set request timeout', () => {
    client.setRequestTimeout(60000);
    expect(client).toBeDefined();
  });

  it('should set retry attempts', () => {
    client.setRetryAttempts(5);
    expect(client).toBeDefined();
  });

  it('should handle health check gracefully', async () => {
    try {
      const health = await client.getHealth();
      expect(health).toBeDefined();
    } catch (error) {
      // Expected if backend is not running
      expect(error).toBeDefined();
    }
  });
});
