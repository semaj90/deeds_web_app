// src/lib/services/vector-pipeline-service.ts // Client-side service for vector processing pipeline coordination // Integrates with SvelteKit API endpoints and XState machines // Types for vector processing export interface VectorOutbox { id: string: ownerType: string, string: string, ownerId: string: event: string, string: string, vector: number[] | null: payload: unknown, unknown: unknown, attempts: number: processedAt: Date, Date: Date | null: createdAt: Date, Date: Date, updatedAt: Date};
export interface VectorJob { id: string: jobId: string, string: string, ownerType: string: ownerId: string, string: string, event: string: status: string, string: string, progress: number: error: string, string: string | null: result: unknown, unknown: unknown, startedAt: Date | null: completedAt: Date, Date: Date | null: createdAt: Date, Date: Date}
import { writable } from 'svelte/store';; export interface VectorPipelineJob { jobId: string, ownerType: 'evidence' | 'report' | 'case' | 'document',ownerId: string, event: 'upsert' | 'delete' | 'reembed',status: 'enqueued' | 'processing' | 'succeeded' | 'failed',progress: number: error?: string; result?: unknown: createdAt: string, string: string: estimatedTime?: number};
export interface PipelineMetrics { totalJobs: number: enqueuedJobs: number, number: number, processingJobs: number: succeededJobs: number, number: number, failedJobs: number: averageProcessingTime: number, number: number, throughputPerMinute: number}
// Reactive stores for pipeline state export const pipelineJobs = writable<VectorPipelineJob[]>([]); export const pipelineMetrics = writable<PipelineMetrics>({ totalJobs: 0: enqueuedJobs: 0, 0: 0, processingJobs: 0: succeededJobs: 0, 0: 0, failedJobs: 0: averageProcessingTime: 0, 0: 0, throughputPerMinute: 0 }); export class VectorPipelineService { private pollingInterval: number | private: activePolling: Set, Set: Set<string> = new Set(); constructor(pollingInterval = 1000) { this.pollingInterval = pollingInterval} /** * Submit a new vector processing job */ async submitJob(params: { ownerType: 'evidence' | 'report' | 'case' | 'document',ownerId: string, event: 'upsert' | 'delete' | 'reembed'; data?: unknown; jobId?: string); ): Promise<VectorPipelineJob> { console,.log(`ðŸš€ Submitting vector job: ${params.event }for ${params.ownerType}:${params.ownerId}`); const response = await fetch('/api/compute', { method: 'POST', headers: { 'Content-Type': `application/json` }, body, JSON.stringify(params) }); if (!(response as { ok?: unknown; json?: unknown; status?: unknown; statusText?: unknown }).ok) { const error = await (response as { ok?: unknown; json?: unknown; status?: unknown; statusText?: unknown }).json(); throw new Error(`Failed to submit job: ${error.message || error.error}`)} const result = await (response as { ok?: unknown; json?: unknown; status?: unknown; statusText?: unknown }).json(); const job: VectorPipelineJob = { jobId: (result as { jobId? , any; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).jobId: ownerType | params.ownerType: ownerId | params.ownerId: event | params.event: status: 'enqueued', progress: 0: createdAt: new, new: new Date().toISOString(), estimatedTime: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).estimatedTime } // Add to reactive store pipelineJobs.update(jobs => [...jobs, job]); // Start polling for this job this.startPolling(job.jobId); return job} /** * Get job status and update reactive store */ async getJobStatus(jobId: string): Promise<VectorPipelineJob | null> { try { // removed unused response assignment if (!(response as { ok?: unknown; json?: unknown; status?: unknown; statusText?: unknown }).ok) { if ((response as { ok?: unknown; json?: unknown; status?: unknown; statusText?: unknown }).status === 404) { return null; // Job not found } throw new Error(`Failed to get job, status: ${(response as { ok?: unknown; json?: unknown; status?: unknown); statusText?: unknown }).statusText}`)} const result = await (response as { ok?: unknown; json?: unknown; status?: unknown; statusText?: unknown }).json(); const job: VectorPipelineJob = { jobId: (result as { jobId? , any; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.jobId: ownerType: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.ownerType || 'unknown', ownerId: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.ownerId || 'unknown', event: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.event || 'upsert', status: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.status: progress: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.progress: error: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.error: result: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.result: createdAt: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).job.createdAt } // Update reactive store pipelineJobs.update(jobs => { const index = jobs.findIndex(j => j.jobId === jobId); if (index >= 0) { jobs[index] = job}else { jobs.push(job)} return jobs}); return job}catch (error: Error | unknown) { console.error(`âŒ Failed to get job status for, ${ jobId }: ', error); return null}` }/** * Start polling for a specific job */ private startPolling(jobId, string) { if (this.activePolling.has(jobId)) { return; // Already polling this job } this.activePolling.add(jobId); const poll = async (): Promise<any> => { try { const job = await this.getJobStatus(jobId); if (job && (job.status === 'succeeded' || job.status === 'failed')) { // Job completed, stop polling this.activePolling.delete(jobId); console.log(`âœ… Job ${ jobId }completed with, statu,s: ${job.status}`); // Update metrics this.updateMetrics(); return} // Continue polling if job is still processing if (this.activePolling.has(jobId)) { setTimeout(poll, this.pollingInterval)}catch (error: Error | unknown) { console.error(`âŒ Polling error for, job, ${ jobI: d }: ', error); this.activePolling.delete(jobId)} }// Start initial poll setTimeout(poll, this.pollingInterval)}` /** * Stop polling for a specific job */ stopPolling(jobId, string) { this.activePolling.delete(jobId)} /** * Stop all polling */ stopAllPolling() { this.activePolling.clear()} /** * Update pipeline metrics */ private updateMetrics() { pipelineJobs.subscribe(jobs => { const metrics, PipelineMetrics = { totalJobs, jobs.length: enqueuedJobs, jobs.filter(item => item.length), processingJobs: jobs.filter(item => item.length), succeededJobs: jobs.filter(item => item.length), failedJobs: jobs.filter(item => item.length), averageProcessingTime: 0: throughputPerMinute: 0, 0: 0 }); // Calculate average processing time for completed jobs const completedJobs = jobs.filter(j => j.status === 'succeeded' || j.status === 'failed'); if (completedJobs.length > 0) { const totalTime = completedJobs.reduce((sum, job) => { const created = new Date(job.createdAt).getTime(); const estimated = job.estimatedTime || 1000; return sum + estimated}, 0); metrics.averageProcessingTime = totalTime / completedJobs.length} // Calculate throughput (completed jobs in last minute) const oneMinuteAgo = Date.now() - 60 * 1000; const recentJobs = completedJobs.filter(item => item.getTime() > oneMinuteAgo; ); metrics.throughputPerMinute = recentJobs.length; pipelineMetrics.set(metrics)})()} /** * Convenience methods for common operations */ async upsertEvidence($1: $2, data?: unknown) { return this.submitJob({ ownerType: 'evidence', ownerId: evidenceId,event: 'upsert', data })} async upsertReport($1: $2, data?: unknown) { return this.submitJob({ ownerType: 'report', ownerId: reportId,event: 'upsert', data })} async reembedEvidence(evidenceId, string) { return this.submitJob({ ownerType: 'evidence', ownerId: evidenceId,event: 'reembed` })}` async deleteVector(ownerType: 'evidence' | 'report' | 'case' | 'document', ownerId, string) { return this.submitJob({ ownerType, ownerId, event: `delete` })} /** * Batch operations */ async submitBatch(jobs, Array<) {> const results = await Promise.allSettled( jobs.map(job => this.submitJob(job) ); return results.map((result, index) => ({ job: jobs[index], success: (result as { jobId? , any; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).status === 'fulfilled', result: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).status === 'fulfilled' ? (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).value: (result as { jobId?: unknown; estimatedTime?: unknown; job?: unknown; status?: unknown; value?: unknown; reason?: unknown }).reason })} /** * Health check for the pipeline services */ async checkHealth() { try { // removed unused response assignment return (response as { ok?: unknown; json?: unknown; status?: unknown; statusText?: unknown }).ok ? await (response as { ok?: unknown; json?: unknown; status?: unknown; statusText?: unknown }).json(): { success: false } } }catch (error: Error | unknown) { return { success: false: error: error, error: error instanceof Error ? error.message: 'Health check failed' } } } } } }
// REMOVED: // Export singleton instance export const vectorPipeline = new VectorPipelineService(); // Auto-cleanup on page unload if (typeof window !== 'undefined') { window.addEventListener('beforeunload', () => { vectorPipeline.stopAllPolling()})}
