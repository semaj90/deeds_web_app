/**
 * Error handling utilities for the legal dashboard
 */

export interface ErrorContext {
  timestamp: Date;
  stage: string;
  message: string;
  recoverable: boolean;
  retryCount?: number;
  maxRetries?: number;
}

export class DashboardErrorHandler {
  private static readonly MAX_RETRIES = 3;
  private static readonly TIMEOUT_MS = 300000; // 5 minutes
  private static readonly RECONNECT_DELAYS = [1000, 2000, 4000, 8000, 16000]; // exponential backoff

  /**
   * Handle connection error with retry logic
   */
  static handleConnectionError(
    error: Error,
    retryCount: number = 0
  ): {
    shouldRetry: boolean;
    delay: number;
    message: string;
  } {
    const shouldRetry = retryCount < this.MAX_RETRIES;
    const delay = shouldRetry
      ? this.RECONNECT_DELAYS[Math.min(retryCount, this.RECONNECT_DELAYS.length - 1)]
      : 0;

    const message = `Connection error: ${error.message}. ${shouldRetry ? `Retrying in ${delay}ms...` : 'Max retries reached.'}`;

    console.error('[ErrorHandler] Connection error:', { error, retryCount, shouldRetry, delay });

    return { shouldRetry, delay, message };
  }

  /**
   * Handle event parsing error
   */
  static handleParsingError(error: Error, eventData: unknown): void {
    console.error('[ErrorHandler] Event parsing error:', {
      error: error.message,
      eventData,
      timestamp: new Date().toISOString(),
    });

    // Log to error tracking service if available
    this.logToErrorTracking({
      type: 'parsing_error',
      message: error.message,
      data: eventData,
      timestamp: new Date(),
    });
  }

  /**
   * Handle timeout error
   */
  static handleTimeoutError(
    stage: string,
    elapsedMs: number
  ): {
    message: string;
    shouldCancel: boolean;
  } {
    const shouldCancel = elapsedMs > this.TIMEOUT_MS;
    const message = shouldCancel
      ? `Processing timeout: ${stage} exceeded ${this.TIMEOUT_MS}ms limit`
      : `Processing taking longer than expected in ${stage}`;

    console.warn('[ErrorHandler] Timeout warning:', { stage, elapsedMs, shouldCancel });

    return { message, shouldCancel };
  }

  /**
   * Handle processing error
   */
  static handleProcessingError(context: ErrorContext): void {
    console.error('[ErrorHandler] Processing error:', context);

    // Log to error tracking service
    this.logToErrorTracking({
      type: 'processing_error',
      ...context,
    });

    // If not recoverable, notify user
    if (!context.recoverable) {
      this.notifyUser({
        type: 'error',
        title: 'Processing Error',
        message: context.message,
        stage: context.stage,
      });
    }
  }

  /**
   * Handle fallback activation
   */
  static handleFallbackActivation(confidence: number): void {
    console.warn('[ErrorHandler] Fallback activated:', { confidence });

    this.notifyUser({
      type: 'warning',
      title: 'GPU Fallback Active',
      message: `GPU processing unavailable. Using CPU fallback with ${Math.round(confidence * 100)}% confidence.`,
    });
  }

  /**
   * Validate event data
   */
  static validateEventData(data: unknown): { valid: boolean; error?: string } {
    if (typeof data !== 'object' || data === null) {
      return { valid: false, error: 'Event data is not an object' };
    }

    const event = data as Record<string, unknown>;

    // Check required fields
    const requiredFields = [
      'stage',
      'status',
      'page',
      'pages_total',
      'percent',
      'eta',
      'details',
      'timestamp',
    ];
    for (const field of requiredFields) {
      if (!(field in event)) {
        return { valid: false, error: `Missing required field: ${field}` };
      }
    }

    // Validate field types
    if (typeof event.stage !== 'string') {
      return { valid: false, error: 'Invalid stage type' };
    }

    if (typeof event.page !== 'number' || typeof event.pages_total !== 'number') {
      return { valid: false, error: 'Invalid page numbers' };
    }

    if (typeof event.percent !== 'number' || event.percent < 0 || event.percent > 100) {
      return { valid: false, error: 'Invalid percentage' };
    }

    if (typeof event.eta !== 'number' || event.eta < 0) {
      return { valid: false, error: 'Invalid ETA' };
    }

    return { valid: true };
  }

  /**
   * Log error to tracking service
   */
  private static logToErrorTracking(errorData: Record<string, unknown>): void {
    try {
      // Send to error tracking service (e.g., Sentry)
      if (typeof window !== 'undefined' && (window as any).Sentry) {
        (window as any).Sentry.captureException(new Error(JSON.stringify(errorData)));
      }

      // Also log to console in development
      if (import.meta.env.DEV) {
        console.log('[ErrorTracking]', errorData);
      }
    } catch (error) {
      console.error('[ErrorHandler] Failed to log error:', error);
    }
  }

  /**
   * Notify user of error/warning
   */
  private static notifyUser(notification: {
    type: 'error' | 'warning' | 'info';
    title: string;
    message: string;
    stage?: string;
  }): void {
    // This would typically dispatch to a notification store
    console.log('[Notification]', notification);

    // Could also use browser notifications API
    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification(notification.title, {
        body: notification.message,
        icon: notification.type === 'error' ? '⚠️' : 'ℹ️',
      });
    }
  }

  /**
   * Create error boundary for components
   */
  static createErrorBoundary(componentName: string): {
    handleError: (error: Error) => void;
    reset: () => void;
  } {
    return {
      handleError: (error: Error) => {
        console.error(`[ErrorBoundary] Error in ${componentName}:`, error);
        this.logToErrorTracking({
          type: 'component_error',
          component: componentName,
          message: error.message,
          stack: error.stack,
          timestamp: new Date(),
        });
      },
      reset: () => {
        console.log(`[ErrorBoundary] Reset ${componentName}`);
      },
    };
  }
}

export default DashboardErrorHandler;
