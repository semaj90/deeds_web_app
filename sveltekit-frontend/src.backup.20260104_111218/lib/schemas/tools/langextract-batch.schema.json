{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ace.tools.langextract.batch",
  "title": "LangExtractBatchRequest",
  "description": "Batch LangExtract entity/relation extraction",
  "type": "object",
  "required": ["run_id", "docs", "schema"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 8,
      "description": "Unique run identifier"
    },
    "docs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["url", "text_ref"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "text_ref": { "type": "string", "minLength": 8 },
          "title": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["minio", "postgres", "qdrant", "file"]
          }
        },
        "additionalProperties": false
      }
    },
    "schema": {
      "type": "object",
      "required": ["entities", "relations"],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["library", "function", "class", "component", "prop", "event", "error", "type", "interface"]
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["imports", "extends", "depends_on", "deprecated_by", "introduced_in", "exports", "implements"]
          }
        }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "default": "gemma3-legal:latest" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.1 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
