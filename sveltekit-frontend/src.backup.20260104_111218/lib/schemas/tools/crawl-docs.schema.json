{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ace.tools.crawl_docs",
  "title": "CrawlDocsRequest",
  "description": "Crawl and parse documentation/web pages",
  "type": "object",
  "required": ["run_id", "urls"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 8,
      "description": "Unique run identifier"
    },
    "urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "depth": { "type": "integer", "minimum": 0, "maximum": 5, "default": 1 },
          "follow_links": { "type": "boolean", "default": false },
          "priority": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 }
        },
        "additionalProperties": false
      }
    },
    "parsing": {
      "type": "object",
      "properties": {
        "extract_code": { "type": "boolean", "default": true },
        "extract_tables": { "type": "boolean", "default": true },
        "extract_images": { "type": "boolean", "default": false },
        "clean_html": { "type": "boolean", "default": true },
        "selectors": {
          "type": "object",
          "properties": {
            "content": { "type": "string" },
            "exclude": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 10000 },
        "max_concurrent": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "user_agent": { "type": "string" },
        "respect_robots": { "type": "boolean", "default": true },
        "cache_ttl_hours": { "type": "integer", "minimum": 0, "maximum": 720, "default": 24 }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "store_raw": { "type": "boolean", "default": false },
        "store_parsed": { "type": "boolean", "default": true },
        "minio_bucket": { "type": "string", "default": "crawled-docs" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
