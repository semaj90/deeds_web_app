{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ace.tools.scan_repo",
  "title": "ScanRepoRequest",
  "description": "Scans repository using ripgrep/awk for patterns",
  "type": "object",
  "required": ["run_id", "patterns", "paths"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 8,
      "description": "Unique run identifier"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["pattern", "type"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["regex", "literal", "glob"]
          },
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["error", "todo", "import", "function", "class", "type"]
          }
        },
        "additionalProperties": false
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Paths to scan (relative to repo root)"
    },
    "excludes": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["node_modules", ".git", "dist"]
    },
    "options": {
      "type": "object",
      "properties": {
        "caseSensitive": { "type": "boolean", "default": false },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1000 },
        "includeLineNumbers": { "type": "boolean", "default": true },
        "includeContext": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
