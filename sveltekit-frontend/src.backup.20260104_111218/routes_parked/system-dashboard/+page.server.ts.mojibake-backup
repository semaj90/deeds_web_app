e', createdAt, new Date() }} return { // Session data for display ...sessionInfo, // Dashboard data recentCases, recentCriminals }}; export const actions: Actions = { logout: async ({ cookies }) => { // Clear the auth-session cookie cookies.delete('auth-session', { path: '/' });'`'` // Redirect back to homepage after logout throw redirect(303, '/')};
