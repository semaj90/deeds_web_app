ionId, expiresAt, expiresAt.toISOString() } })}catch (error: Error | unknown) { // Use `unknown` and narrow to Error to avoid `any` console.error('[TEST LOGIN] Error: ', error); const message = error instanceof Error ? error.message :  typeof error === 'string' ? error: 'Unknown error'; return json( { success: false, error: message, step: 'general_error` },'` { status: 500 } )}; 

