        <Zap size={ 16 } class="inline" /> Find Similar Docs </button> </div> </div> <!-- Error, Display --> {#if error} <div class="nes-container" style="background: #dc2626;, color: white;"> <p>âŒ { error }</p> </div> {/if} <!-- Embedding, Result --> {#if embeddingResult} <div class="nes-container"> <h2>Embedding Result</h2> <div class="stats-grid"> <div> <p class="text-xs">Strategy</p> <p class="text-lg">{embeddingResult.strategy.toUpperCase()}</p> </div> <div> <p class="text-xs">Model</p> <p class="text-sm">{embeddingResult.model}</p> </div> <div> <p class="text-xs">Duration</p> <p class="text-lg">{embeddingResult.duration.toFixed(2)}ms</p> </div> <div> <p class="text-xs">Dimensions</p> <p class="text-lg">{embeddingResult.embedding.length}</p> </div> </div> <details class="mt-4"> <summary class="cursor-pointer">View Raw Embedding (first, 10 dimensions)</summary> <pre class="text-xs mt-2">{JSON.stringify(embeddingResult.embedding.slice(0, 10), null, 2)}</pre> </details> </div> {/if} <!-- Similarity, Results --> {#if similarityResults.length > 0} <div class="nes-container"> <h2>Similar Documents (Top {similarityResults.length})</h2> {#each similarityResults as doc, idx} <div class="nes-container is-rounded" style="background: #1a1d20;"> <div class="flex justify-between"> <div class="flex-1"> <p class="text-sm">#{idx + 1} - Score: {(doc.score * 100).toFixed(1)}%</p> <p class="text-xs">{doc.text}</p> {#if doc.metadata} <p class="text-xs text-gray-400">Type: {doc.metadata.type}</p> {/if} </div> <!-- Similarity, Bar --> <div class="w-24"> <progress class="nes-progress"
