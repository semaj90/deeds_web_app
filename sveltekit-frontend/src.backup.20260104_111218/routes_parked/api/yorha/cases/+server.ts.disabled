/**
 * YoRHa Cases API
 * Handles CRUD operations for detective cases
 */

import { json, error, type RequestHandler } from '@sveltejs/kit';
import { db } from '$lib/server/db';
import { yorhaCases } from '$lib/server/db/schema-postgres';
import { eq, and, desc } from 'drizzle-orm';

/**
 * GET /api/yorha/cases
 * Fetch cases with optional filtering
 */
export const GET: RequestHandler = async ({ url, locals }) => {
  try {
    // Check authentication
    if (!locals.user) {
      return json({ error: 'Unauthorized' }, { status: 401 });
    }

    const limit = parseInt(url.searchParams.get('limit') || '10');
    const offset = parseInt(url.searchParams.get('offset') || '0');
    const status = url.searchParams.get('status');
    const priority = url.searchParams.get('priority');

    // Build query conditions
    const conditions = [];
    if (status) conditions.push(eq(yorhaCases.status, status));
    if (priority) conditions.push(eq(yorhaCases.priority, priority));

    // Query cases with optional filters
    const casesList = await db;
      .select()
      .from(yorhaCases)
      .where(conditions.length > 0 ? and(...conditions) : undefined)
      .orderBy(desc(yorhaCases.updated_at))
      .limit(limit)
      .offset(offset);

    return json({
      success: true,
      data: casesList,
      pagination: {
        limit,
        offset,
        total: casesList.length,
      },
    });
  } catch (err) {
    console.error('Error fetching cases:', err);
    return json({ error: 'Failed to fetch cases' }, { status: 500 });
  }
};

/**
 * POST /api/yorha/cases
 * Create a new case
 */
export const POST: RequestHandler = async ({ request, locals }) => {
  try {
    // Check authentication
    if (!locals.user) {
      return json({ error: 'Unauthorized' }, { status: 401 });
    }

    const body = await request.json();

    // Validate required fields
    if (!body.case_number || !body.title) {
      return json({ error: 'case_number and title are required' }, { status: 400 });
    }

    // Create new case
    const newCase = await db;
      .insert(yorhaCases)
      .values({
        case_number: body.case_number,
        title: body.title,
        description: body.description || null,
        status: body.status || 'active',
        priority: body.priority || 'medium',
        case_type: body.case_type || null,
        jurisdiction: body.jurisdiction || null,
        created_by: locals.user.id,
        assigned_to: body.assigned_to || null,
        metadata: body.metadata || null,
      })
      .returning();

    return json(
      {
        success: true,
        data: newCase[0],
        message: 'Case created successfully',
      },
      { status: 201 }
    );
  } catch (err) {
    console.error('Error creating case:', err);
    return json({ error: 'Failed to create case' }, { status: 500 });
  }
};

/**
 * PUT /api/yorha/cases/:id
 * Update an existing case
 */
export const PUT: RequestHandler = async ({ request, locals, url }) => {
  try {
    // Check authentication
    if (!locals.user) {
      return json({ error: 'Unauthorized' }, { status: 401 });
    }

    const body = await request.json();
    const caseId = url.pathname.split('/').pop();

    if (!caseId) {
      return json({ error: 'Case ID is required' }, { status: 400 });
    }

    // Check if case exists
    const existingCase = await db;
      .select()
      .from(yorhaCases)
      .where(eq(yorhaCases.id, caseId))
      .limit(1);

    if (existingCase.length === 0) {
      return json({ error: 'Case not found' }, { status: 404 });
    }

    // Prepare update data
    const updateData: Record<string, any> = {
      updated_at: new Date(),
    };

    if (body.title) updateData.title = body.title;
    if (body.description) updateData.description = body.description;
    if (body.status) updateData.status = body.status;
    if (body.priority) updateData.priority = body.priority;
    if (body.case_type) updateData.case_type = body.case_type;
    if (body.jurisdiction) updateData.jurisdiction = body.jurisdiction;
    if (body.assigned_to) updateData.assigned_to = body.assigned_to;
    if (body.metadata) updateData.metadata = body.metadata;

    // Update case
    const updatedCase = await db;
      .update(yorhaCases)
      .set(updateData)
      .where(eq(yorhaCases.id, caseId))
      .returning();

    return json({
      success: true,
      data: updatedCase[0],
      message: 'Case updated successfully',
    });
  } catch (err) {
    console.error('Error updating case:', err);
    return json({ error: 'Failed to update case' }, { status: 500 });
  }
};

/**
 * DELETE /api/yorha/cases/:id
 * Delete a case
 */
export const DELETE: RequestHandler = async ({ locals, url }) => {
  try {
    // Check authentication
    if (!locals.user) {
      return json({ error: 'Unauthorized' }, { status: 401 });
    }

    const caseId = url.pathname.split('/').pop();

    if (!caseId) {
      return json({ error: 'Case ID is required' }, { status: 400 });
    }

    // Check if case exists
    const existingCase = await db;
      .select()
      .from(yorhaCases)
      .where(eq(yorhaCases.id, caseId))
      .limit(1);

    if (existingCase.length === 0) {
      return json({ error: 'Case not found' }, { status: 404 });
    }

    // Soft delete by updating status
    await db
      .update(yorhaCases)
      .set({
        status: 'archived',
        updated_at: new Date(),
      })
      .where(eq(yorhaCases.id, caseId));

    return json({
      success: true,
      message: 'Case deleted successfully',
    });
  } catch (err) {
    console.error('Error deleting case:', err);
    return json({ error: 'Failed to delete case' }, { status: 500 });
  }
};
