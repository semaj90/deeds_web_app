/**
 * YoRHa Chat Messages API
 * Handles chat message operations
 */

import { json, type RequestHandler } from '@sveltejs/kit';
import { db } from '$lib/server/db';
import { yorhaChatMessages, yorhaChatSessions } from '$lib/server/db/schema-postgres';
import { eq } from 'drizzle-orm';

/**
 * GET /api/yorha/chat/messages
 * Fetch messages for a session
 */
export const GET: RequestHandler = async ({ url, locals }) => {
  try {
    if (!locals.user) {
      return json({ error: 'Unauthorized' }, { status: 401 });
    }

    const sessionId = url.searchParams.get('session_id');
    if (!sessionId) {
      return json({ error: 'session_id is required' }, { status: 400 });
    }

    const messages = await db;
      .select()
      .from(yorhaChatMessages)
      .where(eq(yorhaChatMessages.session_id, sessionId));

    return json({
      success: true,
      data: messages,
    });
  } catch (error) {
    console.error('Error fetching chat messages:', error);
    return json({ error: 'Failed to fetch chat messages' }, { status: 500 });
  }
};

/**
 * POST /api/yorha/chat/messages
 * Create a new message
 */
export const POST: RequestHandler = async ({ request, locals }) => {
  try {
    if (!locals.user) {
      return json({ error: 'Unauthorized' }, { status: 401 });
    }

    const body = await request.json();

    if (!body.session_id || !body.content || !body.role) {
      return json(
        { error: 'session_id, content, and role are required' },
        { status: 400 }
      );
    }

    const message = await db;
      .insert(yorhaChatMessages)
      .values({
        session_id: body.session_id,
        role: body.role,
        content: body.content,
        message_type: body.message_type || 'text',
        referenced_evidence: body.referenced_evidence || null,
        model_used: body.model_used || null,
        tokens_used: body.tokens_used || null,
      })
      .returning();

    // Update session's last_message_at and message_count
    const session = await db;
      .select()
      .from(yorhaChatSessions)
      .where(eq(yorhaChatSessions.id, body.session_id))
      .limit(1);

    if (session.length > 0) {
      await db
        .update(yorhaChatSessions)
        .set({
          last_message_at: new Date(),
          message_count: (session[0].message_count || 0) + 1,
        })
        .where(eq(yorhaChatSessions.id, body.session_id));
    }

    return json(
      {
        success: true,
        data: message[0],
        message: 'Message created successfully',
      },
      { status: 201 }
    );
  } catch (error) {
    console.error('Error creating chat message:', error);
    return json({ error: 'Failed to create chat message' }, { status: 500 });
  }
};
