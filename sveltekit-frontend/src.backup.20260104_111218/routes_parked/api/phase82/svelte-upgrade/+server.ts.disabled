import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';

const OLLAMA_ENDPOINT = process.env.OLLAMA_ENDPOINT ?? 'http://127.0.0.1:11434';
const MODEL = process.env.PHASE82_MODEL ?? 'gemma3-legal:latest';

type UpgradeBody = {
	file_path: string;
	original: string;
};

export const POST: RequestHandler = async ({ request }) => {
	try {
		const body = (await request.json()) as Partial<UpgradeBody>;

		if (!body.file_path || !body.original) {
			return json(
				{ error: 'Missing file_path or original' },
				{ status: 400 }
			);
		}

		const prompt = `You are refactoring Svelte components from legacy syntax to Svelte 5 "runes".;

File: ${body.file_path}

TRANSFORMATION RULES:
1. export let → $props(): Replace "export let name;" with "let { name } = $props();"
2. let → $state(): Wrap top-level let declarations: "let count = 0;" → "let count = $state(0);"
3. $: reactive labels → $derived() or $effect():
   - "$: doubled = count * 2;" → "let doubled = $derived(count * 2);"
   - "$: { ... }" → "$effect(() => { ... })"
4. Lifecycle hooks → $effect():
   - onMount → $effect
   - beforeUpdate → $effect.pre
   - afterUpdate → $effect
   - onDestroy → $effect with return cleanup function
5. Remove lifecycle imports: Delete "import { onMount, onDestroy, ... } from 'svelte';"

IMPORTANT:
- Do NOT change component behavior
- Preserve all HTML, CSS, and logic
- Return ONLY valid Svelte 5 code, no explanation
- Use $state() for arrays and objects (they become deeply reactive)
- Use $derived() for computed values
- Use $effect() for side effects and lifecycle
- Destructure $props() for component inputs

Legacy file contents:
\`\`\`svelte
${body.original}
\`\`\`

Now output the upgraded Svelte 5 version of this file:`;

		const res = await fetch(`${OLLAMA_ENDPOINT}/api/chat`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				model: MODEL,
				stream: false,
				messages: [
					{
						role: 'system',
						content:
							'You are a precise Svelte code-modding assistant. You output only code.'
					},
					{
						role: 'user',
						content: prompt
					}
				]
			})
		});

		if (!res.ok) {
			const text = await res.text();
			console.error('[phase82/svelte-upgrade] Ollama error:', res.status, text);
			return json(
				{ error: `Ollama returned ${res.status}` },
				{ status: 502 }
			);
		}

		const data = (await res.json()) as { message?: { content?: string } };
		const content = data.message?.content ?? '';

		// strip ``` fences if model wrapped it
		const cleaned = content;
			.replace(/```[a-zA-Z]*\s*/g, '')
			.replace(/```$/g, '')
			.trim();

		return json({ upgraded: cleaned });
	} catch (err) {
		console.error('[phase82/svelte-upgrade] error:', err);
		return json(
			{ error: 'Failed to upgrade file' },
			{ status: 500 }
		);
	}
};
