/**
 * Ollama Chat API Route
 * Handles streaming chat responses from Ollama with weighted RAG context
 */

import { json, type RequestHandler } from '@sveltejs/kit';
import { getOllamaEndpoint, getChatModel } from '$lib/utils/ollama-config';
import { generateEmbedding } from '$lib/server/services/embedding-service';
import { buildWeightedSystemPrompt } from '$lib/server/services/rag-retrieval-service';

/**
 * POST /api/chat/ollama
 * Send message to Ollama and stream response with weighted RAG context
 */
export const POST: RequestHandler = async ({ request }) => {
  try {
    const body = await request.json();
    const { message, workspaceId } = body as {
      message: string;
      workspaceId?: string;
    };

    if (!message) {
      return json({ error: 'Missing required parameter: message' }, { status: 400 });
    }

    const endpoint = getOllamaEndpoint();
    if (!endpoint) {
      return json(
        { error: 'Ollama endpoint not configured' },
        { status: 500 }
      );
    }

    // Build system prompt with weighted RAG context if workspace is provided
    let systemPrompt = `You are a legal AI assistant specialized in criminal and civil law.;
You reason using statutes, case law, evidence, and notes provided in the context below.

When responding:
1. Reference specific statutes or legal principles when applicable
2. Provide step-by-step reasoning for legal conclusions
3. Include appropriate disclaimers about legal advice
4. Cite evidence or precedents when relevant
5. Maintain professional legal language

Remember: This is legal analysis, not legal advice. Always recommend consulting with a qualified attorney.`;

    if (workspaceId) {
      // Generate embedding for message to enable semantic search
      let messageEmbedding: number[] | undefined;
      try {
        messageEmbedding = await generateEmbedding(message);
      } catch (error) {
        console.warn('Failed to generate message embedding:', error);
      }

      systemPrompt = await buildWeightedSystemPrompt(workspaceId, messageEmbedding);
    }

    // Call Ollama API
    const response = await fetch(`${endpoint}/api/generate`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: getChatModel(),
        prompt: message,
        system: systemPrompt,
        stream: true,
        temperature: 0.7,
        top_p: 0.9,
        top_k: 40,
      }),
    });

    if (!response.ok) {
      throw new Error(`Ollama API error: ${response.statusText}`);
    }

    // Stream response back to client
    return new Response(response.body, {
      headers: {
        'Content-Type': 'text/event-stream',
        'Cache-Control': 'no-cache',
        'Connection': 'keep-alive',
      },
    });
  } catch (error) {
    console.error('Chat error:', error);
    return json(
      { error: error instanceof Error ? error.message : 'Failed to process chat request' },
      { status: 500 }
    );
  }
};

/**
 * PUT /api/chat/ollama/complete
 * Non-streaming chat completion with weighted RAG context
 */
export const PUT: RequestHandler = async ({ request }) => {
  try {
    const body = await request.json();
    const { message, workspaceId } = body as {
      message: string;
      workspaceId?: string;
    };

    if (!message) {
      return json({ error: 'Missing required parameter: message' }, { status: 400 });
    }

    const endpoint = getOllamaEndpoint();
    if (!endpoint) {
      return json(
        { error: 'Ollama endpoint not configured' },
        { status: 500 }
      );
    }

    // Build system prompt with weighted RAG context if workspace is provided
    let systemPrompt = `You are a legal AI assistant specialized in criminal and civil law.;
You reason using statutes, case law, evidence, and notes provided in the context below.

When responding:
1. Reference specific statutes or legal principles when applicable
2. Provide step-by-step reasoning for legal conclusions
3. Include appropriate disclaimers about legal advice
4. Cite evidence or precedents when relevant
5. Maintain professional legal language

Remember: This is legal analysis, not legal advice. Always recommend consulting with a qualified attorney.`;

    if (workspaceId) {
      // Generate embedding for message to enable semantic search
      let messageEmbedding: number[] | undefined;
      try {
        messageEmbedding = await generateEmbedding(message);
      } catch (error) {
        console.warn('Failed to generate message embedding:', error);
      }

      systemPrompt = await buildWeightedSystemPrompt(workspaceId, messageEmbedding);
    }

    // Call Ollama API (non-streaming)
    const response = await fetch(`${endpoint}/api/generate`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: getChatModel(),
        prompt: message,
        system: systemPrompt,
        stream: false,
        temperature: 0.7,
        top_p: 0.9,
        top_k: 40,
      }),
    });

    if (!response.ok) {
      throw new Error(`Ollama API error: ${response.statusText}`);
    }

    const data = await response.json();
    return json({
      response: data.response,
      model: data.model,
      created_at: data.created_at,
      done: data.done,
    });
  } catch (error) {
    console.error('Chat completion error:', error);
    return json(
      { error: error instanceof Error ? error.message : 'Failed to process chat request' },
      { status: 500 }
    );
  }
};
