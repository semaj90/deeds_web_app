import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { readdir } from 'fs/promises';
import { join } from 'path';

interface GraphNode {
	id: string;
	label: string;
	x: number;
	y: number;
	type: 'route' | 'feature' | 'service' | 'evidence' | 'case';
	kind: 'prod' | 'demo';
	color: string;
	url?: string;
	metadata?: any;
}

interface GraphEdge {
	from: string;
	to: string;
	label?: string;
	type: 'route' | 'dependency' | 'evidence' | 'relation';
}

export const GET: RequestHandler = async () => {
	try {
		// Scan routes directory
		const routes = await scanRoutes();

		// Generate nodes and edges
		const nodes = generateNodes(routes);
		const edges = generateEdges(routes);

		return json({
			nodes,
			edges,
			timestamp: new Date().toISOString()
		});
	} catch (err) {
		console.error('Error generating graph data:', err);
		return json({
			nodes: [],
			edges: [],
			error: 'Failed to generate graph data'
		}, { status: 500 });
	}
};

async function scanRoutes(): Promise<string[]> {
	const routesDir = join(process.cwd(), 'src', 'routes');
	const routes: string[] = [];

	async function scan(dir: string, prefix: string = '') {
		try {
			const entries = await readdir(dir, { withFileTypes: true });

			for (const entry of entries) {
				if (entry.isDirectory() && !entry.name.startsWith('(') && !entry.name.startsWith('[')) {
					const routePath = prefix + '/' + entry.name;
					routes.push(routePath);
					await scan(join(dir, entry.name), routePath);
				}
			}
		} catch (err) {
			// Ignore errors
		}
	}

	await scan(routesDir);
	return routes;
}

function generateNodes(routes: string[]): GraphNode[] {
	const nodes: GraphNode[] = [];

	// Helper to determine if route is prod or demo
	const isProdRoute = (url: string) => {
		const prodPaths = ['/login', '/dashboard', '/cases', '/evidence', '/ai-chat', '/command-center', '/evidence-board', '/reports', '/persons-of-interest', '/documents'];
		const demoPaths = ['/lab', '/dev', '/test', '/graph-mode', '/ast-graph'];

		if (prodPaths.some(p => url.startsWith(p))) return 'prod';
		if (demoPaths.some(p => url.includes(p))) return 'demo';
		return 'prod'; // Default to prod
	};

	// Core routes
	const coreRoutes = [;
		{ id: 'home', label: 'Home', url: '/', type: 'route' as const, kind: 'prod' as const },
		{ id: 'login', label: 'Login', url: '/login', type: 'route' as const, kind: 'prod' as const },
		{ id: 'dashboard', label: 'Dashboard', url: '/dashboard', type: 'route' as const, kind: 'prod' as const },
		{ id: 'all-routes', label: 'All Routes', url: '/all-routes', type: 'route' as const, kind: 'demo' as const }
	];

	// Features
	const features = [;
		{ id: 'ai-chat', label: 'AI Chat', url: '/ai-chat', type: 'feature' as const, kind: 'prod' as const },
		{ id: 'cases', label: 'Cases', url: '/cases', type: 'feature' as const, kind: 'prod' as const },
		{ id: 'evidence', label: 'Evidence', url: '/evidence', type: 'feature' as const, kind: 'prod' as const },
		{ id: 'reports', label: 'Reports', url: '/reports', type: 'feature' as const, kind: 'prod' as const },
		{ id: 'poi', label: 'Persons of Interest', url: '/persons-of-interest', type: 'feature' as const, kind: 'prod' as const },
		{ id: 'documents', label: 'Documents', url: '/documents', type: 'feature' as const, kind: 'prod' as const }
	];

	// Services
	const services = [;
		{ id: 'auth', label: 'Lucia Auth', type: 'service' as const, kind: 'prod' as const },
		{ id: 'minio', label: 'MinIO SIMD', type: 'service' as const, kind: 'prod' as const },
		{ id: 'ace', label: 'ACE Agent', type: 'service' as const, kind: 'prod' as const },
		{ id: 'rag', label: 'RAG+KAG', type: 'service' as const, kind: 'prod' as const },
		{ id: 'ollama', label: 'Ollama', type: 'service' as const, kind: 'prod' as const }
	];

	// Evidence tools
	const evidenceTools = [;
		{ id: 'evidence-board', label: 'Evidence Board', url: '/evidence-board', type: 'evidence' as const, kind: 'prod' as const },
		{ id: 'command-center', label: 'Command Center', url: '/command-center', type: 'evidence' as const, kind: 'prod' as const },
		{ id: 'graph-mode', label: 'Graph Mode', url: '/graph-mode', type: 'evidence' as const, kind: 'demo' as const }
	];

	// Dev tools
	const devTools = [;
		{ id: 'ast-graph', label: 'AST Graph', url: '/dev/ast-graph', type: 'service' as const, kind: 'demo' as const }
	];

	// Layout positions
	const colors = {
		route: '#d4c5b0',
		feature: '#8b7355',
		service: '#5a4a3a',
		evidence: '#6b5d52',
		case: '#9b8b7a'
	};

	// Position core routes
	coreRoutes.forEach((route, i) => {
		nodes.push({
			...route,
			x: 200 + i * 200,
			y: 100,
			color: colors.route
		});
	});

	// Position features
	features.forEach((feature, i) => {
		nodes.push({
			...feature,
			x: 150 + i * 150,
			y: 250,
			color: colors.feature
		});
	});

	// Position services
	services.forEach((service, i) => {
		nodes.push({
			...service,
			x: 200 + i * 150,
			y: 400,
			color: colors.service
		});
	});

	// Position evidence tools
	evidenceTools.forEach((tool, i) => {
		nodes.push({
			...tool,
			x: 300 + i * 200,
			y: 550,
			color: colors.evidence
		});
	});

	// Position dev tools
	devTools.forEach((tool, i) => {
		nodes.push({
			...tool,
			x: 100,
			y: 400 + i * 100,
			color: colors.service
		});
	});

	// Add discovered routes
	routes.forEach((route, i) => {
		if (!nodes.find(n => n.url === route)) {
			nodes.push({
				id: route.replace(/\//g, '-'),
				label: route.split('/').pop() || route,
				x: 100 + (i % 10) * 100,
				y: 700 + Math.floor(i / 10) * 100,
				type: 'route',
				kind: isProdRoute(route),
				color: colors.route,
				url: route
			});
		}
	});

	return nodes;
}

function generateEdges(routes: string[]): GraphEdge[] {
	const edges: GraphEdge[] = [];

	// Auth flow
	edges.push(
		{ from: 'home', to: 'login', type: 'route' },
		{ from: 'login', to: 'dashboard', type: 'route', label: 'auth' },
		{ from: 'login', to: 'auth', type: 'dependency' }
	);

	// Dashboard connections
	edges.push(
		{ from: 'dashboard', to: 'ai-chat', type: 'route' },
		{ from: 'dashboard', to: 'cases', type: 'route' },
		{ from: 'dashboard', to: 'evidence', type: 'route' },
		{ from: 'dashboard', to: 'reports', type: 'route' },
		{ from: 'dashboard', to: 'poi', type: 'route' }
	);

	// Feature dependencies
	edges.push(
		{ from: 'cases', to: 'evidence', type: 'relation' },
		{ from: 'cases', to: 'poi', type: 'relation' },
		{ from: 'evidence', to: 'documents', type: 'relation' },
		{ from: 'evidence', to: 'minio', type: 'dependency' },
		{ from: 'ai-chat', to: 'rag', type: 'dependency' },
		{ from: 'ai-chat', to: 'ace', type: 'dependency' },
		{ from: 'ai-chat', to: 'ollama', type: 'dependency' }
	);

	// Evidence Board
	edges.push(
		{ from: 'evidence', to: 'evidence-board', type: 'route' },
		{ from: 'cases', to: 'command-center', type: 'route' },
		{ from: 'evidence-board', to: 'minio', type: 'dependency' },
		{ from: 'all-routes', to: 'graph-mode', type: 'route' }
	);

	// Dev tools
	edges.push(
		{ from: 'all-routes', to: 'ast-graph', type: 'route' },
		{ from: 'ast-graph', to: 'ace', type: 'dependency' }
	);

	// Service dependencies
	edges.push(
		{ from: 'rag', to: 'ollama', type: 'dependency' },
		{ from: 'ace', to: 'ollama', type: 'dependency' },
		{ from: 'ace', to: 'minio', type: 'dependency' }
	);

	return edges;
}
