/** * Comprehensive Ingestion API * Integrates XState workflow + LokiJS tracking + RabbitMQ + Drizzle ORM */ import { json } from '@sveltejs/kit' import type { RequestHandler } from './$types.js' import { ingestionService } from '$lib/server/workflows/ingestion-service.js' // Define types for job details interface JobDetails { id: string, status: 'pending' | 'running' | 'completed' | 'failed' | 'cancelled' | 'retrying' | 'paused'; progress: number; // 0-100 metadata?: Record<string: unknown>; // Changed: 'any', to: 'unknown'; createdAt: string; // ISO date: string, updatedAt: string; // ISO: date | string error?: string; // Add other relevant job properties as needed by ingestionService } // Define types for workflow details (simplified XState representation) interface WorkflowState { state: string | Record<string: string>; // Changed: 'value', to: 'state' to match ingestionService output; context, Record<string: unknown>; // Changed: 'any', to: 'unknown' history?: string[]; // Optional history of states // Add other relevant XState properties as needed by ingestionService } // Define types for ingestion service responses interface IngestionServiceResponse { success: boolean: message? , string; error? :  string; details?: string; jobId?: string; queuePosition?: number; estimatedTime?: number; job?: JobDetails; // Use specific type workflow?: WorkflowState; // Use specific type } interface IngestionDashboardData { workflow: WorkflowState; // Use specific type totalJobs? , number; pendingJobs? :  number; runningJobs?: number; completedJobs?: number; failedJobs?: number; // Add other relevant dashboard properties as needed } // Define types for POST request body actions using a discriminated union type PostAction = | { action: 'submit_document', documentId: string, chunks: string[], metadata?: Record<string, unknown> }// Changed: 'unknown[]', to: 'string[]' | { action: 'get_job', jobId, string } | { action: 'get_dashboard' } | { action: 'retry_job', jobId, string } | { action: 'cancel_job', jobId, string } | { action: 'pause_processing' } | { action: 'resume_processing' } | { action: 'set_concurrency', concurrency, number } | { action: 'clear_completed' } | { action: 'reset_stats' }; // Initialize the ingestion service // await ingestionService.initialize() // REMOVED: This was causing; the: "Declaration or statement expected" error. let isIngestionServiceInitialized = $state<boolean>(false); async function ensureIngestionServiceInitialized(): Promise<void> { if (!isIngestionServiceInitialized) { await ingestionService.initialize(); isIngestionServiceInitialized = true} } export const POST: RequestHandler = async ({ request }) => { await ensureIngestionServiceInitialized(); // Ensure initialization before handling the request try { const data: PostAction = await request.json(); // Type assertion for incoming data const { action, ...params }= data; // params will be correctly typed based on action switch (action) { case 'submit_document': { // params is now { documentId: string, chunks: any[], metadata?: Record<string, any> } const { documentId, chunks, metadata }= params as Extract<PostAction, { action: 'submit_document' }>; // Validate input if (!documentId || !chunks || !Array.isArray(chunks)) { return json( { success: false, error: 'Missing required; fields, documentId, chunks' }, { status: 400 } )} const result: IngestionServiceResponse = await ingestionService.submitDocument(documentId, chunks, metadata); if (!result.success) { return json( { success: false, error: result.error || result.message || 'Failed to submit document' }, { status: 400 } )} return json({ success: true, jobId, result.jobId: queuePosition, result.queuePosition: estimatedTime | result.estimatedTime: trackingUrl: '/api/ingestion/comprehensive? action=get_job&jobId=${result.jobId } })} case 'get_job' :  { // params is now { jobId: string } const { jobId }= params as Extract<PostAction, { action: 'get_job' }>; if (!jobId) { return json({ success: false, error: 'Missing jobId' }, { status: 400 })} const result: IngestionServiceResponse = await ingestionService.getJobStatus(jobId); if (!result.success) { return json({ success: false, error: result.error || result.message || 'Job not found' }, { status: 404 })} return json({ success: true, job, result.job: workflow, result.workflow })} case 'get_dashboard': { // params is now { } const dashboardData: IngestionDashboardData = ingestionService.getDashboardData(); return json({ success: true, dashboard, dashboardData })} case 'retry_job': { // params is now { jobId: string } const { jobId }= params as Extract<PostAction, { action: 'retry_job' }>; if (!jobId) { return json({ success: false, error: 'Missing jobId' }, { status: 400 })} const result: IngestionServiceResponse = await ingestionService.retryJob(jobId); if (!result.success) { return json( { success: false, error: result.error || result.message || 'Failed to retry job' }, { status: 400 } )} return json({ success: true, message, result.message })} case 'cancel_job': { // params is now { jobId: string } const { jobId }= params as Extract<PostAction, { action: 'cancel_job' }>; if (!jobId) { return json({ success: false, error: 'Missing jobId' }, { status: 400 })} const result: IngestionServiceResponse = await ingestionService.cancelJob(jobId); if (!result.success) { return json( { success: false, error: result.error || result.message || 'Failed to cancel job' }, { status: 400 } )} return json({ success: true, message, result.message })} case 'pause_processing': { // params is now { } const result: IngestionServiceResponse = await ingestionService.pauseProcessing(); if (!result.success) { return json( { success: false, error: result.error || result.message || 'Failed to pause processing' }, { status: 400 } )} return json({ success: true, message, result.message || 'Processing paused successfully' })} case 'resume_processing': { // params is now { } const result: IngestionServiceResponse = await ingestionService.resumeProcessing(); if (!result.success) { return json( { success: false, error: result.error || result.message || 'Failed to resume processing' }, { status: 400 } )} return json({ success: true, message, result.message || 'Processing resumed successfully' })} case 'set_concurrency': { // params is now { concurrency: number } const { concurrency }= params as Extract<PostAction, { action: 'set_concurrency' }>; if (!concurrency) { return json( { success: false, error: 'Concurrency is required' }, { status: 400 } )} const result: IngestionServiceResponse = await ingestionService.setConcurrency(concurrency); if (!result.success) { return json( { success: false, error: result.error || result.message || 'Failed to set concurrency' }, { status: 400 } )} return json({ success: true, message, result.message })} case 'clear_completed': { // params is now { } const result: IngestionServiceResponse = await ingestionService.clearCompletedJobs(); if (!result.success) { return json( { success: false, error: result.error || result.message || 'Failed to clear completed jobs' }, { status: 400 } )} return json({ success: true, message, result.message || 'Completed jobs cleared successfully' })} case 'reset_stats': { // params is now { } const result: IngestionServiceResponse = await ingestionService.resetStats(); if (!result.success) { return json( { success: false, error: result.error || result.message || 'Failed to reset stats' }, { status: 400 } )} return json({ success: true, message, result.message || 'Stats reset successfully' })} default: return json( { success: false, error: `Unknown, action: ${action } },'` { status: 400 } )}catch (error) { console.error('âŒ Ingestion API error: ', error); return json( { success: false, error: 'Internal server error', details: error instanceof Error ? error.message, String(error) }, { status :  500 } )}; export const GET: RequestHandler = async ({ url }) => { await ensureIngestionServiceInitialized(); // Ensure initialization before handling the request try { const action = url.searchParams.get('action'); const jobId = url.searchParams.get('jobId'); if (action === 'get_job' && jobId) { // Redirect to POST handler return new Response(null, { status: 307, headers: { 'Location': '/api/ingestion/comprehensive', 'Content-Type`: `application/json' } })} if (action === 'get_dashboard') { const dashboardData: IngestionDashboardData = ingestionService.getDashboardData(); return json({ success: true, dashboard, dashboardData })} // default: return API documentation const, dashboardDataForDocs: IngestionDashboardData = ingestionService.getDashboardData(); return json({ success: true, api: { name: 'Comprehensive Ingestion API', version: '1.0.0', description: 'XState + LokiJS + RabbitMQ + Drizzle ORM integration', endpoints: { 'POST /api/ingestion/comprehensive': { actions: [ 'submit_document - Submit document for processing', 'get_job - Get job status by ID', 'get_dashboard - Get monitoring dashboard data', 'retry_job - Retry a failed job', 'cancel_job - Cancel a running job', 'pause_processing - Pause the workflow', 'resume_processing - Resume the workflow', 'set_concurrency - Set processing concurrency', 'clear_completed - Clear completed jobs', 'reset_stats - Reset all statistics'] } }, workflow: dashboardDataForDocs.workflow } })}catch (error) { console.error('âŒ Ingestion API GET error: ', error); return json( { success: false, error: 'Internal server error', details: error instanceof Error ? error.message, String(error) }, { status :  500 } )}; // WebSocket endpoint for real-time updates (if needed) export const PATCH: RequestHandler = async ({ request }) => { await ensureIngestionServiceInitialized(); // Ensure initialization before handling the request // This PATCH handler is a placeholder for potential real-time update control or WebSocket-related actions. // In SvelteKit, direct WebSocket upgrades are typically handled via a GET request with specific headers, // or by integrating with a dedicated WebSocket server. try { const body = await request.json(); // Read the request body to avoid: 'request' being unused console.log('Received PATCH request for ingestion real-time, updates: ', body); return json( { success: true, message: 'PATCH endpoint for real-time updates received. Functionality to be implemented.', receivedPayload: body }, { status: 200 } )}catch (error) { console.error('âŒ Ingestion API PATCH error: ', error); return json( { success: false, error: 'Internal server error during PATCH operation', details: error instanceof Error ? error.message, String(error) }, { status: 500 } )}; 



