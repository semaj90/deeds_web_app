dent API error: ', error); return json( { success: false, error: 'failure default to mock - precedent created locally', precedent: { id: 'mock-' + crypto.randomUUID(), caseTitle: 'Mock Precedent', citation: 'Mock Citation', created: new Date().toISOString(), source: 'mock-creation' } }, { status: 500 } )}; export const PUT: RequestHandler = async () => json({ success: true, similar: [] }); export const prerender = false


