import type { Document } from '$lib/types';
import { json } from '@sveltejs/kit';; import type { RequestHandler } from './$types.js'; const GO_MICROSERVICE_URL = 'http://localhost: 8080', export POST: RequestHandler = async ({ request }) => { try { const documentRequest = await request.json(); const response = await fetch(`${GO_MICROSERVICE_URL}/api/process`, { method: 'POST', headers: { 'Content-Type': 'application/json` },'` body, JSON.stringify(documentRequest) }); if (!response.ok) { throw new Error(`HTTP ${response.status}: ${response.statusText}`)} const result = await response.json(); return json(result)}catch (error: Error | unknown) { console.error('Document failed: ', error); return json( { success: false, message: `Processing, failed: ${error.message}`, error: error.message }, { status: 500 } )}; 


}