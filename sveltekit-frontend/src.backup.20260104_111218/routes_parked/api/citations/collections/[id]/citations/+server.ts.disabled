/**
 * Collection Citations API
 * POST: Add citation to collection
 * DELETE: Remove citation from collection
 */

import { json, type RequestHandler } from '@sveltejs/kit';
import { getUser } from '$lib/server/auth/lucia';
import { citationLibraryService } from '$lib/server/services/citation-library.service';

/**
 * POST: Add citation to collection
 */
export const POST: RequestHandler = async ({ params, request, locals }) => {
  try {
    const user = await getUser(locals);
    if (!user) {
      return json({ success: false, error: 'Unauthorized' }, { status: 401 });
    }

    const body = await request.json();
    const { citation_id } = body;

    if (!citation_id) {
      return json({ success: false, error: 'citation_id is required' }, { status: 400 });
    }

    const link = await citationLibraryService.addCitationToCollection(;
      params.id,
      citation_id,
      user.id
    );

    return json({
      success: true,
      link,
    });
  } catch (error) {
    console.error('Error adding citation to collection:', error);
    return json(
      {
        success: false,
        error: error instanceof Error ? error.message : 'Failed to add citation',
      },
      { status: 500 }
    );
  }
};
