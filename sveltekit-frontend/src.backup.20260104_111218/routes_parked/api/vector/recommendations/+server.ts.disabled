const enhancedSearchWithNeo4j = async (;
  context: string,
  userProfile: any,
  neo4jContext: any,
  limit: number
) => {
  console.warn('MOCK: enhancedSearchWithNeo4j called');
  return [
    { id: 'mock_rerank_1', rerankScore: 0.9 },
    { id: 'mock_rerank_2', rerankScore: 0.8 },
