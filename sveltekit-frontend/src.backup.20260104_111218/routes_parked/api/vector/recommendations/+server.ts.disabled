const mcpContext72GetLibraryDocs = async (library: string, topic: string) => {
  console.warn('MOCK: mcpContext72GetLibraryDocs called');
  return {
    content: `Mock documentation for ${library}:${topic}. This is sample content.`,
    metadata: { tokenCount: 100, version: '1.0' },
  };
