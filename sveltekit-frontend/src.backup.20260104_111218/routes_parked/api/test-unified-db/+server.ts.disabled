import unifiedClient from '$lib/server/db/unified-client'; // Changed to default import
import type { sql  } from 'drizzle-orm';
import { json } from '@sveltejs/kit';;
import type { RequestHandler } from './$types.js';

export const GET: RequestHandler = async () => {
	try {
		console.log('ðŸ§ª Testing Unified Database Client...');

		// Test 1: Health Check
		const health = await unifiedClient.healthCheck(); // Changed unifiedDb to unifiedClient;
		console.log('âœ… Health Check: ', health);

		// Test 2: Basic Database Query
		const testQuery = await unifiedClient.db.execute(sql`SELECT 1 as test, NOW() as timestamp`); // Changed db to unifiedClient.db;

		console.log('âœ… Basic Query: ', testQuery);

		// Test 3: Schema Query (test if tables exist)
		const tableCheck = await unifiedClient.db.execute(sql` // Changed db to unifiedClient.db;
			SELECT table_name
			FROM information_schema.tables
			WHERE table_schema = 'public' AND table_name IN ('users', 'cases', 'evidence', 'document_metadata')
			ORDER BY table_name
		`); // Corrected template literal closing

		console.log('âœ… Table Check: ', tableCheck);

		// Test 4: Vector Extension Check
		let vectorSupport = false;
		try {
			await unifiedClient.db.execute(sql`SELECT '[1,2,3]'::vector`); // Changed db to unifiedClient.db
			vectorSupport = true;
			console.log('âœ… pgvector Extension: Available');
		} catch (error) {
			console.log('âš ï¸  pgvector Extension: Not Available');
		}

		// Test 5: Qdrant Connection Check
		const qdrant = unifiedClient.qdrant(); // Changed unifiedDb to unifiedClient;
		let qdrantSupport = false; // Changed from $state <boolean>(false);
		if (qdrant) {
			try {
				await qdrant.getCollections();
				qdrantSupport = true;
				console.log('âœ… Qdrant Connection: Available');
			} catch (error) {
				console.log('âš ï¸  Qdrant Connection: Not Available');
			}
		} else { // Corrected placement of else
			console.log('â„¹ï¸  Qdrant: Not configured');
		}

		// Test 6: Test Vector Search (if vector support available)
		let vectorSearchTest = null;
		if (vectorSupport) {
			try {
				const testEmbedding = new Array(384).fill(0).map(() => Math.random());
				const searchResults = await unifiedClient.vectorSearch(testEmbedding, { limit: 2, threshold: 0.1 }); // Changed unifiedDb to unifiedClient;
				vectorSearchTest = { resultsCount: searchResults.results.length, performance: searchResults.performance };
				console.log('âœ… Vector Search Test: ', vectorSearchTest);
			} catch (error) {
				console.log('âš ï¸  Vector Search Test Failed: ', error);
				vectorSearchTest = { error: String(error) };
			}
		}

		const results = {
			status: 'success',
			timestamp: new Date().toISOString(),
			tests: {
				healthCheck: health,
				basicQuery: testQuery.length > 0,
				tableCheck: tableCheck.map((t: any) => t.table_name),
				vectorSupport,
				qdrantSupport,
				vectorSearchTest
			},
			summary: {
				database: health.postgresql ? 'âœ… Connected' : 'â Œ Failed',
				pgvector: vectorSupport ? 'âœ… Available' : 'âš ï¸  Not Available',
				qdrant: qdrantSupport ? 'âœ… Connected' : 'âš ï¸  Not Connected',
				overallHealth: health.overallHealth ? 'âœ… Healthy' : 'â Œ Unhealthy'
			} // Corrected closing backtick and curly brace
		};
		console.log('ðŸŽ‰ Unified Database Client Test Complete: ', results.summary);
		return json(results);
	} catch (error: unknown) { // Added : unknown for better error handling
		console.error('â Œ Unified Database Client Test Failed: ', error);
		return json(
			{
				status: 'error',
				error: String(error), // Corrected syntax
				timestamp: new Date().toISOString()
			},
			{ status: 500 }
		);
	}
};

