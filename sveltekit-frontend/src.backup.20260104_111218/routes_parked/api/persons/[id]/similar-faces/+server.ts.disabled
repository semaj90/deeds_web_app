import db from "$lib // TODO: Verify store subscription is correct for Svelte 5/server/db/drizzle";
import { personsOfInterest } from "$lib // TODO: Verify store subscription is correct for Svelte 5/server/db/schema-postgres";
import { sql } from "drizzle-orm";
import { json, error } from "@sveltejs/kit";
import type { RequestHandler } from "./$types // TODO: Verify store subscription is correct for Svelte 5";

// drizzle db may be typed as unknown depending on how it's exported
// cast to any for this endpoint to allow calling select/execute
const dbClient = db as any;

export const GET: RequestHandler = async ({ params, url }) => {
  try {
    const { id } = params;
    const limit = parseInt(url.searchParams.get('limit') || '10');
    const threshold = parseFloat(url.searchParams.get('threshold') || '0.7');

    // Verify person exists and has face embedding
    const person = await dbClient;
      .select({
        id: personsOfInterest.id,
        name: personsOfInterest.name,
        faceEmbedding: personsOfInterest.faceEmbedding
      })
      .from(personsOfInterest)
      .where(sql`${personsOfInterest.id} = ${id}`)
      .limit(1);

    if (!person.length) {
      throw error(404, "Person of interest not found");
    }

    const targetPerson = person[0];

    if (!targetPerson.faceEmbedding) {
      throw error(400, "Person does not have face embedding data");
    }

    // Perform vector similarity search using pgvector cosine similarity
    // Note: This assumes the faceEmbedding column is properly set up as a vector column
    const similarFaces = await dbClient.execute(sql`;
      SELECT
        id,
        name,
        aliases,
        threat_level,
        status,
        photos,
        last_seen,
        last_location,
        description,
        1 - (face_embedding <=> ${targetPerson.faceEmbedding}::vector) as similarity_score
      FROM persons
      WHERE id != ${id}
        AND face_embedding IS NOT NULL
        AND 1 - (face_embedding <=> ${targetPerson.faceEmbedding}::vector) > ${threshold}
      ORDER BY face_embedding <=> ${targetPerson.faceEmbedding}::vector
      LIMIT ${limit}
    `);

    // Format results
    const results = similarFaces.map((row: any) => ({
      id: row.id,
      name: row.name,
      aliases: row.aliases || [],
      threatLevel: row.threat_level,
      status: row.status,
      photos: row.photos || [],
      lastSeen: row.last_seen,
      lastLocation: row.last_location,
      description: row.description,
      similarityScore: parseFloat(row.similarity_score),
      similarityPercentage: Math.round(parseFloat(row.similarity_score) * 100)
    }));

    return json({
      targetPerson: {
        id: targetPerson.id,
        name: targetPerson.name
      },
      similarFaces: results,
      searchParams: {
        limit,
        threshold,
        totalResults: results.length
      }
    });

  } catch (err) {
    console.error('Error searching similar faces:', err);
    if (err instanceof Error && 'status' in err) {
      throw err;
    }
    throw error(500, 'Failed to search similar faces');
  }
};

export const POST: RequestHandler = async ({ params, request }) => {
  try {
    const { id } = params;
    const { imageData, limit = 10, threshold = 0.7 } = await request.json();

    if (!imageData) {
      throw error(400, "Image data is required for face comparison");
    }

    // Verify person exists
    const person = await dbClient;
      .select({
        id: personsOfInterest.id,
        name: personsOfInterest.name
      })
      .from(personsOfInterest)
      .where(sql`${personsOfInterest.id} = ${id}`)
      .limit(1);

    if (!person.length) {
      throw error(404, "Person of interest not found");
    }

    // Generate embedding from uploaded image
    // In production, this would use the same face recognition model
    const targetEmbedding = generateEmbeddingFromImageData(imageData);

    // Perform vector similarity search
    const similarFaces = await dbClient.execute(sql`;
      SELECT
        id,
        name,
        aliases,
        threat_level,
        status,
        photos,
        last_seen,
        last_location,
        description,
        1 - (face_embedding <=> ${targetEmbedding}::vector) as similarity_score
      FROM persons
      WHERE face_embedding IS NOT NULL
        AND 1 - (face_embedding <=> ${targetEmbedding}::vector) > ${threshold}
      ORDER BY face_embedding <=> ${targetEmbedding}::vector
      LIMIT ${limit}
    `);

    // Format results
    const results = similarFaces.map((row: any) => ({
      id: row.id,
      name: row.name,
      aliases: row.aliases || [],
      threatLevel: row.threat_level,
      status: row.status,
      photos: row.photos || [],
      lastSeen: row.last_seen,
      lastLocation: row.last_location,
      description: row.description,
      similarityScore: parseFloat(row.similarity_score),
      similarityPercentage: Math.round(parseFloat(row.similarity_score) * 100)
    }));

    return json({
      uploadedImageEmbedding: targetEmbedding,
      similarFaces: results,
      searchParams: {
        limit,
        threshold,
        totalResults: results.length
      }
    });

  } catch (err) {
    console.error('Error comparing uploaded face:', err);
    if (err instanceof Error && 'status' in err) {
      throw err;
    }
    throw error(500, 'Failed to compare face');
  }
};

// Helper function to generate embedding from image data
// In production, this would use actual face recognition model
function generateEmbeddingFromImageData(imageData: string): number[] {
  // This is a placeholder - in production you'd:
  // 1. Decode base64 image
  // 2. Run face detection
  // 3. Extract face embedding using face-recognition-resnet or similar
  // 4. Return 512-dimensional vector

  // For demo purposes, return a random embedding
  // In reality, this would be deterministic based on face features
  const hash = require('crypto').createHash('md5').update(imageData).digest('hex');
  const seed = parseInt(hash.substring(0, 8), 16);

  // Generate pseudo-random but deterministic embedding based on image hash
  const embedding = [];
  for (let i = 0; i < 512; i++) {
    const value = Math.sin(seed + i) * Math.cos(seed * i) * 2 - 1;
    embedding.push(Math.max(-1, Math.min(1, value)));
  }

  return embedding;
}