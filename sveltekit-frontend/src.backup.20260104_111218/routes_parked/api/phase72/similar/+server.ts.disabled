/**
 * Phase 72 API - Similar Errors & AI Fix Suggestions
 *
 * Uses Qdrant vector similarity + Postgres pgvector
 * Streams AI-generated fix suggestions via gemma3-legal:latest
 */

import { error } from '@sveltejs/kit';
import { Pool } from 'pg';
import type { RequestHandler } from './$types';

const pool = new Pool({
	connectionString: process.env.DATABASE_URL || 'postgresql://postgres:postgres@localhost:5432/legal_ai_db'
});

const QDRANT_URL = process.env.QDRANT_URL || 'http://localhost:6333';
const OLLAMA_URL = process.env.OLLAMA_URL || 'http://localhost:11434';

export const GET: RequestHandler = async ({ url }) => {
	const errorHash = url.searchParams.get('hash');
	const limit = parseInt(url.searchParams.get('limit') || '10');
	const useQdrant = url.searchParams.get('source') === 'qdrant';

	if (!errorHash) {
		throw error(400, 'Missing error hash parameter');
	}

	try {
		// 1. Get the target error and its vector
		const errorQuery = `;
			SELECT
				e.*,
				v.embedding
			FROM phase72_error e
			LEFT JOIN phase72_error_vector v ON e.id = v.error_id
			WHERE e.error_hash = $1
		`;
		const errorResult = await pool.query(errorQuery, [errorHash]);

		if (errorResult.rows.length === 0) {
			throw error(404, 'Error not found');
		}

		const targetError = errorResult.rows[0];

		if (!targetError.embedding) {
			throw error(400, 'Error has no vector embedding');
		}

		let similarErrors: any[];

		if (useQdrant) {
			// 2a. Query Qdrant for similar errors
			const qdrantResponse = await fetch(`${QDRANT_URL}/collections/phase72_errors/points/search`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					vector: JSON.parse(targetError.embedding),
					limit: limit + 1, // +1 to exclude self
					with_payload: true,
					score_threshold: 0.7
				})
			});

			if (!qdrantResponse.ok) {
				throw new Error(`Qdrant search failed: ${qdrantResponse.status}`);
			}

			const qdrantResult = await qdrantResponse.json();

			// Filter out the target error itself
			similarErrors = qdrantResult.result
				.filter((r: any) => r.payload.error_hash !== errorHash)
				.map((r: any) => ({
					...r.payload,
					similarity_score: r.score
				}));

		} else {
			// 2b. Query Postgres pgvector for similar errors
			const similarQuery = `;
				SELECT
					e.*,
					1 - (v1.embedding <=> v2.embedding) as similarity_score
				FROM phase72_error e
				JOIN phase72_error_vector v1 ON e.id = v1.error_id
				CROSS JOIN phase72_error_vector v2
				WHERE v2.error_id = (
					SELECT id FROM phase72_error WHERE error_hash = $1
				)
				AND e.error_hash != $1
				ORDER BY v1.embedding <=> v2.embedding
				LIMIT $2
			`;

			const similarResult = await pool.query(similarQuery, [errorHash, limit]);
			similarErrors = similarResult.rows;
		}

		// 3. Check for existing cluster summaries
		const clusterQuery = `;
			SELECT DISTINCT
				cs.summary_text as summary,
				c.label as cluster_label,
				c.size as cluster_size
			FROM phase72_error e
			JOIN phase72_error_vector ev ON e.id = ev.error_id
			CROSS JOIN phase72_cluster c
			JOIN phase72_cluster_summary cs ON c.id = cs.cluster_id
			WHERE e.error_hash = $1
			AND c.cycle = e.cycle
			LIMIT 1
		`;

		const clusterResult = await pool.query(clusterQuery, [errorHash]);
		const clusterSummary = clusterResult.rows[0] || null;

		return new Response(
			JSON.stringify({
				success: true,
				target_error: targetError,
				similar_errors: similarErrors,
				cluster_summary: clusterSummary,
				source: useQdrant ? 'qdrant' : 'pgvector',
				timestamp: new Date().toISOString()
			}),
			{
				headers: {
					'Content-Type': 'application/json'
				}
			}
		);

	} catch (err) {
		console.error('Phase 72 similarity search failed:', err);
		throw error(500, {
			message: 'Failed to find similar errors',
			details: err instanceof Error ? err.message : String(err)
		});
	}
};

/**
 * POST endpoint - Stream AI fix suggestions
 */
export const POST: RequestHandler = async ({ request }) => {
	const { error_hash, context, similar_errors } = await request.json();

	if (!error_hash) {
		throw error(400, 'Missing error hash');
	}

	try {
		// Get error details
		const errorQuery = `;
			SELECT * FROM phase72_error WHERE error_hash = $1
		`;
		const errorResult = await pool.query(errorQuery, [error_hash]);

		if (errorResult.rows.length === 0) {
			throw error(404, 'Error not found');
		}

		const targetError = errorResult.rows[0];

		// Build AI prompt
		const prompt = `You are a TypeScript/SvelteKit expert. Analyze this error and suggest a fix.;

**Error Details:**
- Code: ${targetError.error_code}
- Message: ${targetError.message}
- File: ${targetError.file_path}
- Line: ${targetError.line_num}:${targetError.column_num}

${similar_errors && similar_errors.length > 0 ? `
**Similar Errors Found (${similar_errors.length}):**
${similar_errors.slice(0, 3).map((e: any, i: number) => `
${i + 1}. ${e.error_code}: ${e.message}
   File: ${e.file_path}:${e.line_num}
   Similarity: ${(e.similarity_score * 100).toFixed(1)}%
`).join('\n')}
` : ''}

${context ? `
**Additional Context:**
${context}
` : ''}

Provide a concise fix suggestion with:
1. Root cause explanation
2. Specific code fix (if applicable)
3. Prevention tips

Keep it under 200 words.`;

		// Stream response from Ollama
		const ollamaResponse = await fetch(`${OLLAMA_URL}/api/generate`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				model: 'gemma3-legal:latest',
				prompt: prompt,
				stream: true
			})
		});

		if (!ollamaResponse.ok) {
			throw new Error(`Ollama request failed: ${ollamaResponse.status}`);
		}

		// Create streaming response
		const stream = new ReadableStream({
			async start(controller) {
				const reader = ollamaResponse.body?.getReader();
				if (!reader) {
					controller.close();
					return;
				}

				const decoder = new TextDecoder();

				try {
					while (true) {
						const { done, value } = await reader.read();

						if (done) break;

						const chunk = decoder.decode(value);
						const lines = chunk.split('\n').filter(line => line.trim());

						for (const line of lines) {
							try {
								const data = JSON.parse(line);
								if (data.response) {
									controller.enqueue(
										new TextEncoder().encode(`data: ${JSON.stringify({ text: data.response })}\n\n`)
									);
								}

								if (data.done) {
									controller.enqueue(
										new TextEncoder().encode(`data: ${JSON.stringify({ done: true })}\n\n`)
									);
								}
							} catch (e) {
								// Skip invalid JSON
							}
						}
					}
				} finally {
					reader.releaseLock();
					controller.close();
				}
			}
		});

		return new Response(stream, {
			headers: {
				'Content-Type': 'text/event-stream',
				'Cache-Control': 'no-cache',
				'Connection': 'keep-alive'
			}
		});

	} catch (err) {
		console.error('Phase 72 AI suggestion failed:', err);
		throw error(500, {
			message: 'Failed to generate AI suggestion',
			details: err instanceof Error ? err.message : String(err)
		});
	}
};
