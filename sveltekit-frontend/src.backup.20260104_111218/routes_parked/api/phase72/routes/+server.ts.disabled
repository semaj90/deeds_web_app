export const GET: RequestHandler = async () => {
	const graph: RouteAstGraph = {
		routes: ROUTE_AST_GRAPH
	};

	return json(graph);
};

export const POST: RequestHandler = async ({ request }) => {
	const body = (await request.json()) as { search?: string; filter?: string };

	let routes = ROUTE_AST_GRAPH;

	// Filter by search term
	if (body.search) {
		const q = body.search.toLowerCase();
		routes = routes.filter(
			(r) =>
				r.path.toLowerCase().includes(q) ||
				r.label.toLowerCase().includes(q) ||
				r.file.toLowerCase().includes(q)
		);
	}

	// Filter by kind
	if (body.filter && body.filter !== 'all') {
		routes = routes.filter((r) => r.kind === body.filter);
	}

	return json({ routes });
};
