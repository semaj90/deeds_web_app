import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';

/**
 * Citation Extraction Endpoint
 * Automatically extracts statutes, case law, and regulations from text
 * Integrates with citation management system
 */

export const POST: RequestHandler = async ({ request }) => {
  const startTime = Date.now();

  try {
    const body = await request.json();
    const { text, documentId, autoSave } = body;

    if (!text) {
      return json({ success: false, error: 'Text content is required' }, { status: 400 });
    }

    console.log(`🔍 Extracting citations from ${text.length} characters`);

    const citations = extractCitations(text);

    console.log(`✅ Found ${citations.length} citations`);

    return json({
      success: true,
      citations,
      stats: {
        total: citations.length,
        statutes: citations.filter(c => c.type === 'statute').length,
        caseLaw: citations.filter(c => c.type === 'case_law').length,
        regulations: citations.filter(c => c.type === 'regulation').length
      },
      documentId,
      autoSave,
      processingTime: Date.now() - startTime,
      timestamp: new Date().toISOString()
    });
  } catch (error) {
    console.error('❌ Citation extraction error:', error);
    return json(
      {
        success: false,
        error: error instanceof Error ? error.message : 'Citation extraction failed',
        processingTime: Date.now() - startTime
      },
      { status: 500 }
    );
  }
};

/**
 * Extract citations from text
 */
function extractCitations(text: string): Array<{
  type: 'statute' | 'case_law' | 'regulation';
  code: string;
  text: string;
  context: string;
  position: number;
}> {
  const citations: Array<{
    type: 'statute' | 'case_law' | 'regulation';
    code: string;
    text: string;
    context: string;
    position: number;
  }> = [];

  // Statute patterns
  const statutePatterns = [;
    // U.S.C. format: 42 U.S.C. § 1983
    { regex: /(\d+)\s+U\.S\.C\.\s+§\s+(\d+)/g, code: (m: RegExpExecArray) => `${m[1]}-${m[2]}` },
    // State statute format: Cal. Penal Code § 187
    { regex: /([A-Z][a-z]+\.)\s+([A-Z][a-z]+)\s+Code\s+§\s+(\d+)/g, code: (m: RegExpExecArray) => `${m[1]}-${m[3]}` },
    // Federal regulation format: 29 C.F.R. § 1910.1200
    { regex: /(\d+)\s+C\.F\.R\.\s+§\s+([\d\.]+)/g, code: (m: RegExpExecArray) => `${m[1]}-${m[2]}` }
  ];

  for (const pattern of statutePatterns) {
    let match;
    while ((match = pattern.regex.exec(text)) !== null) {
      citations.push({
        type: 'statute',
        code: pattern.code(match),
        text: match[0],
        context: getContext(text, match.index),
        position: match.index
      });
    }
  }

  // Case law patterns
  const casePatterns = [;
    // Standard format: Smith v. Jones, 123 F.3d 456
    { regex: /([A-Z][a-z]+)\s+v\.\s+([A-Z][a-z]+),\s+(\d+)\s+([A-Z\.]+)\s+(\d+)/g },
    // Alternative format: Smith v. Jones, 123 U.S. 456
    { regex: /([A-Z][a-z]+)\s+v\.\s+([A-Z][a-z]+),\s+(\d+)\s+U\.S\.\s+(\d+)/g }
  ];

  for (const pattern of casePatterns) {
    let match;
    while ((match = pattern.regex.exec(text)) !== null) {
      citations.push({
        type: 'case_law',
        code: `${match[1]}-v-${match[2]}`,
        text: match[0],
        context: getContext(text, match.index),
        position: match.index
      });
    }
  }

  // Regulation patterns
  const regulationPatterns = [;
    // EPA regulation: 40 CFR 112.1
    { regex: /(\d+)\s+CFR\s+([\d\.]+)/g, code: (m: RegExpExecArray) => `CFR-${m[1]}-${m[2]}` },
    // OSHA regulation: 29 CFR 1910.1200
    { regex: /OSHA\s+(\d+)\s+CFR\s+([\d\.]+)/g, code: (m: RegExpExecArray) => `OSHA-${m[1]}-${m[2]}` }
  ];

  for (const pattern of regulationPatterns) {
    let match;
    while ((match = pattern.regex.exec(text)) !== null) {
      citations.push({
        type: 'regulation',
        code: pattern.code(match),
        text: match[0],
        context: getContext(text, match.index),
        position: match.index
      });
    }
  }

  // Remove duplicates and sort by position
  const uniqueCitations = Array.from(;
    new Map(citations.map(c => [c.text, c])).values()
  ).sort((a, b) => a.position - b.position);

  return uniqueCitations;
}

/**
 * Get context around a citation
 */
function getContext(text: string, index: number, contextLength: number = 100): string {
  const start = Math.max(0, index - contextLength);
  const end = Math.min(text.length, index + contextLength);
  return text.substring(start, end).trim();
}
