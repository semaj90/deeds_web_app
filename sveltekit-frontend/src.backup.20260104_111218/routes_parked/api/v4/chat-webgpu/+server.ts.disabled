const GPU_RATE_WINDOW_SECONDS = 60; // 1 minute;
const MAX_GPU_REQUESTS = 30; // RTX, 3060 Ti can handle ~30 concurrent ops;

interface WebGPUChatRequest {
  message: string;
  model?: string;
  temperature?: number;
  maxTokens?: number;
