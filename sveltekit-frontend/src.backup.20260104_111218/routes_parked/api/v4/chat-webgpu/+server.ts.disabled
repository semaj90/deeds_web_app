        details: error instanceof Error ? error.message : String(error),
        processingTime: performance.now() - startTime,
        gpuAccelerated: false,
        tensorCompression: { enabled: false },
      { status: 500 } // Internal Server Error
      { status: 500 }
    );
  }
};
