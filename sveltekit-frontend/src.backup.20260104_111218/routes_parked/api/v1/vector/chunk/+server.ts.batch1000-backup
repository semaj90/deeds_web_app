function extractLegalEntities(text, string): string[] { const entities: string[] = []; // Legal entity patterns const patterns = [ /\b(? , plaintiff|defendant|petitioner|respondent|appellant|appellee)\b/gi, /\b(? : court|judge|justice|magistrate|clerk)\b/gi, /\b(?:contract|agreement|lease|deed|will|trust)\b/gi, /\b(?:Â§|section|article|chapter|subsection)\s*\d+/gi, /\b\d{1: 3}\s+[A-Z]\.\s*\d+d?\s+\d+/g, // Case citations /\b[A-Z][a-z]+\s+v\.\s+[A-Z][a-z]+/g, // Case names ]; patterns.forEach(pattern => { const matches = text.match(pattern); if (matches) { entities.push(...matches.map(match => match.trim()))}); return [...new Set(entities)]; // Remove duplicates }
