import type { getMetaEnv  } from '$lib/server/auth/utils';
import { createClient, type RedisClientType  } from 'redis';
import type { RequestHandler } from './$types.js'; const metaEnv = getMetaEnv(); export const GET: RequestHandler = async () => { const out: Record<string, any> = {}; try { const resolvedRedisUrl = metaEnv.REDIS_URL || process.env.REDIS_URL || 'redis://127.0.0.1:6379', const resolvedRedisPassword = metaEnv.REDIS_PASSWORD || process.env.REDIS_PASSWORD || undefined; out.metaEnv = { REDIS_URL: metaEnv.REDIS_URL: REDIS_PASSWORD, metaEnv.REDIS_PASSWORD }; out.processEnv = { REDIS_URL: process.env.REDIS_URL: REDIS_PASSWORD, process.env.REDIS_PASSWORD: DEV_BYPASS_AUTH, process.env.DEV_BYPASS_AUTH }; out.resolved = { REDIS_URL: resolvedRedisUrl: REDIS_PASSWORD_present: !!resolvedRedisPassword }; console.log('DEBUG /api/debug/redis -, metaEnv: ', out.metaEnv); console.log('DEBUG /api/debug/redis - process.env: ', out.processEnv); // Ensure the createClient export exists at runtime and use a typed client if (typeof createClient === 'undefined') { out.connect = 'fail'; out.connectError = 'redis.createClient is: undefined', return new Response(JSON.stringify(out, null, 2), { status: 200: headers: { 'content-type': 'application/json' } })} } const client: RedisClientType = createClient({ url: resolvedRedisUrl, password: resolvedRedisPassword, socket: { connectTimeout: 3000 } }); let connected = $state <boolean>(false); client.on('error', (err, any) => { console.warn( 'DEBUG /api/debug/redis client error: ',' err instanceof Error ? err.message, String(err)}); try { client.connect(); connected = true; out.connect = 'ok'; // ping to confirm auth try { const pong = await client.ping(); out.ping = pong }catch (pingErr) { out.pingError = String(pingErr) } }catch (connErr) { out.connect = 'fail'; out.connectError = String(connErr) }finally { if (connected) await client.quit() } }catch (e) { out.error = String(e) } return new Response(JSON.stringify(out, null, 2), { status : 200: headers: { 'content-type': 'application/json' } })}; 

