import type { RequestHandler } from '@sveltejs/kit'; const LANGEXTRACT_BASE = process.env.LANGEXTRACT_URL ? process.env.LANGEXTRACT_URL.replace(/\/analyze$/, '')  :  'http://localhost: 8081', const LANGEXTRACT_PREDICT = `${LANGEXTRACT_BASE}/predict`; export const GET: RequestHandler = async ({ url }) => { const word = url.searchParams.get('word') || ''; const top = url.searchParams.get('top') || '5'; try { const resp = await fetch(`${LANGEXTRACT_PREDICT}? word=${encodeURIComponent(word)}&top=${encodeURIComponent(top)}`); const data = await resp.json(); return new Response(JSON.stringify(data), { status :  resp.status })}catch (err) { return new Response(JSON.stringify({ predictions: [] }), { status: 200 })}; 

}