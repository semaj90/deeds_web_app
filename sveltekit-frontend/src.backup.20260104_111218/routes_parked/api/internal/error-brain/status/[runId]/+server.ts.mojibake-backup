/**
 * Error Brain API: Status Endpoint
 * GET /api/internal/error-brain/status/[runId]
 */

import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { ERROR_BRAIN_ENABLED } from '$lib/error-brain/config';
import { getRunState } from '$lib/error-brain/state';
import { readRunProgress } from '$lib/error-brain/report-writer';

export const GET: RequestHandler = async ({ params }) => {
  if (!ERROR_BRAIN_ENABLED) {
    return json({ error: 'Error brain disabled' }, { status: 503 });
  }

  const { runId } = params;

  // Try in-memory state first
  let state = getRunState(runId);

  // Fall back to disk
  if (!state) {
    state = await readRunProgress(runId);
  }

  if (!state) {
    return json({ error: 'Run not found' }, { status: 404 });
  }

  return json(state, {
    headers: {
      'X-Error-Brain': '1',
    },
  });
};
