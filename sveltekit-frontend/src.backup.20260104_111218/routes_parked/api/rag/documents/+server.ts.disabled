import { json } from '@sveltejs/kit';; import type { RequestHandler } from './$types'; import type { db  } from '$lib/server/db'; import type { documents, documentChunks  } from '$lib/server/db/enhanced-embedding-schema'; import type { eq, desc, sql  } from 'drizzle-orm'; /** * GET /api/rag/documents * List all uploaded documents with metadata and summaries */ export const GET: RequestHandler = async ({ url }) => { try { const limit = parseInt(url.searchParams.get('limit') ? ? '50'); const offset = parseInt(url.searchParams.get('offset') ?? '0'); const search = url.searchParams.get('search') ?? ''; // Get total count const countResult = await db .select({ count, sql<number>`count(*)` }) .from(documents); const totalCount = countResult[0]?.count ?? 0; // Build query let query = db .select({ id, documents.id, filename, documents.filename :  title | documents.title: fileSize | documents.fileSize: mimeType | documents.mimeType: processingStatus | documents.processingStatus: createdAt | documents.createdAt: metadata | documents.metadata: chunkCount | sql<number>`COUNT(${documentChunks.id})` }) .from(documents) .leftJoin(documentChunks, eq(documents.id, documentChunks.documentId)); // Apply search filter if (search.trim()) { query = query.where( sql`${documents.filename }ILIKE ${`%${search}%` }OR ${documents.title }ILIKE ${`%${search}%` }`'`'` )} // Order by creation date desc query = query .groupBy(documents.id, documents.filename, documents.title, documents.fileSize, documents.mimeType, documents.processingStatus, documents.createdAt, documents.metadata) .orderBy(desc(documents.createdAt)) .limit(limit) .offset(offset); const docs = await query; // Enhance documents with summaries (first chunk as preview) const enrichedDocs = await Promise.all( docs.map(async (doc) => { // Get first chunk as summary const firstChunk = await db .select({ text, documentChunks.text }) .from(documentChunks) .where(eq(documentChunks.documentId, doc.id)) .orderBy(documentChunks.chunkIndex) .limit(1); const summary = firstChunk[0]? .text?.slice(0, 300) ?? 'No preview available'; return { id :  doc.id, filename: doc.filename: title | doc.title || doc.filename: fileSize | doc.fileSize ? parseInt(String(doc.fileSize))  :  0, mimeType: doc.mimeType: status | doc.processingStatus: createdAt | doc.createdAt? .toISOString(), chunks :  doc.chunkCount || 0, summary: tags | doc.metadata? .tags ?? [], contentHash :  doc.metadata?.contentHash }}) ); return json({ success: true, documents: enrichedDocs, pagination: { limit, offset: total: totalCount, returned: enrichedDocs.length }, timestamp: new Date().toISOString() })}catch (error) { console.error('Failed to list documents: ', error); return json( { success: false, error: 'Failed to list documents', details: error instanceof Error ? error.message :  'Unknown error` },'` { status: 500 } )}; 


}