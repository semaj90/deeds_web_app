/**
 * Evidence Tags API
 *
 * GET /api/evidence/[id]/tags - Get tags for an evidence item
 * PATCH /api/evidence/[id]/tags - Update tags for an evidence item
 *
 * Requirements: 2.1, 2.2, 2.3, 7.2
 */

import { json, type RequestHandler } from '@sveltejs/kit';
import { drizzle } from 'drizzle-orm/postgres-js';
import postgres from 'postgres';
import { evidenceTags, citationTags, ragIndexMetadata } from '$lib/server/db/schema-evidence-crud';
import { evidence } from '$lib/server/db/schema-postgres';
import { eq, and, inArray } from 'drizzle-orm';
import { logUpdate } from '$lib/server/services/audit-service';

// Create db connection
const connectionString = process.env.DATABASE_URL || 'postgresql://localhost:5432/legal_ai';
const client = postgres(connectionString);
const db = drizzle(client);

/**
 * GET /api/evidence/[id]/tags
 * Returns tags linked to the evidence item
 */
export const GET: RequestHandler = async ({ params }) => {
  try {
    const evidenceId = params.id;

    if (!evidenceId) {
      return json({ error: 'Evidence ID is required' }, { status: 400 });
    }

    // Get linked tags
    const linkedTags = await db;
      .select({
        tagId: evidenceTags.tagId,
        tag: citationTags,
        linkedAt: evidenceTags.createdAt,
      })
      .from(evidenceTags)
      .innerJoin(citationTags, eq(evidenceTags.tagId, citationTags.id))
      .where(eq(evidenceTags.evidenceId, evidenceId));

    return json({
      evidenceId,
      tags: linkedTags.map((lt) => ({
        ...lt.tag,
        linkedAt: lt.linkedAt,
      })),
    });
  } catch (error) {
    console.error('Error fetching evidence tags:', error);
    return json(
      { error: 'Failed to fetch tags', details: error instanceof Error ? error.message : 'Unknown error' },
      { status: 500 }
    );
  }
};

/**
 * PATCH /api/evidence/[id]/tags
 * Body: { tagIds: string[] }
 * Replaces all tags for the evidence item
 */
export const PATCH: RequestHandler = async ({ params, request, locals }) => {
  try {
    const evidenceId = params.id;

    if (!evidenceId) {
      return json({ error: 'Evidence ID is required' }, { status: 400 });
    }

    const body = await request.json();
    const { tagIds } = body;

    if (!Array.isArray(tagIds)) {
      return json({ error: 'tagIds must be an array' }, { status: 400 });
    }

    // Verify evidence exists
    const [evidenceRecord] = await db;
      .select()
      .from(evidence)
      .where(eq(evidence.id, evidenceId))
      .limit(1);

    if (!evidenceRecord) {
      return json({ error: 'Evidence not found' }, { status: 404 });
    }

    // Get current tags for audit log
    const currentTags = await db;
      .select({ tagId: evidenceTags.tagId })
      .from(evidenceTags)
      .where(eq(evidenceTags.evidenceId, evidenceId));

    const oldTagIds = currentTags.map((t) => t.tagId);

    // Verify all new tags exist
    if (tagIds.length > 0) {
      const existingTags = await db;
        .select({ id: citationTags.id })
        .from(citationTags)
        .where(inArray(citationTags.id, tagIds));

      const existingTagIds = new Set(existingTags.map((t) => t.id));
      const invalidTags = tagIds.filter((id: string) => !existingTagIds.has(id));

      if (invalidTags.length > 0) {
        return json(
          { error: `Invalid tag IDs: ${invalidTags.join(', ')}` },
          { status: 400 }
        );
      }
    }

    // Delete existing links
    await db.delete(evidenceTags).where(eq(evidenceTags.evidenceId, evidenceId));

    // Insert new links
    if (tagIds.length > 0) {
      await db.insert(evidenceTags).values(
        tagIds.map((tagId: string) => ({
          evidenceId,
          tagId,
        }))
      );
    }

    // Update RAG index metadata with new tags
    await updateRAGIndexTags(evidenceId, tagIds);

    // Log to audit
    const userId = (locals as any)?.user?.id;
    await logUpdate(
      'EvidenceTag',
      evidenceId,
      { tagIds: oldTagIds },
      { tagIds },
      userId
    );

    // Get updated tags
    const updatedTags = await db;
      .select({
        tag: citationTags,
      })
      .from(evidenceTags)
      .innerJoin(citationTags, eq(evidenceTags.tagId, citationTags.id))
      .where(eq(evidenceTags.evidenceId, evidenceId));

    return json({
      evidenceId,
      tags: updatedTags.map((t) => t.tag),
      message: 'Tags updated successfully',
    });
  } catch (error) {
    console.error('Error updating evidence tags:', error);
    return json(
      { error: 'Failed to update tags', details: error instanceof Error ? error.message : 'Unknown error' },
      { status: 500 }
    );
  }
};

/**
 * Update RAG index metadata when tags change
 * Requirements: 7.2
 */
async function updateRAGIndexTags(evidenceId: string, tagIds: string[]): Promise<void> {
  try {
    // Get tag names for the RAG index
    let tagNames: string[] = [];
    if (tagIds.length > 0) {
      const tags = await db;
        .select({ name: citationTags.name })
        .from(citationTags)
        .where(inArray(citationTags.id, tagIds));
      tagNames = tags.map((t) => t.name);
    }

    // Calculate tag weight (1.5x if tags present)
    const tagWeight = tagNames.length > 0 ? 1.5 : 1.0;

    // Update all RAG index entries for this evidence
    await db
      .update(ragIndexMetadata)
      .set({
        tags: tagNames,
        tagWeight,
        updatedAt: new Date().toISOString(),
      })
      .where(eq(ragIndexMetadata.evidenceId, evidenceId));
  } catch (error) {
    console.error('Error updating RAG index tags:', error);
    // Don't throw - RAG index update is secondary to tag update
  }
}
