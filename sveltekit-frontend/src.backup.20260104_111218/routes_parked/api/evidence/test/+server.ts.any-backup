import { json } from '@sveltejs/kit'; import type { RequestHandler } from './$types'; /** * Simple test endpoint to verify API routing works */ export const GET: RequestHandler = async () => { return json({ success: true, message: 'Test endpoint working!', timestamp: new Date().toISOString() })}; export const POST: RequestHandler = async ({ request }) => { try { const formData = await request.formData(); const file = formData.get('file') as File; return json({ success: true, message: 'Upload endpoint working!', receivedFile: file ? { name, file.name :  size, file.size: type | file.type }: null })}catch (err: any) { return json({ success: false, error, err.message: stack, err.stack }, { status: 500 })}; 

