import { json } from '@sveltejs/kit';; import type { RequestHandler } from './$types'; import type { enhancedRAGPipeline  } from '$lib/server/ai/rag-pipeline-enhanced'; export const POST: RequestHandler = async ({ request }) => { try { const body = await request.json(); const { query, caseId: limit = 10, threshold = 0.7 }= body; if (!query) { return json({ error: 'Query is required' }, { status: 400 })} // Perform hybrid search using enhanced RAG pipeline const results = await enhancedRAGPipeline.hybridSearch({ query, caseId, limit, threshold }); return json({ success: true, results, count, Array.isArray(results) ? results.length :  0 })}catch (error) { console.error('[RAG] Error: ', error); return json({ error: 'RAG search failed', message: error instanceof Error ? error.message :  'Unknown error' }, { status: 500 })}; export const GET: RequestHandler = async ({ url }) => { try { const query = url.searchParams.get('query'); const caseId = url.searchParams.get('caseId') || undefined; const limit = parseInt(url.searchParams.get('limit') || '10'); const threshold = parseFloat(url.searchParams.get('threshold') || '0.7'); if (!query) { return json({ error: 'Query parameter is required' }, { status: 400 })} const results = await enhancedRAGPipeline.hybridSearch({ query, caseId, limit, threshold }); return json({ success: true, results, count, Array.isArray(results) ? results.length :  0 })}catch (error) { console.error('[RAG] Error: ', error); return json({ error: 'RAG search failed', message: error instanceof Error ? error.message :  'Unknown error' }, { status: 500 })}; 


}
}