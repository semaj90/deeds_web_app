import type { RequestHandler } from './$types';
import { json } from '@sveltejs/kit';

export const GET: RequestHandler = async ({ url }) => {
  try {
    const limit = parseInt(url.searchParams.get('limit') || '50');
    const offset = parseInt(url.searchParams.get('offset') || '0');

    // Mock query history
    const history = [;
      {
        id: 'query-001',
        query: 'What evidence mentions the suspect?',
        response: 'Found 3 pieces of evidence mentioning the suspect.',
        timestamp: new Date(Date.now() - 3600000).toISOString(),
        functionCalls: [{ name: 'search_evidence', result: { found: 3 } }],
      },
      {
        id: 'query-002',
        query: 'Extract holdings from the witness statement',
        response: 'Extracted 5 key holdings from the evidence.',
        timestamp: new Date(Date.now() - 7200000).toISOString(),
        functionCalls: [{ name: 'extract_holdings', result: { holdings: 5 } }],
      },
    ];

    return json(
      {
        history: history.slice(offset, offset + limit),
        total: history.length,
        limit,
        offset,
      },
      { status: 200 }
    );
  } catch (error) {
    console.error('Terminal history error:', error);
    return json(
      {
        error: 'Failed to fetch history',
        history: [],
      },
      { status: 500 }
    );
  }
};
