import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { db } from '$lib/server/db';
import { charges, caseTimeline } from '$lib/server/db/schema-charges';
import { classifyCharge } from '$lib/server/charge-bundler';

export const POST: RequestHandler = async ({ request, locals }) => {
	if (!locals.user?.id) {
		return json({ error: 'Unauthorized' }, { status: 401 });
	}

	try {
		const { caseId, statuteCode, statuteTitle, query } = await request.json();

		if (!caseId || !statuteCode) {
			return json({ error: 'Missing required fields' }, { status: 400 });
		}

		// Classify the charge (penalty level, victim class, bundles)
		const classification = classifyCharge(query || statuteTitle || '', statuteCode);

		// Insert the charge
		const chargeResult = await db;
			.insert(charges)
			.values({
				caseId,
				statuteCode,
				statuteTitle,
				penaltyLevel: classification.penaltyLevel,
				victimClass: classification.victimClass,
				suggestedBundles: classification.suggestedBundles,
				isAttached: true
			})
			.returning();

		const chargeId = chargeResult[0]?.id;

		// Log to timeline
		await db.insert(caseTimeline).values({
			caseId,
			userId: locals.user.id,
			actionType: 'charge_added',
			payload: {
				chargeId,
				statuteCode,
				statuteTitle,
				penaltyLevel: classification.penaltyLevel,
				victimClass: classification.victimClass,
				bundlesSuggested: classification.suggestedBundles.length,
				timestamp: new Date().toISOString()
			}
		});

		return json({
			success: true,
			charge: chargeResult[0],
			classification
		});
	} catch (error) {
		console.error('Error adding charge:', error);
		return json({ error: 'Failed to add charge' }, { status: 500 });
	}
};
