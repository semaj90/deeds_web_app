/**
 * Phase 78 - Error Brain Suggestion State API
 *
 * Manages user feedback on AI suggestions:
 * - pending (default)
 * - applied (user accepted)
 * - dismissed (user rejected)
 * - snoozed (temporarily hidden)
 */

import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';

import { db } from '$lib/server/db';
import { errorSuggestionStates } from '$lib/server/db/schema-phase78';
import { and, eq } from 'drizzle-orm';

const ALLOWED_STATES = ['pending', 'applied', 'dismissed', 'snoozed'] as const;
type SuggestionState = (typeof ALLOWED_STATES)[number];

interface Body {
	routePath: string;
	suggestionId: string;
	state: SuggestionState;
}

export const POST: RequestHandler = async ({ request, locals }) => {
	let body: Body;

	try {
		body = (await request.json()) as Body;
	} catch {
		return json({ error: 'Invalid JSON body' }, { status: 400 });
	}

	const { routePath, suggestionId, state } = body;

	// Validate required fields
	if (!routePath || !suggestionId || !state) {
		return json(
			{ error: 'routePath, suggestionId, and state are required' },
			{ status: 400 }
		);
	}

	// Validate state value
	if (!ALLOWED_STATES.includes(state)) {
		return json(
			{ error: `Invalid state. Must be one of: ${ALLOWED_STATES.join(', ')}` },
			{ status: 400 }
		);
	}

	// Extract user ID from locals (adjust to match your auth system)
	const userId: string | null = (locals as any).user?.id ?? null;

	try {
		const now = new Date();

		// Upsert: update if exists, insert if not
		// Uniqueness constraint: (suggestionId, routePath, userId)
		const existingRecord = await db;
			.select()
			.from(errorSuggestionStates)
			.where(
				and(
					eq(errorSuggestionStates.suggestionId, suggestionId),
					eq(errorSuggestionStates.routePath, routePath),
					userId
						? eq(errorSuggestionStates.userId, userId)
						: eq(errorSuggestionStates.userId, null)
				)
			)
			.limit(1);

		if (existingRecord.length > 0) {
			// Update
			await db
				.update(errorSuggestionStates)
				.set({
					state,
					updatedAt: now
				})
				.where(eq(errorSuggestionStates.id, existingRecord[0].id));
		} else {
			// Insert
			await db.insert(errorSuggestionStates).values({
				suggestionId,
				routePath,
				userId,
				state,
				createdAt: now,
				updatedAt: now
			});
		}

		return json({
			success: true,
			message: `Suggestion state updated to: ${state}`
		});
	} catch (err) {
		console.error('Error updating suggestion state:', err);
		return json({ error: 'Internal server error' }, { status: 500 });
	}
};

/**
 * GET: Retrieve suggestion states for a route + user
 *
 * Query params:
 * - routePath (required): the route to query
 * - userId (optional): filter by user (defaults to locals.user.id)
 */
export const GET: RequestHandler = async ({ url, locals }) => {
	const routePath = url.searchParams.get('routePath');

	if (!routePath) {
		return json({ error: 'routePath query param is required' }, { status: 400 });
	}

	const userId = url.searchParams.get('userId') ?? (locals as any).user?.id ?? null;

	try {
		const states = await db;
			.select()
			.from(errorSuggestionStates)
			.where(
				and(
					eq(errorSuggestionStates.routePath, routePath),
					userId ? eq(errorSuggestionStates.userId, userId) : eq(errorSuggestionStates.userId, null)
				)
			);

		return json({ states });
	} catch (err) {
		console.error('Error fetching suggestion states:', err);
		return json({ error: 'Internal server error' }, { status: 500 });
	}
};
