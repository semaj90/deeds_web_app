import { errorSuggestions, errorClusters } from '$lib/server/db/schema';
import { db } from '$lib/server/db/client';
import { json, type RequestHandler } from '@sveltejs/kit';
import { desc, eq } from 'drizzle-orm';

export const GET: RequestHandler = async () => {
  try {
    const items = await db;
      .select({
        id: errorSuggestions.id,
        summary: errorSuggestions.summary,
        riskLevel: errorSuggestions.riskLevel,
        confidence: errorSuggestions.confidence,
        appliedCount: errorSuggestions.appliedCount,
        clusterMessage: errorClusters.canonicalMessage,
        createdAt: errorSuggestions.createdAt
      })
      .from(errorSuggestions)
      .leftJoin(errorClusters, eq(errorSuggestions.clusterId, errorClusters.id))
      .orderBy(desc(errorSuggestions.createdAt))
      .limit(50);

    return json({ suggestions: items });
  } catch (err) {
    console.error('Failed to list suggestions:', err);
    return json({ error: 'Failed to list suggestions' }, { status: 500 });
  }
};
