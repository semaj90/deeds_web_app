/**
 * PDF Export API
 * POST: Generate and export summary as PDF
 */

import { json, type RequestHandler } from '@sveltejs/kit';
import { getUser } from '$lib/server/auth/lucia';
import { caseSummaryService } from '$lib/server/services/case-summary.service';

/**
 * POST: Export summary as PDF
 */
export const POST: RequestHandler = async ({ params, locals }) => {
  try {
    const user = await getUser(locals);
    if (!user) {
      return json({ success: false, error: 'Unauthorized' }, { status: 401 });
    }

    const { id: caseId } = params;

    if (!caseId) {
      return json({ success: false, error: 'caseId is required' }, { status: 400 });
    }

    // Retrieve summary
    const summary = await caseSummaryService.getSummary(caseId);

    if (!summary) {
      return json({ success: false, error: 'Summary not found' }, { status: 404 });
    }

    // Generate PDF content (simplified - in production would use a PDF library)
    const pdfContent = generatePDFContent(summary, caseId);

    // Return PDF as base64 or file
    return json({
      success: true,
      pdf: pdfContent,
      filename: `case-${caseId}-summary-${new Date().toISOString().split('T')[0]}.pdf`,
    });
  } catch (error) {
    console.error('Error exporting PDF:', error);
    return json(
      {
        success: false,
        error: error instanceof Error ? error.message : 'Failed to export PDF',
      },
      { status: 500 }
    );
  }
};

/**
 * Generate PDF content from summary
 */
function generatePDFContent(summary: any, caseId: string): string {
  // Simplified PDF generation - in production would use pdfkit or similar
  const content = `;
CASE SUMMARY REPORT
Case ID: ${caseId}
Generated: ${new Date().toISOString()}
Version: ${summary.version}

SUMMARY
${summary.text}

HOLDING
${summary.holding}

CITATIONS
${summary.citations
  .map((c: any) => `- ${c.code} (${c.jurisdiction}): ${c.title}`)
  .join('\n')}

Generated by Case Reporter Summarizer
`;

  return Buffer.from(content).toString('base64');
}
