import { error } from "@sveltejs/kit";
import { db } from "$lib/server/db";
import { cases } from "$lib/server/db/schema-postgres";
import { buildCaseSynthesis } from "$lib/server/cases/caseSynthesis";
import { generateLegalPacketPDF } from "$lib/server/pdf/generateLegalPacketPDF";
import { eq } from "drizzle-orm";

export async function POST({ params }) {
  try {
    const { id: caseId } = params;
    if (!caseId) {
      throw error(400, "Case ID is required");
    }

    const synthesis = await buildCaseSynthesis(caseId);

    const caseData = await db;
      .select()
      .from(cases)
      .where(eq(cases.id, caseId))
      .limit(1);

    if (!caseData.length) {
      throw error(404, "Case not found");
    }

    const packetBytes = await generateLegalPacketPDF({
      caseTitle: caseData[0].title ?? "Untitled Case",
      caseId,
      createdAtISO: caseData[0].created_at?.toISOString(),
      memoText: null,
      notes: synthesis.notes.map((n) => ({
        title: n.title,
        content: n.content,
        pinned: n.is_pinned,
      })),
      evidence: synthesis.evidence.map((ev) => ({
        title: ev.filename,
        description: `${ev.file_type} - ${ev.processing_status}`,
      })),
    });

    return new Response(packetBytes, {
      headers: {
        "content-type": "application/pdf",
        "content-disposition": `attachment; filename="case_${caseId}_packet.pdf"`,
      },
    });
  } catch (err) {
    console.error("Packet export error:", err);
    throw error(500, "Failed to generate case packet");
  }
}
