/**
 * Case Statute Link Detail API
 * GET: Get link detail
 * PUT: Update link metadata
 * DELETE: Delete link
 */

import { json, type RequestHandler } from '@sveltejs/kit';
import { getUser } from '$lib/server/auth/lucia';
import { caseLinkService } from '$lib/server/services/case-link.service';

/**
 * GET: Get link detail
 */
export const GET: RequestHandler = async ({ params, locals }) => {
  try {
    const user = await getUser(locals);
    if (!user) {
      return json({ success: false, error: 'Unauthorized' }, { status: 401 });
    }

    const link = await caseLinkService.getLinkDetail(params.id, params.statute_code);
    if (!link) {
      return json({ success: false, error: 'Link not found' }, { status: 404 });
    }

    return json({
      success: true,
      link,
    });
  } catch (error) {
    console.error('Error getting link detail:', error);
    return json(
      {
        success: false,
        error: error instanceof Error ? error.message : 'Failed to get link',
      },
      { status: 500 }
    );
  }
};

/**
 * PUT: Update link metadata
 */
export const PUT: RequestHandler = async ({ params, request, locals }) => {
  try {
    const user = await getUser(locals);
    if (!user) {
      return json({ success: false, error: 'Unauthorized' }, { status: 401 });
    }

    const body = await request.json();
    const { link_type, notes } = body;

    const link = await caseLinkService.updateLinkMetadata(;
      params.id,
      params.statute_code,
      { link_type, notes },
      user.id
    );

    return json({
      success: true,
      link,
    });
  } catch (error) {
    console.error('Error updating link:', error);
    return json(
      {
        success: false,
        error: error instanceof Error ? error.message : 'Failed to update link',
      },
      { status: 500 }
    );
  }
};

/**
 * DELETE: Delete link
 */
export const DELETE: RequestHandler = async ({ params, locals }) => {
  try {
    const user = await getUser(locals);
    if (!user) {
      return json({ success: false, error: 'Unauthorized' }, { status: 401 });
    }

    await caseLinkService.unlinkStatute(params.id, params.statute_code, user.id);

    return json({
      success: true,
      message: 'Link deleted',
    });
  } catch (error) {
    console.error('Error deleting link:', error);
    return json(
      {
        success: false,
        error: error instanceof Error ? error.message : 'Failed to delete link',
      },
      { status: 500 }
    );
  }
};
