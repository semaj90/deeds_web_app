/**
 * Cases API
 * Get prosecutor's cases and create new cases
 */

import { json, type RequestHandler } from '@sveltejs/kit';
import { getUser } from '$lib/server/auth/lucia';
import { db } from '$lib/server/db';
import { wardenCases, wardenEvidence } from '$lib/server/db/warden-schema';
import { eq } from 'drizzle-orm';

export const GET: RequestHandler = async ({ locals }) => {
  try {
    const user = await getUser(locals);
    if (!user) {
      return json({ error: 'Unauthorized' }, { status: 401 });
    }

    // Get prosecutor's cases with evidence counts
    const cases = await db.query.wardenCases.findMany({
      where: eq(wardenCases.prosecutorId, user.id),
      with: {
        evidence: {
          columns: {
            id: true,
            status: true,
          },
        },
      },
      orderBy: (cases, { desc }) => [desc(cases.createdAt)],
    });

    return json(cases);
  } catch (error) {
    console.error('Cases fetch error:', error);
    return json(
      { error: error instanceof Error ? error.message : 'Failed to fetch cases' },
      { status: 500 }
    );
  }
};

export const POST: RequestHandler = async ({ request, locals }) => {
  try {
    const user = await getUser(locals);
    if (!user) {
      return json({ error: 'Unauthorized' }, { status: 401 });
    }

    const body = await request.json();
    const { title } = body;

    if (!title || typeof title !== 'string') {
      return json({ error: 'Title required' }, { status: 400 });
    }

    // Create new case
    const [newCase] = await db;
      .insert(wardenCases)
      .values({
        prosecutorId: user.id,
        title: title.trim(),
      })
      .returning();

    return json(newCase);
  } catch (error) {
    console.error('Case creation error:', error);
    return json(
      { error: error instanceof Error ? error.message : 'Failed to create case' },
      { status: 500 }
    );
  }
};
