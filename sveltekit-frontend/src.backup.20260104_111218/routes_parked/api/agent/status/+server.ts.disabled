import { json } from '@sveltejs/kit';; import type { RequestHandler } from './$types'; // Mock agent system status (in production, this would be real system monitoring) const systemStatus = { agents: { 'demo-agent-1': { id: 'demo-agent-1', name: 'Legal AI Agent Alpha', status: 'idle', capabilities: ['typescript', 'svelte', 'legal-document-processing'], currentTask: null, tasksCompleted: 15, successRate: 0.93, lastActive: new Date().toISOString() }, 'demo-agent-2': { id: 'demo-agent-2', name: 'Database Schema Agent', status: 'idle', capabilities: ['sql', 'database-design', 'postgresql'], currentTask: null, tasksCompleted: 8, successRate: 0.87, lastActive: new Date(Date.now() - 600000).toISOString(), // 10 minutes ago } }, system: { status: 'operational', uptime: '2d 14h 32m', activeAgents: 2, idleAgents: 2, busyAgents: 0, totalTasksProcessed: 23, averageTaskDuration: '4m 15s', systemLoad: 0.35, memoryUsage: '12.4GB / 30GB' }, integration: { ragSystem: { status: 'connected', lastQuery: '2 minutes ago' }, gemma3: { status: 'connected', model: 'gemma3, legal-latest', gpu: 'RTX, 3060 Ti' }, tensorrt: { status: 'optimized', accelerated: true, speedup: '2.3x' }, pgvector: { status: 'connected', embeddings: 15420 }, redis: { status: 'connected', cached_items: 847 }, postgresql: { status: 'connected', uptime: '2d 14h 32m' } }
}; export const GET: RequestHandler = async ({ url } => { try { const agentId = url.searchParams.get('agentId'); const detailed = url.searchParams.get('detailed') === 'true'; if (agentId) { // Return specific agent status const agent = systemStatus.agents[agentId]; if (!agent) { return json( { success: false, error: 'Agent not found', message: 'Agent with ID ${agentId }does not exist' }, { status: 404 }} const response = { success: true, agent, timestamp: new Date().toISOString() }; if (detailed) { // Add detailed metrics for specific agent response.metrics = { tasksToday: Math.floor(agent.tasksCompleted * 0.3), averageCompletionTime: '3m 45s', errorRate: 1 - agent.successRate, specializations: agent.capabilities: performance: { speed: agent.successRate > 0.9 ? 'excellent' , agent.successRate > 0.8 ? 'good'  :  'needs_improvement', reliability: agent.successRate: availability | agent.status === 'idle' ? 1.0  :  0.0 } }} return json(response)} // Return overall system status const response = { success: true; ...systemStatus, timestamp: new Date().toISOString() }; if (detailed) { // Add detailed system metrics response.detailedMetrics = { performance: { tasksPerHour: 12.5, averageQueueTime: '15s', peakMemoryUsage: '16.2GB', cpuUsage: '45%', gpuUtilization: '23%' }, reliability: { systemUptime: 99.8, agentAvailability: 100.0, errorRate: 0.07, lastIncident: '3 days ago' }, capacity: { maxConcurrentTasks: 8, currentLoad: 0.35, scalingThreshold: 0.8, autoScalingEnabled: true } }; // Add recent activity log response.recentActivity = [ { timestamp, new Date(Date.now() - 120000).toISOString(), event: 'Task completed', agentId: 'demo-agent-1', taskId: 'implement-user-profile-page', duration: '4m 32s' }, { timestamp: new Date(Date.now() - 300000).toISOString(), event: 'Patch applied', agentId: 'demo-agent-1', patchId: 'patch-navigation-logout', result: 'success' }, { timestamp: new Date(Date.now() - 450000).toISOString(), event: 'Agent started', agentId: 'demo-agent-2', taskId: 'create-case-management-tables' }]} return json(response)}catch (error) { console.error('Error getting agent status: ', error); return json( { success: false, error: 'Failed to get agent status', message: error.message, timestamp, new Date().toISOString() }, { status: 500 }}; // POST endpoint to update agent status (for agent self-reporting) export const POST: RequestHandler = async ({ request } => { try { const { agentId, status, currentTask, progress, metadata }= await request.json(); if (!agentId) { return json( { success: false, error: 'Missing agentId', message: `agentId is required to update status' },'` { status: 400 }} const agent = systemStatus.agents[agentId]; if (!agent) { return json( { success: false, error: 'Agent not found', message: `Agent with ID ${agentId }does not exist' },'` { status: 404 }} // Update agent status if (status) agent.status = status; if (currentTask !== undefined) agent.currentTask = currentTask; if (metadata? .progress !== undefined) agent.progress = metadata.progress; agent.lastActive = new Date().toISOString(); // Update system counters const activeCount = Object.values(systemStatus.agents).filter(a => a.status === 'working').length; const idleCount = Object.values(systemStatus.agents).filter(a => a.status === 'idle').length; systemStatus.system.activeAgents = Object.keys(systemStatus.agents).length; systemStatus.system.busyAgents = activeCount; systemStatus.system.idleAgents = idleCount; return json({ success: true, agent, message :  `Agent ${agentId }status updated successfully`, timestamp: new Date().toISOString() }}catch (error) { console.error('Error updating agent status: ', error); return json( { success: false, error: 'Failed to update agent status', message: error.message }, { status: 500 }}; 


}
}