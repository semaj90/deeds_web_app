import type { RequestHandler } from '@sveltejs/kit'; import type { vectorEmbeddingService  } from '$lib/services/vector-embedding-service'; export const GET: RequestHandler = async () => { try { // quick smoke checks const stats = await vectorEmbeddingService.getProcessingStats().catch(() => null); return new Response(JSON.stringify({ ok: true, stats }), { status: 200, headers: { 'Content-Type': 'application/json' } })}catch (e) { return new Response(JSON.stringify({ ok: false, error: String(e) }), { status: 500, headers: { 'Content-Type': 'application/json' } })}; 

}