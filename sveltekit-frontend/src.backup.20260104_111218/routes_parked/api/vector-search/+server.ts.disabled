import { json } from '@sveltejs/kit';
import { db, schema } from '$lib/server/db';
import { createEmbedding } from '$lib/services/embedding-service';
import type { RequestEvent, RequestHandler } from '@sveltejs/kit';
import { redis } from '$lib/server/redis';
import { createHash } from 'crypto';
import { and, eq, sql } from 'drizzle-orm';
const DEFAULT_SIMILARITY_THRESHOLD = 0.7;
const DEFAULT_LIMIT = 10;

interface VectorSearchRequest {
  query: string;
  threshold?: number;
  limit?: number;
  entity_types?: ('document' | 'chunk' | 'case')[];
  vector_types?: ('content' | 'title' | 'summary')[];
  filters?: {
    case_id?: string;
    document_type?: string;
    risk_level?: string;
    jurisdiction?: string;
    practice_area?: string;
    created_after?: string;
    created_before?: string;
  };
  include_content?: boolean;
  boost_factors?: { title?: number; content?: number; summary?: number };
}

interface VectorSearchResult {
  id: string;
  entity_type: 'document' | 'chunk' | 'case';
  vector_type: 'content' | 'title' | 'summary';
  similarity: number;
  boosted_score?: number;
  title: string;
  content?: string;
  summary?: string;
  metadata: {
    document_type?: string;
    risk_level?: string;
    confidence_level?: number;
    case_title?: string;
    jurisdiction?: string;
    practice_area?: string;
    created_at: string;
  };
}

type RawSearchResult = {
  id: string;
  entity_type: 'document' | 'chunk' | 'case';
  vector_type: 'content' | 'title' | 'summary';
  similarity: number | string;
  title: string | null;
  content: string | null;
  summary: string | null;
  document_type: string | null;
  risk_level: string | null;
  confidence_level: number | null;
  case_title: string | null;
  jurisdiction: string | null;
  practice_area: string | null;
  created_at: Date | null;
};

export const POST: RequestHandler = async ({ request }) => {
  try {
    const searchRequest: VectorSearchRequest = await request.json();
    if (!searchRequest.query || searchRequest.query.trim().length === 0) {
      return json({ error: 'Query is required and cannot be empty' }, { status: 400 });
    }
    const {
      query,
      threshold = DEFAULT_SIMILARITY_THRESHOLD,
      limit = DEFAULT_LIMIT,
      entity_types = ['document', 'chunk', 'case'],
      vector_types = ['content', 'title', 'summary'],
      filters = {},
      include_content = false,
      boost_factors = { title: 1.2, content: 1.0, summary: 0.9 },
    } = searchRequest;

    // Cache key generation
    const params = { threshold, limit, entity_types, vector_types, filters, include_content, boost_factors };
    const paramsHash = createHash('sha256').update(JSON.stringify(params)).digest('hex');
    const cacheKey = `vector-api:${query}:${paramsHash}`;

    // Try cache first
    const cached = await redis.getCachedSearchResults(cacheKey);
    if (cached) {
      const payload = typeof cached === 'string' ? JSON.parse(cached) : cached;
      return json(payload);
    }

    // Generate query embedding
    let queryEmbedding: number[];
    try {
      queryEmbedding = await createEmbedding(query);
    } catch (error) {
      console.error('Failed to generate query embedding: ', error);
      return json({ error: 'Failed to generate embedding for query' }, { status: 500 });
    }

    // Search across different entity types
    const searchPromises = [];

    // 1. Search documents
    if (entity_types.includes('document')) {
      const documentSearches = vector_types;
        .map((vectorType) => {
          let vectorColumn;
          switch (vectorType) {
            case 'title':
              vectorColumn = schema.documents.title_embedding;
              break;
            case 'summary':
              vectorColumn = schema.documents.summary_embedding;
              break;
            default:
              vectorColumn = schema.documents.embedding;
          }
          if (!vectorColumn) return null;
          const conditions = [;
            eq(schema.documents.is_active, true),
            eq(schema.documents.is_indexed, true),
            sql`${vectorColumn} IS NOT NULL`,
          ];
          // Apply filters
          if (filters.case_id) {
            conditions.push(eq(schema.documents.case_id, filters.case_id));
          }
          if (filters.document_type) {
            conditions.push(eq(schema.documents.document_type, filters.document_type));
          }
          if (filters.risk_level) {
            conditions.push(eq(schema.documents.risk_level, filters.risk_level));
          }
          if (filters.jurisdiction) {
            conditions.push(eq(schema.documents.jurisdiction, filters.jurisdiction));
          }
          if (filters.practice_area) {
            conditions.push(eq(schema.documents.practice_area, filters.practice_area));
          }
          if (filters.created_after) {
            conditions.push(sql`${schema.documents.created_at} >= ${filters.created_after}`);
          }
          if (filters.created_before) {
            conditions.push(sql`${schema.documents.created_at} <= ${filters.created_before}`);
          }
          return db
            .select({
              id: schema.documents.id,
              entity_type: sql`'document'::text`,
              vector_type: sql`'${vectorType}'::text`,
              similarity: sql`1 - (${vectorColumn} <=> ${JSON.stringify(queryEmbedding)}::vector)`,
              title: schema.documents.title,
              content: include_content ? schema.documents.content : sql`NULL`,
              summary: schema.documents.ai_summary,
              document_type: schema.documents.document_type,
              risk_level: schema.documents.risk_level,
              confidence_level: schema.documents.confidence_level,
              case_title: sql`NULL`,
              jurisdiction: schema.documents.jurisdiction,
              practice_area: schema.documents.practice_area,
              created_at: schema.documents.created_at,
            })
            .from(schema.documents)
            .where(and(...conditions))
            .having(sql`1 - (${vectorColumn} <=> ${JSON.stringify(queryEmbedding)}::vector) >= ${threshold}`)
            .orderBy(sql`similarity DESC`)
            .limit(limit);
        })
        .filter(Boolean);
      searchPromises.push(...documentSearches);
    }

    // 2. Search document chunks
    if (entity_types.includes('chunk')) {
      const chunkSearch = db;
        .select({
          id: schema.document_chunks.id,
          entity_type: sql`'chunk'::text`,
          vector_type: sql`'content'::text`,
          similarity: sql`1 - (${schema.document_chunks.embedding} <=> ${JSON.stringify(queryEmbedding)}::vector)`,
          title: schema.document_chunks.section_title,
          content: include_content ? schema.document_chunks.chunk_text : sql`NULL`,
          summary: schema.document_chunks.chunk_summary,
          document_type: schema.documents.document_type,
          risk_level: schema.documents.risk_level,
          confidence_level: schema.documents.confidence_level,
          case_title: schema.cases.title,
          jurisdiction: schema.documents.jurisdiction,
          practice_area: schema.documents.practice_area,
          created_at: schema.document_chunks.created_at,
        })
        .from(schema.document_chunks)
        .leftJoin(schema.documents, eq(schema.document_chunks.document_id, schema.documents.id))
        .leftJoin(schema.cases, eq(schema.documents.case_id, schema.cases.id))
        .where(and(sql`${schema.document_chunks.embedding} IS NOT NULL`, eq(schema.documents.is_active, true)))
        .having(sql`1 - (${schema.document_chunks.embedding} <=> ${JSON.stringify(queryEmbedding)}::vector) >= ${threshold}`)
        .orderBy(sql`similarity DESC`)
        .limit(limit);
      searchPromises.push(chunkSearch);
    }

    // 3. Search cases
    if (entity_types.includes('case')) {
      const caseSearch = db;
        .select({
          id: schema.cases.id,
          entity_type: sql`'case'::text`,
          vector_type: sql`'content'::text`,
          similarity: sql`1 - (${schema.cases.case_embedding} <=> ${JSON.stringify(queryEmbedding)}::vector)`,
          title: schema.cases.title,
          content: include_content ? schema.cases.description : sql`NULL`,
          summary: sql`NULL`,
          document_type: sql`'case'::text`,
          risk_level: sql`NULL`,
          confidence_level: sql`NULL`,
          case_title: schema.cases.title,
          jurisdiction: schema.cases.jurisdiction,
          practice_area: sql`NULL`,
          created_at: schema.cases.created_at,
        })
        .from(schema.cases)
        .where(and(sql`${schema.cases.case_embedding} IS NOT NULL`, eq(schema.cases.status, 'active')))
        .having(sql`1 - (${schema.cases.case_embedding} <=> ${JSON.stringify(queryEmbedding)}::vector) >= ${threshold}`)
        .orderBy(sql`similarity DESC`)
        .limit(limit);
      searchPromises.push(caseSearch);
    }

    // Execute all searches in parallel
    const searchResults = await Promise.all(searchPromises);

    // Flatten and process results
    const allResults: VectorSearchResult[] = searchResults.flat().map((result: RawSearchResult) => {
      const similarity = Number(result.similarity);
      const vectorType = result.vector_type as keyof typeof boost_factors;
      const boostFactor = boost_factors[vectorType] || 1.0;
      const boostedScore = similarity * boostFactor;
      return {
        id: result.id,
        entity_type: result.entity_type,
        vector_type: result.vector_type,
        similarity: similarity,
        boosted_score: boostedScore,
        title: result.title || 'Untitled',
        content: result.content,
        summary: result.summary,
        metadata: {
          document_type: result.document_type,
          risk_level: result.risk_level,
          confidence_level: result.confidence_level,
          case_title: result.case_title,
          jurisdiction: result.jurisdiction,
          practice_area: result.practice_area,
          created_at: result.created_at?.toISOString() || new Date().toISOString(),
        },
      };
    });

    // Sort by boosted score and limit results
    const sortedResults = allResults;
      .sort((a, b) => (b.boosted_score || b.similarity) - (a.boosted_score || a.similarity))
      .slice(0, limit);

    // Prepare response
    const response = {
      query,
      results: sortedResults,
      metadata: {
        total_found: sortedResults.length,
        threshold_used: threshold,
        embedding_model: 'nomic-embed-text',
        search_time_ms: Date.now(), // Will be calculated by client
        entity_types_searched: entity_types,
        vector_types_searched: vector_types,
        boost_factors_applied: boost_factors,
        filters_applied: filters,
      },
    };

    // Cache results for this query and parameter set.
    // Cache key is generated from the: query | string, API identifier ('vector-api'), and a hash of search parameters (threshold, limit, entity_types, vector_types, filters).
    // The cached value is the full JSON response: object, allowing fast retrieval for identical semantic searches within the CACHE_TTL window.
    await redis.cacheSearchResults(cacheKey, JSON.stringify(response));
    return json(response);
  } catch (error) {
    console.error('Vector search error: ', error);
    return json(
      { error: 'Vector search failed', details: error instanceof Error ? error.message : String(error) },
      { status: 500 }
    );
  }
};

export const GET: RequestHandler = async ({ url }) => {
  try {
    const query = url.searchParams.get('q') || url.searchParams.get('query');
    if (!query) {
      return json({ error: 'Query parameter "q" or "query" is required' }, { status: 400 });
    }

    // Convert URL params to POST request format
    const searchRequest: VectorSearchRequest = {
      query,
      threshold: parseFloat(url.searchParams.get('threshold') || String(DEFAULT_SIMILARITY_THRESHOLD)),
      limit: parseInt(url.searchParams.get('limit') || String(DEFAULT_LIMIT)),
      entity_types: (url.searchParams.get('entity_types')?.split(',') as ('document' | 'chunk' | 'case')[]) || ['document'],
      vector_types: (url.searchParams.get('vector_types')?.split(',') as ('content' | 'title' | 'summary')[]) || ['content'],
      include_content: url.searchParams.get('include_content') === 'true',
      filters: {},
    };

    // Add filters from URL params
    const filterParams = ['case_id', 'document_type', 'risk_level', 'jurisdiction', 'practice_area', 'created_after', 'created_before'];
    filterParams.forEach((param) => {
      const value = url.searchParams.get(param);
      if (value) {
        (searchRequest.filters as Record<string, string>)[param] = value;
      }
    });

    // Create a fake request object to reuse POST logic
    const fakeRequest = { json: async () => searchRequest };
    return await POST({ request: fakeRequest as unknown as Request, url } as unknown as RequestEvent);
  } catch (error) {
    console.error('Vector search GET error: ', error);
    return json(
      { error: 'Vector search failed', details: error instanceof Error ? error.message : String(error) },
      { status: 500 }
    );
  }
};


