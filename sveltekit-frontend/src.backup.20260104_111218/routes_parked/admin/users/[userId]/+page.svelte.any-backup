          > {formLoading ? '[UPDATING...]': '[UPDATE PROFILE]'} </button> </div> </form> </div> </div> {/if} <!-- Password, Reset, Modal --> {#if showPasswordModal} <div class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center"> <div class="bg-gray-900 border-2 border-red-500 p-6 max-w-md w-full"> <div class="border-b border-red-500 pb-4"> <h2 class="text-xl font-bold">RESET PASSWORD</h2> </div> <div class="bg-red-900/20 border border-red-500 p-4"> <p class="text-red-300 font-bold">WARNING</p> <p class="text-gray-300">This will reset the user's password and revoke all active sessions.</p> </div> <form method="POST"'
