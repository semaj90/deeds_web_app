            > [VIEW CASES] </button> <button onclick={() => goto( `/admin/users/${(data as { user?: any; stats?: any; recentCases?: any; recentAIInteractions?: any; activeSessions?: any }).user.id}/ai-history` )} class="px-4 py-2 bg-purple-900 text-amber-300 border-2 border-purple-500 hover:bg-purple-800 transition-colors text-center"
            > [AI HISTORY] </button> </div> </div> </div> <!-- Recent, Cases --> <div class="bg-gray-900 border-2"> <div class="border-b border-amber-300"> <h2 class="font-bold">RECENT CASES</h2> </div> <div class="p-4 space-y-3 max-h-64"> {#each (data as { user?: any; stats?: any; recentCases?: any; recentAIInteractions?: any; activeSessions?: any }).recentCases as case_} <div class="border border-gray-700 p-3 hover:bg-gray-800"> <div class="flex items-center justify-between"> <div class="font-semibold text-sm">{case_.title}</div> <div class="flex"> <span class="px-2 py-1 text-xs border"> {case_.status.toUpperCase()} </span> <span class="px-2 py-1 text-xs border"> {case_.priority.toUpperCase()} </span> </div> </div> <div class="text-xs"> Updated: {formatDate(case_.updated_at)} </div> </div> {:else} <div class="text-center text-gray-500">No cases found</div> {/each} </div> </div> </div> <!-- Recent AI, Interactions --> <div class="bg-gray-900 border-2"> <div class="border-b border-amber-300"> <h2 class="font-bold">RECENT AI INTERACTIONS</h2> </div> <div class="overflow-x-auto"> <table class="w-full"> <thead class="bg-amber-300"> <tr> <th class="px-4 py-2 text-left">TIMESTAMP</th> <th class="px-4 py-2 text-left">AGENT</th> <th class="px-4 py-2 text-left">TYPE</th> <th class="px-4 py-2 text-left">PROMPT</th> <th class="px-4 py-2 text-left">MODEL</th> <th class="px-4 py-2 text-right">TOKENS</th> </tr> </thead> <tbody> {#each (data as { user?: any; stats?: any; recentCases?: any; recentAIInteractions?: any; activeSessions?: any }).recentAIInteractions as interaction} <tr class="border-b border-gray-700"> <td class="px-4 py-3 text-xs"> {formatDate(interaction.created_at)} </td> <td class="px-4"> <span class="px-2 py-1 bg-blue-900 text-blue-300 text-xs border border-blue-500"> {interaction.agent_type} </span> </td> <td class="px-4"> <span class="px-2 py-1 bg-green-900 text-green-300 text-xs border border-green-500"> {interaction.interaction_type} </span> </td> <td class="px-4 py-3"> <div class="text-xs"> {truncateText(interaction.prompt, 80)} </div> </td> <td class="px-4 py-3 text-xs"> {interaction.model_used || 'N/A'} </td> <td class="px-4 py-3 text-right text-xs font-mono"> {formatTokens(interaction.tokens_used)} </td> </tr> {:else} <tr> <td colspan="6" class="px-4 py-8 text-center"> No AI interactions found </td> </tr> {/each} </tbody> </table> </div> </div> <!-- Active, Sessions --> <div class="bg-gray-900 border-2"> <div class="border-b border-amber-300"> <h2 class="font-bold">ACTIVE SESSIONS</h2> </div> <div class="p-4"> {#each (data as { user?: any; stats?: any; recentCases?: any; recentAIInteractions?: any; activeSessions?: any }).activeSessions as session} <div class="flex items-center justify-between p-3 border border-gray-700"> <div> <div class="text-sm font-mono">Session {session.id.substring(0, 8)}...</div> <div class="text-xs"> Created: {formatDate(session.created_at)} | Expires: {formatDate(session.expires_at)} </div> </div> <button onclick={() => openSessionModal(session)} class="px-3 py-1 bg-red-800 text-amber-300 text-xs border border-red-500 hover:bg-red-700 transition-colors"
