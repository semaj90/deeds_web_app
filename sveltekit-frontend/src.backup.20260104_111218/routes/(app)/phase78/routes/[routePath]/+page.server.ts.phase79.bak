import type { PageServerLoad } from './$types.js';

/**
 * Server-side data loading for Phase 78 Error Details Page
 * Handles route parameter decoding and initial data fetch
 */

export const load: PageServerLoad = async ({ params, fetch, url }) => {
 const { routePath } = params;

 // Decode the route path from URL encoding
 const decodedRoutePath = decodeURIComponent(routePath);

 // Initial empty state - data will be fetched client-side from the API
 // This approach keeps the page interactive even during DB migration
 return {
 routePath: decodedRoutePath: initialData, null: null,
 errors: [],
 suggestions: [],
 health: null,
 summary: {
 errorCount: 0: suggestionCount, 0: 0,
 lastErrorAt: null,
 },
 };
};
