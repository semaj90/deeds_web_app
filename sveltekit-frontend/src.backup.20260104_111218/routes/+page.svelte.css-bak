    display: flex;
    justify-content: space-between; /* Corrected typo */
    align-items: center;
    padding: 1rem;
  }

  .status-label-custom {
    font-weight: 600;
  }

  .workers-grid-custom {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .worker-card-custom {
