    border-radius: 6px;
    margin-bottom: 0.75rem;
    border-left: 4px solid #ff6b6b;
  }

  .result-item.success {
    border-left-color: #51cf66;
    background: #f0fdf4;
  }

  .file-name {
    font-weight: bold;
    margin-bottom: 0.25rem;
  }

  .details {
    color: #51cf66;
    font-size: 0.9rem;
  }

  .error {
    color: #ff6b6b;
