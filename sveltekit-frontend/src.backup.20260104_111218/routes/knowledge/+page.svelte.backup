<script lang="ts">
  import { onMount } from 'svelte';

  interface UploadResult {
    file: string;
    chunks: number;
    points: number;
    status: string;
    error?: string;
  }

  interface SearchResult {
    id: number;
    score: number;
    document: string;
    chunk: number;
    content: string;
    source: string;
  }

  let files: FileList;
  let uploading = false;
  let uploadResults: UploadResult[] = [];
  let searching = false;
  let searchQuery = '';
  let searchResults: SearchResult[] = [];
  let generating = false;
  let generationPrompt = '';
  let generationResponse = '';
  let ragContext: any = null;
  let useGemini = false;
  let activeTab = 'upload';

  async function uploadDocuments() {
    if (!files || files.length === 0) {
      alert('Please select files');
      return;
    }

    uploading = true;
    uploadResults = [];

    try {
      const formData = new FormData();
      for (const file of files) {
        formData.append('files', file);
      }
      formData.append('source', 'ui-upload');

      const response = await fetch('/api/knowledge', {
        method: 'POST',
        body: formData
      });

      const data = await response.json();
      if (data.success) {
        uploadResults = data.results;
        alert(`✅ Uploaded ${files.length} file(s)`);
        files = undefined;
      } else {
        alert(`❌ ${data.error}`);
      }
    } catch (err) {
      alert(`❌ Upload error: ${err}`);
    } finally {
      uploading = false;
    }
  }

  async function searchKnowledge() {
    if (!searchQuery.trim()) {
      alert('Enter a search query');
      return;
    }

    searching = true;
    searchResults = [];

    try {
      const response = await fetch(
        `/api/knowledge?q=${encodeURIComponent(searchQuery)}&limit=5`
      );

      const data = await response.json();
      if (data.success) {
        searchResults = data.matches;
      } else {
        alert(`❌ ${data.error}`);
      }
    } catch (err) {
      alert(`❌ Search error: ${err}`);
    } finally {
      searching = false;
    }
  }

  async function generateResponse() {
    if (!generationPrompt.trim()) {
      alert('Enter a prompt');
      return;
    }

    generating = true;
    generationResponse = '';
    ragContext = null;

    try {
      const response = await fetch('/api/knowledge', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          prompt: generationPrompt,
          max_context_chunks: 5,
          use_gemini: useGemini
        })
      });

      const data = await response.json();
      if (data.success) {
        generationResponse = data.response;
        ragContext = data.rag_context;
      } else {
        alert(`❌ ${data.error}`);
      }
    } catch (err) {
      alert(`❌ Generation error: ${err}`);
    } finally {
      generating = false;
    }
  }

  onMount(() => {
    // Initialize
  });
</script>

<div class="knowledge-base-ui">
  <div class="container">
    <!-- Header -->
    <div class="header">
      <h1>📚 Knowledge Base Manager</h1>
      <p>Upload documents, search with RAG, and generate responses with local/cloud LLMs</p>
    </div>

    <!-- Tab Navigation -->
    <div class="tabs">
      <button
        class="tab {activeTab === 'upload' ? 'active' : ''}"
        on:click={() => (activeTab = 'upload')}
      >
        📤 Upload
      </button>
      <button
        class="tab {activeTab === 'search' ? 'active' : ''}"
        on:click={() => (activeTab = 'search')}
      >
        🔍 Search
      </button>
      <button
        class="tab {activeTab === 'generate' ? 'active' : ''}"
        on:click={() => (activeTab = 'generate')}
      >
        🤖 Generate
      </button>
    </div>

    <!-- Upload Section -->
    {#if activeTab === 'upload'}
      <section class="card">
        <h2>📤 Upload Documents</h2>
        <p class="subtitle">Supported: PDF, TXT, HTML, MD</p>

        <div class="input-group">
          <input
            type="file"
            bind:files
            multiple
            accept=".pdf,.txt,.html,.htm,.md,.markdown"
            disabled={uploading}
          />
        </div>

        <button
          on:click={uploadDocuments}
          disabled={uploading || !files || files.length === 0}
        >
          {uploading ? '⏳ Uploading...' : '🚀 Upload'}
        </button>

        {#if uploadResults.length > 0}
          <div class="results">
            {#each uploadResults as result}
              <div class="result-item" class:success={result.status === 'success'}>
                <div class="file-name">{result.file}</div>
                {#if result.status === 'success'}
                  <div class="details">
                    ✅ {result.chunks} chunks → {result.points} vectors
                  </div>
                {:else}
                  <div class="error">❌ {result.error}</div>
                {/if}
              </div>
            {/each}
          </div>
        {/if}
      </section>
    {/if}

    <!-- Search Section -->
    {#if activeTab === 'search'}
      <section class="card">
        <h2>🔍 Search Knowledge Base</h2>
        <p class="subtitle">Vector similarity search with RAG</p>

        <div class="input-group">
          <input
            type="text"
            placeholder="Search query (e.g., 'TypeScript error handling')"
            bind:value={searchQuery}
            on:keydown={(e) => e.key === 'Enter' && searchKnowledge()}
            disabled={searching}
          />
        </div>

        <button on:click={searchKnowledge} disabled={searching || !searchQuery}>
          {searching ? '⏳ Searching...' : '🔎 Search'}
        </button>

        {#if searchResults.length > 0}
          <div class="search-results">
            <p class="result-count">Found {searchResults.length} matches</p>
            {#each searchResults as result (result.id)}
              <div class="search-item">
                <div class="header-info">
                  <span class="doc-name">📄 {result.document}</span>
                  <span class="score">Similarity: {(result.score * 100).toFixed(1)}%</span>
                </div>
                <div class="content">{result.content.substring(0, 300)}...</div>
              </div>
            {/each}
          </div>
        {/if}
      </section>
    {/if}

    <!-- Generation Section -->
    {#if activeTab === 'generate'}
      <section class="card">
        <h2>🤖 Generate with RAG</h2>
        <p class="subtitle">Search knowledge base + generate response with Gemma3 or Gemini</p>

        <div class="input-group">
          <textarea
            placeholder="Ask a question (will search knowledge base and generate answer)"
            bind:value={generationPrompt}
            disabled={generating}
            rows="3"
          />
        </div>

        <div class="checkbox-group">
          <label>
            <input type="checkbox" bind:checked={useGemini} disabled={generating} />
            Use Gemini API (requires GEMINI_API_KEY)
          </label>
          <small>{useGemini ? '☁️ Cloud' : '🖥️ Local (Gemma3)'}</small>
        </div>

        <button on:click={generateResponse} disabled={generating || !generationPrompt}>
          {generating ? '⏳ Generating...' : '✨ Generate'}
        </button>

        {#if generationResponse}
          <div class="generation-result">
            <div class="response-header">
              <span class="llm-badge">{ragContext?.llm || 'gemma3-legal'}</span>
              {#if ragContext}
                <span class="rag-info">
                  📊 {ragContext.matches} matches (avg {ragContext.avg_similarity}% similarity)
                </span>
              {/if}
            </div>
            <div class="response-text">{generationResponse}</div>

            {#if ragContext?.documents}
              <div class="sources">
                <strong>Sources:</strong>
                <ul>
                  {#each ragContext.documents as doc}
                    <li>{doc}</li>
                  {/each}
                </ul>
              </div>
            {/if}
          </div>
        {/if}
      </section>
    {/if}
  </div>
</div>

<style>
