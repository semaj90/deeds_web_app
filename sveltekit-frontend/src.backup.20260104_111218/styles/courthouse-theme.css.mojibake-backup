/* Courthouse Theme Extension - Professional Legal Dashboard */
/* Extends YoRHa noir-beige palette with judicial aesthetics */

:root {
  /* YoRHa Base Palette (existing) */
  --noir: #1a1a1a;
  --beige: #f5f1e8;
  --bronze: #b8860b;

  /* Courthouse Judicial Colors */
  --navy: #1a3a52;
  --court-red: #8b3a3a;
  --burgundy: #6b2c2c;
  --gold-accent: #d4af37;

  /* Courthouse Typography */
  --font-serif-heading: 'Merriweather', 'Spectral', 'Playfair Display', serif;
  --font-sans-body: 'Inter', 'Source Sans Pro', 'Roboto', sans-serif;
  --font-mono-code: 'JetBrains Mono', 'Consolas', 'Monaco', monospace;

  /* Courthouse Spacing */
  --space-xs: 0.25rem;
  --space-sm: 0.5rem;
  --space-md: 0.75rem;
  --space-lg: 1.25rem;
  --space-xl: 2rem;
  --space-2xl: 3.25rem;

  /* Courthouse Borders */
  --border-width: 1px;
  --border-radius: 4px;
  --border-color-primary: var(--bronze);
  --border-color-secondary: var(--navy);

  /* Courthouse Shadows */
  --shadow-subtle: 0 2px 4px rgba(26, 58, 82, 0.1);
  --shadow-medium: 0 4px 8px rgba(26, 58, 82, 0.15);
  --shadow-strong: 0 8px 16px rgba(26, 58, 82, 0.2);

  /* Progress Bar Colors */
  --progress-fill: var(--bronze);
  --progress-background: rgba(26, 58, 82, 0.2);
  --progress-height: 8px;

  /* Alert Colors */
  --alert-warning-bg: var(--court-red);
  --alert-warning-text: var(--noir);
  --alert-success-bg: #4a7c59;
  --alert-success-text: var(--beige);
  --alert-error-bg: #8b3a3a;
  --alert-error-text: var(--beige);

  /* Status Indicators */
  --status-complete: #4a7c59;
  --status-processing: #d4af37;
  --status-pending: #999999;
  --status-error: #8b3a3a;
}

/* Courthouse Base Styles */
.courthouse-dashboard {
  background: var(--beige);
  color: var(--noir);
  font-family: var(--font-sans-body);
  line-height: 1.6;
}

.courthouse-heading {
  font-family: var(--font-serif-heading);
  color: var(--noir);
  font-weight: 600;
  letter-spacing: 0.02em;
}

.courthouse-heading-1 {
  font-size: 2rem;
  margin-bottom: var(--space-lg);
}

.courthouse-heading-2 {
  font-size: 1.5rem;
  margin-bottom: var(--space-md);
}

.courthouse-heading-3 {
  font-size: 1.25rem;
  margin-bottom: var(--space-md);
}

.courthouse-metadata {
  font-family: var(--font-mono-code);
  font-size: 0.875rem;
  color: var(--noir);
  opacity: 0.8;
}

/* Progress Card Styles */
.progress-card {
  background: var(--beige);
  border: var(--border-width) solid var(--bronze);
  border-radius: var(--border-radius);
  padding: var(--space-lg);
  box-shadow: var(--shadow-subtle);
  transition: all 0.3s ease;
}

.progress-card:hover {
  box-shadow: var(--shadow-medium);
  border-color: var(--navy);
}

.progress-card-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.progress-card-icon {
  font-size: 1.5rem;
  line-height: 1;
}

.progress-card-title {
  font-family: var(--font-serif-heading);
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--noir);
  margin: 0;
}

.progress-bar-container {
  background: var(--progress-background);
  border-radius: 2px;
  height: var(--progress-height);
  overflow: hidden;
  margin: var(--space-md) 0;
  border: var(--border-width) solid var(--navy);
}

.progress-bar-fill {
  background: linear-gradient(90deg, var(--bronze), var(--gold-accent));
  height: 100%;
  transition: width 0.3s ease;
  border-radius: 2px;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--space-md);
  font-size: 0.875rem;
}

.progress-percentage {
  font-family: var(--font-mono-code);
  font-weight: 600;
  color: var(--noir);
}

.progress-eta {
  font-family: var(--font-mono-code);
  color: var(--noir);
  opacity: 0.8;
}

.progress-stage {
  font-family: var(--font-serif-heading);
  font-size: 0.875rem;
  color: var(--noir);
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: var(--border-width) solid var(--bronze);
}

.progress-details {
  font-family: var(--font-mono-code);
  font-size: 0.75rem;
  color: var(--noir);
  opacity: 0.7;
  margin-top: var(--space-sm);
}

/* Thumbnail Tray Styles */
.thumbnail-tray {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-md);
  background: var(--beige);
  border: var(--border-width) solid var(--bronze);
  border-radius: var(--border-radius);
  overflow-x: auto;
  align-items: center;
}

.thumbnail-tray-label {
  font-family: var(--font-serif-heading);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--noir);
  white-space: nowrap;
  margin-right: var(--space-md);
}

.page-thumbnail {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background: var(--noir);
  border: var(--border-width) solid var(--bronze);
  border-radius: var(--border-radius);
  color: var(--beige);
  font-family: var(--font-mono-code);
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  position: relative;
}

.page-thumbnail:hover {
  background: var(--navy);
  border-color: var(--gold-accent);
  box-shadow: var(--shadow-subtle);
}

.page-thumbnail.complete {
  background: var(--status-complete);
  border-color: var(--status-complete);
  color: var(--beige);
}

.page-thumbnail.processing {
  background: var(--status-processing);
  border-color: var(--status-processing);
  color: var(--noir);
  animation: pulse-processing 1.5s ease-in-out infinite;
}

.page-thumbnail.pending {
  background: var(--status-pending);
  border-color: var(--status-pending);
  color: var(--beige);
  opacity: 0.6;
}

.page-thumbnail.error {
  background: var(--status-error);
  border-color: var(--status-error);
  color: var(--beige);
}

.page-thumbnail-status {
  font-size: 1rem;
  line-height: 1;
}

@keyframes pulse-processing {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

/* Fallback Alert Styles */
.fallback-alert {
  background: var(--alert-warning-bg);
  color: var(--alert-warning-text);
  padding: var(--space-lg);
  border-radius: var(--border-radius);
  border-left: 4px solid var(--gold-accent);
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  margin: var(--space-lg) 0;
  box-shadow: var(--shadow-subtle);
}

.fallback-alert-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
  line-height: 1;
}

.fallback-alert-content {
  flex: 1;
}

.fallback-alert-title {
  font-family: var(--font-serif-heading);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.fallback-alert-message {
  font-size: 0.875rem;
  line-height: 1.5;
  margin-bottom: var(--space-md);
}

.fallback-alert-confidence {
  font-family: var(--font-mono-code);
  font-size: 0.75rem;
  opacity: 0.9;
}

.fallback-alert-button {
  background: var(--noir);
  color: var(--beige);
  border: var(--border-width) solid var(--noir);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--border-radius);
  font-family: var(--font-sans-body);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: var(--space-md);
}

.fallback-alert-button:hover {
  background: var(--bronze);
  border-color: var(--bronze);
  color: var(--noir);
}

/* Responsive Layout */
.dashboard-container {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-lg);
  padding: var(--space-lg);
  max-width: 1400px;
  margin: 0 auto;
}

@media (min-width: 1024px) {
  .dashboard-container {
    grid-template-columns: 2fr 1fr;
    grid-template-areas:
      'progress tray'
      'alert alert';
  }

  .progress-card {
    grid-area: progress;
  }

  .thumbnail-tray {
    grid-area: tray;
    flex-direction: column;
    height: fit-content;
  }

  .fallback-alert {
    grid-area: alert;
  }
}

@media (max-width: 768px) {
  .dashboard-container {
    grid-template-columns: 1fr;
    gap: var(--space-md);
    padding: var(--space-md);
  }

  .thumbnail-tray {
    flex-direction: row;
    overflow-x: auto;
  }

  .page-thumbnail {
    width: 36px;
    height: 36px;
    font-size: 0.7rem;
  }
}

/* Accessibility */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

/* Focus Styles */
.progress-card:focus-within,
.page-thumbnail:focus,
.fallback-alert-button:focus {
  outline: 2px solid var(--navy);
  outline-offset: 2px;
}

/* Print Styles */
@media print {
  .courthouse-dashboard {
    background: white;
    color: black;
  }

  .progress-card,
  .thumbnail-tray,
  .fallback-alert {
    border: 1px solid black;
    box-shadow: none;
  }
}
