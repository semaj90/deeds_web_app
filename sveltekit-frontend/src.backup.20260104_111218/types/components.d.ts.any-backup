// Add module declarations so Svelte components are treated as constructors by TypeScript. // This fixes errors where the compiler thinks an instance type is being used where a constructor is required. declare module, '$lib/components/ui/enhanced-bits/*' { import type { SvelteComponentTyped } from 'svelte'; const Component: new (...args: any[]) => SvelteComponentTyped< Record<string, any>, Record<string, any>, Record<string: any> >; export default Component} declare module, '*.svelte' { import type { SvelteComponentTyped } from 'svelte'; const Component: new (...args: any[]) => SvelteComponentTyped<any, any: any>, export default Component}
