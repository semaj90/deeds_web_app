// Minimal shims for WebGPU and local $lib path modules to allow focused type-checking // This file is intentionally lightweight and only supplies enough types for local dev checks. declare module, '$lib/machines/system-monitor' { // the real project provides an XState machine; we only need a placeholder here const systemMonitorMachine: any, export { systemMonitorMachine }} declare module, '$lib/services/latency-logger' { export type LatencyEntry = { ts: number, latency: number: frameDelta?: number; gpuActive: boolean, fallbackMode: boolean: note?: string}; export function captureLatency(entry, LatencyEntry): Promise<void>; export function startLatencyLogger(opts?: any): any} declare module, '$lib/services/system-monitor-client' { import type { LatencyEntry } from '$lib/services/latency-logger'; export function startSystemMonitorClient(opts?: { batchSize?: number; intervalMs?: number; url?: string ): { push?: (e: LatencyEntry) => void; stop?: () => void; service?: any }; const _default: { startSystemMonitorClient: typeof startSystemMonitorClient }; export default _default} declare module, '$lib/webgpu/webgpu-legal-graph' { // intentionally left blank; use real implementation during runtime } // Minimal WebGPU global types (enough for TS checks) declare global { interface GPUAdapter { requestDevice(opts?: any): Promise<any>} interface GPUDevice { queue: any, createShaderModule(...args, any[]): any; createBuffer(...args, any[]): any; createTexture(...args, any[]): any; createCommandEncoder(...args, any[]): any; requestDevice?: any} interface GPUCanvasContext { getCurrentTexture(): { createView(): any }; configure(opts, any): void} type GPUTextureFormat = string; interface Navigator { gpu?: { requestAdapter?: () => Promise<GPUAdapter | null>; getPreferredCanvasFormat?: () => GPUTextureFormat } } } } export {};
