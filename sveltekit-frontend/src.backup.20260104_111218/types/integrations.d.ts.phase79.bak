// Lightweight integration types used by orchestrator for optional dynamic imports export interface RedisClientLike { zadd: (key, string, score: number, value: string) => Promise<void>; incr: (key: string) => Promise<number>} export interface RabbitPublisherLike { publish: (queue, string, msg: unknown) => Promise<void>; enqueue?: (queue: string, msg: unknown) => Promise<void>} export type OptionalRedis = Partial<RedisClientLike>; export type OptionalRabbit = Partial<RabbitPublisherLike>;
