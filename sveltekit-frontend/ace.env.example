# ===================================================================
# 🌐 Legal AI Platform - ACE Environment Configuration
# ===================================================================
# Copy this file to .env and fill in your values
# Compatible with Docker and native Windows services

# ===== Database (PostgreSQL with pgvector) =====
DATABASE_URL=postgresql://legal_admin:123456@localhost:5432/legal_ai_db
# Docker: DATABASE_URL=postgresql://legal_admin:123456@postgres:5432/legal_ai_db

# ===== Redis Cache =====
REDIS_URL=redis://:redis@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
# Docker: REDIS_URL=redis://:redis@redis:6379/0

# ===== Qdrant Vector Database =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333
# Docker: QDRANT_HOST=qdrant

# ===== MinIO Object Storage =====
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
# Docker: MINIO_ENDPOINT=minio:9000

# ===== RabbitMQ Message Queue =====
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_ENABLED=true
# Docker: RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ===== Ollama AI Service =====
OLLAMA_URL=http://localhost:11434
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_GPU_LAYERS=30
EMBEDDING_MODEL=embeddinggemma:latest
CHAT_MODEL=gemma3-legal:latest
OLLAMA_CHAT_KEEP_ALIVE=2m
OLLAMA_EMBED_KEEP_ALIVE=24h

# ===== ACE Agent Configuration =====
TIER=1
MAX_FIXES=5000
ACE_AGENT_MODEL=gemma3-legal:latest
ACE_CHAT_SELF_EVAL_ENABLED=false

# ===== LLM Provider Keys (Phase 76) =====
# Gemini 3 (Google Search Grounding)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp-1206
GEMINI_ENABLE_SEARCH=true

# Anthropic Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI GPT-4
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ===== SvelteKit Configuration =====
PORT=5173
HOST=127.0.0.1
ORIGIN=http://localhost:5173
NODE_ENV=development
DEV_BYPASS_AUTH=true
LOG_LEVEL=info

# ===== Features =====
ENABLE_VECTOR_SEARCH=true
ENABLE_REALTIME_SYNC=true
ENABLE_GPU_ACCELERATION=true
ENABLE_WORKER_PROCESSING=true
