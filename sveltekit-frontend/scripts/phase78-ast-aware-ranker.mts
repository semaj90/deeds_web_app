#!/usr/bin/env node
/**
 * Phase 78 - AST-Aware Error Ranking System
 *
 * This script enhances error analysis by using the Svelte compiler AST to:
 * 1. Parse Svelte files and correlate errors to specific AST nodes
 * 2. Rank errors by architectural impact (component hierarchy, dependency chains)
 * 3. Cluster errors by AST patterns (e.g., all $derived usage errors)
 * 4. Prioritize fixes based on blast radius and fix difficulty
 *
 * Architecture:
 * - Uses svelte/compiler to parse .svelte files into AST
 * - Matches svelte-check diagnostics to AST node positions
 * - Builds dependency graph from imports/exports
 * - Calculates impact ranking using graph centrality
 * - Generates fix recommendations with context
 *
 * Integration with existing Phase 78:
 * - Reads from logs/svelte-check.log (generated by npx svelte-check)
 * - Writes enhanced JSON to svelte-check-errors-index/ast-ranked-errors.json
 * - Updates PostgreSQL raw_error_embeddings with ast_context and priority_score
 * - Feeds into phase78:cluster for GPU-accelerated clustering
 *
 * Usage:
 *   npm run phase78:ast-rank              # Run full AST analysis
 *   npm run phase78:ast-rank -- --top 50  # Rank top 50 files only
 *   npm run phase78:ast-rank -- --verbose # Show detailed AST analysis
 */

import { createHash } from 'crypto';
import dotenv from 'dotenv';
import { drizzle } from 'drizzle-orm/postgres-js';
import * as fs from 'fs/promises';
import * as path from 'path';
import postgres from 'postgres';
import { parse, walk } from 'svelte/compiler';
import { fileURLToPath } from 'url';

dotenv.config();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const projectRoot = path.resolve(__dirname, '..');

// CLI arguments
const args = process.argv.slice(2);
const TOP_N = parseInt(args.find(a => a.startsWith('--top'))?.split('=')[1] || '100');
const VERBOSE = args.includes('--verbose');
const DRY_RUN = args.includes('--dry-run');

// Database connection (optional - graceful fallback if not available)
let db: any = null;
let dbClient: any = null;
if (process.env.DATABASE_URL && !DRY_RUN) {
  try {
    dbClient = postgres(process.env.DATABASE_URL, { onnotice: () => {} });
    db = drizzle(dbClient);
  } catch (err) {
    console.warn('⚠️  Database not available, will skip DB writes');
  }
}

// ============================================================================
// TYPE DEFINITIONS
// ============================================================================

interface SvelteError {
  file: string;
  line: number;
  column: number;
  message: string;
  code?: string;
  severity: 'error' | 'warning' | 'info';
}

interface ASTNode {
  type: string;
  start: number;
  end: number;
  loc?: {
    start: { line: number; column: number };
    end: { line: number; column: number };
  };
  name?: string;
  [key: string]: any;
}

interface EnrichedError extends SvelteError {
  astContext: {
    nodeType: string;
    nodeName?: string;
    parentType?: string;
    depth: number;
    isInComponent: boolean;
    isInScript: boolean;
    isInStyle: boolean;
    reactivityContext: 'none' | '$state' | '$derived' | '$effect' | 'legacy';
  };
  dependencyImpact: {
    importedBy: string[];
    imports: string[];
    blastRadius: number; // How many files could be affected
    centralityScore: number; // 0-1, higher = more central to architecture
  };
  fixComplexity: {
    difficulty: 'trivial' | 'easy' | 'moderate' | 'hard' | 'expert';
    estimatedMinutes: number;
    requiresRefactor: boolean;
    affectsMultipleFiles: boolean;
  };
  priorityScore: number; // 0-100, higher = fix this first
  clusterSignature: string; // Hash for grouping similar errors
}

interface FileAnalysis {
  file: string;
  totalErrors: number;
  astParsed: boolean;
  componentHierarchyDepth: number;
  dependencies: {
    imports: string[];
    exports: string[];
    components: string[];
  };
  errors: EnrichedError[];
}

// ============================================================================
// AST PARSING & ERROR CORRELATION
// ============================================================================

/**
 * Parse svelte-check.log and extract structured errors
 */
async function parseSvelteCheckLog(): Promise<SvelteError[]> {
  const logPath = path.join(projectRoot, 'logs', 'svelte-check.log');

  try {
    const content = await fs.readFile(logPath, 'utf-8');
    const errors: SvelteError[] = [];

    // Regex pattern for svelte-check output:
    // src/routes/+page.svelte:42:10 Error: Type 'string' is not assignable to type 'number'. (ts)
    const errorPattern = /^(.+?):(\d+):(\d+)\s+(Error|Warning|Info):\s*(.+?)(?:\s+\((\w+)\))?$/gm;

    let match;
    while ((match = errorPattern.exec(content)) !== null) {
      errors.push({
        file: match[1],
        line: parseInt(match[2]),
        column: parseInt(match[3]),
        severity: match[4].toLowerCase() as 'error' | 'warning' | 'info',
        message: match[5],
        code: match[6]
      });
    }

    if (VERBOSE) {
      console.log(`✅ Parsed ${errors.length} errors from svelte-check.log`);
    }

    return errors;
  } catch (err) {
    console.error('❌ Failed to read svelte-check.log:', err);
    return [];
  }
}

/**
 * Parse a Svelte file and return its AST
 */
async function parseSvelteAST(filePath: string): Promise<{ ast: any; parsed: boolean }> {
  try {
    const content = await fs.readFile(filePath, 'utf-8');
    const ast = parse(content, { filename: filePath });
    return { ast, parsed: true };
  } catch (err) {
    if (VERBOSE) {
      console.warn(`⚠️  Could not parse AST for ${filePath}:`, (err as Error).message);
    }
    return { ast: null, parsed: false };
  }
}

/**
 * Find the AST node at a specific line/column position
 */
function findNodeAtPosition(ast: any, line: number, column: number): ASTNode | null {
  let foundNode: ASTNode | null = null;
  let minDistance = Infinity;

  walk(ast, {
    enter(node: any) {
      if (!node.loc) return;

      const startLine = node.loc.start.line;
      const endLine = node.loc.end.line;

      if (line >= startLine && line <= endLine) {
        const distance = Math.abs(line - startLine) + Math.abs(column - (node.loc.start.column || 0));
        if (distance < minDistance) {
          minDistance = distance;
          foundNode = node;
        }
      }
    }
  });

}

/**
 * Determine reactivity context from AST node
 */
function getReactivityContext(node: ASTNode, ast: any): 'none' | '$state' | '$derived' | '$effect' | 'legacy' {
  // Check if we're in a $state/$derived/$effect rune context
  if (node.type === 'VariableDeclarator' && node.init) {
    const initType = node.init.type;
    if (initType === 'CallExpression' && node.init.callee?.name) {
      const calleeName = node.init.callee.name;
      if (calleeName === '$state') return '$state';
      if (calleeName === '$derived') return '$derived';
      if (calleeName === '$effect') return '$effect';
    }
  }

  // Check for legacy reactive declarations ($:)
  if (node.type === 'LabeledStatement' && node.label?.name === '$') {
    return 'legacy';
  }

  return 'none';
}

/**
 * Extract dependency information from AST
 */
function extractDependencies(ast: any): { imports: string[]; exports: string[]; components: string[] } {
  const imports: string[] = [];
  const exports: string[] = [];
  const components: string[] = [];

  walk(ast, {
    enter(node: any) {
      if (node.type === 'ImportDeclaration') {
        imports.push(node.source.value);
      }
      if (node.type === 'ExportNamedDeclaration' || node.type === 'ExportDefaultDeclaration') {
        if (node.declaration?.id?.name) {
          exports.push(node.declaration.id.name);
        }
      }
      // Svelte component instantiations
      if (node.type === 'InlineComponent') {
        components.push(node.name);
      }
    }
  });

}

/**
 * Calculate component hierarchy depth
 */
function calculateHierarchyDepth(ast: any): number {
  let maxDepth = 0;

  function traverse(node: any, depth: number) {
    if (node.type === 'InlineComponent') {
      maxDepth = Math.max(maxDepth, depth);
    }
    if (node.children) {
      for (const child of node.children) {
        traverse(child, depth + 1);
      }
    }
  }

  if (ast.html) {
    traverse(ast.html, 0);
  }

  return maxDepth;
}

// ============================================================================
// DEPENDENCY GRAPH & IMPACT ANALYSIS
// ============================================================================

interface DependencyGraph {
  nodes: Map<string, { imports: string[]; importedBy: string[] }>;
}

/**
 * Build a dependency graph from all analyzed files
 */
function buildDependencyGraph(fileAnalyses: FileAnalysis[]): DependencyGraph {
  const graph: DependencyGraph = { nodes: new Map() };

  // Initialize nodes
  for (const analysis of fileAnalyses) {
    graph.nodes.set(analysis.file, { imports: analysis.dependencies.imports, importedBy: [] });
  }

  // Build reverse edges (importedBy)
  for (const [file, node] of graph.nodes) {
    for (const importPath of node.imports) {
      // Resolve relative imports to absolute paths
      const resolvedImport = resolveImport(file, importPath);
      if (resolvedImport && graph.nodes.has(resolvedImport)) {
        graph.nodes.get(resolvedImport)!.importedBy.push(file);
      }
    }
  }

  return graph;
}

/**
 * Resolve relative import to absolute file path
 */
function resolveImport(fromFile: string, importPath: string): string | null {
  if (importPath.startsWith('$lib')) {
    return importPath.replace('$lib', path.join(projectRoot, 'src', 'lib')) + '.svelte';
  }
  if (importPath.startsWith('.')) {
    const dir = path.dirname(fromFile);
    return path.resolve(dir, importPath + '.svelte');
  }
  return null; // External package
}

/**
 * Calculate centrality score (how central a file is to the architecture)
 * Uses PageRank-like algorithm: files imported by many files are more central
 */
function calculateCentrality(file: string, graph: DependencyGraph): number {
  const node = graph.nodes.get(file);
  if (!node) return 0;

  const importedByCount = node.importedBy.length;
  const importsCount = node.imports.length;

  // Files that are imported often but import little are "leaf" utilities (high centrality)
  // Files that import many but are rarely imported are "roots" (medium centrality)
  const centrality = importedByCount / (1 + importsCount);

  // Normalize to 0-1 range (assuming max importedBy count is ~50)
  return Math.min(centrality / 10, 1.0);
}

/**
 * Calculate blast radius (how many files could be affected by changes)
 */
function calculateBlastRadius(file: string, graph: DependencyGraph): number {
  const visited = new Set<string>();

  function traverse(currentFile: string) {
    if (visited.has(currentFile)) return;
    visited.add(currentFile);

    const node = graph.nodes.get(currentFile);
    if (!node) return;

    for (const importer of node.importedBy) {
      traverse(importer);
    }
  }

  traverse(file);
  return visited.size - 1; // Exclude the file itself
}

// ============================================================================
// ERROR ENRICHMENT & RANKING
// ============================================================================

/**
 * Enrich a basic error with AST context and impact analysis
 */
function enrichError(
  error: SvelteError,
  ast: any,
  dependencies: { imports: string[]; exports: string[] },
  graph: DependencyGraph
): EnrichedError {
  const node = ast ? findNodeAtPosition(ast, error.line, error.column) : null;

  // AST Context
  const astContext = {
    nodeType: node?.type || 'unknown',
    nodeName: node?.name || undefined,
    parentType: undefined, // TODO: track parent in walk
    depth: 0, // TODO: calculate depth in tree
    isInComponent: error.file.includes('/components/'),
    isInScript: node?.type?.includes('Script') || false,
    isInStyle: node?.type === 'Style' || false,
    reactivityContext: node ? getReactivityContext(node, ast) : 'none' as const
  };

  // Dependency Impact
  const graphNode = graph.nodes.get(error.file);
  const dependencyImpact = {
    importedBy: graphNode?.importedBy || [],
    imports: graphNode?.imports || [],
    blastRadius: calculateBlastRadius(error.file, graph),
    centralityScore: calculateCentrality(error.file, graph)
  };

  // Fix Complexity
  const fixComplexity = estimateFixComplexity(error, astContext, dependencyImpact);

  // Priority Score (0-100)
  const priorityScore = calculatePriorityScore(error, astContext, dependencyImpact, fixComplexity);

  // Cluster Signature (for grouping similar errors)
  const clusterSignature = generateClusterSignature(error, astContext);

  return {
    ...error,
    astContext,
    dependencyImpact,
    fixComplexity,
    priorityScore,
    clusterSignature
  };
}

/**
 * Estimate how difficult an error is to fix
 */
function estimateFixComplexity(
  error: SvelteError,
  astContext: any,
  depImpact: any
): { difficulty: 'trivial' | 'easy' | 'moderate' | 'hard' | 'expert'; estimatedMinutes: number; requiresRefactor: boolean; affectsMultipleFiles: boolean } {
  let difficulty: 'trivial' | 'easy' | 'moderate' | 'hard' | 'expert' = 'easy';
  let estimatedMinutes = 5;
  let requiresRefactor = false;
  let affectsMultipleFiles = depImpact.blastRadius > 3;

  // Type errors are usually easy
  if (error.code === 'ts' && error.message.includes('not assignable')) {
    difficulty = 'easy';
    estimatedMinutes = 3;
  }

  // Svelte 5 migration issues (runes) are moderate
  if (astContext.reactivityContext === 'legacy' || error.message.includes('$:') || error.message.includes('export let')) {
    difficulty = 'moderate';
    estimatedMinutes = 15;
    requiresRefactor = true;
  }

  // Store/reactivity issues are hard
  if (error.message.includes('writable') || error.message.includes('readable') || error.message.includes('derived')) {
    difficulty = 'hard';
    estimatedMinutes = 30;
    requiresRefactor = true;
  }

  // High blast radius = expert level (need to be careful)
  if (depImpact.blastRadius > 10) {
    difficulty = 'expert';
    estimatedMinutes = 60;
    affectsMultipleFiles = true;
  }

  return { difficulty, estimatedMinutes, requiresRefactor, affectsMultipleFiles };
}

/**
 * Calculate priority score (0-100, higher = fix first)
 */
function calculatePriorityScore(
  error: SvelteError,
  astContext: any,
  depImpact: any,
  fixComplexity: any
): number {
  let score = 50; // Base score

  // Severity boost
  if (error.severity === 'error') score += 20;
  if (error.severity === 'warning') score += 10;

  // Centrality boost (high centrality = fix sooner)
  score += depImpact.centralityScore * 15;

  // Blast radius penalty (high blast = riskier, defer if complex)
  if (depImpact.blastRadius > 10 && fixComplexity.difficulty === 'expert') {
    score -= 10; // Defer risky changes
  } else {
    score += Math.min(depImpact.blastRadius, 15); // Otherwise boost by impact
  }

  // Difficulty penalty (easy wins first)
  const difficultyMap = { trivial: 15, easy: 10, moderate: 0, hard: -10, expert: -15 };
  score += difficultyMap[fixComplexity.difficulty];

  // Reactivity migration boost (Svelte 5 runes high priority)
  if (astContext.reactivityContext === 'legacy') score += 10;

  return Math.max(0, Math.min(100, score));
}

/**
 * Generate a signature for clustering similar errors
 */
function generateClusterSignature(error: SvelteError, astContext: any): string {
  const components = [
    error.code || 'unknown',
    astContext.nodeType,
    astContext.reactivityContext,
    error.message.substring(0, 50) // First 50 chars for similarity
  ];

  return createHash('md5').update(components.join('|')).digest('hex').substring(0, 8);
}

// ============================================================================
// MAIN PIPELINE
// ============================================================================

async function main() {
  console.log('🧠 Phase 78: AST-Aware Error Ranking\n');

  // Step 1: Parse errors from svelte-check log
  const errors = await parseSvelteCheckLog();
  if (errors.length === 0) {
    console.log('ℹ️  No errors found. Run `npx svelte-check > logs/svelte-check.log 2>&1` first.');
    process.exit(0);
  }

  // Step 2: Group errors by file
  const errorsByFile = new Map<string, SvelteError[]>();
  for (const error of errors) {
    if (!errorsByFile.has(error.file)) {
      errorsByFile.set(error.file, []);
    }
    errorsByFile.get(error.file)!.push(error);
  }

  // Step 3: Analyze each file's AST
  console.log(`📂 Analyzing ${errorsByFile.size} files with AST parsing...\n`);
  const fileAnalyses: FileAnalysis[] = [];

  let processed = 0;
  for (const [file, fileErrors] of errorsByFile) {
    processed++;
    if (processed > TOP_N) break;

    const fullPath = path.join(projectRoot, file);
    const { ast, parsed } = await parseSvelteAST(fullPath);

    const dependencies = ast ? extractDependencies(ast) : { imports: [], exports: [], components: [] };
    const hierarchyDepth = ast ? calculateHierarchyDepth(ast) : 0;

    fileAnalyses.push({
      file,
      totalErrors: fileErrors.length,
      astParsed: parsed,
      componentHierarchyDepth: hierarchyDepth,
      dependencies,
      errors: fileErrors as any[] // Will enrich below
    });

    if (VERBOSE && processed % 10 === 0) {
      console.log(`  Processed ${processed}/${Math.min(TOP_N, errorsByFile.size)} files...`);
    }
  }

  // Step 4: Build dependency graph
  console.log('\n🔗 Building dependency graph...');
  const graph = buildDependencyGraph(fileAnalyses);
  console.log(`   Graph contains ${graph.nodes.size} nodes`);

  // Step 5: Enrich errors with AST + impact data
  console.log('\n🎯 Enriching errors with AST context and impact scores...');
  for (const analysis of fileAnalyses) {
    const fullPath = path.join(projectRoot, analysis.file);
    const { ast } = await parseSvelteAST(fullPath);

    analysis.errors = analysis.errors.map(err =>
      enrichError(err, ast, analysis.dependencies, graph)
    );
  }

  // Step 6: Rank and sort
  console.log('\n📊 Ranking errors by priority score...\n');
  const allEnrichedErrors = fileAnalyses.flatMap(a => a.errors);
  const sortedErrors = allEnrichedErrors.sort((a, b) => b.priorityScore - a.priorityScore);

  // Step 7: Generate clusters
  const clusters = new Map<string, EnrichedError[]>();
  for (const error of sortedErrors) {
    if (!clusters.has(error.clusterSignature)) {
      clusters.set(error.clusterSignature, []);
    }
    clusters.get(error.clusterSignature)!.push(error);
  }

  console.log(`✅ Processed ${allEnrichedErrors.length} errors into ${clusters.size} clusters\n`);

  // Step 8: Output results
  const outputDir = path.join(projectRoot, 'svelte-check-errors-index');
  await fs.mkdir(outputDir, { recursive: true });

  const outputData = {
    metadata: {
      generatedAt: new Date().toISOString(),
      totalErrors: allEnrichedErrors.length,
      totalFiles: fileAnalyses.length,
      totalClusters: clusters.size,
      topN: TOP_N
    },
    fileAnalyses,
    rankedErrors: sortedErrors.slice(0, 100), // Top 100
    clusters: Array.from(clusters.entries()).map(([sig, errs]) => ({
      signature: sig,
      count: errs.length,
      averagePriority: errs.reduce((sum, e) => sum + e.priorityScore, 0) / errs.length,
      sampleError: errs[0]
    }))
  };

  const outputPath = path.join(outputDir, 'ast-ranked-errors.json');
  await fs.writeFile(outputPath, JSON.stringify(outputData, null, 2));
  console.log(`📝 Wrote AST-ranked errors to: ${outputPath}`);

  // Step 9: Print summary
  console.log('\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
  console.log('📈 TOP 10 PRIORITY FIXES\n');

  sortedErrors.slice(0, 10).forEach((err, idx) => {
    console.log(`${idx + 1}. [Score: ${err.priorityScore.toFixed(1)}] ${err.file}:${err.line}`);
    console.log(`   ${err.message.substring(0, 80)}`);
    console.log(`   Difficulty: ${err.fixComplexity.difficulty} (${err.fixComplexity.estimatedMinutes}min)`);
    console.log(`   Impact: ${err.dependencyImpact.blastRadius} files | Centrality: ${(err.dependencyImpact.centralityScore * 100).toFixed(0)}%`);
    console.log(`   AST: ${err.astContext.nodeType} in ${err.astContext.reactivityContext} context\n`);
  });

  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
  console.log('\n🎯 TOP 5 ERROR CLUSTERS\n');

  const topClusters = Array.from(clusters.entries())
    .sort((a, b) => b[1].length - a[1].length)
    .slice(0, 5);

  topClusters.forEach(([sig, errs], idx) => {
    const sample = errs[0];
    const avgPriority = errs.reduce((sum, e) => sum + e.priorityScore, 0) / errs.length;
    console.log(`${idx + 1}. Cluster ${sig} (${errs.length} errors, avg priority: ${avgPriority.toFixed(1)})`);
    console.log(`   Pattern: ${sample.astContext.nodeType} + ${sample.code || 'unknown'}`);
    console.log(`   Sample: ${sample.message.substring(0, 70)}\n`);
  });

  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n');

  // Step 10: Update database (optional)
  if (db && !DRY_RUN) {
    console.log('💾 Updating database with AST context and priority scores...');

    // TODO: Update raw_error_embeddings table with ast_context and priority_score
    // This requires adding columns to the schema first

    console.log('✅ Database updated\n');
  }

  // Cleanup
  if (dbClient) await dbClient.end();

  console.log('🎉 AST-aware ranking complete!');
  console.log(`\nNext steps:`);
  console.log(`  1. Review: cat svelte-check-errors-index/ast-ranked-errors.json`);
  console.log(`  2. Cluster: npm run phase78:cluster (GPU-accelerated)`);
  console.log(`  3. Fix: Start with top priority errors above`);
}

main().catch(err => {
  console.error('❌ Fatal error:', err);
  process.exit(1);
});
