  "multi_domain_membership_contract": {
    "structure": "Each packet can belong to multiple domains with independent probabilities",
    "example_packet": {
      "packet_key": "ace:packet:auth:001",
      "domains": {
        "databases": 0.92,
        "networking": 0.65,
        "typescript": 0.88,
        "distributed_systems": 0.34,
        "security": 0.56
      },
      "primary_domain": "databases",
      "domain_membership_confidence": 0.92,
      "router_prior": "Use Naive Bayes posterior over all domains to weight signal lanes in retrieval"
    },
    "storage_location": "atlas_packets.metadata['domain_memberships']",
    "update_frequency": "Per-packet recalculation during Phase 2 feature extraction",
    "naive_bayes_routing": {
      "application": "Route queries to appropriate evidence lanes based on domain posterior",
      "example": "Query about 'distributed consensus' → P(distributed=HIGH | query) → weight Neo4j consensus edges + distributed_systems retrieval lane higher",
      "probabilities_are_soft_not_hard": "Domains are advisory; hard gates still on identity + basic validation"
    }
  },
  "migration_path_from_phase1": {
    "phase_1_flat_labels": 18,
    "phase_1_5_multi_domain": "Keep all 18 ACTIVE labels, add CS hierarchy layers underneath, compute Naive Bayes posteriors",
    "expected_coverage_per_packet": "2-4 domains per packet (multi-signal retrieval)",
    "backward_compatibility": "domain_class field stays unchanged; domain_memberships added to metadata JSONB"
  },
  "validation_gates": {
    "G1_all_domains_have_keywords": "Each domain must have ≥5 keywords for Naive Bayes feature extraction",
    "G2_no_circular_parent_child": "Hierarchy tree must be acyclic",
    "G3_non_overlapping_tier2": "Tier 2 domains should be mutually exclusive at the top level (CS, Engineering, Math, Languages, Infrastructure)",
    "G4_packet_probabilities_sum": "For each packet, domain_memberships probabilities should sum to ~1.0 (allow ±0.1 for precision)",
    "G5_primary_domain_exists": "Every packet with domain_memberships must have primary_domain set to the domain with max probability"
  }
}