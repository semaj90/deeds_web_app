{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "$lib/*": ["src/lib/*"]
    }
  },
  "include": ["../scripts/**/*.ts", "../src/lib/**/*.ts"]
}
