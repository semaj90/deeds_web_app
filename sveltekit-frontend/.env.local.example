# Windows-friendly defaults
# Disable optional native JSON addon
SIMDJSON_DISABLED=1

# Redis (default port)
REDIS_HOST=localhost
REDIS_PORT=6379

# Local Deep Research (LDR) + Firecrawl doc crawl
LDR_BASE_URL=http://127.0.0.1:5000
LDR_ENABLED=true
FIRECRAWL_API_KEY=REPLACE_ME

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/legal_ai_db
RABBITMQ_URL=amqp://legal_admin:secret123@127.0.0.1:5673/%2F
RABBITMQ_MGMT_URL=http://127.0.0.1:15673
RABBITMQ_MGMT_USER=legal_admin
RABBITMQ_MGMT_PASS=secret123
RABBITMQ_MGMT_PORT=15673
RABBITMQ_URL=amqp://legal_admin:secret123@127.0.0.1:5673/%2F
RABBITMQ_MGMT_URL=http://127.0.0.1:15673
RABBITMQ_MGMT_USER=legal_admin
RABBITMQ_MGMT_PASS=secret123
RABBITMQ_MGMT_PORT=15673


# Embeddings backends (optional)
EMBED_MODEL=embeddinggemma:latest
FASTAPI_URL=http://localhost:8096
VLLM_ENDPOINT=http://localhost:8000/v1
# OLLAMA_URL is deprecated for chat/agentic tasks. Use TurboQuant at 8090 for Gemma4.
OLLAMA_CHAT_KEEP_ALIVE=2m
OLLAMA_EMBED_KEEP_ALIVE=24h
ACE_CHAT_SELF_EVAL_ENABLED=false
