{
  "$schema": "https://opencode.ai/config.json",
  "model": "turboquant/gemma4-tq",
  "small_model": "ollama/gemma4-hermes-64k",
  "provider": {
    "turboquant": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TurboQuant llama-server local",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local"
      },
      "models": {
        "gemma4-tq": {
          "name": "Gemma4 via TurboQuant",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gemma4-hermes-64k": {
          "name": "Gemma4 Hermes 64k via Ollama",
          "limit": {
            "context": 32768,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 20000
    }
  },
  "agent": {
    "trace-audit": {
      "description": "Read-only SvelteKit audit agent backed by TRACE MCP — starts with atlas.compact_context and only expands if needed",
      "model": "turboquant/gemma4-tq",
      "temperature": 0,
      "steps": 8,
      "prompt": "Follow .github/instructions/opencode-context-prefetch.instructions.md. Use atlas.compact_context first, then atlas.query or trace.kag_search only as needed. If no TRACE tool is visible, stop with TRACE_MCP_NOT_AVAILABLE. Do not edit files or mutate Postgres, Redis, Qdrant, Neo4j, or the filesystem.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "wiki_*": "allow",
        "wiki.*": "allow",
        "graph_*": "allow",
        "graph.*": "allow",
        "kag_*": "allow",
        "kag.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "search_*": "allow",
        "search.*": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "audit-hermes": {
      "description": "Tool-call sanity check via Ollama Hermes — compare agent behavior against TurboQuant lane and atlas.compact_context",
      "model": "ollama/gemma4-hermes-64k",
      "temperature": 0,
      "steps": 8,
      "prompt": "Follow .github/instructions/opencode-context-prefetch.instructions.md. Use atlas.compact_context first, then atlas.query or trace.kag_search only as needed. If no TRACE tool is visible, stop with TRACE_MCP_NOT_AVAILABLE. Do not edit files or mutate Postgres, Redis, Qdrant, Neo4j, or the filesystem.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "wiki_*": "allow",
        "wiki.*": "allow",
        "graph_*": "allow",
        "graph.*": "allow",
        "kag_*": "allow",
        "kag.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "search_*": "allow",
        "search.*": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "audit": {
      "description": "Read-only SvelteKit 2 / Svelte 5 / Drizzle / Zod auditor (no MCP, local files only)",
      "model": "turboquant/gemma4-tq",
      "prompt": "You are a read-only codebase auditor. Focus on SvelteKit 2, Svelte 5 runes, Bits UI, Drizzle ORM, PostgreSQL schemas, Zod validations, SSR boundaries, API routes, and deep audit safety. Do not edit files.",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },
  "default_agent": "trace-audit",
  "instructions": [
    ".github/instructions/opencode-context-prefetch.instructions.md",
    "AGENTS.md",
    ".claude/skills/trace-mcp-tooling/SKILL.md",
    "sveltekit-frontend/docs/architecture/gemma4-to-claude-code-handoff.md"
  ],
  "share": "disabled"
}