{
  "$schema": "https://opencode.ai/config.json",
  "model": "turboquant/gemma4-tq",
  "small_model": "turboquant/gemma4-tq",
  "default_agent": "hermes-ace",
  "shell": "pwsh.exe",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "bash": {
      "npm run tools:check:structural": "allow",
      "npm run index:*": "allow",
      "npm run graphify:dependency:audit": "allow",
      "npm --prefix * run index:*": "allow",
      "npm --prefix * run graphify:dependency:audit": "allow",
      "node scripts/index/*": "allow",
      "rg *": "allow",
      "ast-grep *": "allow",
      "sg *": "allow",
      "jq *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "rm *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "*": "ask"
    }
  },
  "provider": {
    "turboquant": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama-server :8090",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local"
      },
      "models": {
        "gemma4-iq4xs": {
          "name": "Gemma4 Legal 64K",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "gemma4-tq": {
          "name": "Gemma4 TurboQuant 64K",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    },
    "ollama_disabled": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local :11434 (fallback only)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "embeddinggemma": {
          "name": "EmbeddingGemma — 768-dim embeddings (primary embed model)",
          "limit": {
            "context": 8192,
            "output": 0
          }
        }
      }
    },
    "yorha": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "YorHA OpenAI facade :5173 (ACE/KAG pipeline)",
      "options": {
        "baseURL": "http://127.0.0.1:5173/api/v1",
        "apiKey": "local"
      },
      "models": {
        "yorha-hermes": {
          "name": "YorHA ACE Hermes 64K",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "yorha-legal": {
          "name": "YorHA ACE Legal 64K",
          "limit": {
            "context": 65536,
            "output": 4097
          }
        }
      }
    }
  },
  "mcp": {
    "trace": {
      "type": "remote",
      "url": "http://127.0.0.1:8788/mcp",
      "enabled": true,
      "timeout": 20000
    },
    "gemma4-offload": {
      "type": "local",
      "command": [
        "node",
        "scripts/mcp/gemma4-offload-mcp.mjs"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "turbovec-sidecar": {
      "type": "remote",
      "url": "http://127.0.0.1:8791/mcp",
      "enabled": true,
      "timeout": 30000,
      "description": "TurboVec cosine-ranking sidecar: chunk-id cosine ranking, quantization deque, multi-core SIMD scoring, AVX2 vector ops, NES cartridge JSONB label injection"
    },
    "langextract": {
      "type": "remote",
      "url": "http://127.0.0.1:8793/mcp",
      "enabled": true,
      "timeout": 30000,
      "description": "LangExtract MCP: citation extraction, statute parsing, entity recognition, structural label normalization — TypeScript native (replaces Python FastAPI :8095)"
    },
    "engram-embed": {
      "type": "remote",
      "url": "http://127.0.0.1:8792/mcp",
      "enabled": true,
      "timeout": 30000,
      "description": "Engram Go embedding bridge: 768-dim embeddinggemma via gRPC :50051, QUIC/NATS :4222 fallback, Bifrost ingestion pipeline, ACE packet injection, user chat memory store"
    },
    "ldr-research": {
      "type": "local",
      "command": [
        "node",
        "scripts/mcp/ldr-mcp.mjs"
      ],
      "enabled": true,
      "timeout": 120000,
      "description": "Local Deep Research: async multi-engine research via Gemma4 + SearXNG + Wikipedia. Tools: ldr.start_research, ldr.poll_status, ldr.search_history, ldr.quick_summary"
    }
  },
  "agent": {
    "trace-audit": {
      "description": "Read-only TRACE audit agent with compact context tools.",
      "model": "turboquant/gemma4-tq",
      "temperature": 0,
      "steps": 8,
      "prompt": "Use TRACE MCP prompt-cache flow first: call context.build_kv_packet or atlas.compact_context before broad retrieval, keep the stable system prefix unchanged, and prefer cached compressed cards over raw file expansion. Follow .github/instructions/opencode-context-prefetch.instructions.md. Use atlas.compact_context first, then atlas.query or trace.kag_search only as needed. If no TRACE tool is visible, stop with TRACE_MCP_NOT_AVAILABLE. Do not edit files or mutate Postgres, Redis, Qdrant, Neo4j, or the filesystem.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "wiki_*": "allow",
        "wiki.*": "allow",
        "graph_*": "allow",
        "graph.*": "allow",
        "kag_*": "allow",
        "kag.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "search_*": "allow",
        "search.*": "allow",
        "edit": "deny",
        "bash": {
          "npm run tools:check:structural": "allow",
          "npm run index:*": "allow",
          "npm run graphify:dependency:audit": "allow",
          "npm --prefix * run index:*": "allow",
          "npm --prefix * run graphify:dependency:audit": "allow",
          "node scripts/index/*": "allow",
          "rg *": "allow",
          "ast-grep *": "allow",
          "sg *": "allow",
          "jq *": "allow",
          "git status": "allow",
          "git diff *": "allow",
          "rm *": "deny",
          "del *": "deny",
          "Remove-Item *": "deny",
          "*": "ask"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "audit-hermes": {
      "description": "Hermes 64K direct fallback lane via Ollama; no ACE enrichment",
      "model": "ollama_disabled/gemma4-hermes-64k",
      "temperature": 0,
      "steps": 8,
      "prompt": "Use TRACE MCP prompt-cache flow first: call context.build_kv_packet or atlas.compact_context before broad retrieval, keep the stable system prefix unchanged, and prefer cached compressed cards over raw file expansion. Follow .github/instructions/opencode-context-prefetch.instructions.md. Use atlas.compact_context first, then atlas.query or trace.kag_search only as needed. If no TRACE tool is visible, stop with TRACE_MCP_NOT_AVAILABLE. Do not edit files or mutate Postgres, Redis, Qdrant, Neo4j, or the filesystem.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "wiki_*": "allow",
        "wiki.*": "allow",
        "graph_*": "allow",
        "graph.*": "allow",
        "kag_*": "allow",
        "kag.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "search_*": "allow",
        "search.*": "allow",
        "edit": "deny",
        "bash": {
          "npm run tools:check:structural": "allow",
          "npm run index:*": "allow",
          "npm run graphify:dependency:audit": "allow",
          "npm --prefix * run index:*": "allow",
          "npm --prefix * run graphify:dependency:audit": "allow",
          "node scripts/index/*": "allow",
          "rg *": "allow",
          "ast-grep *": "allow",
          "sg *": "allow",
          "jq *": "allow",
          "git status": "allow",
          "git diff *": "allow",
          "rm *": "deny",
          "del *": "deny",
          "Remove-Item *": "deny",
          "*": "ask"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "hermes-ace": {
      "description": "Hermes-ACE local agent using ACE context, MCP tools, and local Gemma4 64K.",
      "model": "turboquant/gemma4-tq",
      "temperature": 0,
      "steps": 12,
      "prompt": "You are the Hermes-ACE legal AI agent running on gemma4-legal-iq4xs-direct.gguf via TurboQuant :8090. Follow .github/instructions/opencode-context-prefetch.instructions.md. Use MCP tools in this priority order: (1) trace.kag_search or trace.atlas_query for knowledge retrieval, (2) turbovec-sidecar for cosine ranking and chunk-id scoring, (3) engram-embed for 768-dim embeddings and Bifrost ingestion, (4) langextract for citation and entity extraction, (5) ldr.search_history then ldr.quick_summary for external research context, (6) ldr.start_research + ldr.poll_status for deep async research on complex legal questions. Always include chunk_ids and cluster_labels in synthesis context. For image evidence, depth maps are stored in MinIO at evidence/{caseId}/{evidenceId}-depth.png — reference via ai_analysis.depthAnalysis.depthMapUrl. Do not edit files without explicit user approval. Do not mutate live Postgres schema.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "atlas_*": "allow",
        "atlas.*": "allow",
        "context_*": "allow",
        "context.*": "allow",
        "wiki_*": "allow",
        "wiki.*": "allow",
        "graph_*": "allow",
        "graph.*": "allow",
        "kag_*": "allow",
        "kag.*": "allow",
        "trace_*": "allow",
        "trace.*": "allow",
        "search_*": "allow",
        "search.*": "allow",
        "edit": "deny",
        "bash": {
          "npm run tools:check:structural": "allow",
          "npm run index:*": "allow",
          "npm run graphify:dependency:audit": "allow",
          "npm --prefix * run index:*": "allow",
          "npm --prefix * run graphify:dependency:audit": "allow",
          "node scripts/index/*": "allow",
          "rg *": "allow",
          "ast-grep *": "allow",
          "sg *": "allow",
          "jq *": "allow",
          "git status": "allow",
          "git diff *": "allow",
          "rm *": "deny",
          "del *": "deny",
          "Remove-Item *": "deny",
          "*": "ask"
        },
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "audit": {
      "description": "Read-only SvelteKit 2 / Svelte 5 / Drizzle / Zod auditor (no MCP, local files only)",
      "model": "turboquant/gemma4-tq",
      "prompt": "You are a read-only codebase auditor. Focus on SvelteKit 2, Svelte 5 runes, Bits UI, Drizzle ORM, PostgreSQL schemas, Zod validations, SSR boundaries, API routes, and deep audit safety. Do not edit files.",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },
  "instructions": [
    "../.github/instructions/opencode-context-prefetch.instructions.md",
    "docs/architecture/cline-opencode-system-prompt.md",
    "../AGENTS.md",
    "../.claude/skills/trace-mcp-tooling/SKILL.md",
    "docs/architecture/gemma4-to-claude-code-handoff.md"
  ],
  "share": "disabled"
}
