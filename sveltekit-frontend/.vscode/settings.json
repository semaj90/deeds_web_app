{
  // ========================================
  // GPU-ACCELERATED VS CODE CONFIGURATION
  // ========================================
  // GPU Rendering & Hardware Acceleration
  "window.titleBarStyle": "custom",
  "workbench.experimental.useWebGL": true,
  "terminal.integrated.gpuAcceleration": "on",
  "editor.renderControlCharacters": false,
  "editor.renderWhitespace": "none",

  // Multi-Core TypeScript Server (28GB Memory + All Cores)
  "typescript.tsserver.maxTsServerMemory": 28672,
  "typescript.tsserver.useSeparateSyntaxServer": true,
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "prompt",
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEventsOnParentDirectory",
    "watchDirectory": "useFsEventsOnParentDirectory"
  },

  // PRETTIER ENABLED + GPU-ACCELERATED FORMATTING
  "prettier.enable": true,
  "prettier.requireConfig": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  "editor.formatOnSaveMode": "modifications",

  // Multi-Core Prettier Processing
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "cmake.sourceDirectory": "C:/Users/james/Videos/deeds-web-app/sveltekit-frontend/build/_deps/nlohmann_json-src",
  "cmake.configureSettings": {
    "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
    "VCPKG_TARGET_TRIPLET": "x64-windows"
  },
  "cmake.generator": "Visual Studio 17 2022",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.buildType": "Release",
  "cmake.configureOnOpen": false,
  "cmake.showOptionsMovedNotification": false,

  // ========================================
  // PYTHON ENVIRONMENT SETTINGS
  // ========================================
  "python.terminal.useEnvFile": true,
  "python.envFile": "${workspaceFolder}/../.env",
  "python.terminal.activateEnvironment": true,
  "python.terminal.executeInFileDir": false,
  // ========================================
  // CUDA ACCELERATION SETTINGS
  // ========================================
  "C_Cpp.default.compilerPath": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.1/bin/nvcc.exe",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
    "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.1/include"
  ],
  "typescript.inlayHints.variableTypes.enabled": true,
  // ========================================
  // GITHUB COPILOT ENHANCED SETTINGS
  // ========================================
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.editor.enableCodeActions": true,
  "github.copilot.enable": true,
  "github.copilot.chat.history.maxSize": 100,
  "github.copilot.chat.followUps": "always",
  "github.copilot.referencesUsed": "panelWithReferences",
  "github.copilot.chat.scopeSelection": true,
  "editor.acceptSuggestionOnCommitCharacters": true,
  "editor.inlineSuggest.enabled": true,
  "files.autoSave": "afterDelay",
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  // ========================================
  // ADDITIONAL GIT SETTINGS TO DISABLE DIFF PROMPTS
  // ========================================
  "git.autofetch": false,
  "git.confirmPublish": false,
  "git.confirmForcePush": false,
  "git.showPushSuccessNotification": false,
  "diffEditor.renderSideBySide": false,
  "diffEditor.ignoreTrimWhitespace": true,
  // ========================================
  // ADDITIONAL SETTINGS TO REDUCE PROMPTS
  // ========================================
  "editor.suggest.insertMode": "replace",
  "editor.suggest.showWords": false,
  "editor.suggest.showIcons": false,
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "diffEditor.codeLens": false,
  "diffEditor.wordWrap": "off",
  "github.copilot.advanced": {
    "debug.overrideEngine": "nodejs"
  },
  "editor.acceptSuggestionOnEnter": "on",
  // ========================================
  // COPILOT DIFF AND CODE ACTIONS SETTINGS
  // ========================================
  "github.copilot.chat.codeGeneration.useInstructionFiles": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.organizeImports": "never"
  },
  "diffEditor.enableSplitViewResizing": true,
  "diffEditor.experimental.useVersionedHover": true,
  "editor.codeActions.triggerOnFocusChange": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.items": "fillHalf",
  "github.copilot.nextEditSuggestions.enabled": true
}