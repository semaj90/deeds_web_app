{
  "mcpServers": {
    "context7-multicore": {
      "command": "node",
      "args": ["scripts/start-trace-mcp-cluster.mjs", "2"],
      "env": {
        "TRACE_MCP_PORT": "8788",
        "TRACE_MCP_HOST": "127.0.0.1",
        "TRACE_MCP_WORKERS": "2"
      },
      "capabilities": [
        "file_operations",
        "code_analysis",
        "type_checking",
        "prettier_formatting",
        "eslint_fixing",
        "context7_integration"
      ],
      "autoStart": true,
      "restart": "onFailure",
      "timeout": 30000
    },
    "legal-ai-context": {
      "command": "npm",
      "args": ["run", "mcp:stdio"],
      "capabilities": [
        "legal_document_analysis",
        "embedding_generation",
        "vector_operations",
        "case_similarity",
        "evidence_processing"
      ],
      "autoStart": false,
      "restart": "onFailure"
    },
    "gemma4-offload": {
      "command": "node",
      "args": ["scripts/mcp/gemma4-offload-mcp.mjs"],
      "env": {
        "TURBO_BASE": "http://127.0.0.1:8090",
        "OLLAMA_BASE": "http://127.0.0.1:11434",
        "OLLAMA_MODEL": "gemma4-rotorquant:latest"
      },
      "capabilities": ["chat_offload", "summarization", "classification"],
      "autoStart": true,
      "restart": "onFailure",
      "timeout": 60000
    },

    "_adopted_servers_doc": {
      "//": "Below are 2026-shipped official MCP servers per docs/architecture/mcp-ecosystem-survey-2026.md. All start with autoStart:false and enabled:false — verify each via `node scripts/smoke/smoke-adopted-mcp.mjs`, then flip the flag for the ones whose package actually installs and runs in your environment. Do NOT enable blindly — package names + invocation patterns shift."
    },
    "neo4j-readonly": {
      "command": "uvx",
      "args": ["mcp-neo4j-cypher@latest"],
      "env": {
        "NEO4J_URL": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "password",
        "NEO4J_READ_ONLY": "true"
      },
      "capabilities": ["graph_read", "cypher_readonly", "gds_list"],
      "autoStart": false,
      "enabled": false,
      "restart": "onFailure",
      "timeout": 30000
    },
    "qdrant-readonly": {
      "command": "uvx",
      "args": ["mcp-server-qdrant"],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "codebase_chunks_768"
      },
      "capabilities": ["vector_find", "semantic_recall"],
      "autoStart": false,
      "enabled": false,
      "restart": "onFailure",
      "timeout": 30000
    },
    "redis-readonly": {
      "command": "uvx",
      "args": ["mcp-redis"],
      "env": {
        "REDIS_HOST": "localhost",
        "REDIS_PORT": "6379",
        "REDIS_DB": "0"
      },
      "capabilities": ["cache_read", "key_introspect"],
      "autoStart": false,
      "enabled": false,
      "restart": "onFailure",
      "timeout": 30000
    },
    "postgres-readonly": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres",
               "postgresql://readonly_user:readonly_pass@localhost:5432/legal_ai_db"],
      "env": {},
      "capabilities": ["sql_readonly", "schema_introspect"],
      "autoStart": false,
      "enabled": false,
      "restart": "onFailure",
      "timeout": 30000
    },
    "obsidian-vault": {
      "command": "npx",
      "args": ["-y", "mcpvault", "--vault", "./vault"],
      "env": {},
      "capabilities": ["vault_traversal", "frontmatter_query", "note_lookup"],
      "autoStart": false,
      "enabled": false,
      "restart": "onFailure",
      "timeout": 30000
    },
    "ts-lsp": {
      "command": "npx",
      "args": ["-y", "@isaacphi/mcp-language-server", "--workspace", "."],
      "env": {},
      "capabilities": ["symbol_lookup", "find_references", "diagnostics"],
      "autoStart": false,
      "enabled": false,
      "restart": "onFailure",
      "timeout": 60000
    }
  },
  "tools": {
    "prettier": {
      "server": "context7-multicore",
      "multicore": true,
      "cache": true,
      "options": {
        "parser": "typescript",
        "singleQuote": true,
        "trailingComma": "es5",
        "tabWidth": 2,
        "semi": true
      }
    },
    "eslint": {
      "server": "context7-multicore",
      "multicore": true,
      "cache": ".eslintcache",
      "options": {
        "fix": true,
        "maxWarnings": 0
      }
    },
    "typecheck": {
      "server": "context7-multicore",
      "multicore": true,
      "options": {
        "project": "tsconfig.json",
        "skipLibCheck": true,
        "incremental": true
      }
    }
  },
  "performance": {
    "maxConcurrentTasks": 16,
    "taskTimeout": 30000,
    "memoryLimit": "28GB",
    "gpuAcceleration": true,
    "cacheEnabled": true,
    "webWorkers": {
      "enabled": true,
      "maxWorkers": 8,
      "concurrency": "zx"
    },
    "serviceWorkers": {
      "enabled": true,
      "maxInstances": 4
    }
  },
  "logging": {
    "level": "info",
    "file": "mcp-context7.log",
    "rotation": true
  }
}
