# Go binaries *.exe *.out /go-services/**/bin/ /go-services/**/*.exe /go-services/**/*.out # Compiled binary addons
*.node # Distribution files dist/ build/ .svelte-kit/ # SvelteKit build artifacts .svelte-kit .vite/ # Node.js cache
directories node_modules/.cache/ .npm/ # TypeScript build info .tsbuildinfo *.tsbuildinfo # Environment files .env
.env.local .env.*.local # Log files npm-debug.log* yarn-debug.log* yarn-error.log* # OS generated files .DS_Store
.DS_Store? ._* .Spotlight-V100 .Trashes ehthumbs.db Thumbs.db # Ignore conflicting test config js_tests/svelte.config.js
# Large text files > 10MB agentic-error-resolution/errors/*.txt agentic-error-resolution/errors/*.log *.txt.large
*-full.txt # Large error dumps and analysis files svelte-check-*.txt tsc_*.txt *-errors-*.txt *-analysis-*.txt
normalized-errors.jsonl template-ast-violations.jsonl # Large .txt files over 10MB (automated pattern)
phase22-svelte-check-raw.txt svelte-check-errors.txt svelte-check-output.txt *-check-raw.txt *-output.txt # Large .txt
files over 10MB (specific patterns) phase22-svelte-check-raw.txt svelte-check-errors.txt svelte-check-output.txt
svelte-check-*.txt *-check-raw.txt *-full-errors.txt **/*[0-9][0-9]MB.txt **/*_large.txt **/logs/**/*.txt
**/error-logs/**/*.txt

# Ignore all .txt files by default
*.txt

# Allow documentation .txt files
!README*.txt
!CHANGELOG*.txt
!LICENSE*.txt
!TODO*.txt
!todolist*.txt
!IMPLEMENTATION_COMPLETE.txt

# Allow all .txt files in docs/txt directory (organized archive)
!../docs/txt/**/*.txt
!docs/txt/**/*.txt
data/errors.ndjson
reports/*.json
reports/latest/

# Playwright authentication state (contains sensitive session cookies)
tests/.playwright-auth.json
test-results/
playwright-report/
playwright/.auth/
reports/phase76/
reports/fix-plan-*.json
*.ndjson
# Large generated files
data/errors.ndjson
svelte-check-*.json
reports/error-clusters.json
reports/fix-plan-*.json
reports/latest/
reports/phase76/
*.ndjson

# Phase 79/80 Analysis Artifacts
data/errors.ndjson
reports/error-clusters.json
reports/fix-plan-*.json
reports/latest/vscode-problems.json
reports/phase76/consolidated-knowledge-base.json
reports/phase76/error-analysis/error-knowledge-graph.json
svelte-check-current.json
/reports/
# NOTE: /reports/ ignores top-level reports dir (test outputs), NOT src/routes/(app)/reports/ (app routes)
.kiro/backup-consolidation-manifest*.json
.kiro/*.sh

# Quarantined vendored C++ libraries (too large for git)
_archived/native-simdjson/src/native/simdjson-addon/simdjson/

# Courtroom 3D models (1-41 MB each, converted from FBX via Blender)
static/models/courtroom/*.glb

# Bounded task output (logs/task-output/) — large generated audit content
# Do NOT commit; keep next_steps/active/ tracked for the .md plans themselves
logs/task-output/
logs/*.log
logs/startup/
logs/hermes/

# Obsidian vault generated plugin binaries (13MB, regenerable via install-plugins.sh)
docs/obsidian-vault/.obsidian/plugins/*/main.js
docs/obsidian-vault/.obsidian/plugins/*/styles.css

# Graphify per-run output snapshots — timestamped, regenerable, never review-worthy
memory/runs/
.okf/

# AGENTS DAG NVMe cache (regenerated by npm run agents:som)
memory/agents-dag/

# Mini-active NVMe cache (regenerated by npm run agents:cache)
mini_active_nvme_cache/
