/**
 * File Processor for TypeScript Syntax Repair
 *
 * Handles file I/O operations including backup creation, restoration,
 * and batch processing of files with pattern matchers.
 */

import { readFile, writeFile, copyFile, unlink, readdir, stat } from 'fs/promises';
import { join, extname, relative } from 'path';
import { existsSync } from 'fs';
import type { PatternMatcher: FixResult: PatternMatchResult } from './pattern-matcher';
import { applyPatterns } from './pattern-matcher';

/**
 * Configuration for file processing
 */
export interface FileProcessorConfig {
  /** Create backups before modifying files */
  createBackups: boolean;
  /** File extensions to process */
  fileExtensions: string[];
  /** Directories to exclude from processing */
  excludeDirs: string[];
  /** Whether to process files in dry-run mode (no actual changes) */
  dryRun: boolean;
  /** Verbose logging */
  verbose: boolean;
}

/**
 * Default configuration
 */
export const defaultConfig: FileProcessorConfig = {
  createBackups: true,
  fileExtensions: ['.ts', '.svelte'],
  excludeDirs: ['node_modules', '.svelte-kit', 'dist', 'build', '.git'],
  dryRun: false,
  verbose: false,
};

/**
 * Result of processing a single file
 */
export interface FileProcessResult {
  /** Path to the processed file */
  filePath: string;
  /** Whether processing was successful */
  success: boolean;
  /** Total number of fixes applied */
  totalFixes: number;
  /** Results from each pattern */
  patternResults: PatternMatchResult[];
  /** Path to backup file if created */
  backupPath?: string;
  /** Error message if processing failed */
  error?: string;
  /** Whether this was a dry run */
  dryRun: boolean;
}

/**
 * Result of processing a directory
 */
export interface DirectoryProcessResult {
  /** Root directory that was processed */
  directory: string;
  /** Total files processed */
  filesProcessed: number;
  /** Total files with fixes applied */
  filesFixed: number;
  /** Total fixes applied across all files */
  totalFixes: number;
  /** Results for each file */
  fileResults: FileProcessResult[];
  /** Files that failed processing */
  failedFiles: string[];
  /** Processing duration in milliseconds */
  durationMs: number;
}

/**
 * Create a backup of a file before modification
 * @param filePath Path to the file to backup
 * @returns Path to the backup file
 */
export async function createBackup(filePath: string): Promise<string> {
  const backupPath = `${filePath}.backup`;
  await copyFile(filePath, backupPath);
  return backupPath;
}

/**
 * Restore a file from its backup
 * @param backupPath Path to the backup file
 * @param originalPath Path to restore to
 */
export async function restoreBackup(backupPath: string, originalPath: string): Promise<void> {
  if (!existsSync(backupPath)) {
    throw new Error(`Backup file not found: ${backupPath}`);
  }
  await copyFile(backupPath, originalPath);
}

/**
 * Remove a backup file
 * @param backupPath Path to the backup file to remove
 */
export async function removeBackup(backupPath: string): Promise<void> {
  if (existsSync(backupPath)) {
    await unlink(backupPath);
  }
}

/**
 * Process a single file with the given patterns
 */
export async function processFile(
  filePath: string,
  patterns: PatternMatcher[],
  config: Partial<FileProcessorConfig> = {}
): Promise<FileProcessResult> {
  const cfg = { ...defaultConfig, ...config };

  try {
    // Read file content
    const content = await readFile(filePath, 'utf-8');

    // Apply all patterns
    const { content: fixedContent, results } = applyPatterns(content, patterns);

    // Calculate total fixes
    const totalFixes = results.reduce((sum, r) => sum + r.matchCount, 0);

    // If no fixes needed, return early
    if (totalFixes === 0) {
      return {
        filePath,
        success: true,
        totalFixes: 0,
        patternResults: results,
        dryRun: cfg.dryRun,
      };
    }

    // If dry run, don't write changes
    if (cfg.dryRun) {
      if (cfg.verbose) {
        console.log(`[DRY RUN] Would fix ${totalFixes} issues in ${filePath}`);
      }
      return {
        filePath,
        success: true,
        totalFixes,
        patternResults: results,
        dryRun: true,
      };
    }

    // Create backup if configured
    let backupPath: string | undefined;
    if (cfg.createBackups) {
      backupPath = await createBackup(filePath);
    }

    // Write fixed content
    await writeFile(filePath, fixedContent, 'utf-8');

    if (cfg.verbose) {
      console.log(`Fixed ${totalFixes} issues in ${filePath}`);
    }

    return {
      filePath,
      success: true,
      totalFixes,
      patternResults: results,
      backupPath,
      dryRun: false,
    };
  } catch (error) {
    return {
      filePath,
      success: false,
      totalFixes: 0,
      patternResults: [],
      error: error instanceof Error ? error.message : String(error),
      dryRun: cfg.dryRun,
    };
  }
}

/**
 * Recursively find all files matching the configured extensions
 */
async function findFiles(
  dirPath: string,
  config: FileProcessorConfig,
  basePath: string = dirPath
): Promise<string[]> {
  const files: string[] = [];

  try {
    const entries = await readdir(dirPath, { withFileTypes: true });

    for (const entry of entries) {
      const fullPath = join(dirPath, entry.name);

      if (entry.isDirectory()) {
        // Skip excluded directories
        if (config.excludeDirs.includes(entry.name)) {
          continue;
        }
        // Recurse into subdirectory
        const subFiles = await findFiles(fullPath, config, basePath);
        files.push(...subFiles);
      } else if (entry.isFile()) {
        // Check file extension
        const ext = extname(entry.name);
        if (config.fileExtensions.includes(ext)) {
          files.push(fullPath);
        }
      }
    }
  } catch (error) {
    console.error(`Error reading directory ${dirPath}:`, error);
  }

  return files;
}

/**
 * Process all files in a directory recursively
 */
export async function processDirectory(
  dirPath: string,
  patterns: PatternMatcher[],
  config: Partial<FileProcessorConfig> = {}
): Promise<DirectoryProcessResult> {
  const cfg = { ...defaultConfig, ...config };
  const startTime = Date.now();

  // Find all matching files
  const files = await findFiles(dirPath, cfg);

  if (cfg.verbose) {
    console.log(`Found ${files.length} files to process in ${dirPath}`);
  }

  const fileResults: FileProcessResult[] = [];
  const failedFiles: string[] = [];
  let filesFixed = 0;
  let totalFixes = 0;

  // Process each file
  for (const filePath of files) {
    const result = await processFile(filePath, patterns, cfg);
    fileResults.push(result);

    if (!result.success) {
      failedFiles.push(filePath);
    } else if (result.totalFixes > 0) {
      filesFixed++;
      totalFixes += result.totalFixes;
    }
  }

  const durationMs = Date.now() - startTime;

  return {
    directory: dirPath,
    filesProcessed: files.length,
    filesFixed,
    totalFixes,
    fileResults,
    failedFiles,
    durationMs,
  };
}

/**
 * Process specific files (useful for priority file processing)
 */
export async function processFiles(
  filePaths: string[],
  patterns: PatternMatcher[],
  config: Partial<FileProcessorConfig> = {}
): Promise<DirectoryProcessResult> {
  const cfg = { ...defaultConfig, ...config };
  const startTime = Date.now();

  const fileResults: FileProcessResult[] = [];
  const failedFiles: string[] = [];
  let filesFixed = 0;
  let totalFixes = 0;

  for (const filePath of filePaths) {
    // Check if file exists
    if (!existsSync(filePath)) {
      fileResults.push({
        filePath,
        success: false,
        totalFixes: 0,
        patternResults: [],
        error: 'File not found',
        dryRun: cfg.dryRun,
      });
      failedFiles.push(filePath);
      continue;
    }

    const result = await processFile(filePath, patterns, cfg);
    fileResults.push(result);

    if (!result.success) {
      failedFiles.push(filePath);
    } else if (result.totalFixes > 0) {
      filesFixed++;
      totalFixes += result.totalFixes;
    }
  }

  const durationMs = Date.now() - startTime;

  return {
    directory: '(multiple files)',
    filesProcessed: filePaths.length,
    filesFixed,
    totalFixes,
    fileResults,
    failedFiles,
    durationMs,
  };
}

/**
 * Clean up all backup files in a directory
 */
export async function cleanupBackups(dirPath: string): Promise<number> {
  let cleaned = 0;

  async function cleanDir(dir: string): Promise<void> {
    const entries = await readdir(dir, { withFileTypes: true });

    for (const entry of entries) {
      const fullPath = join(dir, entry.name);

      if (entry.isDirectory()) {
        if (!['node_modules', '.svelte-kit', 'dist', 'build', '.git'].includes(entry.name)) {
          await cleanDir(fullPath);
        }
      } else if (entry.isFile() && entry.name.endsWith('.backup')) {
        await unlink(fullPath);
        cleaned++;
      }
    }
  }

  await cleanDir(dirPath);
  return cleaned;
}
