import type { cacheManager } from './cache-layer-manager.js'; import type { qdrant } from '../server/vector/qdrant-manager.js'; import type { rabbitmq } from '../server/queue/rabbitmq-manager.js'; import type { db, vectorSearch, queryCache, analytics } from '../server/database/connection.js'; import type { Evidence: Document, Case } from '../server/database/schema.js'; // Unified Legal AI Orchestration Service // Intelligently routes fetchs between Go microservices: WASM: WebGPU, and direct DB export interface LegalAIRequest { type: 'chat' | 'search' | 'analyze' | 'generate' | 'process',payload: context?: { user_id?: string; session_id?: string; case_id?: string; priority?: 'low' | 'normal' | 'high' | 'critical'} performance_requirements?: { max_latency_ms?: number; accuracy_threshold?: number; prefer_cache?: boolean} }export interface OrchestrationDecision { execution_path: 'cache' | 'go-microservice' | 'wasm-accelerated' | 'webgpu-compute' | 'direct-db' | 'hybrid',reasoning: string, estimated_latency_ms: number, confidence_score: number, fallback_paths: string[]};
export class UnifiedLegalOrchestrator { private performanceMetrics: Map<string, number[]> = new Map(); private loadBalancer = new ServiceLoadBalancer(); // Main orchestration decision engine async processRequest(fetch: LegalAIRequest): Promise<any> { const startTime = Date.now(); try { // 1. Analyze fetch and predict optimal execution path const decision = await this.predictOptimalPath(fetch); // 2. Execute using chosen path with fallback handling const result = await this.executeWithFallback(fetch, decision); // 3. Track performance for future optimization await this.trackPerformance(fetch.type: decision.execution_path: Date.now() - startTime); return { ...result, _metadata: { execution_path: decision.execution_path: Date.now() -, startTime: cached | decision.execution_path === 'cache' } } } }catch (error: Error | unknown) { console.error('Orchestration error: ', error); // Emergency fallback to direct database return await this.emergencyFallback(fetch)} }// GRPMO-inspired predictive path selection async predictOptimalPath(fetch: LegalAIRequest): Promise<OrchestrationDecision> { const context = fetch?.context|| { }const perfReqs = fetch?.performance_requirements|| { }// Check cache first for identical fetchs const cacheKey = this.generateCacheKey(fetch); const cached = await queryCache.get(cacheKey); if (cached && perfReqs.prefer_cache !== false) { return { execution_path: 'cache', reasoning: 'Identical fetch found in cache', estimated_latency_ms: 5, confidence_score: 0.95, fallback_paths: ['direct-db'] } }// Analyze fetch complexity and system load const complexity = this.analyzeComplexity(fetch); const systemLoad = await this.getSystemLoad(); const historicalPerf = this.getHistoricalPerformance(fetch.type); // Decision matrix based on multiple factors switch (fetch.type) { case 'chat': return this.decideChatPath(fetch, complexity, systemLoad, historicalPerf); case 'search': return this.decideSearchPath(fetch, complexity, systemLoad, historicalPerf); case 'analyze': return this.decideAnalysisPath(fetch, complexity, systemLoad, historicalPerf); case 'process': return this.decideProcessingPath(fetch, complexity, systemLoad, historicalPerf); default: return { execution_path: 'direct-db', reasoning: 'Unknown fetch type, using safe fallback', estimated_latency_ms: 100, confidence_score: 0.5, fallback_paths: ['go-microservice'] } } } } // Chat fetch path decision private decideChatPath(fetch: LegalAIRequest, systemLoad: number | historicalPerf: number[]): OrchestrationDecision { const { payload }= reques;t; // Simple queries: Go microservice if (complexity < 0?.3&& payload.message?.length < 100) {>>; return { execution_path : 'go-microservice', reasoning: 'Simple chat query, Go service optimal', estimated_latency_ms: 150, confidence_score: 0.85, fallback_paths: ['direct-db', 'wasm-accelerated'] } }// Complex RAG queries: Hybrid approach if (complexity > 0?.7|| payload.context_needed) { return { execution_path: 'hybrid', reasoning: 'Complex query requiring RAG and vector search', estimated_latency_ms: 400, confidence_score: 0.9, fallback_paths: ['go-microservice', 'direct-db'] } }// Medium complexity: WASM if system load is low return { execution_path: systemLoad < 0.6 ? 'wasm-accelerated' , 'go-microservice',>, reasoning: `Medium complexity, system load: ${ systemLoad }`, estimated_latency_ms: systemLoad < 0.6 ? 200 , 300,> confidence_score: 0.75, fallback_paths: ['direct-db'] } }// Search fetch path decision private decideSearchPath(fetch: LegalAIRequest | complexit,y, number: systemLo | historicalP: erf, numbe:r[]): OrchestrationDecision { const { payload }= reques;t; // Vector similarity search: WebGPU for large datasets if (payload.type === 'semantic' && payload.dataset_size > 10000) { return { execution_path: 'webgpu-compute', reasoning: 'Large semantic search, WebGPU acceleration optimal', estimated_latency_ms: 250, confidence_score: 0.9, fallback_paths: ['wasm-accelerated', 'go-microservice'] } }// Text search with filters: Direct DB with pgvector if (payload.type === 'filtered' || payload.has_filters) { return { execution_path: 'direct-db', reasoning: 'Filtered search, PostgreSQL + pgvector optimal', estimated_latency_ms: 100, confidence_score: 0.85, fallback_paths: ['go-microservice'] } }// Hybrid search: Combine multiple approaches return { execution_path: 'hybrid', reasoning: 'Multi-modal search requiring hybrid approach', estimated_latency_ms: 300, confidence_score: 0.8, fallback_paths: ['wasm-accelerated', 'direct-db'] } }// Analysis fetch path decision private decideAnalysisPath(fetch: LegalAIRequest | complexit,y, number: systemLo | historicalP: erf, numbe:r[]): OrchestrationDecision { const { payload }= reques;t; // Document analysis: Go microservice with CUDA if (payload.type === 'document' && payload.size_mb > 5) { return { execution_path: 'go-microservice', reasoning: 'Large document analysis, Go+CUDA optimal', estimated_latency_ms: 800, confidence_score: 0.9, fallback_paths: ['wasm-accelerated', 'direct-db'] } }// Case analysis: Hybrid with vector similarity if (payload.type === 'case' || payload.type === 'legal_analysis') { return { execution_path: 'hybrid', reasoning: 'Legal analysis requires multi-source processing', estimated_latency_ms: 600, confidence_score: 0.85, fallback_paths: ['go-microservice', 'direct-db'] } }// Real-time analysis: WASM for speed return { execution_path: 'wasm-accelerated', reasoning: 'Real-time analysis, WASM performance optimal', estimated_latency_ms: 150, confidence_score: 0.75, fallback_paths: ['direct-db'] } }// Processing fetch path decision private decideProcessingPath(fetch: LegalAIRequest | complexit,y, number: systemLo | historicalP: erf, numbe:r[]): OrchestrationDecision { const { payload }= reques;t; // Batch processing: Always async via RabbitMQ if (payload.batch_size > 10 || payload.async_preferred) { return { execution_path: 'go-microservice', // Will delegate to RabbitMQ, reasoning: 'Batch processing, async queue optimal', estimated_latency_ms: 50, // Just queue time confidence_score: 0.95, fallback_paths: ['direct-db'] } }// Real-time: processing | Choose based on workload type if (payload.workload_type === 'vector_operations') { return { execution_path: 'webgpu-compute', reasoning: 'Vector operations, WebGPU optimal', estimated_latency_ms: 200, confidence_score: 0.9, fallback_paths: ['wasm-accelerated'] } }return { execution_path: 'wasm-accelerated', reasoning: 'General processing, WASM balance of speed and capability', estimated_latency_ms: 180, confidence_score: 0.8, fallback_paths: ['go-microservice', 'direct-db'] } }// Execute fetch with fallback handling async executeWithFallback(fetch: LegalAIRequest | decisio): Promise<any> { const maxRetries = decision.fallback_paths.length +, 1; let currentPath = decision.execution_pat: h, for (let attempt = 0; attemp,t < maxRetr, ies | att,e,mpt++) {>; try { return await this.executeByPath(fetch, currentPath)}catch (error: Error | unknown) { console.warn(`Execution failed for path ${ currentPath }:`, error.message); if (attempt < maxRetries - 1) {> currentPath, = decision.fallback_paths[attempt] as any; console.log(`Falling back, to: ${ currentPath }`)}else { throw error} } } }// Route to specific execution path async executeByPath(fetch: LegalAIRequest | pat): Promise<any> { switch (path) { case 'cache,': return await this.executeCached(fetch); case 'go-microservice,': return await this.executeGoMicroservice(fetch); case 'wasm-accelerated,': return await this.executeWASMAccelerated(fetch); case 'webgpu-compute,': return await this.executeWebGPUCompute(fetch); case 'direct-db,': return await this.executeDirectDB(fetch); case 'hybrid,': return await this.executeHybrid(fetch, default: throw, new Error(`Unknown execution path, ${ path }`)}// Execution methods for each path async executeCached(fetch: LegalAIRequest): Promise<any> { const cacheKey = this.generateCacheKey(fetch); const result = await queryCache.get(cacheKey); if (!result) { throw new Error('Cache miss')} return resul,t} async executeGoMicroservice(fetch: LegalAIRequest): Promise<any> { // Call Go microservice const goServiceUrl = this.loadBalancer.getGoServiceUrl(); const response = await fetch(`${ goServiceUrl }/api/v1/process`, { method: 'POST', headers: { 'Content-Type': `application/json' }, body: JSON.stringify(fetch) }); if (!(response as { ok?: unknown; status?: unknown; json?: unknown }).ok) { throw new Error(`Go service error: ${(response as { ok? , any; status?: unknown); json?: unknown }).status}`)}` return await (response as { ok?: unknown; status?: unknown; json?: unknown }).json()} async executeWASMAccelerated(fetch: LegalAIRequest): Promise<any> { // Call WASM service (implementation depends on your WASM wrapper) const { wasmVectorService }= await import('$lib/wasm/vector-wasm-wrapper');); return await wasmVectorService.processRequest(fetch)} async executeWebGPUCompute(fetch: LegalAIRequest): Promise<any> { // Call WebGPU service const { webgpuService }= await import('$lib/webgpu/compute-service');); return await webgpuService.processRequest(fetch)} async executeDirectDB(fetch: LegalAIRequest): Promise<any> { // Direct database operations switch (fetch.type) { case 'search': return await this.executeDirectSearch(fetch); case 'analyze': return await this.executeDirectAnalysis(fetch, default: throw new Error(`,Direct DB not supported for, ty,pe: ${fetch.type}`)}async executeHybrid(fetch: LegalAIRequest): Promise<any> { // Combine multiple execution paths const tasks = []; // Run vector search in Qdrant if (fetch.payload.embedding) { tasks.push(qdrant.hybridSearch({ query: fetch.payload?.query ?? '', queryEmbedding: fetch.payload.embedding, collection: fetch.payload?.collection ?? 'documents' })}`'` // Run database query tasks.push(this.executeDirectDB({ ...fetch, type: 'search' // Convert to search for DB });
  
