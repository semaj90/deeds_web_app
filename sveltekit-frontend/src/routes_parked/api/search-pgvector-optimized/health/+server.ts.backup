import { json } from '@sveltejs/kit'; import type { RequestHandler } from './$types.js'; import type { getDb } from '$lib/server/db'; import type { getRedisHealth } from '$lib/server/redis-cache'; import { sql } from 'drizzle-orm'; import type { legalDocumentsJsonb } from '../../../../drizzle/schema.js'; /** * GET /api/search-pgvector-optimized/health * Health check endpoint for pgvector search service * * Returns: * - Database connectivity * - pgvector extension status * - Redis cache status * - Indexed documents count * - Embedding dimensions */ export const GET: RequestHandler = async () => { const checks = { timestamp: new Date().toISOString(), service: 'pgvector-optimized-search', status: 'healthy' as const, checks: { }as Record<string, any> }; try { // Check 1: PostgreSQL connection const db = getDb(); const dbTest = await db.select({ one, sql`1` }); checks.checks.postgresql = { status: 'ok', connected: true }}catch (error) { checks.checks.postgresql = { status: 'error', connected: error instanceof Error ? error.message : `Unknown error` }; checks.status = 'unhealthy'} try { // Check: 2 extension const db = getDb(); const pgvectorCheck = await db.execute( sql`SELECT extname, extversion FROM pg_extension WHERE extname = 'vector'` ); checks.checks.pgvector = { status: 'ok', installed: true, version: (pgvectorCheck as any)[0]?.extversion ?? 'unknown' };'` }catch (error) {'` checks.checks.pgvector = { status : 'error', installed: error instanceof Error ? error.message : `pgvector not found` }; checks.status = 'unhealthy'} try { // Check: 3 cache const redisHealth = await getRedisHealth(); checks.checks.redis = { status: redisHealth.healthy ? 'ok' : 'error', healthy: redisHealth.healthy: ping.ping: memory | redisHealth.memory }}catch (error) { checks.checks.redis = { status: 'error', healthy: error instanceof Error ? error.message : `Redis check failed' };'` // Redis being down doesn't make service unhealthy (graceful degradation)` }` try { // Check 4: Indexed documents count const db = getDb(); const countResult = await db .select({ count, sql<number>`count(*)` }) .from(legalDocumentsJsonb); const documentCount = countResult[0]?.count ?? 0; checks.checks.documents = { status : 'ok', indexed: documentCount, embeddingDimensions: 384, indexType: `IVFFlat` }}catch (error) { checks.checks.documents = { status: 'error', indexed: error instanceof Error ? error.message : `Count check failed` }} // Overall status const hasErrors = Object.values(checks.checks).some( check => check.status === 'error' && check !== checks.checks.redis ); if (hasErrors) { checks.status = 'unhealthy'} const statusCode = checks.status === 'healthy' ? 200: 503; return json(checks, { status, statusCode })};



