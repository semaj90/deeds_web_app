/* Global YoRHa Legal-AI & Royal Dossier Design System (@import must come first) */
@import './lib/styles/dossier-global.css';

/* UnoCSS directives */
@unocss preflights;
@unocss default;

/* Custom properties for theming */
@layer base {
  :root {
    /* Legal AI Theme Colors */
    --color-legal-primary: theme('colors.legal.primary');
    --color-legal-secondary: theme('colors.legal.secondary');
    --color-legal-accent: theme('colors.legal.accent');
    --color-legal-background: theme('colors.legal.background');
    --color-legal-surface: theme('colors.legal.surface');

    /* NES Gaming Colors */
    --color-nes-primary: theme('colors.nes.primary');
    --color-nes-secondary: theme('colors.nes.secondary');
    --color-nes-warning: theme('colors.nes.warning');
    --color-nes-error: theme('colors.nes.error');

    /* YoRHa NieR Colors */
    --color-nier-primary: #e0e0e0;
    --color-nier-background: #0a0a0a;
    --color-nier-surface: #1a1a1a;
    --color-nier-text: #e0e0e0;
    --color-nier-border: #606060;
    --color-nier-accent: #b0b0b0;

    /* Canonical Shell & Royal Dossier × NieR HUD Tokens */
    --shell-sidebar-w: 224px;
    --shell-sidebar-rail-w: 56px;
    --shell-navbar-h: 46px;
    --shell-crimson: #7A1B18;
    --shell-crimson-deep: #58100E;
    --shell-gold: #C9A86A;
    --shell-gold-light: #E5C77B;
    --shell-obsidian: #181E26;
    --shell-prussian: #1E2530;
    --shell-parchment: #F3EFE6;
    --shell-swirl: #EAE3D5;
    --shell-bronco: #B5A792;
    --shell-pablo: #6E6355;
    --font-royal-serif: 'Cinzel', 'Cormorant Garamond', Georgia, 'Palatino Linotype', serif;
    --font-editorial-serif: 'Cormorant Garamond', Georgia, 'Palatino Linotype', 'Times New Roman', serif;
    --font-clean-ui: 'Inter', 'InterLocal', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;

    /* Shadcn/UI CSS Variables for UnoCSS compatibility */
    --background: 10 10 10; /* #0a0a0a */
    --foreground: 224 224 224; /* #e0e0e0 */
    --card: 26 26 26; /* #1a1a1a */
    --card-foreground: 224 224 224; /* #e0e0e0 */
    --popover: 26 26 26; /* #1a1a1a */
    --popover-foreground: 224 224 224; /* #e0e0e0 */
    --primary: 224 224 224; /* #e0e0e0 */
    --primary-foreground: 10 10 10; /* #0a0a0a */
    --secondary: 42 42 42; /* #2a2a2a */
    --secondary-foreground: 224 224 224; /* #e0e0e0 */
    --muted: 42 42 42; /* #2a2a2a */
    --muted-foreground: 176 176 176; /* #b0b0b0 */
    --accent: 42 42 42; /* #2a2a2a */
    --accent-foreground: 224 224 224; /* #e0e0e0 */
    --destructive: 239 68 68; /* #ef4444 */
    --destructive-foreground: 248 250 252; /* #f8fafc */
    --border: 96 96 96; /* #606060 */
    --input: 42 42 42; /* #2a2a2a */
    --ring: 224 224 224; /* #e0e0e0 */
    --radius: 0.5rem;
  }

  .dark {
    --background: 10 10 10; /* #0a0a0a */
    --foreground: 224 224 224; /* #e0e0e0 */
    --card: 26 26 26; /* #1a1a1a */
    --card-foreground: 224 224 224; /* #e0e0e0 */
    --popover: 26 26 26; /* #1a1a1a */
    --popover-foreground: 224 224 224; /* #e0e0e0 */
    --primary: 224 224 224; /* #e0e0e0 */
    --primary-foreground: 10 10 10; /* #0a0a0a */
    --secondary: 42 42 42; /* #2a2a2a */
    --secondary-foreground: 224 224 224; /* #e0e0e0 */
    --muted: 42 42 42; /* #2a2a2a */
    --muted-foreground: 128 128 128; /* #808080 */
    --accent: 42 42 42; /* #2a2a2a */
    --accent-foreground: 224 224 224; /* #e0e0e0 */
    --destructive: 239 68 68; /* #ef4444 */
    --destructive-foreground: 248 250 252; /* #f8fafc */
    --border: 96 96 96; /* #606060 */
    --input: 42 42 42; /* #2a2a2a */
    --ring: 224 224 224; /* #e0e0e0 */
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-family: theme('fontFamily.legal');
  }
}

/* NES.css gaming enhancements */
@layer components {
  .nes-enhanced {
    @apply font-retro text-sm;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
  }

  /* Legal AI Component Styles */
  .legal-nav-item {
    @apply nav-item text-legal-secondary hover:text-legal-primary hover:bg-legal-primary/10;
  }

  .legal-sidebar-item {
    @apply sidebar-item text-legal-secondary hover:text-legal-primary hover:bg-legal-primary/10;
  }

  .legal-card {
    @apply card-elevated bg-legal-surface border-legal-primary/20;
  }

  .legal-button-primary {
    @apply btn-primary bg-legal-primary hover:bg-legal-primary/90;
  }

  .legal-button-secondary {
    @apply btn-secondary bg-legal-secondary hover:bg-legal-secondary/90;
  }

  /* Gaming Component Styles */
  .gaming-button {
    @apply nes-btn bg-nes-primary hover:bg-nes-secondary transition-all duration-200;
  }

  .gaming-card {
    @apply nes-card border-nes-primary shadow-lg;
  }

  .gaming-input {
    @apply nes-input border-nes-primary focus:border-nes-secondary;
  }
}

/* Layout utilities */
@layer utilities {
  .layout-container {
    @apply layout-container;
  }

  .app-grid {
    display: grid;
    grid-template-areas:
      'nav nav'
      'sidebar main'
      'footer footer';
    grid-template-rows: auto 1fr auto;
    grid-template-columns: auto 1fr;
    min-height: 100vh;
  }

  .app-nav {
    grid-area: nav;
  }

  .app-sidebar {
    grid-area: sidebar;
  }

  .app-main {
    grid-area: main;
  }

  .app-footer {
    grid-area: footer;
  }
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--color-nier-background);
}

::-webkit-scrollbar-thumb {
  background: var(--color-nier-border);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-nier-primary);
}

/* Selection styling */
::selection {
  background: var(--color-legal-primary);
  color: var(--color-legal-surface);
}

/* Focus indicators */
.focus-visible {
  outline: 2px solid var(--color-legal-primary);
  outline-offset: 2px;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* High contrast mode */
@media (prefers-contrast: high) {
  :root {
    --color-nier-border: #ffffff;
    --color-nier-text: #ffffff;
  }
}

/* Print styles */
@media print {
  * {
    background: white !important;
    color: black !important;
  }

  .gaming-effects,
  .nes-enhanced,
  .animate-pulse {
    display: none !important;
  }
}

/* ─── Unified HUD Modal & Tactical Toast Styling ─── */
.hud-modal-backdrop {
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
}

[data-sonner-toaster] [data-sonner-toast] {
  background: rgba(19, 27, 42, 0.96) !important;
  border: 1px solid rgba(243, 212, 113, 0.35) !important;
  color: #f3d471 !important;
  backdrop-filter: blur(16px) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.8), 0 0 15px rgba(243, 212, 113, 0.15) !important;
  border-radius: 0.75rem !important;
}

[data-sonner-toaster] [data-sonner-toast] [data-title] {
  color: #ffffff !important;
  font-weight: 600 !important;
  font-size: 0.875rem !important;
}

[data-sonner-toaster] [data-sonner-toast] [data-description] {
  color: rgba(220, 215, 200, 0.75) !important;
  font-size: 0.75rem !important;
}

[data-sonner-toaster] [data-sonner-toast][data-type="error"] {
  border-color: rgba(239, 68, 68, 0.5) !important;
  box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.8), 0 0 15px rgba(239, 68, 68, 0.2) !important;
}

[data-sonner-toaster] [data-sonner-toast][data-type="success"] {
  border-color: rgba(34, 197, 94, 0.5) !important;
  box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.8), 0 0 15px rgba(34, 197, 94, 0.2) !important;
}

[data-sonner-toaster] [data-sonner-toast][data-type="warning"] {
  border-color: rgba(234, 179, 8, 0.5) !important;
  box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.8), 0 0 15px rgba(234, 179, 8, 0.2) !important;
}
