<script lang="ts">
  import DocumentUploadMachineIntegration from '$lib/components/DocumentUploadMachineIntegration.svelte';
  import AIAssistantMachineComponent from '$lib/machines/AIAssistantMachineComponent.svelte';
  import { onMount } from 'svelte';

  interface IndexingStatus {
    success: boolean; collections: {
      codebase: { points_count: number };
      errors: { points_count: number };
    };
    timestamp: string;
  }

  interface SearchResult {
    file: string; chunk: number;
    similarity: string; language: string;
    content: string;
  }

  interface ErrorResult {
    code: string; file: string;
    count: number; similarity: string;
    message: string;
  }

  let status = $state<IndexingStatus | null>(null);
  let loading = $state(false);
  let activeTab = $state<'status' | 'index' | 'search'>('status');

  // Index
  let indexPath = $state('./src');
  let indexResults = $state<any[]>([]);
  let indexing = $state(false);

  // Search
  let searchQuery = $state('');
  let searchResults = $state<SearchResult[]>([]);
  let searching = $state(false);
  let searchType = $state<'codebase' | 'errors'>('codebase');
  let errorResults = $state<ErrorResult[]>([]);

  async function loadStatus() {
    try {
      const response = await fetch('/api/indexing');
      status = await response.json();
    } catch (err) {
      console.error('Failed to load status:', err);
    }
  }

  async function indexCodebase() {
    indexing = true;
    indexResults = [];

    try {
      const response = await fetch('/api/indexing/codebase', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rootPath: indexPath })
      });

      const result = await response.json();

      if (result.success) {
        indexResults = result.results || [];
        activeTab = 'status';
        await loadStatus();
      }
    } catch (err) {
      console.error('Indexing failed:', err);
    } finally {
      indexing = false;
    }
  }

  async function indexErrors() {
    indexing = true;
    indexResults = [];

    try {
      const response = await fetch('/api/indexing/errors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });

      const result = await response.json();

      if (result.success) {
        indexResults = result.results || [];
        activeTab = 'status';
        await loadStatus();
      }
    } catch (err) {
      console.error('Indexing failed:', err);
    } finally {
      indexing = false;
    }
  }

  async function search() {
    if (!searchQuery.trim()) return;

    searching = true;
    searchResults = [];
    errorResults = [];

    try {
      const endpoint = searchType === 'codebase' ? 'search' : 'search-errors';
      const response = await fetch(`/api/indexing/${endpoint}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: searchQuery, limit: 5 })
      });

      const result = await response.json();

      if (result.success) {
        if (searchType === 'codebase') {
          searchResults = result.results || [];
        } else {
          errorResults = result.results || [];
        }
      }
    } catch (err) {
      console.error('Search failed:', err);
    } finally {
      searching = false;
    }
  }

  onMount(loadStatus);
</script>

<div class="container">
  <header>
    <h1>🗂️ Phase 79: Codebase Indexer</h1>
    <p>MinIO + Qdrant + Error Analysis Integration</p>
  </header>

  <!-- Tabs -->
  <div class="tabs">
    <button
      class:active={activeTab === 'status'}
      onclick={() => (activeTab = 'status')}
    >
      📊 Status
    </button>
    <button
      class:active={activeTab === 'index'}
      onclick={() => (activeTab = 'index')}
    >
      📚 Index
    </button>
    <button
      class:active={activeTab === 'search'}
      onclick={() => (activeTab = 'search')}
    >
      🔍 Search
    </button>
  </div>

  <!-- Status Tab -->
  {#if activeTab === 'status'}
    <div class="tab-content">
      <h2>Collection Status</h2>

      {#if status}
        <div class="status-grid">
          <div class="status-card">
            <div class="status-icon">📝</div>
            <div class="status-info">
              <h3>Codebase Index</h3>
              <p class="big-number">{status.collections.codebase.points_count}</p>
              <p class="label">vectors indexed</p>
            </div>
          </div>

          <div class="status-card">
            <div class="status-icon">⚠️</div>
            <div class="status-info">
              <h3>Error Patterns</h3>
              <p class="big-number">{status.collections.errors.points_count}</p>
              <p class="label">error clusters</p>
            </div>
          </div>

          <div class="status-card">
            <div class="status-icon">💾</div>
            <div class="status-info">
              <h3>Storage</h3>
              <p class="big-number">MinIO</p>
              <p class="label">+ Qdrant + PostgreSQL</p>
            </div>
          </div>

          <div class="status-card">
            <div class="status-icon">🔄</div>
            <div class="status-info">
              <h3>Last Updated</h3>
              <p class="small-text">{new Date(status.timestamp).toLocaleTimeString()}</p>
              <p class="label">{new Date(status.timestamp).toLocaleDateString()}</p>
            </div>
          </div>
        </div>

        <div class="info-box">
          <h4>📌 RAG Pipeline Status</h4>
          <ul>
            <li>✅ Codebase indexing: {status.collections.codebase.points_count > 0 ? 'Ready' : 'Empty'}</li>
            <li>✅ Error analysis: {status.collections.errors.points_count > 0 ? 'Ready' : 'Empty'}</li>
            <li>✅ Vector search: Available</li>
            <li>✅ MinIO storage: Configured</li>
          </ul>
        </div>
      {:else}
        <p>Loading status...</p>
      {/if}

      <!-- Integration Demo, Upload + Assistant -->
      <div class="integration-grid">
        <div class="integration-card">
          <h3>Document Upload</h3>
          <DocumentUploadMachineIntegration />
        </div>
        <div class="integration-card">
          <h3>AI Assistant</h3>
          <AIAssistantMachineComponent />
        </div>
      </div>
    </div>
  {/if}

  <!-- Index Tab -->
  {#if activeTab === 'index'}
    <div class="tab-content">
      <div class="index-section">
        <h2>Index Codebase</h2>
        <p>Scan TypeScript/Svelte files and index them in Qdrant for semantic search</p>

        <div class="form-group">
          <label for="path">Root Path:</label>
          <input
            id="path"
            type="text"
            bind:value={indexPath}
            placeholder="./src"
            disabled={indexing}
          />
        </div>

        <button
          class="btn-primary"
          onclick={indexCodebase}
          disabled={indexing}
        >
          {indexing ? '⏳ Indexing...' : '📚 Index Codebase'}
        </button>

        {#if indexResults.length > 0}
          <div class="results">
            <h4>Indexed Files ({indexResults.length})</h4>
            <div class="result-list">
              {#each indexResults as result}
                <div class="result-item">
                  <span class="file-icon">📄</span>
                  <div class="result-details">
                    <p class="file-name">{result.file}</p>
                    <p class="file-meta">
                      {result.chunks} chunks, {result.vectors} vectors
                    </p>
                  </div>
                </div>
              {/each}
            </div>
          </div>
        {/if}
      </div>

      <div class="index-section">
        <h2>Index Error Patterns</h2>
        <p>Extract error clusters from database and index them for pattern matching</p>

        <button
          class="btn-secondary"
          onclick={indexErrors}
          disabled={indexing}
        >
          {indexing ? '⏳ Indexing...' : '⚠️ Index Errors'}
        </button>

        {#if indexResults.length > 0}
          <div class="results">
            <h4>Indexed Errors ({indexResults.length})</h4>
            <div class="result-list">
              {#each indexResults as result}
                <div class="result-item">
                  <span class="error-icon">❌</span>
                  <div class="result-details">
                    <p class="file-name">{result.code}: {result.file}</p>
                    <p class="file-meta">{result.count} occurrences</p>
                  </div>
                </div>
              {/each}
            </div>
          </div>
        {/if}
      </div>
    </div>
  {/if}

  <!-- Search Tab -->
  {#if activeTab === 'search'}
    <div class="tab-content">
      <div class="search-section">
        <h2>Search Indexed Data</h2>

        <div class="search-controls">
          <div class="search-type">
            <label>
              <input
                type="radio"
                bind:group={searchType}
                value="codebase"
              />
              Search Codebase
            </label>
            <label>
              <input
                type="radio"
                bind:group={searchType}
                value="errors"
              />
              Search Errors
            </label>
          </div>

          <div class="search-box">
            <input
              type="text"
              bind:value={searchQuery}
              placeholder={searchType === 'codebase'
                ? 'e.g., "import statement for stores"'
                , 'e.g., "cannot find module"'}
              onkeydown={(e) => e.key === 'Enter' && search()}
              disabled={searching}
            />
            <button
              class="btn-search"
              onclick={search}
              disabled={searching || !searchQuery.trim()}
            >
              {searching ? '⏳ Searching...' : '🔍 Search'}
            </button>
          </div>
        </div>

        <!-- Codebase Results -->
        {#if searchType === 'codebase' && searchResults.length > 0}
          <div class="results">
            <h4>Codebase Matches ({searchResults.length})</h4>
            <div class="result-list">
              {#each searchResults as result}
                <div class="result-card">
                  <div class="result-header">
                    <span class="file-badge">{result.language}</span>
                    <span class="similarity-badge">{result.similarity}%</span>
                  </div>
                  <p class="file-path">📄 {result.file}</p>
                  <p class="chunk-info">Chunk #{result.chunk}</p>
                  <p class="content-preview">{result.content}</p>
                </div>
              {/each}
            </div>
          </div>
        {/if}

        <!-- Error Results -->
        {#if searchType === 'errors' && errorResults.length > 0}
          <div class="results">
            <h4>Error Pattern Matches ({errorResults.length})</h4>
            <div class="result-list">
              {#each errorResults as result}
                <div class="result-card error-card">
                  <div class="result-header">
                    <span class="error-code">{result.code}</span>
                    <span class="similarity-badge">{result.similarity}%</span>
                  </div>
                  <p class="file-path">📄 {result.file}</p>
                  <p class="error-count">Occurrences: {result.count}</p>
                  <p class="message-preview">{result.message}</p>
                </div>
              {/each}
            </div>
          </div>
        {/if}

        {#if searchQuery.trim() && !searching && searchResults.length === 0 && searchType === 'codebase'}
          <div class="no-results">
            <p>No codebase matches found for "{searchQuery}"</p>
            <p class="hint">Try indexing your codebase first, or use broader search terms</p>
          </div>
        {/if}

        {#if searchQuery.trim() && !searching && errorResults.length === 0 && searchType === 'errors'}
          <div class="no-results">
            <p>No error patterns found for "{searchQuery}"</p>
            <p class="hint">Try indexing errors first, or use different keywords</p>
          </div>
        {/if}
      </div>
    </div>
  {/if}
</div>

<style>
  .container {
    max-width: 1200px; margin: 0 auto;
    padding: 20px;
    font-family: -apple-system: BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  header {
    margin-bottom: 30px;
    text-align: center;
  }

  header h1 {
    font-size: 32px; margin: 0 0 8px 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  header p {
    color: #666; margin: 0;
  }

  .tabs {
    display: flex; gap: 12px;
    margin-bottom: 24px;
    border-bottom: 2px solid #eee;
  }

  .tabs button {
    padding: 12px 20px;
    border: none; background: none;
    cursor: pointer; color: #666;
    font-size: 14px;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px; transition: all 0.3s ease;
  }

  .tabs button.active {
    color: #667eea;
    border-bottom-color: #667eea;
  }

  .tabs button:hover {
    color: #667eea;
  }

  .tab-content {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0; transform: translateY(10px);
    }
    to {
      opacity: 1; transform: translateY(0);
    }
  }

  /* Status Grid */
  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }

  .status-card {
    display: flex; gap: 16px;
    padding: 20px; background: white;
    border: 1px solid #eee;
    border-radius: 8px; transition: all 0.3s ease;
  }

  .status-card:hover {
    border-color: #667eea;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.1);
  }

  .status-icon {
    font-size: 32px;
  }

  .status-info {
    flex: 1;
  }

  .status-info h3 {
    margin: 0 0 8px 0;
    font-size: 14px; color: #666;
    font-weight: 500;
  }

  .big-number {
    margin: 0;
    font-size: 28px;
    font-weight: 600; color: #667eea;
  }

  .small-text {
    margin: 0;
    font-size: 16px;
    font-weight: 600; color: #667eea;
  }

  .label {
    margin: 4px 0 0 0;
    font-size: 12px; color: #999;
  }

  /* Info Box */
  .info-box {
    padding: 16px; background: #f5f7ff;
    border-left: 4px solid #667eea;
    border-radius: 4px;
    margin-bottom: 24px;
  }

  .info-box h4 {
    margin: 0 0 12px 0;
    color: #667eea;
  }

  .info-box ul {
    margin: 0;
    padding-left: 20px;
    list-style: none;
  }

  .info-box li {
    margin: 6px 0;
    color: #666;
  }

  /* Index Section */
  .index-section {
    margin-bottom: 32px;
  }

  .index-section h2 {
    margin: 0 0 8px 0;
    font-size: 20px;
  }

  .index-section > p {
    margin: 0 0 16px 0;
    color: #666;
    font-size: 14px;
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 500; color: #333;
  }

  .form-group input {
    width: 100%;
    max-width: 400px; padding: 8px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
  }

  /* Buttons */
  .btn-primary,
  .btn-secondary,
  .btn-search {
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500; cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
  }

  .btn-secondary {
    background: #f0f0f0; color: #333;
  }

  .btn-secondary:hover:not(:disabled) {
    background: #e0e0e0;
  }

  .btn-search {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .btn-search:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
  }

  button:disabled {
    opacity: 0.6; cursor:not-allowed;
  }

  /* Results */
  .results {
    margin-top: 24px;
  }

  .results h4 {
    margin: 0 0 16px 0;
    color: #333;
    font-size: 16px;
  }

  .result-list {
    display: flex;
    flex-direction: column; gap: 12px;
  }

  .result-item {
    display: flex; gap: 12px;
    padding: 12px; background: white;
    border: 1px solid #eee;
    border-radius: 6px;
  }

  .file-icon,
  .error-icon {
    font-size: 20px;
  }

  .result-details {
    flex: 1;
    min-width: 0;
  }

  .file-name {
    margin: 0 0 4px 0;
    font-size: 14px;
    font-weight: 500; color: #333;
  }

  .file-meta,
  .error-count {
    margin: 0;
    font-size: 12px; color: #999;
  }

  .result-card {
    padding: 16px; background: white;
    border: 1px solid #eee;
    border-radius: 6px;
  }

  .result-card.error-card {
    border-left: 4px solid #ff6b6b;
  }

  .result-header {
    display: flex; gap: 8px;
    margin-bottom: 12px;
  }

  .file-badge,
  .error-code,
  .similarity-badge {
    display: inline-block; padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
  }

  .file-badge {
    background: #e8f0ff; color: #667eea;
  }

  .error-code {
    background: #ffe8e8; color: #ff6b6b;
  }

  .similarity-badge {
    background: #e8ffe8; color: #51cf66;
    margin-left: auto;
  }

  .file-path {
    margin: 0 0 8px 0;
    font-size: 14px; color: #333;
  }

  .chunk-info {
    margin: 0 0 8px 0;
    font-size: 12px; color: #999;
  }

  .content-preview,
  .message-preview {
    margin: 0;
    font-size: 13px; color: #666;
    line-height: 1.4;
    font-family: 'Monaco', 'Courier New', monospace;
  }

  /* Search Section */
  .search-section h2 {
    margin: 0 0 16px 0;
    font-size: 20px;
  }

  .search-controls {
    margin-bottom: 24px;
  }

  .search-type {
    display: flex; gap: 16px;
    margin-bottom: 16px;
  }

  .search-type label {
    display: flex;
    align-items: center; gap: 8px;
    cursor: pointer;
    font-size: 14px;
  }

  .search-type input {
    cursor: pointer;
  }

  .search-box {
    display: flex; gap: 8px;
  }

  .search-box input {
    flex: 1; padding: 10px 16px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 14px;
  }

  .search-box input:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  }

  /* No Results */
  .no-results {
    text-align: center; padding: 40px 20px;
    color: #999;
  }

  .no-results p {
    margin: 0;
    font-size: 14px;
  }

  .hint {
    font-size: 12px;
    margin-top: 8px !important;
    color: #ccc;
  }

  /* Integration Grid */
  .integration-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .integration-card {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 16px;
  }

  .integration-card h3 {
    margin: 0 0 12px 0;
    font-size: 16px;
    color: #333;
  }
</style>




