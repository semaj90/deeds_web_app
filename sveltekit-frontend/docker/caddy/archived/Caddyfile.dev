# Development Caddy Configuration with QUIC/HTTP3
# Caddy v2.8.4 - Legal AI Platform Development Setup

# Development SvelteKit server with relaxed QUIC settings
:5178 {
    # HTTP/3 with shorter cache times for dev
    header Alt-Svc "h3=\":5178\"; ma=3600"

    # Development CORS headers (permissive for local dev)
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
    header Access-Control-Allow-Credentials "true"

    # Handle preflight requests
    @options {
        method OPTIONS
    }
    handle @options {
        respond 200
    }

    # SSE — disable buffering for streaming endpoints
    handle /api/sse/* {
        reverse_proxy localhost:5173 {
            flush_interval -1
        }
    }
    handle /api/ai/* {
        reverse_proxy localhost:5173 {
            flush_interval -1
        }
    }

    # Reverse proxy to Vite dev server
    reverse_proxy localhost:5173 {
        # Development connection settings (more permissive)
        transport http {
            keepalive 10s
            keepalive_idle_conns 2
        }

        # Pass through dev headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Handle dev server restarts gracefully
        fail_duration 1s
        max_fails 3
    }

    # Basic compression for dev (lighter than production)
    encode gzip

    # Development logging (more verbose)
    log {
        output stdout
        format console
        level DEBUG
    }
}

# Alternative dev server on different port for testing
:5179 {
    header Alt-Svc "h3=\":5179\"; ma=3600"
    header Access-Control-Allow-Origin "*"

    reverse_proxy localhost:5176 {
        fail_duration 1s
    }

    encode gzip
}

