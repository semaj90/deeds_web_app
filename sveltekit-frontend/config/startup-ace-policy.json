{
  "mode": "incremental",
  "neverRunOnStartup": [
    "qdrant:recreate",
    "graphify:full",
    "graphify:full:force",
    "db:reset",
    "neo4j:clear",
    "redis:flush",
    "couchdb:delete",
    "llms:write:force",
    "drizzle:push",
    "drizzle:reset",
    "db:apply-migration"
  ],
  "allowedOnStartup": [
    "llms:pipeline:dry",
    "llms:pipeline:safe",
    "topology:validate",
    "graph:synthesize",
    "smoke:llms",
    "smoke:trace",
    "kag:ingest",
    "karpathy:gpu:dirty",
    "karpathy:gpu:dry",
    "ace:hit-demand",
    "ace:hit-demand:dry",
    "hypergraph:seed",
    "hypergraph:seed:dry",
    "archive:llm",
    "archive:llm:dry",
    "archive:weekly-cold",
    "archive:weekly-cold:dry",
    "wiki:loop",
    "wiki:loop:smoke",
    "smoke:atlas",
    "smoke:hypergraph",
    "atlas:prompt:smoke",
    "index:codebase:fast:resume",
    "atlas:index",
    "graphify:obsidian:incremental",
    "index:vault:md",
    "index:vault:md:dry",
    "seed:hypergraph:lane-b",
    "seed:hypergraph:lane-c",
    "seed:hypergraph:lane-d",
    "smoke:hypergraph:vault",
    "startup:napi-bridge:warm",
    "turbovec:sidecar:detached",
    "graphify:semantic-cluster",
    "graphify:semantic-cluster:force",
    "hyperrag:multiquery:dry",
    "hyperrag:multiquery",
    "smoke:hyperrag",
    "smoke:hyperrag:skip-mcp",
    "qdrant:patch-topology",
    "neo4j:manifold-sync",
    "search:sync:pg",
    "graphify:rerank-writeback",
    "graphify:rerank-writeback:breakdown",
    "qdrant:rerank-feedback",
    "hypergraph:tag",
    "wiki:loop:smoke",
    "llms:enrich",
    "codebase:index"
  ],
  "thresholds": {
    "smallChangeMaxFiles": 20,
    "mediumChangeMaxFiles": 200,
    "schemaChangeTriggers": [
      "package.json",
      "pnpm-lock.yaml",
      "package-lock.json",
      "drizzle.config.ts",
      "drizzle.config.js",
      "src/lib/server/db/schema",
      "docker-compose.yml",
      "docker-compose.test.yml",
      "scripts/graph/",
      "scripts/neo4j/"
    ]
  },
  "maxRuntimeMs": 300000,
  "lockKey": "lock:startup:ace-refresh",
  "lockTtlSec": 900,
  "logDir": "logs/task-output/pipeline-test",
  "redisStateKeys": {
    "lastSha": "ace:startup:last_sha",
    "latest": "ace:startup:latest",
    "dirtyFiles": "ace:rank:dirty_files",
    "dirtyClusters": "ace:rank:dirty_clusters",
    "heavyLastRun": "ace:startup:heavy_last_run",
    "heavyLock": "lock:startup:heavy-worker"
  },
  "heavyServiceWorker": {
    "enabled": true,
    "cooldownHours": 24,
    "gpuWarmGate": {
      "turboquantUrl": "http://127.0.0.1:8090/health",
      "ollamaUrl": "http://127.0.0.1:11434/api/tags",
      "probeTimeoutMs": 3000,
      "requireBoth": false
    },
    "tasks": [
      "wiki:loop",
      "graphify:authority",
      "graphify:gds",
      "graphify:som",
      "hypergraph:build:4d",
      "graphify:cluster-summaries",
      "graphify:bow-tiles",
      "topology:validate",
      "karpathy:gpu",
      "hypergraph:seed",
      "ace:hit-demand",
      "graphify:obsidian:incremental",
      "graphify:semantic-cluster",
      "hyperrag:multiquery:dry",
      "qdrant:patch-topology",
      "neo4j:manifold-sync",
      "search:sync:pg",
      "graphify:rerank-writeback",
      "graphify:rerank-writeback:breakdown",
      "qdrant:rerank-feedback",
      "hypergraph:tag",
      "audit:full-pipeline",
      "llms:enrich",
      "codebase:index"
    ],
    "logKey": "ace:startup:heavy_log"
  }
}
