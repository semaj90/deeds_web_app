{
  "targets": {
    "debug": {
      "outFile": "../build/vector-ops.debug.wasm",
      "textFile": "../build/vector-ops.debug.wat",
      "sourceMap": true,
      "debug": true
    },
    "release": {
      "outFile": "../build/vector-ops.wasm",
      "textFile": "../build/vector-ops.wat",
