{
  "name": "evidence-service",
  "version": "1.0.0",
  "description": "Production-ready legal evidence processing pipeline with GraphQL, RabbitMQ, Drizzle ORM, and vector embeddings",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bootstrap": "tsx watch src/bootstrap/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:bootstrap": "node dist/bootstrap/index.js",
    "worker:ocr": "tsx src/mq/workers/ocrWorker.ts",
    "worker:embed": "tsx src/mq/workers/embedWorker.ts",
    "worker:summarize": "tsx src/mq/workers/summarizeWorker.ts",
    "worker:entity": "tsx src/mq/workers/entityWorker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "legal",
    "evidence",
    "rag",
    "graphql",
    "rabbitmq",
    "vector-search"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "@xenova/transformers": "^2.17.2",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "graphql": "^16.9.0",
    "ioredis": "^5.8.1",
    "minio": "^8.0.1",
    "ollama": "^0.5.9",
    "postgres": "^3.4.5",
    "tesseract.js": "^5.1.1",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "xstate": "^5.18.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/minio": "^7.1.1",
    "@types/node": "^22.7.9",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
