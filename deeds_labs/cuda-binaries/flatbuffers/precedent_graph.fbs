// FlatBuffers schema for precedent graph used by deeds-web
// Defines nodes (court decisions, statutes, etc.) and directed edges (citations/relations).

namespace deeds.flatbuffers;

file_identifier "PRGT";

/// A single precedent or legal document node.
table Node {
  id:ulong;             // unique identifier
  title:string;         // short title or caption
  text:string;          // full text or excerpt
  date:int;             // UNIX epoch date (seconds)
  jurisdiction:string;  // jurisdiction code or name
  citations:[ulong];    // referenced node ids
}

/// Directed relation between two nodes (e.g., citation, overruling).
table Edge {
  from:ulong;           // source node id
  to:ulong;             // target node id
  relation:string;      // relation type (e.g., "cites", "overrules")
  context:string;       // optional short context or quote
}

/// The root object containing the entire precedent graph.
table PrecedentGraph {
  nodes:[Node];
  edges:[Edge];
  generatedAt:int;      // UNIX epoch seconds when graph was produced
}

root_type PrecedentGraph;
