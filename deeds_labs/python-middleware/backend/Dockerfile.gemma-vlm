FROM nvidia/cuda:12.2.2-runtime-ubuntu22.04\n\nWORKDIR /app\n\n# Install Python and dependencies\nRUN apt-get update && apt-get install -y \\\n    python3.11 \\\n    python3-pip \\\n    git \\\n    curl \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Set Python 3.11 as default\nRUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1\n\n# Copy requirements\nCOPY services/requirements-gemma-vlm.txt .\n\n# Install Python dependencies\nRUN pip install --no-cache-dir -r requirements-gemma-vlm.txt\n\n# Copy service code\nCOPY services/gemma_vlm_embedding_service.py .\n\n# Create cache directories\nRUN mkdir -p /root/.cache /models/cache\n\n# Health check\nHEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \\\n    CMD curl -f http://localhost:8001/health || exit 1\n\n# Expose port\nEXPOSE 8001\n\n# Run service\nCMD [\"python\", \"gemma_vlm_embedding_service.py\"]\n"