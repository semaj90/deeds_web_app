# Multi-stage build for TensorRT-LLM service
FROM nvidia/cuda:12.4-devel-ubuntu22.04 AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    git \
    build-essential \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3.11 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY requirements.tensorrt.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.tensorrt.txt

# Download and cache models during build
RUN mkdir -p /tmp/models && \
    cd /tmp/models && \
    # Download tokenizer for gemma3-legal
    git clone https://huggingface.co/google/gemma-3-4b-it /tmp/models/gemma3-tokenizer && \
    # Create placeholder for TensorRT engines
    mkdir -p /tmp/tensorrt_engines

# Runtime stage
FROM nvidia/cuda:12.4-runtime-ubuntu22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-venv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy models and engines from builder
COPY --from=builder /tmp/models /app/models
COPY --from=builder /tmp/tensorrt_engines /app/tensorrt_engines

# Create directories
RUN mkdir -p /app/tokenizers && \
    mkdir -p /app/logs && \
    mkdir -p /app/cache

# Copy application code
COPY tensorrt_llm_service.py /app/
COPY pyrightconfig.json /app/
COPY requirements.tensorrt.txt /app/

# Copy tokenizer files
RUN cp -r /app/models/gemma3-tokenizer /app/tokenizers/

# Set working directory
WORKDIR /app

# Create non-root user
RUN useradd --create-home --shell /bin/bash tensorrt && \
    chown -R tensorrt:tensorrt /app
USER tensorrt

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8099/health || exit 1

# Expose port
EXPOSE 8099

# Set environment variables
ENV CUDA_VISIBLE_DEVICES=0 \
    TORCH_USE_CUDA_DSA=1 \
    PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Start the service
CMD ["python", "tensorrt_llm_service.py"]