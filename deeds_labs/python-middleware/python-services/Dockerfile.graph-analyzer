# Dockerfile for Phase 47 Graph Analyzer
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements-graph-analyzer.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY phase47_graph_analyzer.py .

# Expose port
EXPOSE 8093

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8093/health || exit 1

# Run the service
CMD ["python", "phase47_graph_analyzer.py"]