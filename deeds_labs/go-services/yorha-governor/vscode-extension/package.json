{
  "name": "yorha-ui-governor",
  "displayName": "YorHa UI Governor",
  "description": "AI-powered UI governance and code quality enforcement for Svelte applications",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:svelte",
    "onLanguage:typescript",
    "onCommand:yorha.fixRunes",
    "onCommand:yorha.inspect"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "yorha.fixRunes",
        "title": "YorHa: Fix Svelte Runes"
      },
      {
        "command": "yorha.inspect",
        "title": "YorHa: Inspect UI Compliance"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "yorha.fixRunes",
          "when": "resourceExtname == .svelte"
        },
        {
          "command": "yorha.inspect",
          "when": "resourceExtname == .svelte"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "acorn": "^8.8.2",
    "acorn-walk": "^8.2.0",
    "fast-glob": "^3.2.12"
  }
}