{
  "name": "sveltekit-evidence",
  "version": "0.1.0",
  "description": "Streamlined evidence board application with Fabric.js canvas and AI-powered case analysis",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:ultra-fast": "svelte-check --tsconfig ./tsconfig.json --skip-diagnostic-sources",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/fabric": "^5.3.0",
    "@types/file-saver": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.30.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^3.6.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.4.20"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.15.5",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.44.5",
    "fabric": "^5.3.0",
    "file-saver": "^2.0.5",
    "nes.css": "^2.3.0",
    "postgres": "^3.4.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/sveltekit-evidence.git"
  },
  "keywords": [
    "sveltekit",
    "evidence",
    "fabric.js",
    "canvas",
    "legal",
    "investigation",
    "ai",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT"
}
