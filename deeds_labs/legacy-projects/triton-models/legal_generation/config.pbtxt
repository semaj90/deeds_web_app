# Triton Model Configuration for Legal Text Generation
# Optimized for Gemma-3 legal model with TensorRT backend

name: "legal_generation"
backend: "tensorrt"
max_batch_size: 8  # Smaller batch for generation tasks
platform: "tensorrt_plan"

# Model versioning
version_policy: { latest { num_versions: 1 } }

# Input tensors for legal text generation
input [
  {
    name: "input_ids"
    data_type: TYPE_INT32
    dims: [ -1 ]  # Dynamic sequence length
    allow_ragged_batch: true
    optional: false
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT32
    dims: [ -1 ]
    allow_ragged_batch: true
    optional: true
  },
  {
    name: "max_length"
    data_type: TYPE_INT32
    dims: [ 1 ]
    optional: true
    reshape: { shape: [ ] }
  }
]

# Output logits for text generation
output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ -1, 256000 ]  # Gemma vocab size
  },
  {
    name: "generated_text"
    data_type: TYPE_STRING
    dims: [ -1 ]
  }
]

# TensorRT optimizations for text generation
optimization {
  priority: PRIORITY_MAX

  # Memory management for generation
  input_pinned_memory {
    enable: true
  }
  output_pinned_memory {
    enable: true
  }

  # GPU execution for generation models
  execution_accelerators {
    gpu_execution_accelerator : [ {
      name : "tensorrt"
      parameters { key: "precision_mode" value: "FP16" }
      parameters { key: "max_workspace_size_bytes" value: "4294967296" }  # 4GB for generation
      parameters { key: "minimum_segment_size" value: "3" }
      parameters { key: "max_cached_engines" value: "50" }
      parameters { key: "trt_engine_cache_enable" value: "1" }
      parameters { key: "trt_engine_cache_path" value: "/models/legal_generation/engine_cache" }
      parameters { key: "trt_fp16_enable" value: "1" }
      parameters { key: "trt_int8_enable" value: "0" }  # Disable INT8 for better quality
    }]
  }
}

# Sequence batching for text generation
sequence_batching {
  max_sequence_idle_microseconds: 5000000  # 5 seconds idle timeout
  control_input [
    {
      name: "START"
      control: [
        {
          kind: CONTROL_SEQUENCE_START
          fp32_false_true: [ 0, 1 ]
        }
      ]
    },
    {
      name: "END"
      control: [
        {
          kind: CONTROL_SEQUENCE_END
          fp32_false_true: [ 0, 1 ]
        }
      ]
    },
    {
      name: "READY"
      control: [
        {
          kind: CONTROL_SEQUENCE_READY
          fp32_false_true: [ 0, 1 ]
        }
      ]
    }
  ]

  # Batching strategy for legal text generation
  oldest {
    max_candidate_sequences: 4
    preferred_batch_size: [ 1, 2, 4 ]
    max_queue_delay_microseconds: 1000  # 1ms queue delay
  }
}

# Instance group optimized for generation workloads
instance_group [
  {
    count: 1  # Single instance for generation to avoid conflicts
    kind: KIND_GPU
    gpus: [ 0 ]
    profile: [ "legal_generation_profile" ]
  }
]

# Model warmup for legal generation patterns
model_warmup [
  {
    name: "legal_prompt_warmup"
    batch_size: 1
    inputs: {
      key: "input_ids"
      value: {
        data_type: TYPE_INT32
        dims: [ 128 ]
        zero_data: false
        random_data: true
      }
    }
    inputs: {
      key: "attention_mask"
      value: {
        data_type: TYPE_INT32
        dims: [ 128 ]
        zero_data: false
        random_data: true
      }
    }
    inputs: {
      key: "max_length"
      value: {
        data_type: TYPE_INT32
        dims: [ 1 ]
        int_contents: [ 256 ]
      }
    }
  }
]

# Response cache disabled for generation (non-deterministic)
response_cache {
  enable: false
}

# Legal generation metadata
parameters: {
  key: "legal_model_type"
  value: { string_value: "generation" }
}
parameters: {
  key: "base_model"
  value: { string_value: "gemma3-legal-latest" }
}
parameters: {
  key: "max_generation_length"
  value: { string_value: "2048_tokens" }
}
parameters: {
  key: "legal_specialization"
  value: { string_value: "contract_drafting,case_analysis,legal_research" }
}