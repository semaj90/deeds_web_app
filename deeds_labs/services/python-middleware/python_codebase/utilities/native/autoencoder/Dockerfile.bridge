FROM nvcr.io/nvidia/pytorch:23.09-py3

LABEL org.opencontainers.image.title="Phase H Analytics Bridge (GPU)"
WORKDIR /app

# Install minimal system deps
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python deps
COPY native/autoencoder/requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy application sources
COPY native/autoencoder /app/native/autoencoder
RUN chmod -R a+rX /app/native/autoencoder

# Create a non-root user for security
RUN useradd -m appuser || true
USER appuser

ENV PYTHONPATH=/app
EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8001/health || exit 1

CMD ["uvicorn", "native.autoencoder.analytics_bridge:app", "--host", "0.0.0.0", "--port", "8001"]
