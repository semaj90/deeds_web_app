name: "adaptive_adapters"
platform: "python"
max_batch_size: 8
input [
  {
    name: "INPUT_IDS"
    data_type: TYPE_INT32
    dims: [ -1 ]
  }
]
output [
  {
    name: "LOGITS"
    data_type: TYPE_FP32
    dims: [ -1, -1 ]
  }
]
parameters: {
  key: "adapter_manifest"
  value: {
    string_value: "adapters/manifest.json"
  }
}
