name: "autoencoder"
backend: "python"
max_batch_size: 8

input {
  name: "INPUT"
  data_type: TYPE_FP32
  dims: [ -1 ]
}

output {
  name: "RECONSTRUCTION"
  data_type: TYPE_FP32
  dims: [ -1 ]
}

output {
  name: "LATENT"
  data_type: TYPE_FP32
  dims: [ -1 ]
}

instance_group {
  kind: KIND_GPU
}

parameters {
  key: "EXECUTION_ENV_PATH"
  value { string_value: "python" }
}

