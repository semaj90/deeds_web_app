{
  "version": "1.0",
  "precision": "int4_awq",
  "weight_only_precision": "int4_awq",
  "max_num_tokens": 4096,
  "max_batch_size": 1,
  "max_input_len": 2048,
  "max_seq_len": 4096,
  "max_beam_width": 1,
  "opt_num_tokens": {
    "batch_size": 1,
    "input_len": 512,
    "output_len": 512
  },
  "kv_cache_type": "paged",
  "multiple_profiles": true,
  "enable_remove_input_padding": true,
  "dtype": "float16",
  "use_gemm_plugin": "auto",
  "use_gpt_attention_plugin": "float16",
  "paged_kv_cache": "enable",
  "per_group": true,
  "group_size": 128,
  "int8_kv_cache": true
}