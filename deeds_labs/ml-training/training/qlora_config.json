{
  "epochs": 3,
  "batch_size": 4,
  "gradient_accumulation": 2,
  "learning_rate": 2e-4,
  "max_length": 512,
  "lora_rank": 64,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
  "warmup_steps": 100,
  "weight_decay": 0.01,
  "save_steps": 500,
  "eval_steps": 500,
  "logging_steps": 10,
  "fp16": true,
  "gradient_checkpointing": true,
  "optim": "adamw_torch"
}