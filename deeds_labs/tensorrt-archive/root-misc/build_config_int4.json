{
  "max_input_len": 2048,
  "max_seq_len": 4096,
  "max_batch_size": 1,
  "max_beam_width": 1,
  "max_num_tokens": 4096,
  "opt_num_tokens": 2048,

  "precision": {
    "weight_only_precision": "int4",
    "logits_dtype": "float16",
    "enable_fp16_qdq": true
  },

  "kv_cache": {
    "paged_kv_cache": true,
    "use_paged_context_fmha": true,
    "context_fmha": true
  },

  "model_config": {
    "sliding_window_pattern": [4096]
  },

  "opt": {
    "builder_opt": [
      "memory_pool_limit:workspace=4096MiB",
      "hardware_compatibility_level=ampere_plus"
    ],
    "embed_ptx": true,
    "multiple_profiles": false
  },

  "input": {
    "enable_remove_input_padding": true
  }
}