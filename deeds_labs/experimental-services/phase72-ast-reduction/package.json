  "description": "Phase 72: Self-healing AST error reduction pipeline",
  "main": "phase72-orchestrator.ts",
  "type": "module",
  "scripts": {
    "start": "node phase72-orchestrator.ts run",
    "init": "node phase72-orchestrator.ts init",
