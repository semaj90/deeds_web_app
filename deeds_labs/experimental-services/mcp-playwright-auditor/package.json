{
  "name": "mcp-playwright-auditor",
  "version": "1.0.0",
  "description": "MCP Playwright UI Auditor for SvelteKit frontend testing and route crawling",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp": "node --loader ts-node/esm src/index.ts",
    "server": "npm run build && node dist/index.js --server",
    "dev": "ts-node --esm src/index.ts",
    "test": "playwright test",
    "audit": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "playwright": "^1.40.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "ws": "^8.14.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "puppeteer": "^21.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@playwright/test": "^1.40.0"
  }
}