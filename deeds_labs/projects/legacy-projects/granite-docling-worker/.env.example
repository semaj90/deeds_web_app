# Granite-Docling Worker Configuration
# Copy this file to .env and update values for your environment

# Application settings
DEBUG=false
LOG_LEVEL=INFO

# MinIO settings
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false
MINIO_PARALLEL_STREAMS=4

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10
REDIS_CACHE_TTL=604800

# GPU settings
GPU_ENABLED=true
GPU_DEVICE_ID=0
GPU_MEMORY_FRACTION=0.8
GPU_BATCH_SIZE=32
GPU_TIMEOUT_MS=500

# CPU settings
CPU_BATCH_SIZE=16
CPU_THREADS=4
CPU_FALLBACK_DELAY_MS=500

# Processing settings
WORKER_THREADS=12
BATCH_SIZE=32
PAGE_CLASSIFIER_CONFIDENCE_THRESHOLD=0.8
HEAVY_ROI_CONFIDENCE_THRESHOLD=0.7

# Tesseract settings
TESSERACT_PATH=tesseract
TESSERACT_THREADS=4
TESSERACT_OEM=3
TESSERACT_PSM=3

# Granite-Docling settings
GRANITE_MODEL_PATH=ibm/granite-docling-258m
GRANITE_MAX_IMAGE_SIZE=768

# Chunking settings
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
CHUNKER_WORKERS=4

# RAG settings
EMBEDDING_MODEL=sentence-transformers/legal-bert-base-uncased
BM25_K1=1.5
BM25_B=0.75
R2_WEIGHT=0.3
R3_WEIGHT=0.7

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Dashboard integration
DASHBOARD_SSE_ENDPOINT=http://localhost:3000/api/document-processing/stream
DASHBOARD_AUTH_TOKEN=

# TensorRT settings
TENSORRT_ENABLED=false
TENSORRT_ENGINE_PATH=

# Windows-specific settings
WINDOWS_NATIVE_BUILD=true
USE_WSL2=false
