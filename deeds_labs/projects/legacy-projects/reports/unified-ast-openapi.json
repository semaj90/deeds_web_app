{
  "openapi": "3.0.0",
  "info": {
    "title": "Unified AST Graph API",
    "version": "1.0.0",
    "description": "Multi-language AST error analysis and fix recommendation system"
  },
  "servers": [
    {
      "url": "http://localhost:5175",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/unified-ast/query": {
      "post": {
        "summary": "Query unified AST graph across TypeScript, Go, and Python errors",
        "operationId": "unified_ast_query",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Search query"
                  },
                  "languages": {
                    "type": "array",
                    "description": ""
                  },
                  "limit": {
                    "type": "integer",
                    "description": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/api/unified-ast/similarity": {
      "post": {
        "summary": "Find similar errors across different programming languages",
        "operationId": "cross_language_similarity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "error_message": {
                    "type": "string",
                    "description": ""
                  },
                  "source_language": {
                    "type": "string",
                    "description": ""
                  },
                  "target_languages": {
                    "type": "array",
                    "description": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/unified-ast/cuda-priority": {
      "post": {
        "summary": "GPU-accelerated computation of optimal error fix order using CUDA PageRank",
        "operationId": "cuda_fix_priority",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cluster_id": {
                    "type": "integer",
                    "description": ""
                  },
                  "algorithm": {
                    "type": "string",
                    "description": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/api/unified-ast/glyph": {
      "get": {
        "summary": "Query Redis for cached glyph tensor metadata",
        "operationId": "glyph_metadata",
        "requestBody": null,
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/unified-ast/neo4j-graph": {
      "post": {
        "summary": "Visualize cross-language dependency graph from Neo4j",
        "operationId": "neo4j_dependency_graph",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "start_node": {
                    "type": "string",
                    "description": ""
                  },
                  "depth": {
                    "type": "integer",
                    "description": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/unified-ast/recommend": {
      "post": {
        "summary": "Get AI-generated fix recommendations for specific error types",
        "operationId": "agentic_recommendation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "description": ""
                  },
                  "error_type": {
                    "type": "string",
                    "description": ""
                  },
                  "context": {
                    "type": "object",
                    "description": "Additional context (file path, line number, etc.)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/unified-ast/batch-analyze": {
      "post": {
        "summary": "Analyze multiple errors in batch for efficiency",
        "operationId": "batch_error_analysis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "error_ids": {
                    "type": "array",
                    "description": "List of error IDs to analyze"
                  },
                  "analysis_type": {
                    "type": "string",
                    "description": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/unified-ast/redis-stats": {
      "get": {
        "summary": "Get Redis cache statistics and performance metrics",
        "operationId": "redis_cache_stats",
        "requestBody": null,
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/unified-ast/health": {
      "get": {
        "summary": "Check health status of all unified AST graph components",
        "operationId": "system_health_check",
        "requestBody": null,
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}