{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start SIMD JSON Parser Service",
      "type": "shell",
      "command": "python",
      "args": ["python/simd_parser_service.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Install SIMD Parser Dependencies",
      "type": "shell",
      "command": "pip",
      "args": ["install", "-r", "python/requirements.txt"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Test SIMD Parser Health",
      "type": "shell",
      "command": "curl",
      "args": ["-s", "http://localhost:8097/health"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}