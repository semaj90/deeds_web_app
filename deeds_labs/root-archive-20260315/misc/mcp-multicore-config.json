{
  "mcp": {
    "multicore": {
      "enabled": true,
      "workers": 4,
      "autoRestart": true,
      "healthCheck": true
    },
    "gpu": {
      "acceleration": true,
      "device": "RTX_3060_TI",
      "optimization": true,
      "memoryLimit": "8GB"
    },
    "context7": {
      "multicore": true,
      "autoSolve": true,
      "integration": "vscode-tasks",
      "errorCapture": true
    },
    "integration": {
      "vscode": {
        "enabled": true,
        "taskRunner": "powershell",
        "autoLaunch": false,
        "notifications": true
      },
      "redis": {
        "host": "localhost",
        "port": 6379,
        "password": "redis",
        "errorLogging": true
      },
      "minio": {
        "endpoint": "localhost:9000",
        "accessKey": "minioadmin",
        "secretKey": "minioadmin",
        "useSSL": false,
        "simdService": "http://localhost:8096"
      },
      "simd": {
        "host": "localhost",
        "port": 8096,
        "url": "http://localhost:8096"
      },
      "endpoints": {
        "health": "/mcp/health",
        "metrics": "/mcp/metrics",
        "workers": "/mcp/workers",
        "solve": "/mcp/solve",
        "simd": "http://localhost:8096",
        "minioChunks": "http://localhost:8096/api/chunks",
        "minioEvidence": "http://localhost:8096/api/evidence",
        "minioManifest": "http://localhost:8096/api/manifest"
      }
    },
    "performance": {
      "cpuCores": 4,
      "memoryLimit": "8GB",
      "workerTimeout": 30000,
      "batchSize": 10
    },
    "logging": {
      "level": "info",
      "file": "logs/mcp-multicore.log",
      "console": true,
      "timestamps": "YYYY-MM-DD HH:mm:ss"
    }
  }
}