{
  "name": "ts-ast-autofixer",
  "version": "1.0.0",
  "description": "TypeScript AST analysis and automated fixing system with Svelte patcher",
  "main": "dist/index.js",
  "bin": {
    "ts-ast-fix": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "typescript": "^5.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "glob": "^10.0.0",
    "chokidar": "^3.5.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "ws": "^8.14.0",
    "axios": "^1.6.0",
    "chalk": "^5.0.0",
    "ora": "^7.0.0",
    "inquirer": "^9.0.0",
    "fs-extra": "^11.0.0",
    "ignore": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/glob": "^8.0.0",
    "@types/cors": "^2.8.0",
    "@types/ws": "^8.5.0",
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "ts-node": "^10.9.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}