# Phase 70: TensorRT-LLM Service Dockerfile
FROM nvcr.io/nvidia/tensorrt:24.01-py3

# Set working directory
WORKDIR /app

# Copy Python service
COPY python-services/tensorrt_llm_service.py /app/

# Install additional dependencies
RUN pip install --no-cache-dir fastapi uvicorn

# Create necessary directories
RUN mkdir -p /app/models /app/tensorrt_engines /app/tokenizers

# Expose port
EXPOSE 8099

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8099/health || exit 1

# Run service
CMD ["python", "tensorrt_llm_service.py"]