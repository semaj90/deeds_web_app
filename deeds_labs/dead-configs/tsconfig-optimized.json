{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitOverride": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "suppressImplicitAnyIndexErrors": true,
    "suppressExcessPropertyErrors": true,
    "types": ["svelte", "vite/client", "@sveltejs/kit"],
    "lib": ["es2022", "DOM"],
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "isolatedModules": true,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,

    // Memory optimization settings
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "disableSizeLimit": false,
    "assumeChangesOnlyAffectDirectDependencies": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte"
  ],
  "exclude": [
    "node_modules/**",
    "build/**",
    ".svelte-kit/**",
    "dist/**",
    "archived-components/**",
    "src/tests/**",
    "src/stories/**",
    "src/lib/experimental/**",
    "src/lib/server/thread-safe-postgres.ts",
    "src/lib/server/gpu-thread-coordinator.ts",
    "src/lib/services/gpu-cache-orchestrator.ts",
    "src/lib/server/concurrent-json-serializer.ts",
    "src/lib/services/cognitive-cache-integration.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.d.ts",
    "**/logs/**",
    "**/coverage/**",
    "**/tmp/**"
  ],
  "typeAcquisition": {
    "enable": false,
    "include": [],
    "exclude": ["*"]
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}