    {
      "chunkId": "doc:sveltekit:62e6dd9932a74b58:15",
      "claimOrdinal": 1,
      "claim": "When multiple `load` functions return data with the same key, the last one wins, so a layout `load` returning `{ a: 1, b: 2 }` combined with a page `load` returning `{ b: 3, c: 4 }` results in `{ a: 1, b: 3, c: 4 }`.",
      "deterministicStatuses": {
        "technical": "PASS",
        "numeric": "PASS",
        "version": "PASS"
