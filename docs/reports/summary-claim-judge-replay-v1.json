    {
      "chunkId": "doc:sveltekit:62e6dd9932a74b58:15",
      "claimOrdinal": 0,
      "claim": "In SvelteKit, layout `load` functions can provide data to child pages, which is accessible via the `data` prop in the page component.",
      "deterministicStatuses": {
        "technical": "PASS",
        "numeric": "PASS",
        "version": "PASS"
      },
      "judgeInputChecksum": "ec1fc8fb7628c761e2f76d1738552f3631c4b35c7eb728cd692931956d7c6fe5",
