    {
      "chunkId": "doc:sveltekit:7eecebe5e0d7481c:19",
      "claimOrdinal": 0,
      "claim": "SvelteKit reuses existing layout and page components when navigating between routes, so the `data` prop updates rather than the components being recreated.",
      "deterministicStatuses": {
        "technical": "PASS",
        "numeric": "PASS",
        "version": "PASS"
