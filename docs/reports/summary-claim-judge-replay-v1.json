    {
      "chunkId": "doc:svelte5-runes:4606958abe2e620d:13",
      "claimOrdinal": 0,
      "claim": "The `$effect` automatically tracks reactive values (`$state`, `$derived`, `$props`) that are synchronously read inside its function body and schedules a re-run when they change.",
      "deterministicStatuses": {
        "technical": "PASS",
        "numeric": "PASS",
        "version": "PASS"
      },
      "judgeInputChecksum": "9718bcf6612aa68dd85308468bba74ee7fcb5cca146e2d8ddb172f20a2116633",
