    {
      "chunkId": "doc:sveltekit:7eecebe5e0d7481c:19",
      "claimOrdinal": 1,
      "claim": "Because the code doesn't rerun, lifecycle methods like `onMount` and `onDestroy` won't rerun and values like `estimatedReadingTime` won't be recalculated.",
      "deterministicStatuses": {
        "technical": "PASS",
        "numeric": "PASS",
        "version": "PASS"
