      "chunkId": "doc:postgresql-18:38d5e74bafb89df8:10",
      "claimOrdinal": 0,
      "claim": "PostgreSQL 18 adds an asynchronous I/O subsystem that lets backends queue multiple read requests for more efficient sequential scans, bitmap heap scans, and vacuums, controlled by the server variables `io_method`, `io_combine_limit`, and `io_max_combine_limit`, while also enabling `effective_io_concurrency` and `maintenance_io_concurrency` values greater than zero on systems without `fadvise()` support and exposing file handles through the new system view `pg_aios`.",
      "deterministicStatuses": {
        "technical": "PASS",
        "numeric": "PASS",
        "version": "PASS"
      },
      "judgeInputChecksum": "a891946bb95fbc2118857fed8b069916710730388eb938410d599f4423722ce1",
