      "unsupportedFragment": null
    },
    {
      "chunkId": "doc:svelte5-runes:4606958abe2e620d:13",
      "claimOrdinal": 1,
      "claim": "Values read asynchronously—after an `await` or inside a `setTimeout`—are not tracked, and `$state`/`$derived` used directly inside the `$effect` are not treated as dependencies.",
      "deterministicStatuses": {
        "technical": "PASS",
        "numeric": "PASS",
        "version": "PASS"
      },
      "judgeInputChecksum": "5dda63712f152af4545c22e24ac3b426b689e004f8649fd6f28aed8ec0071011",
      "verdict": "SUPPORTED",
      "status": "JUDGED",
      "unsupportedFragment": null
    },
    {
      "chunkId": "doc:svelte5-runes:4606958abe2e620d:13",
      "claimOrdinal": 2,
      "claim": "The effect runs after the DOM is updated, does not run during server-side rendering, and any returned cleanup function is called before the effect re-runs or when the component unmounts.",
      "deterministicStatuses": {
        "technical": "PASS",
        "numeric": "PASS",
        "version": "PASS"
