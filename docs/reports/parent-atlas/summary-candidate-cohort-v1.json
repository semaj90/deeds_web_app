    },
    {
      "schema": "atlas.summary-candidate.v1",
      "chunkId": "doc:sveltekit:7eecebe5e0d7481c:20",
      "chunkEvidenceRevision": "sha256:c6fbdca5bcbaa86c6974834dc4b8a959ac7da79de4ad2fd6e60f8cf4249398f3",
      "identityVersion": "external-doc-chunk-id:v1",
