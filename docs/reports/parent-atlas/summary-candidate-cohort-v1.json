      "promptRevision": "external-doc-summary-prompt-v1@sha256:0a0ad1dc8ca62272901f0858243da78a736b81fe5f4e55a9d222a79eaf7486bb",
      "inputChecksum": "c0abddf6695733e10d7cf2217f83d4657b7f612f66b6edaa31da0b00f8b3ff56",
      "summaryText": "SvelteKit preserves component and page state across navigation, so reactive values like `$derived` calculations remain intact when components are reused. If code in `onMount` or `onDestroy` needs to run again after navigation, you can use `afterNavigate` and `beforeNavigate` respectively. To completely destroy and remount a component on navigation, wrap it in a `{#key page.url.pathname}` block.",
      "outputChecksum": "89b26e1e2c643ead34c7efeaec4e9252e8ab20419d3187b6f65ea3d8be5cefae",
