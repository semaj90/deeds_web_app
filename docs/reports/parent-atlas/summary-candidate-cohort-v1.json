      "chunkEvidenceRevision": "sha256:3802f9585429d798009f484d06e598c0b2531df5579a0ce066bc5d2a5ee5e5db",
      "identityVersion": "external-doc-chunk-id:v1",
      "producerId": "atlas-external-doc-summarizer",
