        "claimList": [
          {
            "claimOrdinal": 0,
            "claimText": "This chunk explains how to index nearest neighbor queries that include a `WHERE` clause.",
            "claimChecksum": "f62f1ff1cfeef00ea797f65c37855686dcb13d2e1232985fdf07768cb5fc79f3"
          },
          {
            "claimOrdinal": 1,
            "claimText": "It recommends creating an index on the filter column, noting that Postgres supports B-tree, hash, GiST, SP-GiST, GIN, and BRIN index types, and that multicolumn indexes can cover multiple columns.",
            "claimChecksum": "3fdeab111632b87024b296cf29421fe2b71512f22980b56367312de9472b6ed5"
          },
          {
            "claimOrdinal": 2,
            "claimText": "For low-selectivity filters, exact indexes work well, but approximate indexes like HNSW may perform better, with filtering applied after the index scan.",
            "claimChecksum": "620257a51058d0a9431a08461531e885761a1825f05b9744a7bcd14358c0fde4"
          },
          {
            "claimOrdinal": 3,
            "claimText": "To handle cases where few rows match, you can enable iterative index scans by setting `hnsw.iterative_scan = strict_order`.",
            "claimChecksum": "a5526c72ba7708b41804075e3a980e6819632d6b0602600ef1bb6dcd7323b46a"
          },
          {
            "claimOrdinal": 4,
            "claimText": "For filtering by a few distinct values, partial indexing is suggested, while partitioning is recommended when filtering by many different values.",
            "claimChecksum": "1845d0f74c07050d3d129efb70c30d9cff0a70a66d23a9e6ab12447a0989920d"
          }
        ],
