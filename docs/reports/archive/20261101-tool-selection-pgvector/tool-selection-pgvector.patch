+// Ranking source #1: pgvector atlas_tool_manifest_vectors_v1 (real embeddinggemma vectors; live_surface = discoverable on atlas-tools/TRACE).
+// Returns [] on any failure so the caller falls back to Qdrant, then to FALLBACK_TOOLS.
+async function searchToolManifestPg(
+  vector: number[],
+  topK: number
+): Promise<Array<{ tool_name: string; score: number }>> {
+  try {
+    const { db } = await import('$lib/server/db/client');
+    const { sql } = await import('drizzle-orm');
+    const vectorLiteral = `[${vector.join(',')}]`;
+    const rows = (await db.execute(
+      sql`SELECT tool_name, 1 - (embedding <=> ${vectorLiteral}::vector) AS score
+          FROM public.atlas_tool_manifest_vectors_v1
+          WHERE payload->>'live_surface' = 'true'
+          ORDER BY embedding <=> ${vectorLiteral}::vector
+          LIMIT ${topK * 2}`
+    )) as unknown as Array<{ tool_name: string; score: number | string }>;
+    return rows.map((r) => ({ tool_name: String(r.tool_name), score: Number(r.score) })).slice(0, topK);
+  } catch {
+    return [];
+  }
+}
