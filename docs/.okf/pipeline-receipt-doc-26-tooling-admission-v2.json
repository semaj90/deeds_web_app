        {
          "chunkId": "doc:oaklib:ed40c186e3c59c11:1",
          "ordinal": 1,
          "headingPath": [
            "search datamodel "
          ],
          "sectionAnchor": "search datamodel ",
          "startChar": 569,
          "endChar": 1058,
          "startByte": 571,
          "endByte": 1060,
          "text": "A datamodel for representing a search configuration and results.\nThis is intended to provide a unified layer over both:\n(a) how searches are\nparameterized\n(b) the structure of search\nresults\n.\nThe scope is any kind of service that provides search over\nnamed entities\n, including ontology concepts. It is not intended to cover generic\nsearch results, e.g. google search, although parts could be generalized for this purpose.\nURI: https://w3id.org/oak/search-datamodel\nName: search-datamodel",
          "domainClass": "graph",
          "ontologyClasses": [
            "RETRIEVAL"
          ],
          "codeBlocks": [],
