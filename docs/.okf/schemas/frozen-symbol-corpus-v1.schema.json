{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:frozen-symbol-corpus:v1",
  "title": "Frozen local symbol observation corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "canonicalAuthority", "workspaceRevision", "trainingEligible", "inputs", "taskRef", "symbols"],
  "properties": {
    "schema": { "const": "atlas.frozen-symbol-corpus.v1" },
    "status": { "const": "PROPOSAL_ONLY" },
    "canonicalAuthority": { "const": false },
    "workspaceRevision": { "type": "null" },
    "trainingEligible": { "const": false },
    "inputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/digest" },
      "required": ["routePlanSha256", "workboardSha256", "ontologySha256", "languageProfileSha256"]
    },
    "taskRef": {
      "type": "object", "additionalProperties": false,
      "required": ["logicalTaskKey", "sourceRef", "sourceFileSha256", "taskRevision"],
      "properties": {
        "logicalTaskKey": { "$ref": "#/$defs/text" }, "sourceRef": { "$ref": "#/$defs/text" },
        "sourceFileSha256": { "$ref": "#/$defs/digest" }, "taskRevision": { "$ref": "#/$defs/digest" }
      }
    },
    "symbols": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/symbol" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "route", "method", "featureLabel", "file", "sourceSha256", "startByte", "endByte", "spanSha256", "parser", "languageId", "lspStatus", "proposedOboIds"],
      "properties": {
        "role": { "enum": ["FIXTURE_ROUTE", "EXISTING_CONTROL"] },
        "route": { "type": "string", "pattern": "^/api/[^?#]+$" }, "method": { "enum": ["GET", "POST"] },
        "featureLabel": { "$ref": "#/$defs/text" }, "file": { "$ref": "#/$defs/text" },
        "sourceSha256": { "$ref": "#/$defs/digest" }, "spanSha256": { "$ref": "#/$defs/digest" },
        "startByte": { "type": "integer", "minimum": 0 }, "endByte": { "type": "integer", "minimum": 1 },
        "parser": { "type": "string", "pattern": "^typescript@[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "languageId": { "const": "typescript" }, "lspStatus": { "const": "NOT_OBSERVED" },
        "proposedOboIds": { "const": ["ATLASLANG:typescript", "ATLASDOM:frontend.sveltekit"] }
      }
    }
  }
}
