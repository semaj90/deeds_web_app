{
  "tier1": [
    {
      "sourceId": "sveltekit",
      "title": "SvelteKit Documentation",
      "version": "2",
      "baseUrl": "https://kit.svelte.dev/docs",
      "kind": "framework_docs",
      "licensePolicy": "respect_site_terms",
      "crawlDepth": 3,
      "include": ["/docs"],
      "exclude": ["/blog", "/showcase"],
      "topics": ["routing", "load", "actions", "hooks", "adapters"],
      "trustTier": "official_docs"
    },
    {
      "sourceId": "svelte",
      "title": "Svelte 5 Documentation",
      "version": "5",
      "baseUrl": "https://svelte.dev/docs",
      "kind": "framework_docs",
      "licensePolicy": "respect_site_terms",
      "crawlDepth": 3,
      "include": ["/docs"],
      "exclude": ["/blog"],
      "topics": ["runes", "props", "events", "snippets"],
      "trustTier": "official_docs"
    },
    {
      "sourceId": "drizzle",
      "title": "Drizzle ORM",
      "version": "0.44",
      "baseUrl": "https://orm.drizzle.team/docs/overview",
      "kind": "orm_docs",
      "licensePolicy": "respect_site_terms",
      "crawlDepth": 3,
      "include": ["/docs"],
      "topics": ["schema", "queries", "migrations", "relations"],
      "trustTier": "official_docs"
    }
  ],
  "tier2": [
    {
      "sourceId": "webgpu",
      "title": "WebGPU / WGSL",
      "version": "1.0",
      "baseUrl": "https://www.w3.org/TR/webgpu/",
      "kind": "spec_docs",
      "licensePolicy": "open_standard",
      "crawlDepth": 2,
      "topics": ["render-pipeline", "compute-shader", "bind-groups"],
      "trustTier": "standard_body"
    },
    {
      "sourceId": "cuda",
      "title": "CUDA C++",
      "version": "12.4",
      "baseUrl": "https://docs.nvidia.com/cuda/",
      "kind": "vendor_docs",
      "licensePolicy": "nvidia_terms",
      "crawlDepth": 3,
      "topics": ["memory-management", "kernels", "streams"],
      "trustTier": "official_docs"
    }
  ]
}
