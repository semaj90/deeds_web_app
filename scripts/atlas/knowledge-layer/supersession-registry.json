{
  "schemaVersion": "atlas-supersession-v1",
  "lifecycleStates": {
    "ACTIVE": "canonical production implementation",
    "MIGRATION_CANDIDATE": "implementation suspected of having a replacement; retained and not safe to delete",
    "SUPERSEDED": "replacement proven and no production callers remain; retained until cleanup review",
    "QUARANTINED": "superseded artifact retained for historical or rollback reference",
    "DELETED": "removal explicitly approved after the quarantine/recovery window"
  },
  "promotionPolicy": {
    "migrationCandidateToSuperseded": [
      "canonical_replacement_exists",
      "all_live_callers_use_replacement",
      "behavioral_contract_tests_pass",
      "graphify_daily_no_longer_depends_on_artifact"
    ],
    "requiredEvidence": [
