      "ast_replacement_parity",
      "source_span_parity",
      "required_edge_parity",
      "canonical_identity_unchanged",
      "rollback_path_documented",
      "superseded_import_count_zero"
    ],
    "deletionRequires": [
      "superseded_state",
      "quarantine_or_recovery_window_complete",
      "digest_and_reason_recorded",
      "rollback_instructions_recorded"
    ]
  },
