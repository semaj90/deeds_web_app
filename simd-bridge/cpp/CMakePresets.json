{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 18 },
  "configurePresets": [
    {
      "name": "windows-cuda",
      "displayName": "Windows CUDA (RTX 3060 Ti, auto-detect libs)",
      "description": "Release x64: CUDA 13.0 SM86 + LibTorch 2.9 + cuBLAS + cuBLASLt. Paths auto-detected from env vars or well-known locations.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": { "value": "host=x64" },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_ARCHITECTURES": "86",
        "TORCH_CUDA_ARCH_LIST": "8.6",
        "CMAKE_CUDA_FLAGS": "-use_fast_math -lineinfo",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /arch:AVX2",
        "SIMD_ENABLE_CUDA": "ON",
        "SIMD_ENABLE_LIBTORCH": "ON",
        "SIMD_ENABLE_FALLBACK_STUBS": "ON",
        "SIMD_ENABLE_CUBLAS": "ON",
        "SIMD_ENABLE_CUBLASLT": "ON",
        "SIMD_ENABLE_CUDNN": "OFF",
        "SIMD_ENABLE_CUVS": "OFF",
        "SIMD_ENABLE_CUTLASS": "OFF"
      },
      "environment": {
        "LIBTORCH_ROOT": "C:/libtorch-win-shared-with-deps-2.9.0+cu130/libtorch"
      }
    },
