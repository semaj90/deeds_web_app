{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.nary-fact-proposal.v1",
  "title": "Parent Atlas N-ary Fact Proposal V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceRef",
    "sourceRevision",
    "workspaceRevision",
    "packetKey",
    "graphRevision",
    "producerRevision",
    "predicate",
    "participants",
    "evidenceRefs",
    "proposalChecksum",
    "canonicalAuthority",
    "admission"
  ],
  "properties": {
    "schema": { "type": "string", "const": "atlas.nary-fact-proposal.v1" },
    "sourceRef": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "workspaceRevision": { "type": "string", "minLength": 1 },
    "packetKey": { "type": "string", "minLength": 1 },
    "graphRevision": { "type": "string", "minLength": 1 },
    "producerRevision": { "type": "string", "minLength": 1 },
    "ontologyRevision": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "predicate": { "type": "string", "minLength": 1 },
    "predicatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "registryDocumentSha256", "registrySchemaSha256"],
      "properties": {
        "schema": { "type": "string", "const": "atlas.okf.predicate-policy-ref.v1" },
        "registryDocumentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "registrySchemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonicalId", "role", "entityType"],
        "properties": {
          "canonicalId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "ordinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "entityType": { "type": "string", "minLength": 1 },
          "entityRevision": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1 }
    },
    "proposalChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalAuthority": { "type": "boolean", "const": false },
    "admission": { "type": "string", "enum": ["PROPOSED", "ADMITTED", "REJECTED", "AMBIGUOUS"] }
  }
}
