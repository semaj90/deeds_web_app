{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parent-atlas.local/okf/schemas/domain-taxonomy-v1.schema.json",
  "title": "Parent Atlas domain taxonomy reference snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "domain_id", "name", "status", "owner", "purpose", "canonical_authority", "snapshot", "matching_policy", "ordinals", "legacy_label_crosswalk", "groups"],
  "properties": {
    "version": { "const": 1 },
    "domain_id": { "const": "atlas.domain-taxonomy" },
    "name": { "type": "string", "minLength": 1 },
    "status": { "const": "reference_snapshot" },
    "owner": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "canonical_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology_source", "rule", "canonical"],
      "properties": {
        "ontology_source": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "canonical": { "const": false }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "source_checksum", "captured_at"],
      "properties": {
        "source_file": { "type": "string", "minLength": 1 },
        "source_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "captured_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "matching_policy": { "type": "string", "minLength": 1 },
    "ordinals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rule"],
      "properties": { "status": { "enum": ["UNASSIGNED", "ASSIGNED"] }, "rule": { "type": "string" } }
    },
    "legacy_label_crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ref"],
      "properties": { "status": { "enum": ["PROPOSAL_NOT_APPLIED", "APPROVED"] }, "ref": { "type": "string" } }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "label", "parent_group_id", "taxonomy_level", "description"],
        "properties": {
          "group_id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*(?:\\.[a-z]+(?:-[a-z]+)*)?$" },
          "label": { "type": "string", "minLength": 1 },
          "parent_group_id": { "type": ["string", "null"] },
          "taxonomy_level": { "enum": [0, 1] },
          "description": { "type": "string" }
        }
      }
    }
  }
}
