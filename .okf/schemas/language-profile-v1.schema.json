{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.okf-language-profile.v1",
  "title": "Parent Atlas language syntax profile",
  "type": "object",
  "required": ["version", "language", "name", "extensions"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "language": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "extensions": {"$ref": "#/$defs/stringList"},
    "grammar": {"type": "string", "minLength": 1},
    "exclude_paths": {"$ref": "#/$defs/stringList"},
    "symbol_kinds": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {"^[a-z][a-z0-9_]*$": {"$ref": "#/$defs/symbolKind"}},
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "patternProperties": {"^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/featureRule"}},
      "additionalProperties": false
    },
    "validation": {"$ref": "#/$defs/validation"}
  },
  "anyOf": [
    {"required": ["grammar"]},
    {"required": ["exclude_paths", "symbol_kinds"]}
  ],
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidenceWeight": {"enum": ["low", "medium", "high"]},
    "symbolKind": {
      "type": "object",
      "required": ["weight", "description", "evidence_weight"],
      "additionalProperties": false,
      "properties": {
        "weight": {"type": "number", "minimum": 0, "maximum": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_weight": {"$ref": "#/$defs/evidenceWeight"},
        "ast_labels": {"$ref": "#/$defs/stringList"},
        "function_patterns": {"$ref": "#/$defs/stringList"},
        "class_patterns": {"$ref": "#/$defs/stringList"},
        "modifiers": {"$ref": "#/$defs/stringList"},
        "decorators": {"$ref": "#/$defs/stringList"},
        "base_classes": {"$ref": "#/$defs/stringList"},
        "imports": {"$ref": "#/$defs/stringList"},
        "attributes": {"$ref": "#/$defs/stringList"},
        "symbol_patterns": {"$ref": "#/$defs/stringList"},
        "path_patterns": {"$ref": "#/$defs/stringList"},
        "filename_patterns": {"$ref": "#/$defs/stringList"},
        "path_markers": {"$ref": "#/$defs/stringList"},
        "exclude_patterns": {"$ref": "#/$defs/stringList"},
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {"^[a-z][a-z0-9_]*$": {"$ref": "#/$defs/stringList"}},
          "additionalProperties": false
        }
      },
      "anyOf": [
        {"required": ["ast_labels"]},
        {"required": ["function_patterns"]},
        {"required": ["class_patterns"]},
        {"required": ["decorators"]},
        {"required": ["base_classes"]},
        {"required": ["attributes"]},
        {"required": ["symbol_patterns"]},
        {"required": ["path_patterns"]},
        {"required": ["filename_patterns"]},
        {"required": ["path_markers"]},
        {"required": ["evidence"]}
      ]
    },
    "featureRule": {
      "type": "object",
      "required": ["description", "evidence_weight"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "evidence_weight": {"$ref": "#/$defs/evidenceWeight"},
        "path_terms": {"$ref": "#/$defs/stringList"},
        "path_markers": {"$ref": "#/$defs/stringList"},
        "imports": {"$ref": "#/$defs/stringList"},
        "symbols": {"$ref": "#/$defs/stringList"}
      },
      "anyOf": [
        {"required": ["path_terms"]},
        {"required": ["path_markers"]},
        {"required": ["imports"]},
        {"required": ["symbols"]}
      ]
    },
    "validation": {
      "type": "object",
      "required": ["min_symbol_name_length", "max_symbol_name_length", "require_source_ref", "require_packet_key", "exclude_generated_markers"],
      "additionalProperties": false,
      "properties": {
        "min_symbol_name_length": {"type": "integer", "minimum": 1},
        "max_symbol_name_length": {"type": "integer", "minimum": 1},
        "require_source_ref": {"type": "boolean"},
        "require_packet_key": {"type": "boolean"},
        "exclude_generated_markers": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}
