{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atlas.parent-atlas-agentic-retrieval-corpus.v1",
  "title": "Parent Atlas agentic retrieval vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "type", "title", "status", "authority", "canonical_authority", "source_refs", "generated", "verified", "indexing", "entries"],
  "properties": {
    "schema": { "const": "atlas.parent-atlas-agentic-retrieval-corpus.v1" },
    "version": { "const": 1 },
    "id": { "const": "parent-atlas-agentic-retrieval-vocabulary" },
    "type": { "const": "corpus" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "reference_only" },
    "authority": { "const": "derived_reference" },
    "canonical_authority": { "const": false },
    "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "generated": {
      "type": "object", "additionalProperties": false,
      "required": ["by", "at"],
      "properties": { "by": { "type": "string", "minLength": 1 }, "at": { "type": "string", "format": "date" } }
    },
    "verified": {
      "type": "object", "additionalProperties": false,
      "required": ["by", "at"],
      "properties": { "by": { "type": "string", "minLength": 1 }, "at": { "type": "string", "format": "date" } }
    },
    "indexing": {
      "type": "object", "additionalProperties": false,
      "required": ["populated", "searchable", "qdrant_written", "admission_required"],
      "properties": {
        "populated": { "const": false },
        "searchable": { "const": false },
        "qdrant_written": { "const": false },
        "admission_required": { "const": true }
      }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "terms", "definition", "evidence_status", "source_refs", "retrieval_policy"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "terms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "definition": { "type": "string", "minLength": 1 },
          "evidence_status": { "type": "string", "minLength": 1 },
          "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "retrieval_policy": { "type": "string", "minLength": 1 },
          "mcp_surface": {
            "type": "object", "additionalProperties": false,
            "required": ["server_authority_id", "tool_surface_revision", "discovery_status", "captured_at", "tools"],
            "properties": {
              "server_authority_id": { "type": "string", "pattern": "^parent-atlas:mcp:[a-z0-9-]+$" },
              "tool_surface_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "discovery_status": { "const": "ALL_SERVERS_REACHABLE" },
              "captured_at": { "type": "string", "format": "date-time" },
              "tools": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["tool_name", "input_schema_digest", "output_schema_digest", "execution_metadata_digest", "invocation_verified"],
                  "properties": {
                    "tool_name": { "type": "string", "minLength": 1 },
                    "input_schema_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "output_schema_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
                    "execution_metadata_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
                    "invocation_verified": { "const": false }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
