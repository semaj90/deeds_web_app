{
  "name": "deeds-graph",
  "displayName": "Deeds — Codebase Graph",
  "description": "Codebase cluster graph with GPU-accelerated SOM/k-means — cached WebView",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deeds.showGraph",
        "title": "Deeds: Show Codebase Graph",
        "icon": "$(graph)"
      },
      {
        "command": "deeds.refreshGraph",
        "title": "Deeds: Refresh Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "deeds.createClaudePlan",
        "title": "Deeds: Create Claude Plan",
        "icon": "$(export)"
      },
      {
        "command": "deeds.askGemma4Selection",
        "title": "Deeds: Ask Gemma4 About Selection",
        "icon": "$(comment-discussion)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "deedsGraphTree",
          "name": "Deeds Clusters",
          "icon": "$(graph)",
          "contextualTitle": "Codebase Clusters"
        }
      ]
    },
    "menus": {
      "editor/title": [
        { "command": "deeds.showGraph", "group": "navigation" }
      ],
      "view/title": [
        {
          "command": "deeds.refreshGraph",
          "when": "view == deedsGraphTree",
          "group": "navigation"
        },
        {
          "command": "deeds.showGraph",
          "when": "view == deedsGraphTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "deeds.createClaudePlan",
          "when": "view == deedsGraphTree && viewItem == cluster",
          "group": "deeds@1"
        },
        {
          "command": "deeds.createClaudePlan",
          "when": "view == deedsGraphTree && viewItem == node",
          "group": "deeds@1"
        },
        {
          "command": "deeds.askGemma4Selection",
          "when": "view == deedsGraphTree && viewItem == cluster",
          "group": "deeds@2"
        }
      ],
      "editor/context": [
        {
          "command": "deeds.askGemma4Selection",
          "when": "editorHasSelection",
          "group": "deeds@1"
        },
        {
          "command": "deeds.createClaudePlan",
          "group": "deeds@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.118.0",
    "typescript": "^5.9.3"
  }
}
