# TensorRT-LLM Dockerfile — Gemma3 12B INT4 Engine Builder + Inference
# TRT-LLM v0.21.0+ (first version with Gemma3 VLM PyTorch backend support)
# Target: RTX 3060 Ti (8GB VRAM), INT4 AWQ quantization

FROM nvcr.io/nvidia/tensorrt-llm/release:v0.21.0

# Set working directory
WORKDIR /app

# Install dependencies for engine building + inference serving
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    transformers>=4.45.0 \
    pydantic==2.5.0 \
    httpx==0.25.2 \
    safetensors \
    redis==5.0.1 \
    requests==2.31.0

# Copy converter script for HF → TRT-LLM tensor remapping
COPY hf_to_trt_gemma3_rank0.py /app/hf_to_trt_gemma3_rank0.py
COPY validate_safetensors.py /app/validate_safetensors.py

# Create directories for model artifacts
RUN mkdir -p /models/input /models/checkpoint /models/engine_int4

# Set environment variables
ENV PYTHONPATH=/app
ENV CUDA_VISIBLE_DEVICES=0
ENV CUDA_DEVICE_MAX_CONNECTIONS=1
ENV TOKENIZERS_PARALLELISM=false

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import tensorrt_llm; print('TensorRT-LLM OK')" || exit 1

# Default: interactive shell for engine building
CMD ["bash"]