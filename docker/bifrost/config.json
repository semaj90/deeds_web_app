{
  "version": 1,
  "vector_store": {
    "enabled": true,
    "type": "qdrant",
    "config": {
      "host": "172.18.0.5",
      "port": 6334
    }
  },
  "plugins": [
    {
      "enabled": false,
      "name": "semantic_cache",
      "config": {
        "default_cache_key": "global",
        "provider": "ollama",
        "embedding_model": "embeddinggemma:latest",
        "dimension": 768,
        "cleanup_on_shutdown": false,
        "ttl": "2h",
        "threshold": 0.82,
        "conversation_history_threshold": 3,
        "exclude_system_prompt": false,
        "cache_by_model": true,
        "cache_by_provider": true
      }
    }
  ],
  "client": {
    "enable_logging": true,
    "disable_content_logging": false,
    "log_retention_days": 7
  },
  "providers": {
    "ollama": {
      "network_config": {
        "base_url": "http://host.docker.internal:11434"
      },
      "keys": [
        {
          "name": "ollama-key",
          "value": "dummy-key",
          "weight": 1.0,
          "models": [
            "*"
          ],
          "ollama_key_config": {
            "url": "http://host.docker.internal:11434"
          }
        }
      ]
    }
  }
}
