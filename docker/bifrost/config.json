{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 1,
  "vector_store": {
    "enabled": true,
    "type": "qdrant",
    "config": {
      "host": "qdrant",
      "port": 6334
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "semantic_cache",
      "config": {
        "default_cache_key": "global",
        "provider": "ollama",
        "embedding_model": "embeddinggemma:latest",
        "dimension": 768,
        "ttl": "2h",
        "threshold": 0.82,
        "conversation_history_threshold": 3,
        "exclude_system_prompt": false,
        "cache_by_model": true,
        "cache_by_provider": true
      }
    }
  ],
  "client": {
    "enable_logging": true,
    "disable_content_logging": false,
    "log_retention_days": 7
  },
  "providers": {
    "ollama": {
      "keys": [
        {
          "name": "ollama-key",
          "value": "",
          "weight": 1.0,
          "models": [
            "*"
          ],
          "ollama_key_config": {
            "url": "http://host.docker.internal:11434"
          }
        }
      ],
      "network_config": {
        "base_url": "http://host.docker.internal:11434",
        "default_request_timeout_in_seconds": 180,
        "max_retries": 1,
        "retry_backoff_initial": 5000,
        "retry_backoff_max": 10000
      }
    },
    "openai": {
      "keys": [
        {
          "name": "turboquant-local",
          "value": "local",
          "weight": 1,
          "models": [
            "gemma4-rotorquant:latest",
            "gemma4-legal-vlm:latest",
            "gemma3-legal:latest"
          ]
        }
      ],
      "network_config": {
        "base_url": "http://host.docker.internal:8090/v1",
        "default_request_timeout_in_seconds": 180,
        "max_retries": 1,
        "retry_backoff_initial": 5000,
        "retry_backoff_max": 10000
      }
    }
  }
}
