<clickhouse>
    <!-- Bound server log files: 3 rotated files of 100 MB (was unbounded, ~1.6 GB on disk) -->
    <logger>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- Disable high-volume diagnostic tables with no consumer in this repo (trace_log 7 GB,
         asynchronous_metric_log 1.4 GB / 2.7 B rows). Existing data is handled separately. -->
    <trace_log remove="1"/>
    <asynchronous_metric_log remove="1"/>

    <!-- Keep remaining diagnostic tables, but delete rows older than 7 days (TTL). -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <database>system</database>
        <table>part_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
    <metric_log>
        <database>system</database>
        <table>metric_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </metric_log>
    <text_log>
        <database>system</database>
        <table>text_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </text_log>
    <error_log>
        <database>system</database>
        <table>error_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
</clickhouse>
