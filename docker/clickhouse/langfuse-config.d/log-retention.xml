<clickhouse>
    <!-- Bound server log files: 3 rotated files of 100 MB (was unbounded, ~1.6 GB on disk) -->
    <logger>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- Keep only short-lived errors in ClickHouse system-log storage. These tables are
         diagnostic history, not application data; live metrics remain available in system.*. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <processors_profile_log remove="1"/>
    <trace_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <part_log remove="1"/>
    <metric_log remove="1"/>
    <text_log remove="1"/>

    <!-- Preserve a small error history; this does not clean pre-existing rows. -->
    <error_log>
        <database>system</database>
        <table>error_log</table>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </error_log>
</clickhouse>
