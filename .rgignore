# .rgignore — ripgrep override for gitignored NES/CHROM packet files
#
# These paths are in .gitignore (ephemeral local artifacts) but MUST be
# searchable by rg for offline MapReduce joins, awk pipelines, and graph
# traversal queries. Add them here so plain `rg` finds them without --no-ignore.
#
# Usage:
#   rg "cluster_key"           .opencode/ndjson/   # works — .rgignore unblocks
#   rg --no-ignore "cluster_key" .opencode/ndjson/ # also works (explicit)
#
# Note: ripgrep 14.x uses --no-ignore (not --uu which was rg 13.x)

!.opencode/ndjson/
!.opencode/ndjson/*.ndjson
!.opencode/ndjson/**/*.ndjson
!.opencode/ace-packets/
!.opencode/ace-packets/*.ndjson
!.opencode/ace-packets/*.json
!.opencode/gemma4_candidates.ndjson
!.opencode/outcome-ledger.ndjson
!.opencode/outcome-ledger-with-cardIds.ndjson
!.opencode/cards/
!.opencode/cards/*.json

# Codebase graph — large gitignored JSON, but searchable for offline analytics
!sveltekit-frontend/docs/graph/codebase-graph.json

# Multihop enriched map — large gitignored JSON, but searchable for offline analytics
!sveltekit-frontend/docs/graph/multihop-codebase-map.enriched.json

# index-codebase-fast.mjs probe runs (2026-08-11) — timestamped receipt + graph/map copies
# per non --publish-canonical run, gitignored but rg-searchable for offline diffing.
!sveltekit-frontend/docs/graph/.build/
!sveltekit-frontend/docs/graph/.build/**
!sveltekit-frontend/docs/reports/graph-probes/
!sveltekit-frontend/docs/reports/graph-probes/**

# GRAPH_SNAPSHOT_PARITY frozen artifacts (2026-08-12) — nodes.parquet/edges.parquet
# and the two per-node PageRank score NDJSON dumps are gitignored (regenerable,
# large) but must stay rg-searchable for offline inspection/diffing.
!sveltekit-frontend/docs/reports/graph-snapshot-parity/
!sveltekit-frontend/docs/reports/graph-snapshot-parity/**

# Canonical graphify/ output directory (2026-08-09) — gitignored, rg-searchable.
# Infra only: no graphify scripts write here yet. See graphify/README.md.
!/graphify/
!/graphify/**

# Canonical neo4j/ output directory (2026-08-09) — gitignored, rg-searchable.
# Infra only: no scripts write here yet. See neo4j/README.md.
!/neo4j/
!/neo4j/**

# Python virtual environments — gitignored but searchable by rg
!.venv-gemma4/
!.venv-gemma4/**

# Env files — keep gitignored for safety, but searchable for local runtime audits
!.env
!.env.local
!.env.example
!.env.sample
!/sveltekit-frontend/
!sveltekit-frontend/.env
!sveltekit-frontend/.env.local
!sveltekit-frontend/.env.example
!sveltekit-frontend/.env.local.example
!/sveltekit-frontend/.env
!/sveltekit-frontend/.env.local
!/sveltekit-frontend/.env.example
!/sveltekit-frontend/.env.local.example

# Graphify-generated report noise (2026-08-09) — gitignored, still rg-searchable.
!docs/graph/repo-couchdb-mapreduce-report.*
!docs/reports/bitfrost-semantic-cache-warm.*
!docs/reports/materialize-feature-envelopes-receipt.json
!docs/reports/packet-reader-writer-audit.*
!docs/reports/qdrant-tag-mirror-audit.*
!docs/reports/summary-index-ranker.*
!sveltekit-frontend/docs/reports/backfill-latent-vectors-writeback.json
!sveltekit-frontend/docs/reports/summary-envelope-build.json
!sveltekit-frontend/docs/reports/train-som-20x20-writeback.json

# Container dependency manifests — selectively searchable even though the
# repository-wide *.txt rule keeps generated/text artifacts out of normal rg.
!docker/**/requirements*.txt
!services/**/requirements*.txt
!scripts/**/requirements*.txt
!python/requirements*.txt
!docs/reports/docker-reproducibility-v1.json
!sveltekit-frontend/memory/graphify/gds/*.json
!openspec/drafts/*.md

# --- Classification + AST-authority evidence (2026-09-20) ---------------------------------------------
# Gitignored on purpose: the git hook rejects files > 10 MB and *.jsonl / .tmp/ are ignored. They must
# still be rg-searchable for offline joins (packet_key, sourceRef, qualifiedSymbol). Selective on purpose:
# .tmp/atlas is ~422 MB in total, so only the evidence files below are un-ignored, not the whole directory.
# These are derived/regenerable artifacts, never canonical evidence; regenerate before citing them.
!docs/reports/domain-calibration-draft-v1.jsonl
!docs/reports/domain-calibration-reviewed-v1.jsonl
# .tmp/ is ignored as a whole directory, and a file cannot be re-included while its parent directory is
# ignored. So: re-include .tmp/, ignore its children, re-include .tmp/atlas/, ignore its children, then
# re-include the named evidence files. Last matching rule wins. Everything else under .tmp/ stays hidden.
!.tmp/
.tmp/*
!.tmp/atlas/
.tmp/atlas/*
!.tmp/atlas/ast-declaration-candidates-current-v1.jsonl
!.tmp/atlas/ast-canary-eligible-v1.jsonl
!.tmp/atlas/ast-source-authority-cohort-v1.json
!.tmp/atlas/current-graphify-symbol-nominations-v1.jsonl
!.tmp/atlas/current-graph-symbol-resolution-v1.jsonl
!.tmp/knowledge-source-snapshot-live-v1.json

# re-include gitignored >10 MB generated reports so plain rg from the repo root finds them (searchable != authoritative; regenerate before citing)
!docs/reports/openspec-directory-graph-v1.json
!docs/reports/openspec-file-labels-v1.json
