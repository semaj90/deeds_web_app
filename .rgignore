# .rgignore — ripgrep override for gitignored NES/CHROM packet files
#
# These paths are in .gitignore (ephemeral local artifacts) but MUST be
# searchable by rg for offline MapReduce joins, awk pipelines, and graph
# traversal queries. Add them here so plain `rg` finds them without --no-ignore.
#
# Usage:
#   rg "cluster_key"           .opencode/ndjson/   # works — .rgignore unblocks
#   rg --no-ignore "cluster_key" .opencode/ndjson/ # also works (explicit)
#
# Note: ripgrep 14.x uses --no-ignore (not --uu which was rg 13.x)

!.opencode/ndjson/
!.opencode/ndjson/*.ndjson
!.opencode/ndjson/**/*.ndjson
!.opencode/ace-packets/
!.opencode/ace-packets/*.ndjson
!.opencode/ace-packets/*.json
!.opencode/gemma4_candidates.ndjson
!.opencode/outcome-ledger.ndjson
!.opencode/outcome-ledger-with-cardIds.ndjson
!.opencode/cards/
!.opencode/cards/*.json

# Codebase graph — large gitignored JSON, but searchable for offline analytics
!sveltekit-frontend/docs/graph/codebase-graph.json

# Canonical graphify/ output directory (2026-08-09) — gitignored, rg-searchable.
# Infra only: no graphify scripts write here yet. See graphify/README.md.
!/graphify/
!/graphify/**

# Canonical neo4j/ output directory (2026-08-09) — gitignored, rg-searchable.
# Infra only: no scripts write here yet. See neo4j/README.md.
!/neo4j/
!/neo4j/**

# Python virtual environments — gitignored but searchable by rg
!.venv-gemma4/
!.venv-gemma4/**

# Env files — keep gitignored for safety, but searchable for local runtime audits
!.env
!.env.local
!.env.example
!.env.sample
!/sveltekit-frontend/
!sveltekit-frontend/.env
!sveltekit-frontend/.env.local
!sveltekit-frontend/.env.example
!sveltekit-frontend/.env.local.example
!/sveltekit-frontend/.env
!/sveltekit-frontend/.env.local
!/sveltekit-frontend/.env.example
!/sveltekit-frontend/.env.local.example

# Graphify-generated report noise (2026-08-09) — gitignored, still rg-searchable.
!docs/graph/repo-couchdb-mapreduce-report.*
!docs/reports/bitfrost-semantic-cache-warm.*
!docs/reports/materialize-feature-envelopes-receipt.json
!docs/reports/packet-reader-writer-audit.*
!docs/reports/qdrant-tag-mirror-audit.*
!docs/reports/summary-index-ranker.*
!sveltekit-frontend/docs/reports/backfill-latent-vectors-writeback.json
!sveltekit-frontend/docs/reports/summary-envelope-build.json
!sveltekit-frontend/docs/reports/train-som-20x20-writeback.json
!sveltekit-frontend/memory/graphify/gds/*.json
!openspec/drafts/*.md
