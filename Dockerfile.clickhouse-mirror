FROM python:3.13-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    psycopg2-binary \
    clickhouse-driver \
    qdrant-client \
    redis \
    httpx \
    ollama

# Copy mirror script (from build context root)
COPY ./clickhouse-mirror.py /app/clickhouse-mirror.py

# Run the sync service
CMD ["python", "-u", "/app/clickhouse-mirror.py"]
