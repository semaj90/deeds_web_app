name: "siglip_vision"
platform: "onnxruntime_onnx"
max_batch_size: 4

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [ 3, 384, 384 ]
  }
]

output [
  {
    name: "image_features"
    data_type: TYPE_FP32
    dims: [ 729, 1152 ]
  }
]

# On-demand loading: starts unloaded, loaded via model control API
# POST /v2/repository/models/siglip_vision/load
instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator: [
      {
        name: "tensorrt"
        parameters {
          key: "precision_mode"
          value: "FP16"
        }
        parameters {
          key: "max_workspace_size_bytes"
          value: "2147483648"
        }
      }
    ]
  }
}

dynamic_batching {
  preferred_batch_size: [ 1, 2, 4 ]
  max_queue_delay_microseconds: 500
}
